@model Webgiasu.Models.ViewModels.ClassDetailsViewModel

@{
    ViewData["Title"] = "Chi tiết lớp học";
    Layout = "~/Views/Shared/_SchoolLayout.cshtml";
}

<div class="dashboard-container">
    <!-- Page Header -->
    <div class="page-header d-flex justify-content-between align-items-center">
        <div>
            <h2><i class="bi bi-info-circle me-2 text-warning"></i>Chi tiết lớp học</h2>
            <p class="text-muted mb-0">@Model.ClassName</p>
        </div>
        <div>
            <a asp-controller="School" asp-action="EditClass" asp-route-id="@Model.Id" class="btn btn-warning me-2">
                <i class="bi bi-pencil me-2"></i>Chỉnh sửa
            </a>
            <a asp-controller="School" asp-action="ManageClasses" class="btn btn-secondary">
                <i class="bi bi-arrow-left me-2"></i>Quay lại
            </a>
        </div>
    </div>

    <div class="row">
        <!-- Class Info -->
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-book me-2"></i>Thông tin lớp học</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="text-muted small">Tên lớp học</label>
                            <div class="fw-semibold">@Model.ClassName</div>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small">Môn học</label>
                            <div>
                                <span class="badge bg-info">@Model.Subject</span>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="text-muted small">Ngày bắt đầu</label>
                            <div class="fw-semibold">
                                <i class="bi bi-calendar-event me-1"></i>@Model.StartDate
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small">Ngày kết thúc (dự kiến)</label>
                            <div class="fw-semibold">
                                <i class="bi bi-calendar-check me-1"></i>@Model.EndDate
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="text-muted small">Trạng thái</label>
                        <div>
                            @if (Model.Status == ClassStatus.Active)
                            {
                                <span class="badge bg-success">
                                    <i class="bi bi-check-circle me-1"></i>Đang hoạt động
                                </span>
                            }
                            else if (Model.Status == ClassStatus.Completed)
                            {
                                <span class="badge bg-secondary">
                                    <i class="bi bi-check-all me-1"></i>Đã hoàn thành
                                </span>
                            }
                            else if (Model.Status == ClassStatus.Upcoming)
                            {
                                <span class="badge bg-info">
                                    <i class="bi bi-clock me-1"></i>Sắp bắt đầu
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    <i class="bi bi-x-circle me-1"></i>Đã hủy
                                </span>
                            }
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <div class="mb-3">
                            <label class="text-muted small">Mô tả</label>
                            <div class="border rounded p-3 bg-light">@Model.Description</div>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="text-muted small">Ngày tạo</label>
                        <div class="fw-semibold">
                            <i class="bi bi-calendar-plus me-1"></i>@Model.CreatedDate
                        </div>
                    </div>
                </div>
            </div>

            <!-- Students List -->
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-people me-2"></i>Danh sách học sinh (@Model.Students.Count người)
                    </h5>
                </div>
                <div class="card-body">
                    @if (Model.Students.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>STT</th>
                                        <th>Họ tên</th>
                                        <th>Email</th>
                                        <th>Số điện thoại</th>
                                        <th>Ngày tham gia</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var (student, index) in Model.Students.Select((s, i) => (s, i)))
                                    {
                                        <tr>
                                            <td>@(index + 1)</td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(student.FullName)&background=17a2b8&color=fff&size=32" 
                                                         class="rounded-circle me-2" alt="Avatar" width="32" height="32">
                                                    <strong>@student.FullName</strong>
                                                </div>
                                            </td>
                                            <td>@student.Email</td>
                                            <td>@student.PhoneNumber</td>
                                            <td>@student.JoinedDate</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                            <p>Chưa có học sinh nào trong lớp</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <!-- Tutor Info -->
            <div class="card mb-3">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="bi bi-person-badge me-2"></i>Mentor phụ trách</h5>
                </div>
                <div class="card-body text-center">
                    @if (!string.IsNullOrEmpty(Model.TutorName))
                    {
                        <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(Model.TutorName)&background=4CAF50&color=fff&size=80" 
                             class="rounded-circle mb-3" alt="Avatar" width="80" height="80">
                        <h5 class="mb-1">@Model.TutorName</h5>
                        @if (!string.IsNullOrEmpty(Model.TutorEmail))
                        {
                            <p class="text-muted mb-1">
                                <i class="bi bi-envelope me-1"></i>@Model.TutorEmail
                            </p>
                        }
                        @if (!string.IsNullOrEmpty(Model.TutorPhone))
                        {
                            <p class="text-muted mb-0">
                                <i class="bi bi-telephone me-1"></i>@Model.TutorPhone
                            </p>
                        }
                    }
                    else
                    {
                        <i class="bi bi-person-x fs-1 text-muted mb-3 d-block"></i>
                        <p class="text-muted">Chưa có Mentor được phân công</p>
                    }
                </div>
            </div>

            <!-- Quick Stats -->
            <div class="card mb-3">
                <div class="card-header bg-warning text-white">
                    <h5 class="mb-0"><i class="bi bi-graph-up me-2"></i>Thống kê nhanh</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Tổng học sinh</span>
                        <strong class="text-info">@Model.Students.Count người</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Trạng thái</span>
                        <strong class="text-success">@Model.Status</strong>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Thời gian</span>
                        <strong>@Model.Duration</strong>
                    </div>
                </div>
            </div>

            <!-- Actions -->
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-lightning me-2"></i>Thao tác</h5>
                </div>
                <div class="card-body">
                    <a asp-controller="School" asp-action="EditClass" asp-route-id="@Model.Id" class="btn btn-warning w-100 mb-2">
                        <i class="bi bi-pencil me-2"></i>Chỉnh sửa lớp học
                    </a>
                    <button class="btn btn-danger w-100" onclick="deleteClass(@Model.Id)">
                        <i class="bi bi-trash me-2"></i>Xóa lớp học
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function deleteClass(classId) {
            if (!confirm('Bạn có chắc chắn muốn xóa lớp học này?\n\nThao tác này không thể hoàn tác!')) {
                return;
            }

            fetch(`/School/DeleteClass/${classId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert('Xóa lớp học thành công!');
                    window.location.href = '/School/ManageClasses';
                } else {
                    alert('Không thể xóa lớp học: ' + (data.message || 'Lỗi không xác định'));
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Đã xảy ra lỗi khi xóa lớp học!');
            });
        }
    </script>
}
