@model Webgiasu.Models.ViewModels.ProblemDetailsViewModel
@{
    ViewData["Title"] = "Chi tiết bài toán";
    Layout = "_TutorLayout";
}

@functions {
    string GetGradeLevelText(Webgiasu.Models.DifficultyLevel level)
    {
        return level switch
        {
            Webgiasu.Models.DifficultyLevel.TieuHoc => "Tiểu học",
            Webgiasu.Models.DifficultyLevel.THCS => "THCS",
            Webgiasu.Models.DifficultyLevel.THPT => "THPT",
            Webgiasu.Models.DifficultyLevel.DaiHoc => "Đại học",
            _ => "N/A"
        };
    }

    string GetGradeLevelBadgeClass(Webgiasu.Models.DifficultyLevel level)
    {
        return level switch
        {
            Webgiasu.Models.DifficultyLevel.TieuHoc => "primary",
            Webgiasu.Models.DifficultyLevel.THCS => "info",
            Webgiasu.Models.DifficultyLevel.THPT => "warning",
            Webgiasu.Models.DifficultyLevel.DaiHoc => "success",
            _ => "secondary"
        };
    }
}

<div class="row">
    <div class="col-lg-8">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-success text-white">
                <h4 class="mb-0"><i class="bi bi-file-text"></i> Thông tin bài toán</h4>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong><i class="bi bi-hash"></i> Mã bài:</strong> #@Model.Problem.Id
                    </div>
                    <div class="col-md-6 text-end">
                        @{
                            var statusClass = Model.Problem.Status switch
                            {
                                Webgiasu.Models.ProblemStatus.WaitingForTutor => "warning",
                                Webgiasu.Models.ProblemStatus.InProgress => "info",
                                Webgiasu.Models.ProblemStatus.Solved => "success",
                                _ => "secondary"
                            };
                            var statusText = Model.Problem.Status switch
                            {
                                Webgiasu.Models.ProblemStatus.WaitingForTutor => "Chờ gia sư",
                                Webgiasu.Models.ProblemStatus.InProgress => "Đang giải",
                                Webgiasu.Models.ProblemStatus.Solved => "Đã giải",
                                _ => "Khác"
                            };
                        }
                        <span class="badge bg-@statusClass fs-6">@statusText</span>
                    </div>
                </div>

                <h3 class="mb-3">@Model.Problem.Title</h3>
                
                <div class="mb-3">
                    <span class="badge bg-secondary me-2"><i class="bi bi-book"></i> @Model.Problem.Type</span>
                    <span class="badge bg-@GetGradeLevelBadgeClass(Model.Problem.Difficulty) me-2">
                        <i class="bi bi-mortarboard"></i> @GetGradeLevelText(Model.Problem.Difficulty)
                    </span>
                    <span class="badge bg-success fs-6"><i class="bi bi-currency-dollar"></i> @Model.Problem.Price.ToString("N0") đ</span>
                </div>

                <hr />

                <h5 class="mb-3"><i class="bi bi-file-text"></i> Mô tả chi tiết:</h5>
                <div class="bg-light p-3 rounded">
                    <p class="mb-0">@Html.Raw(Model.Problem.Description)</p>
                </div>

                @if (!string.IsNullOrEmpty(Model.Problem.ImageUrl) && Model.Problem.ImageUrl != "/images/default.jpg")
                {
                    <div class="mt-3">
                        <h5><i class="bi bi-image"></i> Hình ảnh:</h5>
                        <img src="@Model.Problem.ImageUrl" alt="Problem image" class="img-fluid rounded" style="max-height: 400px;" />
                    </div>
                }

                <hr />

                <div class="row mt-3">
                    <div class="col-md-6">
                        <p class="mb-1"><strong><i class="bi bi-calendar-plus"></i> Ngày đăng:</strong></p>
                        <p>@Model.Problem.CreatedDate.ToString("dd/MM/yyyy HH:mm")</p>
                    </div>
                    <div class="col-md-6">
                        <p class="mb-1"><strong><i class="bi bi-calendar-event"></i> Deadline:</strong></p>
                        <p class="text-danger fw-bold">@Model.Problem.Deadline.ToString("dd/MM/yyyy HH:mm")</p>
                        <small class="text-muted">
                            Còn @((Model.Problem.Deadline - DateTime.Now).Days) ngày @((Model.Problem.Deadline - DateTime.Now).Hours) giờ
                        </small>
                    </div>
                </div>
            </div>
        </div>

        @* <div class="mt-4">
            @await Html.PartialAsync("_AiChatPartial", Model)
        </div> *@

        @if (Model.Solution != null)
        {
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="bi bi-check-circle"></i> Lời giải của bạn</h5>
                </div>
                <div class="card-body">
                    <div class="bg-light p-3 rounded">
                        <pre class="mb-0" style="white-space: pre-wrap;">@Model.Solution.Content</pre>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Solution.FileUrl))
                    {
                        <div class="mt-3">
                            <p><strong>File đính kèm:</strong> <code>@Model.Solution.FileUrl</code></p>
                        </div>
                    }

                    <hr />

                    <small class="text-muted">
                        <i class="bi bi-clock"></i> Gửi lúc: @Model.Solution.SubmittedDate.ToString("dd/MM/yyyy HH:mm")
                    </small>

                    @if (Model.Solution.Rating.HasValue)
                    {
                        <div class="alert alert-success mt-3">
                            <h6><i class="bi bi-star-fill text-warning"></i> Đánh giá từ học sinh: @Model.Solution.Rating/5 ⭐</h6>
                            @if (!string.IsNullOrEmpty(Model.Solution.Feedback))
                            {
                                <p class="mb-0"><strong>Nhận xét:</strong> @Model.Solution.Feedback</p>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info mt-3">
                            <i class="bi bi-info-circle"></i> Chờ học sinh đánh giá
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-person"></i> Thông tin học sinh</h5>
            </div>
            <div class="card-body text-center">
                <i class="bi bi-person-circle text-primary" style="font-size: 4rem;"></i>
                <h5 class="mt-3">@Model.Student?.FullName</h5>
                <p class="text-muted mb-2">
                    <i class="bi bi-envelope"></i> @Model.Student?.Email<br />
                    <i class="bi bi-phone"></i> @Model.Student?.PhoneNumber
                </p>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="bi bi-cash"></i> Thu nhập</h5>
            </div>
            <div class="card-body text-center">
                <h2 class="text-success mb-0">@Model.Problem.Price.ToString("N0") đ</h2>
                <p class="text-muted mb-0">Phần thưởng</p>
            </div>
        </div>

        @if (Model.Problem.Status == Webgiasu.Models.ProblemStatus.WaitingForTutor)
        {
            <div class="card shadow-sm mb-4 border-success">
                <div class="card-body">
                    <h5 class="text-center mb-3">
                        <i class="bi bi-hand-thumbs-up"></i> Quan tâm bài này?
                    </h5>
                    
                    <!-- ✅ FIX: Link đến form đăng ký -->
                    <div class="d-grid gap-2">
                        <a asp-action="ApplyForProblem" 
                           asp-route-problemId="@Model.Problem.Id" 
                           class="btn btn-success btn-lg">
                            <i class="bi bi-hand-thumbs-up me-1"></i> Đăng ký nhận bài
                        </a>
                    </div>
                    
                    <div class="alert alert-info mt-3 mb-0">
                        <small>
                            <i class="bi bi-info-circle"></i> 
                            Bạn cần gửi đề xuất để học sinh xem xét
                        </small>
                    </div>
                </div>
            </div>
        }
        else if (Model.Problem.Status == Webgiasu.Models.ProblemStatus.InProgress && Model.Solution == null)
        {
            <div class="card shadow-sm mb-4 border-warning">
                <div class="card-body text-center">
                    <i class="bi bi-hourglass-split text-warning" style="font-size: 3rem;"></i>
                    <h5 class="mt-3">Đang thực hiện</h5>
                    <p class="text-muted">Hãy gửi lời giải của bạn</p>
                    <a asp-action="SubmitSolution" asp-route-problemId="@Model.Problem.Id" class="btn btn-warning btn-lg">
                        <i class="bi bi-send"></i> Gửi lời giải
                    </a>
                </div>
            </div>
        }

        <div class="d-grid gap-2">
            <a asp-action="AvailableProblems" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Danh sách bài toán
            </a>
            <a asp-action="Dashboard" class="btn btn-outline-primary">
                <i class="bi bi-house"></i> Dashboard
            </a>
        </div>
    </div>
</div>
