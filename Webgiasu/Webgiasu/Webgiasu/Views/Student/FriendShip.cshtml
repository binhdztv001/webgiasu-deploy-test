@model List<Webgiasu.Models.User>

@{
    ViewData["Title"] = "Bạn Bè";
    Layout = "_StudentLayout";
    var receivedRequests = ViewBag.ReceivedRequests as List<Webgiasu.Models.Friendship>;
    var sentRequests = ViewBag.SentRequests as List<Webgiasu.Models.Friendship>;
    var friends = ViewBag.Friends as List<Webgiasu.Models.User>;
    var friendshipStatuses = ViewBag.FriendshipStatuses as Dictionary<int, Webgiasu.Models.FriendshipStatus?>;
}

<div>
    <div class="page-header d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h5 class="fw-bold mb-1 text-dark">
                <i class="bi bi-people-fill text-primary me-2"></i>Quản lý bạn bè
            </h5>
            <p class="text-muted mb-0 small">Kết nối và quản lý mạng lưới bạn bè của bạn</p>
        </div>
        <div>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#findFriendsModal">
                <i class="bi bi-person-plus-fill me-2"></i>Tìm bạn mới
            </button>
        </div>
    </div>

    <!-- Tabs Navigation -->
    <ul class="nav nav-tabs mb-4" id="friendshipTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="friends-tab" data-bs-toggle="tab" data-bs-target="#friends" type="button" role="tab">
                <i class="bi bi-people me-2"></i>Bạn bè <span class="badge bg-primary rounded-pill ms-2">@ViewBag.FriendsCount</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="requests-tab" data-bs-toggle="tab" data-bs-target="#requests" type="button" role="tab">
                <i class="bi bi-person-plus me-2"></i>Lời mời kết bạn <span class="badge bg-danger rounded-pill ms-2">@ViewBag.ReceivedCount</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="sent-tab" data-bs-toggle="tab" data-bs-target="#sent" type="button" role="tab">
                <i class="bi bi-send me-2"></i>Đã gửi lời mời <span class="badge bg-info rounded-pill ms-2">@ViewBag.SentCount</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="all-users-tab" data-bs-toggle="tab" data-bs-target="#all-users" type="button" role="tab">
                <i class="bi bi-stars me-2"></i>Tất cả người dùng
            </button>
        </li>
    </ul>

    <!-- Tab Content -->
    <div class="tab-content" id="friendshipTabContent">
        <!-- Friends List Tab -->
        <div class="tab-pane fade show active" id="friends" role="tabpanel">
            @if (friends == null || !friends.Any())
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>
                    Bạn chưa có bạn bè nào. Hãy gửi lời mời kết bạn!
                </div>
            }
            else
            {
                <div class="row g-4">
                    @foreach(var friend in friends)
                    {
                        var roleText = friend.Role == Webgiasu.Models.UserRole.Tutor ? "Gia sư" : "Học sinh";
                        var roleIcon = friend.Role == Webgiasu.Models.UserRole.Tutor ? "bi-briefcase-fill text-primary" : "bi-person-fill text-info";
                        var subjects = !string.IsNullOrEmpty(friend.Subjects) ? friend.Subjects : "Chưa có thông tin";
                        
                        <div class="col-md-6 col-lg-4">
                            <div class="card border-0 shadow-sm h-100 friend-card">
                                <div class="card-body text-center">
                                    <div class="position-relative d-inline-block mb-3">
                                        <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(friend.FullName)&size=100" 
                                             class="rounded-circle" width="100" height="100">
                                        <span class="position-absolute bottom-0 end-0 p-1 bg-success border border-light rounded-circle">
                                            <span class="visually-hidden">Online</span>
                                        </span>
                                    </div>
                                    <h6 class="card-title mb-1 fw-bold">@friend.FullName</h6>
                                    <p class="text-muted small mb-2">
                                        <i class="bi @roleIcon me-1"></i>@roleText
                                    </p>
                                    @if (friend.Role == Webgiasu.Models.UserRole.Tutor && !string.IsNullOrEmpty(friend.Subjects))
                                    {
                                        <p class="text-muted small mb-2">
                                            <i class="bi bi-book me-1"></i>@subjects
                                        </p>
                                    }
                                    <div class="d-grid gap-2">
                                        <a href="/Student/Messages" class="btn btn-primary btn-sm">
                                            <i class="bi bi-chat-dots-fill me-1"></i>Nhắn tin
                                        </a>
                                        <button class="btn btn-outline-danger btn-sm" onclick="unfriend(@friend.Id, '@friend.FullName')">
                                            <i class="bi bi-person-x-fill me-1"></i>Hủy kết bạn
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Friend Requests Tab -->
        <div class="tab-pane fade" id="requests" role="tabpanel">
            @if (receivedRequests == null || !receivedRequests.Any())
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle-fill me-2"></i>
                    Bạn không có lời mời kết bạn nào.
                </div>
            }
            else
            {
                @foreach(var request in receivedRequests)
                {
                    var requester = request.Requester;
                    var roleText = requester.Role == Webgiasu.Models.UserRole.Tutor ? "Gia sư" : "Học sinh";
                    var roleIcon = requester.Role == Webgiasu.Models.UserRole.Tutor ? "bi-briefcase-fill text-primary" : "bi-person-fill text-info";
                    var timeAgo = GetTimeAgo(request.RequestedDate);
                    
                    <div class="card border-0 shadow-sm mb-3" id="request-@request.Id">
                        <div class="card-body">
                            <div class="d-flex align-items-center">
                                <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(requester.FullName)&size=60" 
                                     class="rounded-circle me-3" width="60" height="60">
                                <div class="flex-grow-1">
                                    <h6 class="mb-1 fw-bold">@requester.FullName</h6>
                                    <p class="text-muted small mb-1">
                                        <i class="bi @roleIcon me-1"></i>@roleText
                                    </p>
                                    @if (requester.Role == Webgiasu.Models.UserRole.Tutor && !string.IsNullOrEmpty(requester.Subjects))
                                    {
                                        <p class="text-muted small mb-1">
                                            <i class="bi bi-book me-1"></i>@requester.Subjects
                                        </p>
                                    }
                                    <small class="text-muted">Gửi lời mời @timeAgo</small>
                                </div>
                                <div>
                                    <button class="btn btn-success btn-sm me-2" onclick="acceptRequest(@request.Id, '@requester.FullName')">
                                        <i class="bi bi-check-lg"></i> Chấp nhận
                                    </button>
                                    <button class="btn btn-outline-danger btn-sm" onclick="declineRequest(@request.Id, '@requester.FullName')">
                                        <i class="bi bi-x-lg"></i> Từ chối
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <!-- Sent Requests Tab -->
        <div class="tab-pane fade" id="sent" role="tabpanel">
            @if (sentRequests == null || !sentRequests.Any())
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle-fill me-2"></i>
                    Bạn chưa gửi lời mời kết bạn nào.
                </div>
            }
            else
            {
                @foreach(var request in sentRequests)
                {
                    var addressee = request.Addressee;
                    var roleText = addressee.Role == Webgiasu.Models.UserRole.Tutor ? "Gia sư" : "Học sinh";
                    var roleIcon = addressee.Role == Webgiasu.Models.UserRole.Tutor ? "bi-briefcase-fill text-primary" : "bi-person-fill text-info";
                    var timeAgo = GetTimeAgo(request.RequestedDate);
                    
                    <div class="card border-0 shadow-sm mb-3" id="sent-@request.Id">
                        <div class="card-body">
                            <div class="d-flex align-items-center">
                                <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(addressee.FullName)&size=60" 
                                     class="rounded-circle me-3" width="60" height="60">
                                <div class="flex-grow-1">
                                    <h6 class="mb-1 fw-bold">@addressee.FullName</h6>
                                    <p class="text-muted small mb-1">
                                        <i class="bi @roleIcon me-1"></i>@roleText
                                    </p>
                                    <small class="text-muted">
                                        <i class="bi bi-clock-fill me-1"></i>Đã gửi @timeAgo
                                    </small>
                                </div>
                                <button class="btn btn-outline-secondary btn-sm" onclick="cancelRequest(@request.Id, '@addressee.FullName')">
                                    <i class="bi bi-x-circle"></i> Hủy lời mời
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <!-- All Users Tab -->
        <div class="tab-pane fade" id="all-users" role="tabpanel">
            <div class="row mb-3">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-white">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" id="searchInput" class="form-control" placeholder="Tìm kiếm người dùng...">
                    </div>
                </div>
                <div class="col-md-6">
                    <select class="form-select" id="filterRole">
                        <option value="all" selected>Tất cả</option>
                        <option value="student">Học sinh</option>
                        <option value="tutor">Gia sư</option>
                    </select>
                </div>
            </div>

            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>
                    Không có người dùng nào trong hệ thống.
                </div>
            }
            else
            {
                <div class="row g-4" id="userList">
                    @foreach(var user in Model)
                    {
                        var roleText = user.Role == Webgiasu.Models.UserRole.Tutor ? "Gia sư" : "Học sinh";
                        var roleIcon = user.Role == Webgiasu.Models.UserRole.Tutor ? "bi-briefcase-fill text-primary" : "bi-person-fill text-info";
                        var subjects = !string.IsNullOrEmpty(user.Subjects) ? user.Subjects : "Chưa có thông tin";
                        var status = friendshipStatuses != null && friendshipStatuses.ContainsKey(user.Id) ? friendshipStatuses[user.Id] : null;
                        
                        <div class="col-md-6 col-lg-4 user-card" data-role="@user.Role.ToString().ToLower()" data-name="@user.FullName.ToLower()">
                            <div class="card border-0 shadow-sm h-100 friend-card">
                                <div class="card-body text-center">
                                    <div class="position-relative d-inline-block mb-3">
                                        <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(user.FullName)&size=100" 
                                             class="rounded-circle" width="100" height="100">
                                        <span class="position-absolute bottom-0 end-0 p-1 bg-secondary border border-light rounded-circle">
                                            <span class="visually-hidden">Offline</span>
                                        </span>
                                    </div>
                                    <h6 class="card-title mb-1 fw-bold">@user.FullName</h6>
                                    <p class="text-muted small mb-2">
                                        <i class="bi @roleIcon me-1"></i>@roleText
                                    </p>
                                    @if (user.Role == Webgiasu.Models.UserRole.Tutor)
                                    {
                                        <p class="text-muted small mb-2">
                                            <i class="bi bi-book me-1"></i>@subjects
                                        </p>
                                        @if (user.ExperienceYears.HasValue)
                                        {
                                            <p class="text-muted small mb-3">
                                                <i class="bi bi-star-fill me-1"></i>@user.ExperienceYears năm kinh nghiệm
                                            </p>
                                        }
                                    }
                                    else
                                    {
                                        <p class="text-muted small mb-3">
                                            <i class="bi bi-envelope me-1"></i>@user.Email
                                        </p>
                                    }
                                    <div class="d-grid gap-2">
                                        @if (status == Webgiasu.Models.FriendshipStatus.Accepted)
                                        {
                                            <span class="badge bg-success p-2">
                                                <i class="bi bi-check-circle-fill me-1"></i>Đã là bạn bè
                                            </span>
                                            <a href="/Student/Messages" class="btn btn-outline-primary btn-sm">
                                                <i class="bi bi-chat-dots-fill me-1"></i>Nhắn tin
                                            </a>
                                        }
                                        else if (status == Webgiasu.Models.FriendshipStatus.Pending)
                                        {
                                            <span class="badge bg-warning p-2">
                                                <i class="bi bi-clock-fill me-1"></i>Đang chờ xác nhận
                                            </span>
                                        }
                                        else
                                        {
                                            <button class="btn btn-primary btn-sm" onclick="sendFriendRequest(@user.Id, '@user.FullName')">
                                                <i class="bi bi-person-plus-fill me-1"></i>Kết bạn
                                            </button>
                                            <a href="/Student/Messages" class="btn btn-outline-primary btn-sm">
                                                <i class="bi bi-chat-dots-fill me-1"></i>Nhắn tin
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Find Friends Modal -->
    <div class="modal fade" id="findFriendsModal" tabindex="-1" aria-labelledby="findFriendsModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="findFriendsModalLabel">
                        <i class="bi bi-search me-2"></i>Tìm bạn bè
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <input type="text" id="modalSearchInput" class="form-control form-control-lg" placeholder="Tìm kiếm theo tên, email hoặc số điện thoại...">
                    </div>
                    <div class="mb-3">
                        <select class="form-select" id="modalFilterRole">
                            <option value="all" selected>Tất cả</option>
                            <option value="tutor">Gia sư</option>
                            <option value="student">Học sinh</option>
                        </select>
                    </div>
                    <div id="modalUserList" class="list-group">
                        @if (Model != null && Model.Any())
                        {
                            @foreach(var user in Model.Take(5))
                            {
                                var roleText = user.Role == Webgiasu.Models.UserRole.Tutor ? "Gia sư" : "Học sinh";
                                <div class="list-group-item">
                                    <div class="d-flex align-items-center">
                                        <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(user.FullName)&size=50" 
                                             class="rounded-circle me-3" width="50" height="50">
                                        <div class="flex-grow-1">
                                            <h6 class="mb-0">@user.FullName</h6>
                                            <small class="text-muted">@roleText</small>
                                        </div>
                                        <button class="btn btn-sm btn-primary" onclick="sendFriendRequest(@user.Id, '@user.FullName')">
                                            <i class="bi bi-person-plus-fill"></i> Kết bạn
                                        </button>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .friend-card {
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .friend-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
    }

    .nav-tabs .nav-link {
        color: #6c757d;
        border: none;
        border-bottom: 3px solid transparent;
        font-weight: 500;
    }

    .nav-tabs .nav-link:hover {
        border-color: transparent;
        color: #2196F3;
    }

    .nav-tabs .nav-link.active {
        color: #2196F3;
        border-bottom-color: #2196F3;
        background-color: transparent;
    }
</style>

<script>
    // Search functionality
    const searchInput = document.getElementById('searchInput');
    if (searchInput) {
        searchInput.addEventListener('input', function() {
            filterUsers();
        });
    }

    // Filter by role
    const filterRole = document.getElementById('filterRole');
    if (filterRole) {
        filterRole.addEventListener('change', function() {
            filterUsers();
        });
    }

    function filterUsers() {
        const searchTerm = document.getElementById('searchInput')?.value.toLowerCase() || '';
        const roleFilter = document.getElementById('filterRole')?.value || 'all';
        const userCards = document.querySelectorAll('.user-card');

        userCards.forEach(card => {
            const userName = card.getAttribute('data-name');
            const userRole = card.getAttribute('data-role');
            
            const matchesSearch = userName.includes(searchTerm);
            const matchesRole = roleFilter === 'all' || userRole === roleFilter;

            if (matchesSearch && matchesRole) {
                card.style.display = '';
            } else {
                card.style.display = 'none';
            }
        });
    }

    async function sendFriendRequest(userId, userName) {
        if (!confirm(`Bạn có muốn gửi lời mời kết bạn tới ${userName}?`)) {
            return;
        }

        try {
            const response = await fetch('/Student/SendFriendRequest', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ userId: userId })
            });

            const data = await response.json();
            
            if (data.success) {
                alert(data.message);
                location.reload();
            } else {
                alert(data.message);
            }
        } catch (error) {
            console.error('Error:', error);
            alert('Có lỗi xảy ra. Vui lòng thử lại!');
        }
    }

    async function acceptRequest(friendshipId, userName) {
        try {
            const response = await fetch('/Student/AcceptFriendRequest', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ friendshipId: friendshipId })
            });

            const data = await response.json();
            
            if (data.success) {
                alert(`Đã chấp nhận lời mời kết bạn từ ${userName}`);
                location.reload();
            } else {
                alert(data.message);
            }
        } catch (error) {
            console.error('Error:', error);
            alert('Có lỗi xảy ra. Vui lòng thử lại!');
        }
    }

    async function declineRequest(friendshipId, userName) {
        if (!confirm(`Bạn có chắc muốn từ chối lời mời từ ${userName}?`)) {
            return;
        }

        try {
            const response = await fetch('/Student/DeclineFriendRequest', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ friendshipId: friendshipId })
            });

            const data = await response.json();
            
            if (data.success) {
                alert(data.message);
                location.reload();
            } else {
                alert(data.message);
            }
        } catch (error) {
            console.error('Error:', error);
            alert('Có lỗi xảy ra. Vui lòng thử lại!');
        }
    }

    async function cancelRequest(friendshipId, userName) {
        if (!confirm(`Bạn có chắc muốn hủy lời mời kết bạn gửi tới ${userName}?`)) {
            return;
        }

        try {
            const response = await fetch('/Student/CancelFriendRequest', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ friendshipId: friendshipId })
            });

            const data = await response.json();
            
            if (data.success) {
                alert(data.message);
                location.reload();
            } else {
                alert(data.message);
            }
        } catch (error) {
            console.error('Error:', error);
            alert('Có lỗi xảy ra. Vui lòng thử lại!');
        }
    }

    async function unfriend(userId, userName) {
        if (!confirm(`Bạn có chắc muốn hủy kết bạn với ${userName}?`)) {
            return;
        }

        try {
            const response = await fetch('/Student/Unfriend', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ userId: userId })
            });

            const data = await response.json();
            
            if (data.success) {
                alert(data.message);
                location.reload();
            } else {
                alert(data.message);
            }
        } catch (error) {
            console.error('Error:', error);
            alert('Có lỗi xảy ra. Vui lòng thử lại!');
        }
    }
</script>

@functions {
    private string GetTimeAgo(DateTime dateTime)
    {
        var timeSpan = DateTime.Now - dateTime;
        
        if (timeSpan.TotalMinutes < 1)
            return "vừa xong";
        if (timeSpan.TotalMinutes < 60)
            return $"{(int)timeSpan.TotalMinutes} phút trước";
        if (timeSpan.TotalHours < 24)
            return $"{(int)timeSpan.TotalHours} giờ trước";
        if (timeSpan.TotalDays < 30)
            return $"{(int)timeSpan.TotalDays} ngày trước";
        if (timeSpan.TotalDays < 365)
            return $"{(int)(timeSpan.TotalDays / 30)} tháng trước";
        
        return $"{(int)(timeSpan.TotalDays / 365)} năm trước";
    }
}
