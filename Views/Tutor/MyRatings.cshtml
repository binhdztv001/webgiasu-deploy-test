@model Webgiasu.Models.ViewModels.TutorRatingsSummaryViewModel
@{
    ViewData["Title"] = "Đánh giá của tôi";
    Layout = "_TutorLayout";
}

<div>
    <div class="page-header mb-4">
        <h2 class="fw-bold">
            <i class="bi bi-star-fill text-warning"></i> Đánh giá của tôi
        </h2>
        <p class="text-muted">Xem tất cả đánh giá từ học sinh</p>
    </div>

    <!-- Summary Cards -->
    <div class="row g-4 mb-4">
        <!-- Average Rating Card -->
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center p-4">
                    <div class="mb-3">
                        <i class="bi bi-star-fill text-warning" style="font-size: 3rem;"></i>
                    </div>
                    <h1 class="display-4 fw-bold text-warning mb-2">
                        @Model.AverageRating.ToString("F1")
                        <small class="fs-4 text-muted">/ 5.0</small>
                    </h1>
                    <p class="text-muted mb-0">Đánh giá trung bình</p>

                    @{
                        var ratingPercent = (Model.AverageRating / 5.0) * 100;
                        var ratingClass = Model.AverageRating >= 4.5 ? "success" :
                        Model.AverageRating >= 3.5 ? "info" :
                        Model.AverageRating >= 2.5 ? "warning" : "danger";
                    }

                    <div class="mt-3">
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar bg-@ratingClass" role="progressbar"
                                 style="width: @ratingPercent%"
                                 aria-valuenow="@ratingPercent" aria-valuemin="0" aria-valuemax="100">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Total Ratings Card -->
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center p-4">
                    <div class="mb-3">
                        <i class="bi bi-people-fill text-primary" style="font-size: 3rem;"></i>
                    </div>
                    <h1 class="display-4 fw-bold text-primary mb-2">@Model.TotalRatings</h1>
                    <p class="text-muted mb-0">Tổng số đánh giá</p>

                    @if (Model.TotalRatings > 0)
                    {
                        <div class="mt-3">
                            <span class="badge bg-primary">
                                @(Model.TotalRatings) học sinh đã đánh giá
                            </span>
                        </div>
                    }
                    else
                    {
                        <div class="mt-3">
                            <span class="badge bg-secondary">
                                Chưa có đánh giá nào
                            </span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Performance Card -->
        <div class="col-md-12 col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3">
                        <i class="bi bi-trophy text-warning"></i> Thành tích
                    </h6>

                    @if (Model.AverageRating >= 4.5)
                    {
                        <div class="alert alert-success mb-2">
                            <i class="bi bi-award-fill"></i> <strong>Gia sư xuất sắc!</strong>
                        </div>
                    }
                    else if (Model.AverageRating >= 3.5)
                    {
                        <div class="alert alert-info mb-2">
                            <i class="bi bi-hand-thumbs-up-fill"></i> <strong>Gia sư tốt!</strong>
                        </div>
                    }
                    else if (Model.AverageRating >= 2.5)
                    {
                        <div class="alert alert-warning mb-2">
                            <i class="bi bi-exclamation-triangle-fill"></i> <strong>Cần cải thiện</strong>
                        </div>
                    }
                    else if (Model.TotalRatings > 0)
                    {
                        <div class="alert alert-danger mb-2">
                            <i class="bi bi-x-circle-fill"></i> <strong>Cần nỗ lực hơn</strong>
                        </div>
                    }

                    <div class="mt-3">
                        <small class="text-muted">
                            <i class="bi bi-lightbulb"></i>
                            <strong>Mẹo:</strong> Giữ đánh giá trên 4.0 sao để thu hút nhiều học sinh hơn!
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Star Distribution -->
    @if (Model.TotalRatings > 0 && Model.StarDistribution != null)
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-bottom">
                <h5 class="mb-0 text-dark">
                    <i class="bi bi-bar-chart-fill text-info"></i> Phân bố đánh giá
                </h5>
            </div>
            <div class="card-body p-4">
                @foreach (var star in Model.StarDistribution.OrderByDescending(x => x.Key))
                {
                    var percentage = Model.TotalRatings > 0 ? (star.Value * 100.0 / Model.TotalRatings) : 0;
                    var barClass = star.Key >= 4 ? "success" : star.Key >= 3 ? "info" : star.Key >= 2 ? "warning" : "danger";

                    <div class="mb-3">
                        <div class="d-flex align-items-center mb-2">
                            <div style="min-width: 80px;">
                                <span class="fw-bold">@star.Key sao</span>
                            </div>
                            <div class="flex-grow-1 mx-3">
                                <div class="progress" style="height: 25px;">
                                    <div class="progress-bar bg-@barClass"
                                         role="progressbar"
                                         style="width: @percentage%"
                                         aria-valuenow="@percentage"
                                         aria-valuemin="0"
                                         aria-valuemax="100">
                                        <span class="fw-bold">@percentage.ToString("F1")%</span>
                                    </div>
                                </div>
                            </div>
                            <div style="min-width: 60px;" class="text-end">
                                <span class="badge bg-@barClass">@star.Value</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Recent Ratings -->
    @if (Model.RecentRatings != null && Model.RecentRatings.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom">
                <h5 class="mb-0 text-dark">
                    <i class="bi bi-chat-left-text text-primary"></i> Đánh giá gần đây
                </h5>
            </div>
            <div class="card-body">
                @foreach (var rating in Model.RecentRatings)
                {
                    <div class="card border mb-3">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h6 class="mb-1">
                                        <i class="bi bi-person-circle text-primary"></i>
                                        <strong>@rating.StudentName</strong>
                                    </h6>
                                    <small class="text-muted">
                                        <i class="bi bi-journal-text"></i> @rating.ProblemTitle
                                    </small>
                                </div>
                                <div class="text-end">
                                    <div class="mb-1">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= rating.Stars)
                                            {
                                                <i class="bi bi-star-fill text-warning"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-star text-muted"></i>
                                            }
                                        }
                                    </div>
                                    <small class="text-muted">
                                        <i class="bi bi-clock"></i> @rating.CreatedAt.ToString("dd/MM/yyyy")
                                    </small>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(rating.Comment))
                            {
                                <div class="alert alert-light mb-0 mt-2">
                                    <i class="bi bi-quote"></i>
                                    <em>"@rating.Comment"</em>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-star text-muted" style="font-size: 4rem;"></i>
                <h4 class="mt-3 text-muted">Chưa có đánh giá nào</h4>
                <p class="text-muted">
                    Hãy tiếp tục giải các bài toán để nhận được đánh giá từ học sinh!
                </p>
                <a asp-action="AvailableProblems" class="btn btn-primary">
                    <i class="bi bi-search"></i> Tìm bài toán
                </a>
            </div>
        </div>
    }
</div>

<!-- Back Button -->
<div class="mt-4">
    <a asp-action="Dashboard" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Quay lại Dashboard
    </a>
</div>

