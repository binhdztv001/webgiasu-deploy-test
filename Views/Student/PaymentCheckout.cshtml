@model Webgiasu.Services.SePayCheckout
@{
    ViewData["Title"] = "Thanh toán SePay";
    Layout = "_StudentLayout";
}

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">Chuyển hướng đến cổng SePay</h5>
    </div>
    <div class="card-body">
        <p class="text-muted">Vui lòng đợi trong giây lát, chúng tôi đang chuyển bạn đến cổng thanh toán.</p>
        <form id="sepayForm" method="post" action="@Model.ActionUrl">
            @foreach (var field in Model.Fields)
            {
                <input type="hidden" name="@field.Key" value="@field.Value" />
            }
            <button type="submit" class="btn btn-success">
                <i class="bi bi-credit-card"></i> Thanh toán ngay
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var form = document.getElementById('sepayForm');
            if (form) {
                form.submit();
            }
        });
    </script>
}
