@model List<Webgiasu.Models.Problem>
@{
    ViewData["Title"] = "Bài toán chờ giải";
    Layout = "~/Views/Shared/_TutorLayout.cshtml";
}

<div class="row mb-4">
    <div class="col">
        <h2 class="fw-bold">
            <i class="bi bi-list-task text-success"></i> Bài toán chờ giải
        </h2>
        <p class="text-muted">Chọn bài toán phù hợp với bạn</p>
    </div>
</div>

@if (Model.Any())
{
    <div class="row">
        @foreach (var problem in Model)
        {
            <div class="col-lg-6 mb-4">
                <div class="card shadow-sm h-100 hover-card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h5 class="card-title mb-0">@problem.Title</h5>
                            <span class="badge bg-success fs-6">@problem.Price.ToString("N0") đ</span>
                        </div>

                        <p class="card-text text-muted">
                            @(problem.Description.Length > 150 
                                ? problem.Description.Substring(0, 150) + "..." 
                                : problem.Description)
                        </p>

                        <div class="mb-3">
                            <span class="badge bg-secondary me-1">
                                <i class="bi bi-book"></i> @problem.Type
                            </span>
                            @if (problem.Difficulty == Webgiasu.Models.DifficultyLevel.Easy)
                            {
                                <span class="badge bg-success me-1">
                                    <i class="bi bi-bar-chart"></i> Dễ
                                </span>
                            }
                            else if (problem.Difficulty == Webgiasu.Models.DifficultyLevel.Medium)
                            {
                                <span class="badge bg-warning me-1">
                                    <i class="bi bi-bar-chart"></i> Trung bình
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger me-1">
                                    <i class="bi bi-bar-chart"></i> Khó
                                </span>
                            }
                        </div>

                        <div class="mb-3">
                            <small class="text-muted">
                                <i class="bi bi-calendar-plus"></i> Đăng: @problem.CreatedDate.ToString("dd/MM/yyyy")<br />
                                <i class="bi bi-calendar-event"></i> Deadline: <span class="text-danger fw-bold">@problem.Deadline.ToString("dd/MM/yyyy HH:mm")</span>
                            </small>
                        </div>

                        @if (!string.IsNullOrEmpty(problem.ImageUrl) && problem.ImageUrl != "/images/default.jpg")
                        {
                            <div class="mb-3">
                                <img src="@problem.ImageUrl" alt="Problem" class="img-fluid rounded" style="max-height: 150px;" />
                            </div>
                        }

                        <div class="d-flex gap-2">
                            <a asp-action="ProblemDetails" asp-route-id="@problem.Id" class="btn btn-outline-primary flex-fill">
                                <i class="bi bi-eye"></i> Xem chi tiết
                            </a>
                            <form asp-action="AcceptProblem" method="post" class="flex-fill">
                                <input type="hidden" name="id" value="@problem.Id" />
                                <button type="submit" class="btn btn-success w-100" onclick="return confirm('Bạn chắc chắn muốn nhận bài này?')">
                                    <i class="bi bi-check-circle"></i> Nhận bài
                                </button>
                            </form>
                        </div>
                    </div>
                    <div class="card-footer bg-light">
                        <small class="text-muted">
                            <i class="bi bi-clock"></i> 
                            Còn @((problem.Deadline - DateTime.Now).Days) ngày
                        </small>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-inbox text-muted" style="font-size: 5rem;"></i>
            <h4 class="mt-3 text-muted">Hiện không có bài toán nào</h4>
            <p class="text-muted">Vui lòng quay lại sau</p>
            <a asp-action="Dashboard" class="btn btn-primary">
                <i class="bi bi-arrow-left"></i> Quay lại Dashboard
            </a>
        </div>
    </div>
}

<style>
    .hover-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .hover-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 0.5rem 1.5rem rgba(0,0,0,.15)!important;
    }
</style>
