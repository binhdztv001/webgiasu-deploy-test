@model Webgiasu.Models.ViewModels.CreateProblemViewModel
@{
    ViewData["Title"] = "Sửa bài toán";
    Layout = "_StudentLayout";
    var problemId = ViewBag.ProblemId ?? 0;
    var currentImageUrl = ViewBag.CurrentImageUrl as string ?? "";
    var currentAttachmentUrl = ViewBag.CurrentAttachmentUrl as string ?? "";
    var currentPrice = ViewBag.CurrentPrice as decimal? ?? 0m;
}

<div>
    <div class="page-header d-flex flex-wrap justify-content-between align-items-center mb-3">
        <div>
            <h5 class="fw-bold mb-1 text-dark">
                <i class="bi bi-pencil-square text-primary me-2"></i>Sửa bài toán #@problemId
            </h5>
            <p class="text-muted mb-0 small">Cập nhật thông tin bài toán</p>
        </div>
        <a asp-action="ProblemDetails" asp-route-id="@problemId" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-3">
                    <form asp-action="EditProblem" asp-route-id="@problemId" method="post" enctype="multipart/form-data" id="problemForm">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-semibold">
                                <i class="bi bi-pencil text-primary me-1"></i> Tiêu đề bài toán <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Title" class="form-control" placeholder="VD: Giải phương trình bậc 2" required />
                            <small class="text-muted">Tiêu đề ngắn gọn, dễ hiểu</small>
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-semibold">
                                <i class="bi bi-file-text text-primary me-1"></i> Mô tả chi tiết <span class="text-danger">*</span>
                            </label>
                            <textarea asp-for="Description" class="form-control" rows="6" placeholder="Mô tả chi tiết bài toán của bạn..." required></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Type" class="form-label fw-semibold">
                                    <i class="bi bi-book text-primary me-1"></i> Môn học <span class="text-danger">*</span>
                                </label>
                                <select asp-for="Type" class="form-select" required>
                                    <option value="">-- Chọn môn học --</option>
                                    <option value="Toan">Toán</option>
                                    <option value="Ly">Vật lý</option>
                                    <option value="Hoa">Hóa học</option>
                                    <option value="Sinh">Sinh học</option>
                                    <option value="Van">Ngữ văn</option>
                                    <option value="Anh">Tiếng Anh</option>
                                    <option value="Su">Lịch sử</option>
                                    <option value="Dia">Địa lý</option>
                                </select>
                                <span asp-validation-for="Type" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Difficulty" class="form-label fw-semibold">
                                    <i class="bi bi-mortarboard text-primary me-1"></i> Cấp học <span class="text-danger">*</span>
                                </label>
                                <select asp-for="Difficulty" id="educationLevelSelect" class="form-select" required>
                                    <option value="">-- Chọn cấp học --</option>
                                    <option value="0" data-price="30000">Tiểu học (30,000 đ)</option>
                                    <option value="1" data-price="50000">THCS (50,000 đ)</option>
                                    <option value="2" data-price="70000">THPT (70,000 đ)</option>
                                    <option value="3" data-price="100000">Đại học (100,000 đ)</option>
                                </select>
                                <small class="text-muted">Chọn cấp học phù hợp với bài toán</small>
                                <span asp-validation-for="Difficulty" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-cash-coin text-success me-1"></i> Giá tiền (tùy chọn)
                            </label>
                            <div class="input-group">
                                <input type="number" id="customPriceInput" name="CustomPrice" class="form-control"
                                       placeholder="Nhập số tiền tùy chỉnh (VNĐ)" min="10000" step="1000"
                                       value="@(currentPrice > 0 ? currentPrice.ToString("0") : "")" />
                                <span class="input-group-text">đ</span>
                            </div>
                            <small class="text-muted">
                                <i class="bi bi-info-circle me-1"></i>
                                Để trống để sử dụng giá mặc định theo cấp học. Giá tối thiểu: 10,000 đ
                            </small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Deadline" class="form-label fw-semibold">
                                <i class="bi bi-calendar text-primary me-1"></i> Deadline <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Deadline" type="datetime-local" class="form-control" required />
                            <span asp-validation-for="Deadline" class="text-danger"></span>
                        </div>

                        @* Current image *@
                        @if (!string.IsNullOrEmpty(currentImageUrl) && currentImageUrl != "/images/default.jpg")
                        {
                            <div class="mb-3">
                                <label class="form-label">Ảnh hiện tại</label>
                                <div><img src="@currentImageUrl" class="img-thumbnail" style="max-height:180px;" alt="Current image" /></div>
                                <div class="form-text">Nếu bạn upload ảnh mới, ảnh cũ sẽ được thay thế.</div>
                            </div>
                        }

                        <div class="mb-3">
                            <label asp-for="ImageFile" class="form-label fw-semibold">
                                <i class="bi bi-image text-primary me-1"></i> Hình ảnh bài toán (nếu có)
                            </label>
                            <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
                            <small class="text-muted">Hỗ trợ: JPG, PNG, GIF (Tối đa 5MB)</small>
                        </div>

                        @* Current attachment *@
                        @if (!string.IsNullOrEmpty(currentAttachmentUrl))
                        {
                            <div class="mb-3">
                                <label class="form-label">File đính kèm hiện tại</label>
                                <div>
                                    <a href="@currentAttachmentUrl" target="_blank" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-file-earmark-pdf"></i> Xem file
                                    </a>
                                </div>
                                <div class="form-text">Nếu upload file mới, file cũ sẽ được thay thế.</div>
                            </div>
                        }

                        <div class="mb-3">
                            <label asp-for="AttachmentFile" class="form-label fw-semibold">
                                <i class="bi bi-paperclip text-primary me-1"></i> Tài liệu (nếu có)
                            </label>
                            <input asp-for="AttachmentFile" type="file" class="form-control" accept=".pdf,.doc,.docx" />
                            <small class="text-muted">Hỗ trợ: .pdf, .doc, .docx (Tối đa 10MB)</small>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-check-circle me-1"></i> Cập nhật
                                </button>
                                <a asp-action="ProblemDetails" asp-route-id="@problemId" class="btn btn-secondary">
                                    <i class="bi bi-x-circle me-1"></i> Hủy
                                </a>
                                <button type="button" class="btn btn-danger ms-auto" onclick="confirmDelete(@problemId)">
                                    <i class="bi bi-trash me-1"></i> Xóa bài toán
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Price Card -->
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body text-center">
                    <i class="bi bi-currency-dollar text-primary icon-size-xl"></i>
                    <h6 class="mt-2 mb-1">Giá hiện tại</h6>
                    <p class="fs-4 fw-bold text-primary mb-0" id="priceDisplay">@((currentPrice>0) ? currentPrice.ToString("N0") + " đ" : "-- đ")</p>
                    <small class="text-muted" id="priceHint">@((currentPrice>0) ? "Giá hiện tại" : "Chọn cấp học để xem giá")</small>
                </div>
            </div>

            <!-- Education Level Info Card -->
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white border-0">
                    <h6 class="mb-0 fw-bold"><i class="bi bi-info-circle text-info me-2"></i>Bảng giá theo cấp</h6>
                </div>
                <div class="card-body pt-2">
                    <div class="row g-2 text-center">
                        <div class="col-6">
                            <div class="border rounded p-2">
                                <div class="text-primary fw-bold">Tiểu học</div>
                                <div class="small text-muted">30,000 đ</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="border rounded p-2">
                                <div class="text-info fw-bold">THCS</div>
                                <div class="small text-muted">50,000 đ</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="border rounded p-2">
                                <div class="text-warning fw-bold">THPT</div>
                                <div class="small text-muted">70,000 đ</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="border rounded p-2">
                                <div class="text-success fw-bold">Đại học</div>
                                <div class="small text-muted">100,000 đ</div>
                            </div>
                        </div>
                    </div>
                    <div class="alert alert-info mt-3 mb-0 small">
                        <i class="bi bi-lightbulb me-1"></i>
                        Bạn có thể tùy chỉnh giá nếu muốn
                    </div>
                </div>
            </div>

            <!-- Tips Card -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0">
                    <h6 class="mb-0 fw-bold"><i class="bi bi-lightbulb text-warning me-2"></i>Mẹo</h6>
                </div>
                <div class="card-body pt-0">
                    <ul class="list-unstyled mb-0 small">
                        <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Tiêu đề rõ ràng</li>
                        <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Mô tả đủ chi tiết</li>
                        <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Đính kèm ảnh nếu có</li>
                        <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Chọn deadline hợp lý</li>
                        <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Chọn cấp học chính xác</li>
                        <li><i class="bi bi-check-circle text-success me-2"></i>Tùy chỉnh giá nếu cần</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }

    <script src="https://cdn.ckeditor.com/4.22.1/standard/ckeditor.js"></script>
    <script>
        // CKEditor
        CKEDITOR.replace('Description', {
            height: 300,
            removePlugins: 'elementspath,save,print,preview,find,flash,forms,iframe,fullscreen,sourcearea,maximize',
            removeButtons: 'Save,NewPage,ExportPdf,Preview,Print,Templates,SelectAll,Form,Checkbox,Radio,TextField,Textarea,Select,Button,ImageButton,HiddenField,Flash,Iframe,Maximize,Source',
            toolbar: [
                { name: 'basicstyles', items: ['Bold', 'Italic', 'Underline', 'Strike'] },
                { name: 'paragraph', items: ['NumberedList', 'BulletedList', '-', 'JustifyLeft', 'JustifyCenter', 'JustifyRight'] },
                { name: 'links', items: ['Link', 'Unlink'] },
                { name: 'insert', items: ['Image', 'Table'] },
                { name: 'styles', items: ['Format', 'FontSize'] },
                { name: 'colors', items: ['TextColor', 'BGColor'] }
            ]
        });
        CKEDITOR.config.versionCheck = false;

        // ✅ PRICE & EDUCATION LEVEL HANDLING
        (function () {
            const educationLevelSelect = document.getElementById('educationLevelSelect');
            const customPriceInput = document.getElementById('customPriceInput');
            const priceDisplay = document.getElementById('priceDisplay');
            const priceHint = document.getElementById('priceHint');

            // Handle education level change
            educationLevelSelect?.addEventListener('change', function () {
                const selectedOption = this.options[this.selectedIndex];
                const defaultPrice = selectedOption?.getAttribute('data-price');

                if (defaultPrice) {
                    const price = parseInt(defaultPrice);
                    
                    // Only update if custom price is not entered
                    if (!customPriceInput.value) {
                        priceDisplay.textContent = price.toLocaleString('vi-VN') + ' đ';
                        priceHint.textContent = 'Giá mặc định theo cấp học';
                    }
                } else {
                    if (!customPriceInput.value) {
                        priceDisplay.textContent = '-- đ';
                        priceHint.textContent = 'Chọn cấp học để xem giá';
                    }
                }
            });

            // Handle custom price input
            customPriceInput?.addEventListener('input', function () {
                const customPrice = parseInt(this.value);
                
                if (customPrice && customPrice >= 10000) {
                    priceDisplay.textContent = customPrice.toLocaleString('vi-VN') + ' đ';
                    priceHint.textContent = 'Giá tùy chỉnh';
                } else if (this.value === '') {
                    // Revert to default price if custom price is cleared
                    const selectedOption = educationLevelSelect.options[educationLevelSelect.selectedIndex];
                    const defaultPrice = selectedOption?.getAttribute('data-price');
                    
                    if (defaultPrice) {
                        const price = parseInt(defaultPrice);
                        priceDisplay.textContent = price.toLocaleString('vi-VN') + ' đ';
                        priceHint.textContent = 'Giá mặc định theo cấp học';
                    } else {
                        priceDisplay.textContent = '-- đ';
                        priceHint.textContent = 'Chọn cấp học để xem giá';
                    }
                } else {
                    priceDisplay.textContent = '-- đ';
                    priceHint.textContent = 'Giá không hợp lệ (tối thiểu 10,000 đ)';
                }
            });

            // Initialize display on page load
            (function init() {
                if (educationLevelSelect?.value) {
                    const selectedOption = educationLevelSelect.options[educationLevelSelect.selectedIndex];
                    const defaultPrice = selectedOption?.getAttribute('data-price');
                    
                    // If custom price is already set, show it
                    const currentCustomPrice = parseInt(customPriceInput.value);
                    if (currentCustomPrice && currentCustomPrice >= 10000) {
                        priceDisplay.textContent = currentCustomPrice.toLocaleString('vi-VN') + ' đ';
                        priceHint.textContent = 'Giá tùy chỉnh';
                    } else if (defaultPrice) {
                        const price = parseInt(defaultPrice);
                        priceDisplay.textContent = price.toLocaleString('vi-VN') + ' đ';
                        priceHint.textContent = 'Giá mặc định theo cấp học';
                    }
                } else if (@(currentPrice > 0 ? "true" : "false")) {
                    priceDisplay.textContent = parseInt(@currentPrice).toLocaleString('vi-VN') + ' đ';
                    priceHint.textContent = 'Giá hiện tại';
                }
            })();
        })();

        // ✅ DELETE CONFIRMATION
        function confirmDelete(id) {
            if (!confirm('⚠️ Bạn có chắc chắn muốn xóa bài toán này? Hành động không thể hoàn tác.')) return;
            
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            
            fetch(`/Student/DeleteProblem/${id}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                }
            })
            .then(r => r.json())
            .then(data => {
                if (data.success) {
                    alert('✅ Xóa bài toán thành công.');
                    window.location.href = '/Student/MyProblems';
                } else {
                    alert('❌ Lỗi: ' + (data.message || 'Không thể xóa!'));
                }
            })
            .catch(err => {
                console.error(err);
                alert('❌ Đã xảy ra lỗi khi xóa bài toán.');
            });
        }
    </script>
}