@model Webgiasu.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    var roleText = Model.Role switch
    {
        Webgiasu.Models.UserRole.Student => "Học sinh",
        Webgiasu.Models.UserRole.Tutor => "Mentor",
        Webgiasu.Models.UserRole.Admin => "Quản trị viên",
        Webgiasu.Models.UserRole.School => "Nhà trường",
        _ => "Người dùng"
    };
    var roleIcon = Model.Role switch
    {
        Webgiasu.Models.UserRole.Student => "bi-person-circle",
        Webgiasu.Models.UserRole.Tutor => "bi-mortarboard",
        Webgiasu.Models.UserRole.Admin => "bi-shield-check",
        Webgiasu.Models.UserRole.School => "bi-building",
        _ => "bi-person"
    };
    var roleColor = Model.Role switch
    {
        Webgiasu.Models.UserRole.Student => "primary",
        Webgiasu.Models.UserRole.Tutor => "success",
        Webgiasu.Models.UserRole.Admin => "danger",
        Webgiasu.Models.UserRole.School => "warning",
        _ => "secondary"
    };
    var glowClass = Model.Role switch
    {
        Webgiasu.Models.UserRole.Student => "hover-glow-primary",
        Webgiasu.Models.UserRole.Tutor => "hover-glow-success",
        Webgiasu.Models.UserRole.Admin => "hover-glow-danger",
        Webgiasu.Models.UserRole.School => "hover-glow-warning",
        _ => "hover-glow-primary"
    };
}

<link rel="stylesheet" href="~/css/animations.css" asp-append-version="true" />

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7">
            <div class="card shadow-lg border-0 login-card @glowClass fade-in">
                <div class="card-header bg-@roleColor bg-gradient text-white text-center py-4 login-header">
                    <div class="mb-2 icon-container">
                        <i class="@roleIcon icon-bounce" style="font-size: 3.5rem;"></i>
                    </div>
                    <h2 class="fw-bold mb-1 fade-in-up delay-1">Đăng nhập</h2>
                    <p class="mb-0 fade-in-up delay-2">Vai trò: <span class="badge bg-white text-@roleColor badge-animated">@roleText</span></p>
                </div>
                
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Login" method="post">
                        <input type="hidden" asp-for="Role" />
                        
                        <div class="mb-4 fade-in-up delay-2">
                            <label asp-for="Username" class="form-label fw-bold">
                                <i class="bi bi-person-badge-fill text-@roleColor me-1"></i> Tên đăng nhập
                            </label>
                            <input asp-for="Username" class="form-control form-control-lg form-control-animated" placeholder="Nhập tên đăng nhập" required autofocus />
                        </div>

                        <div class="mb-4 fade-in-up delay-3">
                            <label asp-for="Password" class="form-label fw-bold">
                                <i class="bi bi-lock-fill text-@roleColor me-1"></i> Mật khẩu
                            </label>
                            <div class="input-group">
                                <input asp-for="Password" type="password" class="form-control form-control-lg form-control-animated" placeholder="Nhập mật khẩu" required id="passwordInput" />
                                <button class="btn btn-outline-secondary" type="button" id="togglePassword">
                                    <i class="bi bi-eye" id="eyeIcon"></i>
                                </button>
                            </div>
                        </div>

                        <div class="mb-4 fade-in-up delay-4">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="rememberMe" />
                                <label class="form-check-label" for="rememberMe">
                                    Ghi nhớ đăng nhập
                                </label>
                            </div>
                        </div>

                        <div class="d-grid gap-2 mb-3 fade-in-up delay-4">
                            <button type="submit" class="btn btn-@roleColor btn-lg btn-pill">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
                            </button>
                        </div>

                        @* @if (Model.Role != Webgiasu.Models.UserRole.Admin)
                        {
                            <div class="alert alert-info border-0 shadow-sm alert-animated fade-in-up delay-5">
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-info-circle-fill fs-4 me-3 icon-pulse"></i>
                                    <div>
                                        <strong>Tài khoản demo:</strong><br />
                                        @if (Model.Role == Webgiasu.Models.UserRole.Student)
                                        {
                                            <small><code>Username: student1</code> / <code>Password: 123456</code></small>
                                        }
                                        else if (Model.Role == Webgiasu.Models.UserRole.Tutor)
                                        {
                                            <small><code>Username: tutor1</code> / <code>Password: 123456</code></small>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning border-0 shadow-sm alert-animated fade-in-up delay-5">
                                <div class="d-flex align-items-center">
                                    <i class="bi bi-shield-exclamation fs-4 me-3 icon-pulse"></i>
                                    <div>
                                        <strong>Quản trị viên:</strong><br />
                                        <small><code>Username: admin</code> / <code>Password: admin123</code></small>
                                    </div>
                                </div>
                            </div>
                        } *@

                        <hr class="my-4" />

                        <div class="text-center fade-in-up delay-5">
                            <p class="text-muted mb-3">Chưa có tài khoản?</p>
                            @if (Model.Role != Webgiasu.Models.UserRole.Admin)
                            {
                                <a asp-action="Register" asp-route-role="@Model.Role.ToString()" class="btn btn-outline-@roleColor btn-pill btn-animated px-5">
                                    <i class="bi bi-person-plus me-2"></i> Đăng ký ngay
                                </a>
                            }
                            else
                            {
                                <p class="text-muted small">
                                    <i class="bi bi-lock"></i> Tài khoản admin không thể đăng ký
                                </p>
                            }
                        </div>
                    </form>
                </div>

                <div class="card-footer bg-light text-center py-3 fade-in-up delay-5">
                    <a asp-controller="Home" asp-action="Index" asp-route-role="@Model.Role.ToString()" class="btn btn-outline-@roleColor @(Model.Role == Webgiasu.Models.UserRole.School ? "btn-no-border-hover" : "btn-pill") btn-animated px-5">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại trang chủ
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .login-card {
        border-radius: 20px;
        overflow: hidden;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    .login-card:hover {
        transform: translateY(-10px);
    }
    
    .login-header {
        position: relative;
        overflow: hidden;
    }
    
    .login-header::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
        animation: shimmer 3s infinite;
    }
    
    @@keyframes shimmer {
        0% { left: -100%; }
        100% { left: 100%; }
    }
    
    .icon-container {
        display: inline-block;
    }
    
    .form-control-animated {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        border: 2px solid #e9ecef;
        border-radius: 12px;
    }
    
    .form-control-animated:focus {
        border-color: var(--bs-@roleColor, #667eea);
        box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.15);
        transform: translateY(-2px);
    }
    
    .btn-animated {
        position: relative;
        overflow: hidden;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    .btn-animated::before {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        width: 0;
        height: 0;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.3);
        transform: translate(-50%, -50%);
        transition: width 0.6s, height 0.6s;
    }
    
    .btn-animated:hover::before {
        width: 400px;
        height: 400px;
    }
    
    .btn-animated:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    }
    
    .btn-pill {
        border-radius: 50px;
    }
    
    .alert-animated {
        border-radius: 12px;
        transition: all 0.3s ease;
    }
    
    .alert-animated:hover {
        transform: translateX(5px);
    }
    
    .input-group .btn {
        border-radius: 0 12px 12px 0;
        border-color: #e9ecef;
    }
    
    .input-group .form-control {
        border-radius: 12px 0 0 12px;
    }
    
    /* Floating animation for card on load */
    @@keyframes floatIn {
        0% {
            opacity: 0;
            transform: translateY(50px) scale(0.95);
        }
        100% {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }
    
    .login-card {
        animation: floatIn 0.8s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Toggle password visibility
        const togglePassword = document.getElementById('togglePassword');
        const passwordInput = document.getElementById('passwordInput');
        const eyeIcon = document.getElementById('eyeIcon');
        
        if (togglePassword && passwordInput && eyeIcon) {
            togglePassword.addEventListener('click', function() {
                const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
                passwordInput.setAttribute('type', type);
                eyeIcon.classList.toggle('bi-eye');
                eyeIcon.classList.toggle('bi-eye-slash');
            });
        }
        
        // Add focus animations to inputs
        const inputs = document.querySelectorAll('.form-control-animated');
        inputs.forEach(input => {
            input.addEventListener('focus', function() {
                this.parentElement.classList.add('focused');
            });
            input.addEventListener('blur', function() {
                this.parentElement.classList.remove('focused');
            });
        });
    });
</script>
