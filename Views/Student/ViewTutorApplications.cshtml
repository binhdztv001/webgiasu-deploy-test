@model List<Webgiasu.Models.TutorApplication>
@{
    ViewData["Title"] = "Chọn Mentor";
    Layout = "_StudentLayout";
    var problem = ViewBag.Problem as Webgiasu.Models.Problem;
    var totalApplications = (int)(ViewBag.TotalApplications ?? 0);
}

<div>
    <!-- Page Header -->
    <div class="page-header mb-4">
        <div class="d-flex justify-content-between align-items-center flex-wrap">
            <div>
                <h4 class="fw-bold mb-2">
                    <i class="bi bi-people text-primary me-2"></i>Danh sách Mentor đăng ký
                </h4>
                <p class="text-muted mb-0">Chọn Mentor phù hợp nhất cho bài toán của bạn</p>
            </div>
            <a asp-action="MyProblems" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Quay lại
            </a>
        </div>
    </div>

    <!-- Problem Info Card -->
    @if (problem != null)
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">
                    <i class="bi bi-file-earmark-text me-2"></i>Thông tin bài toán
                </h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-8">
                        <h5 class="mb-3">@problem.Title</h5>
                        <div class="row">
                            <div class="col-6 mb-2">
                                <small class="text-muted">Môn học:</small>
                                <div><span class="badge bg-secondary">@problem.Type</span></div>
                            </div>
                            <div class="col-6 mb-2">
                                <small class="text-muted">Cấp học:</small>
                                <div>
                                    <span class="badge bg-info">
                                        @switch (problem.Difficulty)
                                        {
                                            case Webgiasu.Models.DifficultyLevel.TieuHoc:
                                                <text>Tiểu học</text>
                                                ; break;
                                            case Webgiasu.Models.DifficultyLevel.THCS:

                                                <text>THCS</text>
                                                ; break;
                                            case Webgiasu.Models.DifficultyLevel.THPT:

                                                <text>THPT</text>
                                                ; break;
                                            case Webgiasu.Models.DifficultyLevel.DaiHoc:

                                                <text>Đại học</text>
                                                ; break;
                                        }
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 text-end">
                        <div class="mb-2">
                            <small class="text-muted d-block">Giá gốc</small>
                            <h4 class="text-success mb-0">@problem.Price.ToString("N0")đ</h4>
                        </div>
                        <div>
                            <small class="text-muted d-block">Deadline</small>
                            <span class="text-danger fw-bold">@problem.Deadline.ToString("dd/MM/yyyy")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Statistics -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm text-center">
                <div class="card-body py-3">
                    <i class="bi bi-people-fill text-primary fs-2 mb-2"></i>
                    <h3 class="fw-bold mb-0">@totalApplications</h3>
                    <small class="text-muted">Mentor đăng ký</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm text-center">
                <div class="card-body py-3">
                    <i class="bi bi-star-fill text-warning fs-2 mb-2"></i>
                    <h3 class="fw-bold mb-0">@Model.Count(a => a.Tutor?.IsPremium ?? false)</h3>
                    <small class="text-muted">Premium Mentors</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm text-center">
                <div class="card-body py-3">
                    <i class="bi bi-currency-dollar text-success fs-2 mb-2"></i>
                    <h3 class="fw-bold mb-0">
                        @if (Model.Any())
                        {
                            var avgPrice = Model.Average(a => a.ProposedPrice);
                            @avgPrice.ToString("N0")
                        }
                        else
                        {
                            <text>0</text>
                        }
đ
                    </h3>
                    <small class="text-muted">Giá trung bình</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Applications List -->
    @if (Model.Any())
    {
        <div class="alert alert-info mb-4">
            <i class="bi bi-info-circle me-2"></i>
            <strong>Gợi ý:</strong> Các Mentor Premium được ưu tiên hiển thị đầu tiên.
            Họ có nhiều kinh nghiệm và được xác thực chất lượng.
        </div>

        <div class="row">
            @foreach (var app in Model)
            {
                var isPremium = app.Tutor?.IsPremium ?? false;
                var isRecommended = isPremium && app.ProposedPrice <= problem.Price;

                <div class="col-lg-6 mb-4">
                    <div class="card shadow-sm h-100 @(isPremium ? "border-warning border-2" : "") position-relative">
                        <!-- Premium Badge -->
                        @if (isPremium)
                        {
                            <div class="position-absolute top-0 end-0 m-2">
                                <span class="badge bg-warning text-dark">
                                    <i class="bi bi-star-fill"></i> PREMIUM
                                </span>
                            </div>
                        }

                        @if (isRecommended)
                        {
                            <div class="position-absolute top-0 start-0 m-2">
                                <span class="badge bg-success">
                                    <i class="bi bi-hand-thumbs-up"></i> ĐỀ XUẤT
                                </span>
                            </div>
                        }

                        <div class="card-body @(isPremium ? "pt-5" : "")">
                            <!-- Tutor Info -->
                            <div class="d-flex align-items-center mb-3">
                                <div class="flex-shrink-0">
                                    <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center icon-wrapper-xl">
                                        <i class="bi bi-person-circle text-primary fs-2"></i>
                                    </div>
                                </div>
                                <div class="flex-grow-1 ms-3">
                                    <h5 class="mb-1">@app.Tutor?.FullName</h5>
                                    <small class="text-muted">
                                        <i class="bi bi-envelope me-1"></i>@app.Tutor?.Email
                                    </small>
                                    @if (!string.IsNullOrEmpty(app.Tutor?.Subjects))
                                    {
                                        <div class="mt-1">
                                            <span class="badge bg-info">@app.Tutor.Subjects</span>
                                        </div>
                                    }
                                </div>
                            </div>

                            <hr />

                            <!-- Proposal -->
                            <div class="mb-3">
                                <strong class="d-block mb-2">
                                    <i class="bi bi-chat-square-text text-info me-1"></i>Đề xuất:
                                </strong>
                                <div class="bg-light p-3 rounded">
                                    <p class="mb-0 small">@app.Proposal</p>
                                </div>
                            </div>

                            <!-- Price & Time Comparison -->
                            <div class="row mb-3">
                                <div class="col-6">
                                    <small class="text-muted d-block">Giá đề xuất</small>
                                    <h5 class="mb-0 @(app.ProposedPrice < problem.Price ? "text-success" : app.ProposedPrice > problem.Price ? "text-danger" : "text-primary")">
                                        @app.ProposedPrice.ToString("N0")đ
                                    </h5>
                                    @if (app.ProposedPrice < problem.Price)
                                    {
                                        <small class="text-success">
                                            <i class="bi bi-arrow-down"></i> Rẻ hơn @((problem.Price - app.ProposedPrice).ToString("N0"))đ
                                        </small>
                                    }
                                    else if (app.ProposedPrice > problem.Price)
                                    {
                                        <small class="text-danger">
                                            <i class="bi bi-arrow-up"></i> Đắt hơn @((app.ProposedPrice - problem.Price).ToString("N0"))đ
                                        </small>
                                    }
                                </div>
                                <div class="col-6">
                                    <small class="text-muted d-block">Thời gian dự kiến</small>
                                    <h5 class="mb-0 text-info">@app.EstimatedDays ngày</h5>
                                    <small class="text-muted">
                                        Hoàn thành trước @app.AppliedDate.AddDays(app.EstimatedDays).ToString("dd/MM")
                                    </small>
                                </div>
                            </div>

                            <!-- Applied Date -->
                            <small class="text-muted d-block mb-3">
                                <i class="bi bi-calendar-check me-1"></i>
                                Đăng ký: @app.AppliedDate.ToString("HH:mm dd/MM/yyyy")
                            </small>

                            <!-- Action Buttons -->
                            <div class="d-flex gap-2">
                                <button type="button"
                                        class="btn btn-success flex-grow-1"
                                        onclick="approveApplication(@app.Id, '@app.Tutor?.FullName')">
                                    <i class="bi bi-check-circle me-1"></i>Chọn Mentor này
                                </button>
                                <button type="button"
                                        class="btn btn-outline-danger"
                                        onclick="rejectApplication(@app.Id)"
                                        title="Từ chối">
                                    <i class="bi bi-x-circle"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-inbox text-muted empty-state-icon-lg"></i>
                <h4 class="mt-3 text-muted">Chưa có Mentor nào đăng ký</h4>
                <p class="text-muted mb-4">Vui lòng chờ Mentor đăng ký nhận bài của bạn</p>
                <a asp-action="MyProblems" class="btn btn-primary">
                    <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách bài
                </a>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function approveApplication(applicationId, tutorName) {
            if (!confirm(`Bạn chắc chắn muốn chọn ${tutorName} làm Mentor?\n\nSau khi chọn, bạn sẽ không thể thay đổi!`)) {
                return;
            }

            console.log('📤 Sending approve request:', applicationId);

            $.ajax({
                url: '/Student/ApproveApplication',
                type: 'POST',
                data: JSON.stringify({ applicationId: applicationId }),
                contentType: 'application/json',
                success: function(result) {
                    console.log('📥 Response:', result);
                    if (result.success) {
                        alert('✅ ' + result.message);
                        window.location.href = '/Student/MyProblems';
                    } else {
                        alert('❌ ' + result.message);
                    }
                },
                error: function(xhr, status, error) {
                    console.error('❌ AJAX Error:', xhr.responseText);
                    alert('❌ Đã xảy ra lỗi khi duyệt Mentor!\n' + (xhr.responseText || error));
                }
            });
        }

        function rejectApplication(applicationId) {
            if (!confirm('Bạn chắc chắn muốn từ chối Mentor này?')) {
                return;
            }

            $.ajax({
                url: '/Student/RejectApplication',
                type: 'POST',
                data: JSON.stringify({ applicationId: applicationId }),
                contentType: 'application/json',
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                success: function(result) {
                    if (result.success) {
                        alert('✅ Đã từ chối!');
                        location.reload();
                    } else {
                        alert('❌ ' + result.message);
                    }
                },
                error: function() {
                    alert('❌ Đã xảy ra lỗi!');
                }
            });
        }

        // ✅ Auto-refresh every 30 seconds
        setInterval(() => {
            location.reload();
        }, 30000);
    </script>
}

<style>
    .card:hover {
        transform: translateY(-3px);
        transition: all 0.3s ease;
    }

    .border-warning {
        box-shadow: 0 0 15px rgba(255, 193, 7, 0.3);
    }
</style>