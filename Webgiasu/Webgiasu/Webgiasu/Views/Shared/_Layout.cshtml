<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hệ thống Gia sư Online</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/animations.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dropdown-fix.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Webgiasu.styles.css" asp-append-version="true" />
    <style>
        .navbar {
            /* Brown -> beige gradient to match beige theme */
            background: linear-gradient(135deg, #8B5E3C 0%, #D6C2A1 100%) !important;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.08);
        }

        .navbar .nav-link,
        .navbar .navbar-brand {
            color: #2b2b2b !important; /* darker text for contrast on beige */
        }
        /* Nav links: simple hover, no underline pseudo-element */
        .navbar .nav-link {
            text-decoration: none !important;
            color: #2b2b2b !important;
            transition: color .15s ease;
        }

        .navbar .nav-link:hover,
        .navbar .nav-link:focus {
            color: #111 !important;
            text-decoration: none !important;
        }

        html, body {
            height: 100%;
            margin: 0;
            /* Hide scrollbar but keep scroll functionality */
            scrollbar-width: none; /* Firefox */
            -ms-overflow-style: none; /* IE and Edge */
        }

        /* Hide scrollbar for Chrome, Safari, and Opera */
        html::-webkit-scrollbar,
        body::-webkit-scrollbar {
            display: none;
            width: 0;
            height: 0;
        }

        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .main-content {
            flex: 1 0 auto;
            padding-top: 2rem;
            padding-bottom: 2rem;
        }

        .page-header {
            margin-bottom: 2rem;
            animation: fadeIn 0.6s ease-out;
        }

        .foooter {
            flex-shrink: 0;
        }

        .foooter {
            /* Match footer to navbar (brown -> beige) */
            background: linear-gradient(135deg, #8B5E3C 0%, #D6C2A1 100%);
            color: #2b2b2b;
            margin-top: auto;
            width: 100%;
        }

            .foooter a {
                transition: var(--transition-base);
            }

                .foooter a:hover {
                    opacity: 0.8;
                    transform: translateX(3px);
                }
        
        .home-background {
            background-image: url('@Url.Content("~/images/background.png")');
            background-size: cover;
            background-position: center center;
            background-repeat: no-repeat;
            background-attachment: fixed;
            /* Ensure image remains sharp: no blur or filters */
            filter: none;
            -webkit-filter: none;
            backdrop-filter: none;
        }

        /* When navbar is fixed, add spacing so content isn't hidden behind it */
        header + .container.main-content {
            padding-top: calc(2rem + 56px);
        }

        .navbar.fixed-top {
            z-index: 1030; /* ensure it sits above page content */
        }
        /* Center language dropdown under its toggle icon */
        .lang-dropdown { position: relative; }
        .lang-dropdown .dropdown-menu {
            position: absolute !important;
            left: 50% !important;
            transform: translateX(-50%) !important;
            top: calc(100% + 6px) !important;
            right: auto !important;
            z-index: 2000 !important;
            margin: 0 !important;
            min-width: 8rem;
        }
        /* Make navbar dropdowns visually consistent with navbar theme */
        .navbar .dropdown-menu {
            background: linear-gradient(135deg, #8B5E3C 0%, #D6C2A1 100%);
            border: none;
            color: #2b2b2b;
            padding: .25rem 0;
            min-width: 10rem;
            box-shadow: 0 8px 24px rgba(0,0,0,0.08);
        }

        .navbar .dropdown-item {
            color: #2b2b2b;
        }

        .navbar .dropdown-item:hover,
        .navbar .dropdown-item:focus {
            background: rgba(0,0,0,0.04);
            color: #2b2b2b;
        }
    </style>

</head>
@{
    var path = Context.Request.Path.ToString();
    var roleQuery = Context.Request.Query["role"].ToString();
    var isHome = path == "/" || path == "/Home" || path == "/Home/Index";
    var isLoginWithRole = path == "/Account/Login" && (roleQuery == "Student" || roleQuery == "Tutor" || roleQuery == "Admin");
    var isRegisterWithRole = path == "/Account/Register" && (roleQuery == "Student" || roleQuery == "Tutor" || roleQuery == "Admin");
    var bodyClass = (isHome || isLoginWithRole || isRegisterWithRole) ? "home-background" : string.Empty;
}
<body class="@bodyClass">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark fixed-top">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-mortarboard-fill me-2"></i> Gia Sư Online
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    @{
                        var userName = Context.Session.GetString("UserName");
                        var userRole = Context.Session.GetString("UserRole");
                    }
                    
                    @if (!string.IsNullOrEmpty(userRole))
                    {
                        @if (userRole == "Student")
                        {
                            <ul class="navbar-nav me-auto">
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Student" asp-action="Dashboard">
                                        <i class="bi bi-speedometer2"></i> Dashboard
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Student" asp-action="CreateProblem">
                                        <i class="bi bi-plus-circle"></i> Đăng bài toán
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Student" asp-action="Payments">
                                        <i class="bi bi-credit-card"></i> Thanh toán
                                    </a>
                                </li>
                            </ul>
                        }
                        else if (userRole == "Tutor")
                        {
                            <ul class="navbar-nav me-auto">
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Tutor" asp-action="Dashboard">
                                        <i class="bi bi-speedometer2"></i> Dashboard
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Tutor" asp-action="AvailableProblems">
                                        <i class="bi bi-list-task"></i> Bài toán chờ giải
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Tutor" asp-action="MyProblems">
                                        <i class="bi bi-briefcase"></i> Bài của tôi
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Tutor" asp-action="MySolutions">
                                        <i class="bi bi-check-circle"></i> Lời giải đã gửi
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Tutor" asp-action="MyRatings">
                                        <i class="bi bi-star"></i> Đánh giá của tôi
                                    </a>
                                </li>
                            </ul>
                        }
                        else if (userRole == "Admin")
                        {
                            <ul class="navbar-nav me-auto">
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Admin" asp-action="Dashboard">
                                        <i class="bi bi-speedometer2"></i> Dashboard
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Admin" asp-action="PendingTutors">
                                        <i class="bi bi-person-check"></i> Duyệt gia sư
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Admin" asp-action="ManageProblems">
                                        <i class="bi bi-card-list"></i> Quản lý bài toán
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Admin" asp-action="ManagePayments">
                                        <i class="bi bi-currency-dollar"></i> Giao dịch
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Admin" asp-action="Statistics">
                                        <i class="bi bi-bar-chart"></i> Thống kê
                                    </a>
                                </li>
                            </ul>
                        }
                        
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item dropdown me-2 lang-dropdown">
                                <a class="nav-link dropdown-toggle lang-toggle" href="#" id="langDropdown" role="button" data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false">
                                    <span class="me-1">🌐</span>
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="langDropdown">
                                    <li><a class="dropdown-item" href="#" data-lang="vi">Tiếng Việt</a></li>
                                    <li><a class="dropdown-item" href="#" data-lang="en">Tiếng Anh</a></li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle me-1"></i> @userName
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    @if (userRole == "Student")
                                    {
                                        <li><a class="dropdown-item" asp-controller="Student" asp-action="Profile"><i class="bi bi-person me-2"></i> Hồ sơ</a></li>
                                        <li><a class="dropdown-item" asp-controller="Student" asp-action="Settings"><i class="bi bi-gear me-2"></i> Cài đặt</a></li>
                                    }
                                    else if (userRole == "Tutor")
                                    {
                                        <li><a class="dropdown-item" asp-controller="Tutor" asp-action="Profile"><i class="bi bi-person me-2"></i> Hồ sơ</a></li>
                                        <li><a class="dropdown-item" asp-controller="Tutor" asp-action="Settings"><i class="bi bi-gear me-2"></i> Cài đặt</a></li>
                                    }
                                    else if (userRole == "Admin")
                                    {
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Profile"><i class="bi bi-person me-2"></i> Hồ sơ</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Settings"><i class="bi bi-gear me-2"></i> Cài đặt</a></li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i> Đăng xuất</a></li>
                                </ul>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <ul class="navbar-nav ms-auto align-items-center">
                            <li class="nav-item dropdown me-2 lang-dropdown">
                                <a class="nav-link dropdown-toggle lang-toggle" href="#" id="langDropdownGuest" role="button" data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false">
                                    <span class="me-1">🌐</span>
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="langDropdown">
                                    <li><a class="dropdown-item" href="#" data-lang="vi">Tiếng Việt</a></li>
                                    <li><a class="dropdown-item" href="#" data-lang="en">Tiếng Anh</a></li>
                                </ul>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>
    
    <div class="container main-content">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>
                <strong>Thành công!</strong> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <strong>Lỗi!</strong> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Warning"] != null)
        {
            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-circle-fill me-2"></i>
                <strong>Chú ý!</strong> @TempData["Warning"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Info"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                <i class="bi bi-info-circle-fill me-2"></i>
                <strong>Thông tin!</strong> @TempData["Info"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>


    <footer class="foooter mt-auto py-4">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-3 mb-md-0">
                    <h5 class="fw-bold mb-3">
                        <i class="bi bi-mortarboard-fill me-2"></i>Gia Sư Online
                    </h5>
                    <p class="mb-0 text-dark">Nền tảng kết nối học sinh và gia sư chất lượng cao, giúp giải đáp bài tập nhanh chóng và hiệu quả.</p>
                </div>
                <div class="col-md-4 mb-3 mb-md-0">
                    <h5 class="fw-bold mb-3">Liên kết nhanh</h5>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a href="#" class="text-dark text-decoration-none"><i class="bi bi-chevron-right me-1"></i>Điều khoản sử dụng</a></li>
                        <li class="mb-2"><a href="#" class="text-dark text-decoration-none"><i class="bi bi-chevron-right me-1"></i>Chính sách bảo mật</a></li>
                        <li class="mb-2"><a href="#" class="text-dark text-decoration-none"><i class="bi bi-chevron-right me-1"></i>Liên hệ</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h5 class="fw-bold mb-3">Kết nối với chúng tôi</h5>
                    <div class="d-flex gap-3 mb-3">
                        <a href="#" class="text-dark fs-4"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="text-dark fs-4"><i class="bi bi-twitter"></i></a>
                        <a href="#" class="text-dark fs-4"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="text-dark fs-4"><i class="bi bi-youtube"></i></a>
                    </div>
                    <p class="mb-1 text-dark"><i class="bi bi-envelope me-2"></i>support@giasu.com</p>
                    <p class="mb-0 text-dark"><i class="bi bi-telephone me-2"></i>1900 xxxx</p>
                </div>
            </div>
            <hr class="my-4" style="border-color: rgba(0,0,0,0.08); opacity: .25;">
            <div class="text-center">
                <p class="mb-0 text-dark">&copy; 2025 - Hệ thống Gia sư Online. All rights reserved.</p>
            </div>
        </div>
    </footer>


    
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <script>
        // Auto hide alerts after 5 seconds
        setTimeout(function() {
            $('.alert').fadeOut('slow');
        }, 5000);

        // Add smooth scroll
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({ behavior: 'smooth' });
                }
            });
        });

        // Add animation to cards on scroll
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        };

        const observer = new IntersectionObserver(function(entries) {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('fade-in');
                }
            });
        }, observerOptions);

        document.querySelectorAll('.card, .row > div').forEach(el => {
            observer.observe(el);
        });

        // Language selector: store selection in cookie and reload
        (function() {
            function getCookie(name) {
                const v = document.cookie.match('(^|;)\\s*' + name + '\\s*=\\s*([^;]+)');
                return v ? v.pop() : null;
            }

            const current = getCookie('lang') || 'vi';
            document.querySelectorAll('.lang-toggle').forEach(t => {
                t.innerHTML = '<span class="me-1">🌐</span> ' + (current === 'en' ? 'Tiếng Anh' : 'Tiếng Việt');
            });

            document.querySelectorAll('[data-lang]').forEach(item => {
                item.addEventListener('click', function(e) {
                    e.preventDefault();
                    const lang = this.getAttribute('data-lang');
                    document.cookie = 'lang=' + lang + ';path=/;max-age=' + (60*60*24*365) + ';SameSite=Lax';
                    location.reload();
                });
            });
        })();
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
