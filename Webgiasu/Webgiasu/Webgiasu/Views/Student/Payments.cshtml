@model List<Webgiasu.Models.Payment>
@{
    ViewData["Title"] = "Quản lý thanh toán";
    Layout = "_StudentLayout";
}

<div>
    <div class="page-header d-flex flex-wrap justify-content-between align-items-center">
        <div>
            <h5 class="fw-bold mb-1 text-dark">
                <i class="bi bi-credit-card text-primary me-2"></i>Quản lý thanh toán
            </h5>
            <p class="text-muted mb-0 small">Theo dõi các giao dịch thanh toán của bạn</p>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card text-center shadow-sm border-success">
                <div class="card-body">
                    <i class="bi bi-check-circle text-success" style="font-size: 2rem;"></i>
                    <h3 class="mt-2 mb-0">@Model.Count(p => p.Status == Webgiasu.Models.PaymentStatus.Completed)</h3>
                    <p class="text-muted mb-0">Đã thanh toán</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center shadow-sm border-warning">
                <div class="card-body">
                    <i class="bi bi-hourglass-split text-warning" style="font-size: 2rem;"></i>
                    <h3 class="mt-2 mb-0">@Model.Count(p => p.Status == Webgiasu.Models.PaymentStatus.Pending)</h3>
                    <p class="text-muted mb-0">Chờ thanh toán</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center shadow-sm border-info">
                <div class="card-body">
                    <i class="bi bi-currency-dollar text-info" style="font-size: 2rem;"></i>
                    <h3 class="mt-2 mb-0">@Model.Count</h3>
                    <p class="text-muted mb-0">Tổng giao dịch</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center shadow-sm border-primary">
                <div class="card-body">
                    <i class="bi bi-cash-stack text-primary" style="font-size: 2rem;"></i>
                    <h4 class="mt-2 mb-0">@Model.Where(p => p.Status == Webgiasu.Models.PaymentStatus.Completed).Sum(p => p.Amount).ToString("N0") đ</h4>
                    <p class="text-muted mb-0">Tổng đã chi</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header py-3" style="background: linear-gradient(135deg, #2196F3 0%, #03A9F4 100%);">
            <h5 class="mb-0 text-white"><i class="bi bi-list-ul me-2"></i>Lịch sử giao dịch</h5>
        </div>
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Mã GD</th>
                                <th>Mã bài toán</th>
                                <th>Số tiền</th>
                                <th>Ngày tạo</th>
                                <th>Trạng thái</th>
                                <th>Mã giao dịch</th>
                                <th>Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var payment in Model)
                            {
                                <tr>
                                    <td class="fw-bold">#@payment.Id</td>
                                    <td>
                                        <a asp-action="ProblemDetails" asp-route-id="@payment.ProblemId" class="text-decoration-none">
                                            #@payment.ProblemId
                                        </a>
                                    </td>
                                    <td class="fw-bold text-success">@payment.Amount.ToString("N0") đ</td>
                                    <td>@payment.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        @if (payment.Status == Webgiasu.Models.PaymentStatus.Completed)
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle"></i> Đã thanh toán
                                            </span>
                                        }
                                        else if (payment.Status == Webgiasu.Models.PaymentStatus.Pending)
                                        {
                                            <span class="badge bg-warning">
                                                <i class="bi bi-hourglass-split"></i> Chờ thanh toán
                                            </span>
                                        }
                                        else if (payment.Status == Webgiasu.Models.PaymentStatus.Failed)
                                        {
                                            <span class="badge bg-danger">
                                                <i class="bi bi-x-circle"></i> Thất bại
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                <i class="bi bi-arrow-return-left"></i> Hoàn tiền
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(payment.TransactionId))
                                        {
                                            <code>@payment.TransactionId</code>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (payment.Status == Webgiasu.Models.PaymentStatus.Pending)
                                        {
                                            <form asp-action="ProcessPayment" method="post" class="d-inline">
                                                <input type="hidden" name="paymentId" value="@payment.Id" />
                                                <button type="submit" class="btn btn-sm btn-success">
                                                    <i class="bi bi-credit-card"></i> Thanh toán
                                                </button>
                                            </form>
                                        }
                                        else if (payment.Status == Webgiasu.Models.PaymentStatus.Completed)
                                        {
                                            <span class="text-success">
                                                <i class="bi bi-check-circle-fill"></i>
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox text-muted" style="font-size: 4rem;"></i>
                    <p class="text-muted mt-3">Chưa có giao dịch nào</p>
                    <a asp-action="Dashboard" class="btn btn-primary">
                        <i class="bi bi-arrow-left"></i> Quay lại Dashboard
                    </a>
                </div>
            }
        </div>
    </div>
</div>
