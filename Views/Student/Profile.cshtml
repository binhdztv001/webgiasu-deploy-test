@model Webgiasu.Models.User
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
    Layout = "_StudentLayout";
}

<div>
    <div class="row page-header d-flex flex-wrap justify-content-between align-items-center">
        <div>
            <h5 class="fw-bold mb-1 text-dark">
                <i class="bi bi-person-circle text-primary me-2"></i>Hồ sơ cá nhân
            </h5>
            <p class="text-muted mb-0 small">Quản lý thông tin tài khoản của bạn</p>
        </div>
    </div>

    <div class="row g-4">
        @* bên phải  *@
        <div class="col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center p-4">
                    <div class="mb-4">
                        <div class="rounded-circle bg-primary bg-gradient text-white d-inline-flex align-items-center justify-content-center" style="width: 120px; height: 120px;">
                            <i class="bi bi-person-fill" style="font-size: 4rem;"></i>
                        </div>
                    </div>
                    <h4 class="fw-bold mb-1">@Model.FullName</h4>
                    <p class="text-muted mb-3">@Model.Username</p>
                    <span class="badge bg-primary badge-pill px-4 py-2">
                        <i class="bi bi-person-badge me-1"></i> Học sinh
                    </span>

                    <hr class="my-4" />

                    <div class="d-grid gap-2">
                        <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editProfileModal">
                            <i class="bi bi-pencil-square me-1"></i> Chỉnh sửa hồ sơ
                        </button>
                        <button type="button" class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#changePasswordModal">
                            <i class="bi bi-key me-1"></i> Đổi mật khẩu
                        </button>
                    </div>
                </div>
            </div>
        </div>
        @* bên trái  *@
        <div class="col-lg-8">
            <div class="card shadow-sm h-100">
                <div class="card-header py-3" style="background: linear-gradient(135deg, #2196F3 0%, #03A9F4 100%);">
                    <h5 class="mb-0 text-white">
                        <i class="bi bi-info-circle me-2"></i>Thông tin chi tiết
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="border-start border-primary border-4 ps-3 mb-4">
                                <label class="text-muted small mb-1">Họ và tên</label>
                                <h6 class="fw-bold mb-0">@Model.FullName</h6>
                            </div>

                            <div class="border-start border-primary border-4 ps-3 mb-4">
                                <label class="text-muted small mb-1">Email</label>
                                <h6 class="fw-bold mb-0">
                                    <i class="bi bi-envelope text-primary me-1"></i> @Model.Email
                                </h6>
                            </div>

                            <div class="border-start border-primary border-4 ps-3 mb-4">
                                <label class="text-muted small mb-1">Tên đăng nhập</label>
                                <h6 class="fw-bold mb-0">
                                    <i class="bi bi-person-badge text-primary me-1"></i> @Model.Username
                                </h6>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="border-start border-primary border-4 ps-3 mb-4">
                                <label class="text-muted small mb-1">Số điện thoại</label>
                                <h6 class="fw-bold mb-0">
                                    <i class="bi bi-phone text-primary me-1"></i> @Model.PhoneNumber
                                </h6>
                            </div>

                            <div class="border-start border-primary border-4 ps-3 mb-4">
                                <label class="text-muted small mb-1">Cấp học</label>
                                <h6 class="fw-bold mb-0">
                                    <i class="bi bi-book text-primary me-1"></i> 
                                    @if (Model.Level.HasValue)
                                    {
                                        switch (Model.Level.Value)
                                        {
                                            case Webgiasu.Models.EducationLevel.TieuHoc:
                                                <text>Tiểu học</text>
                                                break;
                                            case Webgiasu.Models.EducationLevel.THCS:
                                                <text>THCS</text>
                                                break;
                                            case Webgiasu.Models.EducationLevel.THPT:
                                                <text>THPT</text>
                                                break;
                                            case Webgiasu.Models.EducationLevel.DaiHoc:
                                                <text>Đại học</text>
                                                break;
                                            default:
                                                <text>Chưa cập nhật</text>
                                                break;
                                        }
                                    }
                                    else
                                    {
                                        <text>Chưa cập nhật</text>
                                    }
                                </h6>
                            </div>

                            <div class="border-start border-primary border-4 ps-3 mb-4">
                                <label class="text-muted small mb-1">Vai trò</label>
                                <h6 class="fw-bold mb-0">
                                    <span class="badge bg-primary">Học sinh</span>
                                </h6>
                            </div>

                            <div class="border-start border-primary border-4 ps-3 mb-4">
                                <label class="text-muted small mb-1">Trạng thái</label>
                                <h6 class="fw-bold mb-0">
                                    <span class="badge bg-success">
                                        <i class="bi bi-check-circle me-1"></i> Đang hoạt động
                                    </span>
                                </h6>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-info border-0">
                        <i class="bi bi-info-circle-fill me-2"></i>
                        <strong>Lưu ý:</strong> Để bảo vệ tài khoản, vui lòng không chia sẻ mật khẩu với người khác.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit Profile Modal -->
    <div class="modal fade" id="editProfileModal" tabindex="-1" data-bs-backdrop="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header" style="background: linear-gradient(135deg, #2196F3 0%, #03A9F4 100%);">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-pencil-square me-2"></i>Chỉnh sửa hồ sơ
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form asp-controller="Student" asp-action="UpdateProfile" method="post">
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold">
                                <i class="bi bi-person text-primary me-1"></i> Họ và tên
                            </label>
                            <input type="text" name="FullName" class="form-control" value="@Model.FullName" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">
                                <i class="bi bi-envelope text-primary me-1"></i> Email
                            </label>
                            <input type="email" name="Email" class="form-control" value="@Model.Email" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">
                                <i class="bi bi-phone text-primary me-1"></i> Số điện thoại
                            </label>
                            <input type="tel" name="PhoneNumber" class="form-control" value="@Model.PhoneNumber" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">
                                <i class="bi bi-book text-primary me-1"></i> Cấp học
                            </label>
                            <select name="Level" class="form-select">
                                <option value="">-- Chọn cấp học --</option>
                                <option value="1" selected="@(Model.Level.HasValue && Model.Level.Value == Webgiasu.Models.EducationLevel.TieuHoc)">Tiểu học</option>
                                <option value="2" selected="@(Model.Level.HasValue && Model.Level.Value == Webgiasu.Models.EducationLevel.THCS)">THCS</option>
                                <option value="3" selected="@(Model.Level.HasValue && Model.Level.Value == Webgiasu.Models.EducationLevel.THPT)">THPT</option>
                                <option value="4" selected="@(Model.Level.HasValue && Model.Level.Value == Webgiasu.Models.EducationLevel.DaiHoc)">Đại học</option>
                            </select>
                            <div class="form-text">Chọn cấp học bạn đang theo học</div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <i class="bi bi-x-circle me-1"></i> Hủy
                        </button>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle me-1"></i> Lưu thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Change Password Modal -->
    <div class="modal fade" id="changePasswordModal" tabindex="-1" data-bs-backdrop="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header" style="background: linear-gradient(135deg, #2196F3 0%, #03A9F4 100%);">
                    <h5 class="modal-title text-white">
                        <i class="bi bi-key me-2"></i> Đổi mật khẩu
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form asp-controller="Student" asp-action="ChangePassword" method="post" id="changePasswordForm">
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold">
                                <i class="bi bi-lock text-primary me-1"></i> Mật khẩu hiện tại
                            </label>
                            <input type="password" name="CurrentPassword" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">
                                <i class="bi bi-lock-fill text-primary me-1"></i> Mật khẩu mới
                            </label>
                            <input type="password" name="NewPassword" id="newPassword" class="form-control" required minlength="6" />
                            <div class="form-text">Tối thiểu 6 ký tự</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">
                                <i class="bi bi-shield-lock text-primary me-1"></i> Xác nhận mật khẩu mới
                            </label>
                            <input type="password" name="ConfirmPassword" id="confirmPassword" class="form-control" required />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <i class="bi bi-x-circle me-1"></i> Hủy
                        </button>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle me-1"></i> Đổi mật khẩu
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('changePasswordForm').addEventListener('submit', function(e) {
            var newPass = document.getElementById('newPassword').value;
            var confirmPass = document.getElementById('confirmPassword').value;
            
            if (newPass !== confirmPass) {
                e.preventDefault();
                alert('Mật khẩu xác nhận không khớp!');
                return false;
            }
        });
    </script>
}
