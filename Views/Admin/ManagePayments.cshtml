@model List<Webgiasu.Models.Payment>
@inject Webgiasu.Services.IUserService UserService
@inject Webgiasu.Services.IProblemService ProblemService
@{
    ViewData["Title"] = "Quản lý thanh toán";
    Layout = "_AdminLayout";
}

<div class="row mb-4">
    <div class="col">
        <h2 class="fw-bold">
            <i class="bi bi-credit-card text-danger"></i> Quản lý thanh toán
        </h2>
        <p class="text-muted">Theo dõi các giao dịch thanh toán</p>
    </div>
</div>

<div class="row g-2 g-md-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card text-center shadow-sm card-hover h-100">
            <div class="card-body p-3">
                <i class="bi bi-check-circle text-success" style="font-size: 1.5rem;"></i>
                <h4 class="mt-2 mb-0 fw-bold">@Model.Count(p => p.Status == Webgiasu.Models.PaymentStatus.Completed)</h4>
                <p class="text-muted mb-0 extra-small">Đã thanh toán</p>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center shadow-sm card-hover h-100">
            <div class="card-body p-3">
                <i class="bi bi-hourglass-split text-warning" style="font-size: 1.5rem;"></i>
                <h4 class="mt-2 mb-0 fw-bold">@Model.Count(p => p.Status == Webgiasu.Models.PaymentStatus.Pending)</h4>
                <p class="text-muted mb-0 extra-small">Chờ thanh toán</p>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center shadow-sm card-hover h-100">
            <div class="card-body p-3">
                <i class="bi bi-currency-dollar text-primary" style="font-size: 1.5rem;"></i>
                <h4 class="mt-2 mb-0 fw-bold">@Model.Count</h4>
                <p class="text-muted mb-0 extra-small">Tổng giao dịch</p>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card text-center shadow-sm card-hover h-100">
            <div class="card-body p-3">
                <i class="bi bi-cash-stack text-info" style="font-size: 1.5rem;"></i>
                <h5 class="mt-2 mb-0 fw-bold">@Model.Where(p => p.Status == Webgiasu.Models.PaymentStatus.Completed).Sum(p => p.Amount).ToString("N0") đ</h5>
                <p class="text-muted mb-0 extra-small">Doanh thu</p>
            </div>
        </div>
    </div>
</div>

<style>
    .extra-small {
        font-size: 0.75rem !important;
    }
</style>

<div class="card shadow-sm">
<div class="card-header py-3" style="background: linear-gradient(135deg, #DC143C 0%, #FF1744 100%);">
    <h5 class="mb-0 text-white"><i class="bi bi-list-ul me-2"></i>Danh sách giao dịch</h5>
</div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Mã GD</th>
                        <th>Học sinh</th>
                        <th>Mã bài toán</th>
                        <th>Số tiền</th>
                        <th>Ngày tạo</th>
                        <th>Ngày hoàn thành</th>
                        <th>Trạng thái</th>
                        <th>Mã giao dịch</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var payment in Model.OrderByDescending(p => p.CreatedDate))
                    {
                        var student = UserService.GetUserById(payment.StudentId);
                        var problem = ProblemService.GetProblemById(payment.ProblemId);
                        <tr>
                            <td class="fw-bold">#@payment.Id</td>
                            <td>@student?.FullName</td>
                            <td>
                                <a asp-action="ProblemDetails" asp-route-id="@payment.ProblemId" class="text-decoration-none">
                                    #@payment.ProblemId
                                </a>
                            </td>
                            <td class="fw-bold text-success">@payment.Amount.ToString("N0") đ</td>
                            <td>@payment.CreatedDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @if (payment.CompletedDate.HasValue)
                                {
                                    @payment.CompletedDate.Value.ToString("dd/MM/yyyy HH:mm")
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                @if (payment.Status == Webgiasu.Models.PaymentStatus.Completed)
                                {
                                    <span class="badge bg-success">
                                        <i class="bi bi-check-circle"></i> Đã thanh toán
                                    </span>
                                }
                                else if (payment.Status == Webgiasu.Models.PaymentStatus.Pending)
                                {
                                    <span class="badge bg-warning">
                                        <i class="bi bi-hourglass-split"></i> Chờ thanh toán
                                    </span>
                                }
                                else if (payment.Status == Webgiasu.Models.PaymentStatus.Failed)
                                {
                                    <span class="badge bg-danger">
                                        <i class="bi bi-x-circle"></i> Thất bại
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        <i class="bi bi-arrow-return-left"></i> Hoàn tiền
                                    </span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(payment.TransactionId))
                                {
                                    <code class="small">@payment.TransactionId</code>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
