@model List<Webgiasu.Models.Notification>
@{
    ViewData["Title"] = "Thông báo";
    Layout = "_StudentLayout";
}

<div class="container py-4">
    <div class="page-header d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1 text-dark">
                <i class="bi bi-bell text-primary me-2"></i>Thông báo
            </h2>
            <p class="text-muted mb-0">Tất cả thông báo của bạn</p>
        </div>
        <div>
            <form asp-action="MarkAllNotificationsAsRead" method="post">
                <button type="submit" class="btn btn-outline-primary">
                    <i class="bi bi-check-all me-1"></i>Đánh dấu tất cả đã đọc
                </button>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-0">
            @if (Model.Any())
            {
                <div class="list-group list-group-flush">
                    @foreach (var notification in Model)
                    {
                        var iconClass = notification.Type switch
                        {
                            Webgiasu.Models.NotificationType.ProblemCreated => "bi-plus-circle",
                            Webgiasu.Models.NotificationType.TutorAccepted => "bi-person-check",
                            Webgiasu.Models.NotificationType.SolutionSubmitted => "bi-check-circle",
                            Webgiasu.Models.NotificationType.PaymentCompleted => "bi-credit-card",
                            Webgiasu.Models.NotificationType.TutorApplied => "bi-person-raised-hand",
                            Webgiasu.Models.NotificationType.ApplicationApproved => "bi-patch-check",
                            Webgiasu.Models.NotificationType.ApplicationRejected => "bi-x-circle",
                            Webgiasu.Models.NotificationType.FriendRequest => "bi-person-plus",
                            Webgiasu.Models.NotificationType.RatingReceived => "bi-star",
                            _ => "bi-bell"
                        };

                        var bgClass = notification.Type switch
                        {
                            Webgiasu.Models.NotificationType.ProblemCreated => "bg-primary",
                            Webgiasu.Models.NotificationType.TutorAccepted => "bg-info",
                            Webgiasu.Models.NotificationType.SolutionSubmitted => "bg-success",
                            Webgiasu.Models.NotificationType.PaymentCompleted => "bg-success",
                            _ => "bg-secondary"
                        };
                        
                        <a href="@(notification.Link ?? "#")" 
                           class="list-group-item list-group-item-action py-3 border-0 @(!notification.IsRead ? "bg-light" : "")"
                           style="border-bottom: 1px solid #eee !important;">
                            <div class="d-flex align-items-center">
                                <div class="rounded-circle @bgClass d-flex align-items-center justify-content-center me-3 shadow-sm" 
                                     style="width: 45px; height: 45px; flex-shrink: 0;">
                                    <i class="bi @iconClass text-white fs-5"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <h6 class="mb-1 fw-bold @(!notification.IsRead ? "text-primary" : "text-dark")">@notification.Title</h6>
                                        <small class="text-muted fw-normal">@notification.CreatedDate.ToString("dd/MM/yyyy HH:mm")</small>
                                    </div>
                                    <p class="mb-0 text-muted small text-truncate" style="max-width: 500px;">@notification.Message</p>
                                </div>
                                @if (!notification.IsRead)
                                {
                                    <div class="ms-2">
                                        <span class="badge bg-danger rounded-pill p-1"><span class="visually-hidden">Mới</span></span>
                                    </div>
                                }
                            </div>
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <img src="/images/no-notifications.svg" alt="No notifications" class="mb-3" style="width: 150px; opacity: 0.5;">
                    <h5 class="text-muted">Không có thông báo nào</h5>
                    <p class="text-muted small">Chúng tôi sẽ thông báo cho bạn khi có tin mới!</p>
                </div>
            }
        </div>
    </div>
</div>
