@model Webgiasu.Models.ViewModels.TutorEarningsViewModel
@inject Webgiasu.Services.IProblemService ProblemService
@inject Webgiasu.Services.IPaymentService PaymentService
@inject Webgiasu.Services.IRatingService RatingService
@{
    ViewData["Title"] = "Thu nhập";
    Layout = "~/Views/Shared/_TutorLayout.cshtml";
}

<div>
    <div class="page-header mb-4">
        <h2 class="fw-bold">
            <i class="bi bi-cash-stack text-success"></i> Thu nhập & Thanh toán
        </h2>
        <p class="text-muted">Theo dõi thu nhập từ các bài giải</p>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm card-hover">
                <div class="card-body text-center">
                    <i class="bi bi-cash-coin text-success" style="font-size: 3rem;"></i>
                    <h2 class="mt-3 mb-0 text-success">@Model.TotalEarnings.ToString("N0")đ</h2>
                    <p class="text-muted mb-0">Tổng thu nhập</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body text-center card-hover">
                    <i class="bi bi-check-circle text-info" style="font-size: 3rem;"></i>
                    <h2 class="mt-3 mb-0 text-info">@Model.Solutions.Count</h2>
                    <p class="text-muted mb-0">Bài đã giải</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body text-center card-hover">
                    <i class="bi bi-graph-up text-warning" style="font-size: 3rem;"></i>
                    <h2 class="mt-3 mb-0 text-warning">@(Model.Solutions.Count > 0 ? (Model.TotalEarnings / Model.Solutions.Count).ToString("N0") : "0")đ</h2>
                    <p class="text-muted mb-0">Thu nhập TB/bài</p>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Solutions.Any())
    {
        <div class="card shadow-sm">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">
                    <i class="bi bi-list-check"></i> Lịch sử thu nhập
                </h5>
            </div>
            <div class="card-body">
                <div class="table-responsive hide-scrollbar">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Bài toán</th>
                                <th>Ngày hoàn thành</th>
                                <th>Đánh giá</th>
                                <th class="text-end">Thu nhập</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var solution in Model.Solutions.OrderByDescending(s => s.SubmittedDate))
                            {
                                var problem = ProblemService.GetProblemById(solution.ProblemId);
                                
                                // ✅ KIỂM TRA PAYMENT STATUS THỰC TẾ
                                var payment = PaymentService.GetPaymentByProblemId(solution.ProblemId);
                                var isPaid = payment?.Status == Webgiasu.Models.PaymentStatus.Completed;
                                
                                // ✅ KIỂM TRA RATING TỪ BẢNG RATINGS
                                var rating = await RatingService.GetRatingByProblemIdAsync(solution.ProblemId);
                                
                                <tr>
                                    <td class="fw-bold">#@solution.Id</td>
                                    <td>
                                        @if (problem != null)
                                        {
                                            <div>@problem.Title</div>
                                            <small class="text-muted">@problem.Type</small>
                                        }
                                    </td>
                                    <td>@solution.SubmittedDate.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        @if (rating != null)
                                        {
                                            <div class="text-warning">
                                                @for (int i = 1; i <= 5; i++)
                                                {
                                                    if (i <= rating.Stars)
                                                    {
                                                        <i class="bi bi-star-fill"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-star"></i>
                                                    }
                                                }
                                            </div>
                                            @if (!string.IsNullOrEmpty(rating.Comment))
                                            {
                                                <small class="text-muted d-block" title="@rating.Comment">
                                                    "@(rating.Comment.Length > 30 ? rating.Comment.Substring(0, 30) + "..." : rating.Comment)"
                                                </small>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">Chưa đánh giá</span>
                                        }
                                    </td>
                                    <td class="text-end fw-bold text-success">
                                        @if (problem != null)
                                        {
                                            @problem.Price.ToString("N0")
                                            <text>đ</text>
                                        }
                                    </td>
                                    <td>
                                        @if (isPaid)
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle"></i> Đã thanh toán
                                            </span>
                                            @if (payment?.CompletedDate != null)
                                            {
                                                <small class="d-block text-muted mt-1">
                                                    @payment.CompletedDate.Value.ToString("dd/MM/yyyy")
                                                </small>
                                            }
                                        }
                                        else if (payment?.Status == Webgiasu.Models.PaymentStatus.Pending)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                <i class="bi bi-clock"></i> Chờ thanh toán
                                            </span>
                                        }
                                        else if (payment?.Status == Webgiasu.Models.PaymentStatus.Failed)
                                        {
                                            <span class="badge bg-danger">
                                                <i class="bi bi-x-circle"></i> Thất bại
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                <i class="bi bi-question-circle"></i> Chưa xác định
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="table-success">
                                <td colspan="4" class="text-end fw-bold">TỔNG CỘNG:</td>
                                <td class="text-end fw-bold fs-5">@Model.TotalEarnings.ToString("N0")đ</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="d-flex justify-content-center">
                    <div class="card border-0 shadow-sm bg-light w-100" style="max-width:1100px; padding-left:18px; padding-right:18px;">
                        <div class="card-body text-center py-5">
                            <i class="bi bi-inbox display-1 text-secondary d-block mb-3" aria-hidden="true"></i>
                            <h4 class="mt-3 text-muted">Chưa có thu nhập</h4>
                            <p class="text-muted mb-3">Hãy bắt đầu giải bài để có thu nhập đầu tiên!</p>
                            <a asp-action="AvailableProblems" class="btn btn-success btn-lg mt-2">
                                <i class="bi bi-search me-1"></i> Tìm bài toán
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-center">
                <div class="card border-0 shadow-sm bg-light w-100"
                     style="max-width:1100px;">
                    <div class="card-header" style="background: linear-gradient(135deg, #00BCD4 0%, #26C6DA 100%);">
                        <h5 class="mb-0 text-white">
                            <i class="bi bi-info-circle"></i> Thông tin thanh toán
                        </h5>
                    </div>
                    <div class="card-body px-4">
                        <div class="row">
                            <div class="col-md-6">
                                <h6 class="fw-bold mb-3">
                                    <i class="bi bi-credit-card-2-front text-primary me-2"></i>Phương thức thanh toán
                                </h6>
                                <ul class="list-unstyled ms-4">
                                    <li class="mb-2">
                                        <i class="bi bi-bank text-primary me-2"></i> Chuyển khoản ngân hàng
                                    </li>
                                    <li class="mb-2">
                                        <i class="bi bi-wallet2 text-success me-2"></i> Ví điện tử (Momo, ZaloPay)
                                    </li>
                                    <li class="mb-2">
                                        <i class="bi bi-credit-card text-warning me-2"></i> Thẻ ATM/Visa
                                    </li>
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <h6 class="fw-bold mb-3">
                                    <i class="bi bi-calendar2-check text-info me-2"></i>Chu kỳ thanh toán
                                </h6>
                                <ul class="list-unstyled ms-4">
                                    <li class="mb-2 text-muted">
                                        <i class="bi bi-check-circle text-success me-2"></i> Thanh toán sau khi học sinh xác nhận và đánh giá bài giải.
                                    </li>
                                    <li class="mb-2 text-muted">
                                        <i class="bi bi-clock text-warning me-2"></i> Thời gian xử lý: 1-3 ngày làm việc.
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


