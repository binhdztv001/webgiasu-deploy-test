@{
    ViewData["Title"] = "Tin nhắn";
    Layout = "_StudentLayout";
}

<div class="page-header d-flex flex-wrap justify-content-between align-items-center">
    <div>
        <h5 class="fw-bold mb-1 text-dark">
            <i class="bi bi-chat-dots text-primary me-2"></i>Tin nhắn
        </h5>
        <p class="text-muted mb-0 small">Trò chuyện với gia sư của bạn</p>
    </div>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header py-3" style="background: linear-gradient(135deg, #2196F3 0%, #03A9F4 100%);">
                <div class="input-group">
                    <span class="input-group-text bg-white border-0"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control border-0" placeholder="Tìm kiếm...">
                </div>
            </div>
            <div class="card-body p-0" style="height: 500px; overflow-y: auto;">
                <div class="list-group list-group-flush">
                    <a href="#" class="list-group-item list-group-item-action active">
                        <div class="d-flex align-items-center">
                            <img src="https://ui-avatars.com/api/?name=Nguyen+Van+A&size=40" class="rounded-circle me-3" width="40" height="40">
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between">
                                    <h6 class="mb-0">Thầy Nguyễn Văn A</h6>
                                    <small class="text-muted">5 phút</small>
                                </div>
                                <small class="text-muted">Đã gửi lời giải cho bạn</small>
                            </div>
                            <span class="badge bg-danger rounded-pill">3</span>
                        </div>
                    </a>
                    <a href="#" class="list-group-item list-group-item-action">
                        <div class="d-flex align-items-center">
                            <img src="https://ui-avatars.com/api/?name=Tran+Thi+B&size=40" class="rounded-circle me-3" width="40" height="40">
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between">
                                    <h6 class="mb-0">Cô Trần Thị B</h6>
                                    <small class="text-muted">1 giờ</small>
                                </div>
                                <small class="text-muted">Cảm ơn em!</small>
                            </div>
                        </div>
                    </a>
                    <a href="#" class="list-group-item list-group-item-action">
                        <div class="d-flex align-items-center">
                            <img src="https://ui-avatars.com/api/?name=Le+Van+C&size=40" class="rounded-circle me-3" width="40" height="40">
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between">
                                    <h6 class="mb-0">Thầy Lê Văn C</h6>
                                    <small class="text-muted">2 giờ</small>
                                </div>
                                <small class="text-muted">Em cần hỗ trợ gì không?</small>
                            </div>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-8">
        <div class="card border-0 shadow-sm" style="height: 600px; display: flex; flex-direction: column;">
            <div class="card-header py-3" style="background: linear-gradient(135deg, #2196F3 0%, #03A9F4 100%);">
                <div class="d-flex align-items-center">
                    <img src="https://ui-avatars.com/api/?name=Nguyen+Van+A&size=40" class="rounded-circle me-3" width="40" height="40">
                    <div>
                        <h6 class="mb-0 text-white">Thầy Nguyễn Văn A</h6>
                        <small class="text-white-50"><i class="bi bi-circle-fill" style="font-size: 8px; color: #4CAF50;"></i> Đang hoạt động</small>
                    </div>
                </div>
            </div>
            
            <div class="card-body flex-grow-1" style="overflow-y: auto;">
                <div class="mb-3">
                    <div class="d-flex justify-content-start mb-2">
                        <div>
                            <img src="https://ui-avatars.com/api/?name=Nguyen+Van+A&size=32" class="rounded-circle me-2" width="32" height="32">
                        </div>
                        <div>
                            <div class="bg-light rounded p-3 shadow-sm" style="max-width: 400px;">
                                <p class="mb-0">Chào em! Thầy đã xem bài toán của em rồi.</p>
                            </div>
                            <small class="text-muted">15:30</small>
                        </div>
                    </div>
                </div>
                
                <div class="mb-3">
                    <div class="d-flex justify-content-end mb-2">
                        <div class="text-end">
                            <div class="bg-primary text-white rounded p-3 shadow-sm" style="max-width: 400px;">
                                <p class="mb-0">Dạ, em cảm ơn thầy ạ!</p>
                            </div>
                            <small class="text-muted">15:32</small>
                        </div>
                        <div>
                            <img src="https://ui-avatars.com/api/?name=Student&size=32" class="rounded-circle ms-2" width="32" height="32">
                        </div>
                    </div>
                </div>
                
                <div class="mb-3">
                    <div class="d-flex justify-content-start mb-2">
                        <div>
                            <img src="https://ui-avatars.com/api/?name=Nguyen+Van+A&size=32" class="rounded-circle me-2" width="32" height="32">
                        </div>
                        <div>
                            <div class="bg-light rounded p-3 shadow-sm" style="max-width: 400px;">
                                <p class="mb-0">Thầy đã gửi lời giải chi tiết. Em xem và feedback nhé!</p>
                            </div>
                            <small class="text-muted">15:45</small>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="card-footer bg-white border-top">
                <div class="input-group">
                    <button class="btn btn-outline-secondary" type="button">
                        <i class="bi bi-paperclip"></i>
                    </button>
                    <input type="text" class="form-control" placeholder="Nhập tin nhắn...">
                    <button class="btn btn-primary" type="button">
                        <i class="bi bi-send"></i> Gửi
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
