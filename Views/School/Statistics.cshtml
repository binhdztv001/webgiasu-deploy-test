@{
    ViewData["Title"] = "Thống kê - Nhà trường";
    Layout = "~/Views/Shared/_SchoolLayout.cshtml";
}

<div class="dashboard-container">
    <!-- Page Header -->
    <div class="page-header d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div class="mb-2 mb-md-0">
            <h5 class="fw-bold mb-1 text-dark">
                <i class="bi bi-bar-chart-line text-warning me-2"></i>Thống kê nhà trường
            </h5>
            <p class="text-muted mb-0 small">Xem báo cáo và phân tích chi tiết về hoạt động của trường</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="ExportStatisticsToPdf" class="btn btn-danger btn-sm">
                <i class="bi bi-file-pdf me-1"></i> Xuất PDF
            </a>
            <a asp-action="ExportStatisticsToExcel" class="btn btn-success btn-sm">
                <i class="bi bi-file-earmark-excel me-1"></i> Xuất Excel
            </a>
        </div>
    </div>

    <!-- Overview Stats -->
    <div class="row g-3 mb-4">
        <div class="col-md-6 col-lg-3">
            <div class="card stat-card border-start border-5 border-warning h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small text-uppercase mb-1">Tổng số lớp</div>
                            <h3 class="mb-0 fw-bold text-warning">@ViewBag.TotalClasses</h3>
                            <small class="text-success">
                                <i class="bi bi-arrow-up"></i> @ViewBag.ActiveClasses đang hoạt động
                            </small>
                        </div>
                        <div class="stat-icon bg-warning bg-opacity-10 text-warning">
                            <i class="bi bi-collection"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card stat-card border-start border-5 border-info h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small text-uppercase mb-1">Học sinh</div>
                            <h3 class="mb-0 fw-bold text-info">@ViewBag.TotalStudents</h3>
                            <small class="text-muted">
                                <i class="bi bi-people"></i> Tổng số học sinh
                            </small>
                        </div>
                        <div class="stat-icon bg-info bg-opacity-10 text-info">
                            <i class="bi bi-people-fill"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card stat-card border-start border-5 border-success h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small text-uppercase mb-1">Mentor</div>
                            <h3 class="mb-0 fw-bold text-success">@ViewBag.TotalTutors</h3>
                            <small class="text-success">
                                <i class="bi bi-check-circle"></i> @ViewBag.ActiveTutors đang hoạt động
                            </small>
                        </div>
                        <div class="stat-icon bg-success bg-opacity-10 text-success">
                            <i class="bi bi-person-badge-fill"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card stat-card border-start border-5 border-primary h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small text-uppercase mb-1">Tỷ lệ hoàn thành</div>
                            <h3 class="mb-0 fw-bold text-primary">@ViewBag.CompletionRate.ToString("F1")%</h3>
                            <small class="text-muted">
                                @ViewBag.CompletedClasses/@ViewBag.TotalClasses lớp
                            </small>
                        </div>
                        <div class="stat-icon bg-primary bg-opacity-10 text-primary">
                            <i class="bi bi-trophy-fill"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row 1 -->
    <div class="row g-3 mb-4">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header bg-warning bg-opacity-10">
                    <h5 class="mb-0"><i class="bi bi-table me-2 text-warning"></i>Danh sách lớp học chi tiết</h5>
                </div>
                <div class="card-body scroll-area-md">
                    @{
                        var classDetails = ViewBag.ClassDetailsList as IEnumerable<dynamic>;
                        if (classDetails != null && classDetails.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-sm table-hover mb-0">
                                    <thead class="table-light sticky-top">
                                        <tr>
                                            <th>Lớp học</th>
                                            <th>Môn</th>
                                            <th>Mentor</th>
                                            <th>HS</th>
                                            <th>Trạng thái</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in classDetails)
                                        {
                                            var badgeClass = item.Status == Webgiasu.Models.ClassStatus.Active ? "bg-success" : 
                                                           item.Status == Webgiasu.Models.ClassStatus.Completed ? "bg-primary" : "bg-secondary";
                                            <tr>
                                                <td>
                                                    <a href="@Url.Action("ClassDetails", "School", new { id = item.Id })" class="text-decoration-none fw-semibold">
                                                        @item.ClassName
                                                    </a>
                                                </td>
                                                <td><span class="badge bg-info">@item.Subject</span></td>
                                                <td><small>@item.TutorName</small></td>
                                                <td class="text-center"><strong>@item.StudentCount</strong></td>
                                                <td><span class="badge @badgeClass">@item.StatusText</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <i class="bi bi-inbox text-muted icon-size-xxl"></i>
                                <p class="text-muted mt-2">Chưa có lớp học nào</p>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header bg-info bg-opacity-10">
                    <h5 class="mb-0"><i class="bi bi-graph-up me-2 text-info"></i>Trạng thái lớp học</h5>
                </div>
                <div class="card-body">
                    <canvas id="statusChart" style="max-height: 300px;"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row 2 -->
    <div class="row g-3 mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-success bg-opacity-10">
                    <h5 class="mb-0"><i class="bi bi-bar-chart-line me-2 text-success"></i>Tăng trưởng lớp học 6 tháng</h5>
                </div>
                <div class="card-body">
                    <canvas id="monthlyChart" style="max-height: 350px;"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Performance Metrics -->
    <div class="row g-3">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-secondary bg-opacity-10">
                    <h5 class="mb-0"><i class="bi bi-speedometer2 me-2 text-secondary"></i>Hiệu suất hệ thống</h5>
                </div>
                <div class="card-body">
                    <div class="row g-4">
                        <div class="col-md-3">
                            <div class="text-center">
                                <div class="position-relative d-inline-block mb-3">
                                    <canvas id="completionRateChart" width="120" height="120"></canvas>
                                    <div class="position-absolute top-50 start-50 translate-middle">
                                        <div class="h3 fw-bold text-success mb-0">@ViewBag.CompletionRate.ToString("F0")%</div>
                                    </div>
                                </div>
                                <h6 class="fw-semibold">Tỷ lệ hoàn thành</h6>
                                <p class="text-muted small mb-0">Lớp học đã hoàn thành</p>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="text-center">
                                <div class="position-relative d-inline-block mb-3">
                                    <canvas id="activeRateChart" width="120" height="120"></canvas>
                                    <div class="position-absolute top-50 start-50 translate-middle">
                                        @{
                                            var activeRate = ViewBag.TotalClasses > 0 ? (double)ViewBag.ActiveClasses / ViewBag.TotalClasses * 100 : 0;
                                        }
                                        <div class="h3 fw-bold text-warning mb-0">@activeRate.ToString("F0")%</div>
                                    </div>
                                </div>
                                <h6 class="fw-semibold">Tỷ lệ hoạt động</h6>
                                <p class="text-muted small mb-0">Lớp đang hoạt động</p>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="text-center">
                                <div class="position-relative d-inline-block mb-3">
                                    <canvas id="mentorRateChart" width="120" height="120"></canvas>
                                    <div class="position-absolute top-50 start-50 translate-middle">
                                        @{
                                            var mentorRate = ViewBag.TotalTutors > 0 ? (double)ViewBag.ActiveTutors / ViewBag.TotalTutors * 100 : 0;
                                        }
                                        <div class="h3 fw-bold text-info mb-0">@mentorRate.ToString("F0")%</div>
                                    </div>
                                </div>
                                <h6 class="fw-semibold">Mentor tham gia</h6>
                                <p class="text-muted small mb-0">Mentor đang hoạt động</p>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="text-center">
                                <div class="position-relative d-inline-block mb-3">
                                    <canvas id="studentAvgChart" width="120" height="120"></canvas>
                                    <div class="position-absolute top-50 start-50 translate-middle">
                                        @{
                                            var avgStudents = ViewBag.TotalClasses > 0 ? (double)ViewBag.TotalStudents / ViewBag.TotalClasses : 0;
                                        }
                                        <div class="h3 fw-bold text-primary mb-0">@avgStudents.ToString("F1")</div>
                                    </div>
                                </div>
                                <h6 class="fw-semibold">TB học sinh/lớp</h6>
                                <p class="text-muted small mb-0">Trung bình mỗi lớp</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Màu sắc gradient
        const colors = {
            primary: ['#667eea', '#764ba2'],
            success: ['#11998e', '#38ef7d'],
            warning: ['#f093fb', '#f5576c'],
            info: ['#4facfe', '#00f2fe'],
            danger: ['#fa709a', '#fee140']
        };

        // Chart: Trạng thái lớp học (Bar Chart)
        const statusData = @Html.Raw(Json.Serialize(ViewBag.ClassesByStatus));
        console.log("Status Data:", statusData);
        const statusLabels = statusData.map(x => x.status || x.Status);
        const statusValues = statusData.map(x => x.count || x.Count);

        const statusChart = new Chart(document.getElementById('statusChart'), {
            type: 'bar',
            data: {
                labels: statusLabels,
                datasets: [{
                    label: 'Số lượng lớp',
                    data: statusValues,
                    backgroundColor: [
                        'rgba(102, 126, 234, 0.8)',
                        'rgba(17, 153, 142, 0.8)',
                        'rgba(250, 112, 154, 0.8)'
                    ],
                    borderColor: [
                        '#667eea',
                        '#11998e',
                        '#fa709a'
                    ],
                    borderWidth: 2,
                    borderRadius: 8
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return context.parsed.y + ' lớp học';
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { stepSize: 1 },
                        grid: { color: 'rgba(0, 0, 0, 0.05)' }
                    },
                    x: {
                        grid: { display: false }
                    }
                }
            }
        });

        // Chart 3: Tăng trưởng theo tháng (Line Chart)
        const monthlyData = @Html.Raw(Json.Serialize(ViewBag.ClassesByMonth));
        console.log("Monthly Data:", monthlyData);
        const monthLabels = monthlyData.map(x => x.month || x.Month);
        const monthValues = monthlyData.map(x => x.count || x.Count);

        const studentsData = @Html.Raw(Json.Serialize(ViewBag.StudentsByMonth));
        console.log("Students Data:", studentsData);
        const studentValues = studentsData.map(x => x.count || x.Count);

        const monthlyChart = new Chart(document.getElementById('monthlyChart'), {
            type: 'line',
            data: {
                labels: monthLabels,
                datasets: [
                    {
                        label: 'Lớp học mới',
                        data: monthValues,
                        borderColor: '#667eea',
                        backgroundColor: 'rgba(102, 126, 234, 0.1)',
                        borderWidth: 3,
                        fill: true,
                        tension: 0.4,
                        pointRadius: 5,
                        pointHoverRadius: 7,
                        pointBackgroundColor: '#667eea'
                    },
                    {
                        label: 'Học sinh mới',
                        data: studentValues,
                        borderColor: '#11998e',
                        backgroundColor: 'rgba(17, 153, 142, 0.1)',
                        borderWidth: 3,
                        fill: true,
                        tension: 0.4,
                        pointRadius: 5,
                        pointHoverRadius: 7,
                        pointBackgroundColor: '#11998e'
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                plugins: {
                    legend: {
                        position: 'top',
                        labels: {
                            padding: 15,
                            font: { size: 13 }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { stepSize: 1 },
                        grid: { color: 'rgba(0, 0, 0, 0.05)' }
                    },
                    x: {
                        grid: { display: false }
                    }
                }
            }
        });

        // Circular Progress Charts
        function createCircularChart(canvasId, value, color1, color2) {
            return new Chart(document.getElementById(canvasId), {
                type: 'doughnut',
                data: {
                    datasets: [{
                        data: [value, 100 - value],
                        backgroundColor: [color1, 'rgba(0, 0, 0, 0.05)'],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: false,
                    cutout: '75%',
                    plugins: {
                        legend: { display: false },
                        tooltip: { enabled: false }
                    }
                }
            });
        }

        createCircularChart('completionRateChart', @Html.Raw(Json.Serialize(ViewBag.CompletionRate)), '#11998e', '#e0e0e0');
        createCircularChart('activeRateChart', @Html.Raw(Json.Serialize(activeRate)), '#f093fb', '#e0e0e0');
        createCircularChart('mentorRateChart', @Html.Raw(Json.Serialize(mentorRate)), '#4facfe', '#e0e0e0');
        
        const avgValue = @Html.Raw(Json.Serialize(avgStudents)) * 10; // Scale to percentage (assume max 10 students per class)
        createCircularChart('studentAvgChart', avgValue > 100 ? 100 : avgValue, '#667eea', '#e0e0e0');
    </script>
}
