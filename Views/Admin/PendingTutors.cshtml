@model List<Webgiasu.Models.User>
@{
    ViewData["Title"] = "Duyệt Mentor";
    Layout = "_AdminLayout";
}

<div>
    <div class="row mb-4">
        <div class="col">
            <h2 class="fw-bold">
                <i class="bi bi-person-check text-danger"></i> Duyệt Mentor
            </h2>
            <p class="text-muted">Xét duyệt tài khoản Mentor mới đăng ký</p>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle"></i>
            <strong>Lưu ý:</strong> Có @Model.Count Mentor đang chờ phê duyệt
        </div>

        <div class="row">
            @foreach (var tutor in Model)
            {
                <div class="col-lg-6 mb-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-header bg-warning text-dark">
                            <h5 class="mb-0">
                                <i class="bi bi-person-circle"></i> @tutor.FullName
                            </h5>
                        </div>
                        <div class="card-body p-3 p-md-4">
                            <div class="row mb-3">
                                <div class="col-6">
                                    <p class="mb-1">
                                        <i class="bi bi-person-badge text-primary"></i>
                                        <strong>Username:</strong>
                                    </p>
                                    <p class="text-muted small">@tutor.Username</p>
                                </div>
                                <div class="col-6">
                                    <p class="mb-1">
                                        <i class="bi bi-hash text-primary"></i>
                                        <strong>ID:</strong>
                                    </p>
                                    <p class="text-muted small">#@tutor.Id</p>
                                </div>
                            </div>

                            <div class="mb-3">
                                <p class="mb-1">
                                    <i class="bi bi-envelope text-primary"></i>
                                    <strong>Email:</strong>
                                </p>
                                <p class="text-muted small">@tutor.Email</p>
                            </div>

                            <div class="mb-3">
                                <p class="mb-1">
                                    <i class="bi bi-phone text-primary"></i>
                                    <strong>Số điện thoại:</strong>
                                </p>
                                <p class="text-muted small">@tutor.PhoneNumber</p>
                            </div>

                            <div class="mb-3">
                                <p class="mb-1">
                                    <i class="bi bi-calendar text-primary"></i>
                                    <strong>Ngày đăng ký:</strong>
                                </p>
                                <p class="text-muted small">@tutor.RegisteredDate.ToString("dd/MM/yyyy HH:mm")</p>
                            </div>

                            <div class="alert alert-info mb-0 py-2">
                                <i class="bi bi-info-circle"></i>
                                <small>Tài khoản này đã đăng ký @((DateTime.Now - tutor.RegisteredDate).Days) ngày trước</small>
                            </div>
                        </div>
                        <div class="card-footer">
                            <form asp-action="ApproveTutor" method="post" class="d-grid gap-2">
                                <input type="hidden" name="id" value="@tutor.Id" />
                                <button type="submit" class="btn btn-success" onclick="return confirm('Xác nhận duyệt Mentor @tutor.FullName?')">
                                    <i class="bi bi-check-circle"></i> Phê duyệt
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
                <h4 class="mt-3 text-success">Không có Mentor chờ duyệt</h4>
                <p class="text-muted">Tất cả Mentor đã được phê duyệt</p>
                <a asp-action="Dashboard" class="btn btn-primary">
                    <i class="bi bi-arrow-left"></i> Quay lại Dashboard
                </a>
            </div>
        </div>
    }

    <div class="mt-4">
        <a asp-action="ManageTutors" class="btn btn-outline-primary">
            <i class="bi bi-list"></i> Xem tất cả Mentor
        </a>
        <a asp-action="Dashboard" class="btn btn-outline-secondary">
            <i class="bi bi-house"></i> Dashboard
        </a>
    </div>
</div>
