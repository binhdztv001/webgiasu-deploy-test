@{
    ViewData["Title"] = "Nhật ký hệ thống";
    Layout = "_AdminLayout";
}

<div class="page-header mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-clock-history text-danger"></i> Nhật ký hệ thống
            </h2>
            <p class="text-muted mb-0 small">Theo dõi hoạt động và sự kiện hệ thống</p>
        </div>
        <div class="d-flex gap-2">
            <select class="form-select form-select-sm">
                <option>Hôm nay</option>
                <option>7 ngày qua</option>
                <option>30 ngày qua</option>
                <option>Tùy chỉnh</option>
            </select>
            <button class="btn btn-outline-danger btn-sm">
                <i class="bi bi-trash"></i> <span class="d-none d-sm-inline">Xóa log cũ</span>
            </button>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-12">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="row g-2">
                    <div class="col-12 col-md-8">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                            <input type="text" class="form-control" placeholder="Tìm kiếm trong nhật ký...">
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <select class="form-select form-select-sm">
                            <option>Tất cả mức độ</option>
                            <option>Info</option>
                            <option>Warning</option>
                            <option>Error</option>
                            <option>Critical</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

