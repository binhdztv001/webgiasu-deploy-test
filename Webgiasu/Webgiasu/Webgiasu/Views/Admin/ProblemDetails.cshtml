@model Webgiasu.Models.ViewModels.ProblemDetailsViewModel
@{
    ViewData["Title"] = "Chi tiết bài toán - Admin";
    Layout = "_AdminLayout";
}

<div class="row">
    <div class="col-lg-8">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="bi bi-file-text"></i> Thông tin bài toán</h4>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong><i class="bi bi-hash"></i> Mã bài:</strong> #@Model.Problem.Id
                    </div>
                    <div class="col-md-6 text-end">
                        @{
                            var statusClass = Model.Problem.Status switch
                            {
                                Webgiasu.Models.ProblemStatus.WaitingForTutor => "warning",
                                Webgiasu.Models.ProblemStatus.InProgress => "info",
                                Webgiasu.Models.ProblemStatus.Solved => "success",
                                _ => "secondary"
                            };
                            var statusText = Model.Problem.Status switch
                            {
                                Webgiasu.Models.ProblemStatus.WaitingForTutor => "Chờ gia sư",
                                Webgiasu.Models.ProblemStatus.InProgress => "Đang giải",
                                Webgiasu.Models.ProblemStatus.Solved => "Đã giải",
                                _ => "Khác"
                            };
                        }
                        <span class="badge bg-@statusClass fs-6">@statusText</span>
                    </div>
                </div>

                <h3 class="mb-3">@Model.Problem.Title</h3>
                
                <div class="mb-3">
                    <span class="badge bg-secondary me-2"><i class="bi bi-book"></i> @Model.Problem.Type</span>
                    @if (Model.Problem.Difficulty == Webgiasu.Models.DifficultyLevel.Easy)
                    {
                        <span class="badge bg-success me-2"><i class="bi bi-bar-chart"></i> Dễ</span>
                    }
                    else if (Model.Problem.Difficulty == Webgiasu.Models.DifficultyLevel.Medium)
                    {
                        <span class="badge bg-warning me-2"><i class="bi bi-bar-chart"></i> Trung bình</span>
                    }
                    else
                    {
                        <span class="badge bg-danger me-2"><i class="bi bi-bar-chart"></i> Khó</span>
                    }
                    <span class="badge bg-info"><i class="bi bi-currency-dollar"></i> @Model.Problem.Price.ToString("N0") đ</span>
                </div>

                <hr />

                <h5 class="mb-3"><i class="bi bi-file-text"></i> Mô tả chi tiết:</h5>
                <div class="bg-light p-3 rounded">
                    <p class="mb-0">@Model.Problem.Description</p>
                </div>

                @if (!string.IsNullOrEmpty(Model.Problem.ImageUrl) && Model.Problem.ImageUrl != "/images/default.jpg")
                {
                    <div class="mt-3">
                        <h5><i class="bi bi-image"></i> Hình ảnh:</h5>
                        <img src="@Model.Problem.ImageUrl" alt="Problem image" class="img-fluid rounded" style="max-height: 400px;" />
                    </div>
                }

                <hr />

                <div class="row mt-3">
                    <div class="col-md-6">
                        <p class="mb-1"><strong><i class="bi bi-calendar-plus"></i> Ngày đăng:</strong></p>
                        <p>@Model.Problem.CreatedDate.ToString("dd/MM/yyyy HH:mm")</p>
                    </div>
                    <div class="col-md-6">
                        <p class="mb-1"><strong><i class="bi bi-calendar-event"></i> Deadline:</strong></p>
                        <p class="text-danger fw-bold">@Model.Problem.Deadline.ToString("dd/MM/yyyy HH:mm")</p>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.Solution != null)
        {
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="bi bi-check-circle"></i> Lời giải</h5>
                </div>
                <div class="card-body">
                    <div class="bg-light p-3 rounded">
                        <pre class="mb-0" style="white-space: pre-wrap;">@Model.Solution.Content</pre>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Solution.FileUrl))
                    {
                        <div class="mt-3">
                            <p><strong>File đính kèm:</strong> <code>@Model.Solution.FileUrl</code></p>
                        </div>
                    }

                    <hr />

                    <small class="text-muted">
                        <i class="bi bi-clock"></i> Gửi lúc: @Model.Solution.SubmittedDate.ToString("dd/MM/yyyy HH:mm")
                    </small>

                    @if (Model.Solution.Rating.HasValue)
                    {
                        <div class="alert alert-success mt-3 mb-0">
                            <h6><i class="bi bi-star-fill text-warning"></i> Đánh giá: @Model.Solution.Rating/5</h6>
                            @if (!string.IsNullOrEmpty(Model.Solution.Feedback))
                            {
                                <p class="mb-0"><strong>Nhận xét:</strong> @Model.Solution.Feedback</p>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-person"></i> Học sinh</h5>
            </div>
            <div class="card-body">
                <h6>@Model.Student?.FullName</h6>
                <p class="text-muted mb-1">
                    <i class="bi bi-person-badge"></i> @Model.Student?.Username<br />
                    <i class="bi bi-envelope"></i> @Model.Student?.Email<br />
                    <i class="bi bi-phone"></i> @Model.Student?.PhoneNumber
                </p>
            </div>
        </div>

        @if (Model.AssignedTutor != null)
        {
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="bi bi-mortarboard"></i> Gia sư</h5>
                </div>
                <div class="card-body">
                    <h6>@Model.AssignedTutor.FullName</h6>
                    <p class="text-muted mb-1">
                        <i class="bi bi-person-badge"></i> @Model.AssignedTutor.Username<br />
                        <i class="bi bi-envelope"></i> @Model.AssignedTutor.Email<br />
                        <i class="bi bi-phone"></i> @Model.AssignedTutor.PhoneNumber
                    </p>
                </div>
            </div>
        }

        <div class="d-grid gap-2">
            <a asp-action="ManageProblems" class="btn btn-outline-primary">
                <i class="bi bi-arrow-left"></i> Quay lại danh sách
            </a>
            <a asp-action="Dashboard" class="btn btn-outline-secondary">
                <i class="bi bi-house"></i> Dashboard
            </a>
            <form asp-action="DeleteProblem" method="post">
                <input type="hidden" name="id" value="@Model.Problem.Id" />
                <button type="submit" class="btn btn-danger w-100" onclick="return confirm('Xác nhận xóa bài toán này?')">
                    <i class="bi bi-trash"></i> Xóa bài toán
                </button>
            </form>
        </div>
    </div>
</div>
