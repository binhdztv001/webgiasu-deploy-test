@{
    ViewData["Title"] = "Thống kê";
    Layout = "~/Views/Shared/_EnterpriseLayout.cshtml";
}

<div class="dashboard-container">
    <!-- Page Header -->
    <div class="page-header d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div class="mb-2 mb-md-0">
            <h5 class="fw-bold mb-1 text-dark">
                <i class="bi bi-bar-chart-line me-2" style="color: #795548;"></i>Thống kê tổng quan
            </h5>
            <p class="text-muted mb-0 small">Xem báo cáo và thống kê chi tiết về hệ thống</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="ExportStatisticsToPdf" class="btn btn-danger btn-sm">
                <i class="bi bi-file-pdf me-1"></i> Xuất PDF
            </a>
            <a asp-action="ExportStatisticsToExcel" class="btn btn-success btn-sm">
                <i class="bi bi-file-earmark-excel me-1"></i> Xuất Excel
            </a>
            <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Quay lại
            </a>
        </div>
    </div>

    <!-- Tổng quan -->
    <div class="row g-4 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm stat-card" style="border-left: 4px solid #795548 !important;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 small text-uppercase">Tổng số trường</p>
                            <h3 class="fw-bold mb-0" style="color: #795548;">@ViewBag.TotalSchools</h3>
                        </div>
                        <div class="stat-icon rounded" style="background: linear-gradient(135deg, rgba(121, 85, 72, 0.1) 0%, rgba(141, 110, 99, 0.1) 100%);">
                            <i class="bi bi-building" style="font-size: 2rem; color: #795548;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm stat-card" style="border-left: 4px solid #4CAF50 !important;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 small text-uppercase">Tổng Mentor</p>
                            <h3 class="fw-bold mb-0 text-success">@ViewBag.TotalMentors</h3>
                        </div>
                        <div class="stat-icon bg-success bg-opacity-10 rounded">
                            <i class="bi bi-person-check" style="font-size: 2rem; color: #4CAF50;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm stat-card" style="border-left: 4px solid #2196F3 !important;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 small text-uppercase">Tổng lớp học</p>
                            <h3 class="fw-bold mb-0 text-primary">@ViewBag.TotalClasses</h3>
                            <small class="text-success">
                                <i class="bi bi-check-circle me-1"></i>@ViewBag.ActiveClasses đang hoạt động
                            </small>
                        </div>
                        <div class="stat-icon bg-primary bg-opacity-10 rounded">
                            <i class="bi bi-book" style="font-size: 2rem; color: #2196F3;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm stat-card" style="border-left: 4px solid #FF9800 !important;">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 small text-uppercase">Tổng học sinh</p>
                            <h3 class="fw-bold mb-0 text-warning">@ViewBag.TotalStudents</h3>
                        </div>
                        <div class="stat-icon bg-warning bg-opacity-10 rounded">
                            <i class="bi bi-people" style="font-size: 2rem; color: #FF9800;"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Thống kê theo trường -->
    <div class="row g-4 mb-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header py-3 bg-white border-bottom">
                    <h6 class="mb-0 fw-bold">
                        <i class="bi bi-building me-2" style="color: #795548;"></i>Thống kê theo trường
                    </h6>
                </div>
                <div class="card-body p-0">
                    @if (ViewBag.SchoolStats != null && ((IEnumerable<dynamic>)ViewBag.SchoolStats).Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th>STT</th>
                                        <th>Tên trường</th>
                                        <th class="text-center">Tổng lớp học</th>
                                        <th class="text-center">Lớp đang hoạt động</th>
                                        <th class="text-center">Tổng học sinh</th>
                                        <th class="text-center">Lịch trao đổi</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        var index = 1;
                                    }
                                    @foreach (var school in ViewBag.SchoolStats)
                                    {
                                        <tr>
                                            <td class="fw-semibold">@index</td>
                                            <td class="fw-semibold">
                                                <i class="bi bi-building me-2" style="color: #795548;"></i>
                                                @school.SchoolName
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-primary">@school.TotalClasses</span>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-success">@school.ActiveClasses</span>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-warning">@school.TotalStudents</span>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-info">@school.TotalSchedules</span>
                                            </td>
                                        </tr>
                                        index++;
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="p-5 text-center">
                            <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                            <p class="text-muted mt-3">Chưa có dữ liệu thống kê</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="row g-4 mb-4">
        <!-- Thống kê Mentor theo môn học -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header py-3 bg-white border-bottom">
                    <h6 class="mb-0 fw-bold">
                        <i class="bi bi-mortarboard me-2" style="color: #795548;"></i>Mentor theo môn học (Top 5)
                    </h6>
                </div>
                <div class="card-body">
                    @if (ViewBag.MentorsBySubject != null && ((IEnumerable<dynamic>)ViewBag.MentorsBySubject).Any())
                    {
                        <div class="chart-container" style="position: relative; height: 300px;">
                            <canvas id="mentorsBySubjectChart"></canvas>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                            <p class="text-muted mt-3">Chưa có dữ liệu</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Thống kê lịch trao đổi theo trạng thái -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header py-3 bg-white border-bottom">
                    <h6 class="mb-0 fw-bold">
                        <i class="bi bi-calendar-event me-2" style="color: #795548;"></i>Lịch trao đổi theo trạng thái
                    </h6>
                </div>
                <div class="card-body">
                    @if (ViewBag.SchedulesByStatus != null && ((IEnumerable<dynamic>)ViewBag.SchedulesByStatus).Any())
                    {
                        <div class="chart-container" style="position: relative; height: 300px;">
                            <canvas id="schedulesByStatusChart"></canvas>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                            <p class="text-muted mt-3">Chưa có dữ liệu</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Biểu đồ lớp học theo tháng -->
    <div class="row g-4">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header py-3 bg-white border-bottom">
                    <h6 class="mb-0 fw-bold">
                        <i class="bi bi-graph-up me-2" style="color: #795548;"></i>Lớp học theo tháng (6 tháng gần nhất)
                    </h6>
                </div>
                <div class="card-body">
                    @if (ViewBag.ClassesByMonth != null && ((IEnumerable<dynamic>)ViewBag.ClassesByMonth).Any())
                    {
                        <div class="chart-container" style="position: relative; height: 350px;">
                            <canvas id="classesByMonthChart"></canvas>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                            <p class="text-muted mt-3">Chưa có dữ liệu</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        // Chart.js configuration
        Chart.defaults.font.family = 'Inter, sans-serif';
        
        @if (ViewBag.MentorsBySubject != null && ((IEnumerable<dynamic>)ViewBag.MentorsBySubject).Any())
        {
            <text>
            // Mentor by Subject Chart
            const mentorData = @Html.Raw(Json.Serialize(ViewBag.MentorsBySubject));
            const mentorCtx = document.getElementById('mentorsBySubjectChart');
            
            new Chart(mentorCtx, {
                type: 'doughnut',
                data: {
                    labels: mentorData.map(m => m.subject),
                    datasets: [{
                        data: mentorData.map(m => m.count),
                        backgroundColor: [
                            'rgba(121, 85, 72, 0.8)',
                            'rgba(76, 175, 80, 0.8)',
                            'rgba(33, 150, 243, 0.8)',
                            'rgba(255, 152, 0, 0.8)',
                            'rgba(156, 39, 176, 0.8)'
                        ],
                        borderColor: [
                            'rgba(121, 85, 72, 1)',
                            'rgba(76, 175, 80, 1)',
                            'rgba(33, 150, 243, 1)',
                            'rgba(255, 152, 0, 1)',
                            'rgba(156, 39, 176, 1)'
                        ],
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return context.label + ': ' + context.parsed + ' mentor';
                                }
                            }
                        }
                    }
                }
            });
            </text>
        }

        @if (ViewBag.SchedulesByStatus != null && ((IEnumerable<dynamic>)ViewBag.SchedulesByStatus).Any())
        {
            <text>
            // Schedules by Status Chart
            const scheduleData = @Html.Raw(Json.Serialize(ViewBag.SchedulesByStatus));
            const scheduleCtx = document.getElementById('schedulesByStatusChart');
            
            new Chart(scheduleCtx, {
                type: 'pie',
                data: {
                    labels: scheduleData.map(s => s.status),
                    datasets: [{
                        data: scheduleData.map(s => s.count),
                        backgroundColor: [
                            'rgba(33, 150, 243, 0.8)',
                            'rgba(255, 193, 7, 0.8)',
                            'rgba(76, 175, 80, 0.8)',
                            'rgba(244, 67, 54, 0.8)'
                        ],
                        borderColor: [
                            'rgba(33, 150, 243, 1)',
                            'rgba(255, 193, 7, 1)',
                            'rgba(76, 175, 80, 1)',
                            'rgba(244, 67, 54, 1)'
                        ],
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return context.label + ': ' + context.parsed + ' lịch';
                                }
                            }
                        }
                    }
                }
            });
            </text>
        }

        @if (ViewBag.ClassesByMonth != null && ((IEnumerable<dynamic>)ViewBag.ClassesByMonth).Any())
        {
            <text>
            // Classes by Month Chart
            const monthData = @Html.Raw(Json.Serialize(ViewBag.ClassesByMonth));
            const monthCtx = document.getElementById('classesByMonthChart');
            
            new Chart(monthCtx, {
                type: 'bar',
                data: {
                    labels: monthData.map(m => m.month),
                    datasets: [{
                        label: 'Số lớp học',
                        data: monthData.map(m => m.count),
                        backgroundColor: 'rgba(121, 85, 72, 0.7)',
                        borderColor: 'rgba(121, 85, 72, 1)',
                        borderWidth: 2,
                        borderRadius: 8
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return 'Số lớp: ' + context.parsed.y;
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                stepSize: 1
                            }
                        }
                    }
                }
            });
            </text>
        }
    </script>
}
