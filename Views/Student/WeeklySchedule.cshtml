@model List<Webgiasu.Models.ViewModels.TutorScheduleDayViewModel>
@{
    ViewData["Title"] = "Thời khóa biểu";
    Layout = "_StudentLayout";
    var weekExchangeSchedules = ViewBag.WeekExchangeSchedules as List<Webgiasu.Models.ViewModels.ScheduleListViewModel>
        ?? new List<Webgiasu.Models.ViewModels.ScheduleListViewModel>();

    string GetDayText(DateTime date)
    {
        return date.DayOfWeek switch
        {
            DayOfWeek.Monday => "Thứ 2",
            DayOfWeek.Tuesday => "Thứ 3",
            DayOfWeek.Wednesday => "Thứ 4",
            DayOfWeek.Thursday => "Thứ 5",
            DayOfWeek.Friday => "Thứ 6",
            DayOfWeek.Saturday => "Thứ 7",
            DayOfWeek.Sunday => "Chủ nhật",
            _ => ""
        };
    }
}

<div class="schedule-page">
    <div class="schedule-header card border-0 shadow-sm mb-3">
        <div class="card-body d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
            <div>
                <h4 class="fw-bold mb-1 text-dark"><i class="bi bi-calendar-week me-2 text-primary"></i>Thời khóa biểu tuần</h4>
                <p class="text-muted mb-0 small">@(((DateTime)ViewBag.WeekStart).ToString("dd/MM/yyyy")) - @(((DateTime)ViewBag.WeekEnd).ToString("dd/MM/yyyy"))</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="WeeklySchedule" asp-route-weekOffset="@((int)ViewBag.WeekOffset - 1)" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-chevron-left"></i> Tuần trước
                </a>
                <a asp-action="WeeklySchedule" asp-route-weekOffset="0" class="btn btn-primary btn-sm">
                    Tuần này
                </a>
                <a asp-action="WeeklySchedule" asp-route-weekOffset="@((int)ViewBag.WeekOffset + 1)" class="btn btn-outline-secondary btn-sm">
                    Tuần sau <i class="bi bi-chevron-right"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white border-bottom">
            <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-journal-check me-2 text-info"></i>Lịch bài toán của tôi</h6>
        </div>
        <div class="card-body">
            <div class="mb-3 d-flex flex-wrap gap-3">
                <span class="legend-pill"><span class="legend-dot bg-info"></span> Mentor nhận bài</span>
                <span class="legend-pill"><span class="legend-dot bg-danger"></span> Deadline</span>
            </div>
            <div class="table-responsive hide-scrollbar">
                <table class="table schedule-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="period-col">Mục</th>
                            @foreach (var day in Model)
                            {
                                <th>
                                    <span class="day-badge">@GetDayText(day.Date)</span>
                                    <div class="day-date">@day.Date.ToString("dd/MM")</div>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="row-label">Mentor nhận bài</td>
                            @foreach (var day in Model)
                            {
                                <td class="slot-cell @(day.ReceivedProblemTitles.Any() ? "slot-received" : "")">
                                    @if (day.ReceivedProblemTitles.Any())
                                    {
                                        <div class="slot-list">
                                            @foreach (var title in day.ReceivedProblemTitles)
                                            {
                                                <div class="slot-item">@title</div>
                                            }
                                        </div>
                                    }
                                </td>
                            }
                        </tr>
                        <tr>
                            <td class="row-label">Deadline</td>
                            @foreach (var day in Model)
                            {
                                <td class="slot-cell @(day.DeadlineProblemTitles.Any() ? "slot-deadline" : "")">
                                    @if (day.DeadlineProblemTitles.Any())
                                    {
                                        <div class="slot-list">
                                            @foreach (var title in day.DeadlineProblemTitles)
                                            {
                                                <div class="slot-item">@title</div>
                                            }
                                        </div>
                                    }
                                </td>
                            }
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-people me-2 text-warning"></i>Lịch trao đổi theo tuần (Sáng / Chiều / Tối)</h6>
            <a asp-action="MyClassSchedules" class="btn btn-outline-warning btn-sm">Xem tất cả</a>
        </div>
        <div class="card-body">
            <div class="mb-3 d-flex flex-wrap gap-3">
                <span class="legend-pill"><span class="legend-dot bg-warning"></span> Sáng (00:00 - 11:59)</span>
                <span class="legend-pill"><span class="legend-dot bg-success"></span> Chiều (12:00 - 17:59)</span>
                <span class="legend-pill"><span class="legend-dot bg-dark"></span> Tối (18:00 - 23:59)</span>
            </div>

            <div class="table-responsive hide-scrollbar">
                <table class="table schedule-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="period-col">Buổi</th>
                            @foreach (var day in Model)
                            {
                                <th>
                                    <span class="day-badge">@GetDayText(day.Date)</span>
                                    <div class="day-date">@day.Date.ToString("dd/MM")</div>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="row-label">Sáng</td>
                            @foreach (var day in Model)
                            {
                                var morningSchedules = weekExchangeSchedules
                                    .Where(s => s.ScheduleDate.Date == day.Date.Date && s.StartTime < new TimeSpan(12, 0, 0))
                                    .OrderBy(s => s.StartTime)
                                    .ToList();

                                <td class="slot-cell @(morningSchedules.Any() ? "slot-exchange-morning" : "")">
                                    @if (morningSchedules.Any())
                                    {
                                        <div class="slot-list">
                                            @foreach (var s in morningSchedules)
                                            {
                                                <div class="slot-item">
                                                    <div class="fw-semibold text-truncate" title="@s.Title">@s.Title</div>
                                                    <div class="small text-muted">@s.StartTime.ToString(@"hh\:mm") - @s.EndTime.ToString(@"hh\:mm")</div>
                                                    <div class="small text-muted text-truncate">@s.ClassName</div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </td>
                            }
                        </tr>

                        <tr>
                            <td class="row-label">Chiều</td>
                            @foreach (var day in Model)
                            {
                                var afternoonSchedules = weekExchangeSchedules
                                    .Where(s => s.ScheduleDate.Date == day.Date.Date
                                                && s.StartTime >= new TimeSpan(12, 0, 0)
                                                && s.StartTime < new TimeSpan(18, 0, 0))
                                    .OrderBy(s => s.StartTime)
                                    .ToList();

                                <td class="slot-cell @(afternoonSchedules.Any() ? "slot-exchange-afternoon" : "")">
                                    @if (afternoonSchedules.Any())
                                    {
                                        <div class="slot-list">
                                            @foreach (var s in afternoonSchedules)
                                            {
                                                <div class="slot-item">
                                                    <div class="fw-semibold text-truncate" title="@s.Title">@s.Title</div>
                                                    <div class="small text-muted">@s.StartTime.ToString(@"hh\:mm") - @s.EndTime.ToString(@"hh\:mm")</div>
                                                    <div class="small text-muted text-truncate">@s.ClassName</div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </td>
                            }
                        </tr>

                        <tr>
                            <td class="row-label">Tối</td>
                            @foreach (var day in Model)
                            {
                                var eveningSchedules = weekExchangeSchedules
                                    .Where(s => s.ScheduleDate.Date == day.Date.Date && s.StartTime >= new TimeSpan(18, 0, 0))
                                    .OrderBy(s => s.StartTime)
                                    .ToList();

                                <td class="slot-cell @(eveningSchedules.Any() ? "slot-exchange-evening" : "")">
                                    @if (eveningSchedules.Any())
                                    {
                                        <div class="slot-list">
                                            @foreach (var s in eveningSchedules)
                                            {
                                                <div class="slot-item">
                                                    <div class="fw-semibold text-truncate" title="@s.Title">@s.Title</div>
                                                    <div class="small text-muted">@s.StartTime.ToString(@"hh\:mm") - @s.EndTime.ToString(@"hh\:mm")</div>
                                                    <div class="small text-muted text-truncate">@s.ClassName</div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </td>
                            }
                        </tr>
                    </tbody>
                </table>
            </div>

            @if (!weekExchangeSchedules.Any())
            {
                <div class="mt-3 text-center text-muted small">
                    <i class="bi bi-info-circle me-1"></i> Tuần này chưa có lịch trao đổi.
                </div>
            }
        </div>
    </div>
</div>

<style>
    .schedule-page {
        max-width: 100%;
    }

    .legend-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 0.85rem;
        color: #6c757d;
        font-weight: 600;
    }

    .legend-dot {
        width: 10px;
        height: 10px;
        border-radius: 999px;
        display: inline-block;
    }

    .schedule-table {
        border-collapse: separate;
        border-spacing: 8px;
        min-width: 900px;
    }

    .schedule-table thead th {
        border: none;
        text-align: center;
        background: transparent;
    }

    .period-col {
        width: 120px;
        color: #0d6efd;
        font-weight: 700;
    }

    .day-badge {
        display: inline-block;
        background: #f8f9fa;
        color: #000;
        border: 1px solid #dee2e6;
        border-radius: 999px;
        padding: 4px 12px;
        font-size: 0.85rem;
    }

    .day-date {
        margin-top: 4px;
        color: #000;
        font-size: 0.8rem;
    }

    .row-label {
        background: #f8f9fa;
        color: #212529;
        border: 1px solid #e9ecef;
        font-weight: 700;
        border-radius: 10px;
        text-align: center;
        vertical-align: middle;
        border: none;
    }

    .slot-cell {
        background: #fff;
        min-height: 90px;
        border-radius: 10px;
        border: 1px solid #eef1f4;
    }

    .slot-received {
        background: rgba(13, 202, 240, 0.16);
    }

    .slot-deadline {
        background: rgba(220, 53, 69, 0.16);
    }

    .slot-exchange-morning {
        background: rgba(255, 193, 7, 0.14);
    }

    .slot-exchange-afternoon {
        background: rgba(25, 135, 84, 0.12);
    }

    .slot-exchange-evening {
        background: rgba(33, 37, 41, 0.08);
    }

    .slot-list {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .slot-item {
        font-size: 0.85rem;
        line-height: 1.3;
        background: #eaf2ff;
        border: 1px solid #d8e6ff;
        border-radius: 8px;
        padding: 6px 8px;
    }
</style>
