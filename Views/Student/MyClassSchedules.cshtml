@model List<Webgiasu.Models.ViewModels.ScheduleListViewModel>

@{
    ViewData["Title"] = "Lịch trao đổi của tôi";
    Layout = "_StudentLayout";
}

<div>
    <!-- Page Header -->
    <div class="page-header d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h5 class="fw-bold mb-1 text-dark">
                <i class="bi bi-calendar-event text-primary me-2"></i>Lịch trao đổi của các lớp học
            </h5>
            <p class="text-muted mb-0 small">Xem lịch trao đổi mà nhà trường đã tạo cho các lớp bạn tham gia</p>
        </div>
        <a asp-action="MyClassSchool" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Quay lại lớp học
        </a>
    </div>

    <!-- Statistics Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 small">Tổng số lịch</p>
                            <h3 class="fw-bold mb-0">@ViewBag.TotalSchedules</h3>
                        </div>
                        <div class="rounded-circle bg-primary bg-opacity-10 p-3">
                            <i class="bi bi-calendar-check text-primary icon-size-md"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 small">Sắp tới</p>
                            <h3 class="fw-bold mb-0 text-info">@ViewBag.UpcomingSchedules</h3>
                        </div>
                        <div class="rounded-circle bg-info bg-opacity-10 p-3">
                            <i class="bi bi-clock-history text-info icon-size-md"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 small">Đã hoàn thành</p>
                            <h3 class="fw-bold mb-0 text-success">@ViewBag.CompletedSchedules</h3>
                        </div>
                        <div class="rounded-circle bg-success bg-opacity-10 p-3">
                            <i class="bi bi-check-circle text-success icon-size-md"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Schedules List -->
    @if (Model.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom">
                <h6 class="mb-0 fw-bold text-black">
                    <i class="bi bi-list-ul me-2"></i>Danh sách lịch trao đổi
                </h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="px-3">Tiêu đề</th>
                                <th>Lớp học</th>
                                <th>Ngày & Giờ</th>
                                <th>Hình thức</th>
                                <th>Trạng thái</th>
                                <th class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var schedule in Model)
                            {
                                <tr>
                                    <td class="px-3">
                                        <div>
                                            <strong>@schedule.Title</strong>
                                            <br>
                                            <small class="text-muted">@schedule.Subject</small>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-warning bg-opacity-10 text-white">
                                            <i class="bi bi-building me-1"></i>@schedule.ClassName
                                        </span>
                                    </td>
                                    <td>
                                        <div>
                                            <i class="bi bi-calendar3 text-muted me-1"></i>
                                            <strong>@schedule.ScheduleDate.ToString("dd/MM/yyyy")</strong>
                                            <br>
                                            <i class="bi bi-clock text-muted me-1"></i>
                                            <small>@schedule.StartTime.ToString(@"hh\:mm") - @schedule.EndTime.ToString(@"hh\:mm")</small>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge @(schedule.MeetingType == "Online" ? "bg-info" : "bg-secondary")">
                                            <i class="bi @(schedule.MeetingType == "Online" ? "bi-camera-video" : "bi-geo-alt") me-1"></i>
                                            @schedule.MeetingType
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge @schedule.StatusBadgeClass">
                                            @schedule.StatusDisplay
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="ScheduleDetails" asp-route-id="@schedule.Id"
                                           class="btn btn-sm btn-primary">
                                            <i class="bi bi-eye me-1"></i>Chi tiết
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-calendar-x text-muted icon-size-3xl"></i>
                <h5 class="text-muted mt-3 mb-2">Chưa có lịch trao đổi nào</h5>
                <p class="text-muted mb-0">
                    Các lịch trao đổi do nhà trường tạo sẽ hiển thị tại đây.<br>
                    Vui lòng theo dõi để cập nhật thông tin mới nhất.
                </p>
            </div>
        </div>
    }
</div>

<style>
    .table tbody tr:hover {
        background-color: rgba(0, 123, 255, 0.05);
    }
</style>