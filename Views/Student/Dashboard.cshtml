@model Webgiasu.Models.ViewModels.StudentDashboardViewModel
@{
    ViewData["Title"] = "Trang chủ - Học sinh";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<div class="dashboard-container">
    <!-- Page Header -->
    <div class="page-header d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div class="mb-2 mb-md-0">
            <h5 class="fw-bold mb-1 text-dark">
                <i class="bi bi-house-door text-primary me-2"></i>Trang chủ Học sinh
            </h5>
            <p class="text-muted mb-0 small">Quản lý bài toán và theo dõi tiến độ học tập</p>
        </div>
        <a asp-action="CreateProblem" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Đăng bài mới
        </a>
    </div>

    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card stat-card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 small text-uppercase fw-semibold">Tổng bài</p>
                            <h3 class="fw-bold mb-0 text-primary">@Model.MyProblems.Count</h3>
                            <small class="text-muted">Đã đăng</small>
                        </div>
                        <div class="stat-icon bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center icon-wrapper-lg">
                            <i class="bi bi-file-text text-primary fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card stat-card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 small text-uppercase fw-semibold">Hoàn thành</p>
                            <h3 class="fw-bold mb-0 text-success">@Model.MyProblems.Count(p => p.Status == Webgiasu.Models.ProblemStatus.Solved)</h3>
                            <small class="text-muted">Đã giải</small>
                        </div>
                        <div class="stat-icon bg-success bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center icon-wrapper-lg">
                            <i class="bi bi-check-circle text-success fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card stat-card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 small text-uppercase fw-semibold">Đang xử lý</p>
                            <h3 class="fw-bold mb-0 text-warning">@Model.MyProblems.Count(p => p.Status == Webgiasu.Models.ProblemStatus.InProgress)</h3>
                            <small class="text-muted">Đang giải</small>
                        </div>
                        <div class="stat-icon bg-warning bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center icon-wrapper-lg">
                            <i class="bi bi-hourglass-split text-warning fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card stat-card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 small text-uppercase fw-semibold">Thanh toán</p>
                            <h3 class="fw-bold mb-0 text-info">@Model.Payments.Count(p => p.Status == Webgiasu.Models.PaymentStatus.Pending)</h3>
                            <small class="text-muted">Chờ xử lý</small>
                        </div>
                        <div class="stat-icon bg-info bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center icon-wrapper-lg">
                            <i class="bi bi-credit-card text-info fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Problems List -->
    <div class="card border-0 shadow-sm">
        <div class="card-header py-3 bg-gradient-primary">
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2">
                <div>
                    <h6 class="mb-0 fw-bold text-white">
                        <i class="bi bi-list-ul me-2"></i>Danh sách bài toán của bạn
                    </h6>
                </div>
                <div class="d-flex gap-2 align-items-center align-self-end align-self-sm-auto mt-2 mt-sm-0">
                    <span class="badge bg-white text-primary">@Model.MyProblems.Count bài</span>
                    <a asp-action="MyProblems" class="btn btn-sm btn-light">
                        Xem tất cả <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
        </div>
        <div class="card-body p-0">
            @if (Model.MyProblems.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">ID</th>
                                <th>Tiêu đề</th>
                                <th>Môn học</th>
                                <th>Cấp học</th>
                                <th>Ngày đăng</th>
                                <th>Trạng thái</th>
                                <th>Giá</th>
                                <th class="text-center pe-3">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var problem in Model.MyProblems.OrderByDescending(p => p.CreatedDate).Take(10))
                            {
                                var statusClass = problem.Status switch
                                {
                                    Webgiasu.Models.ProblemStatus.WaitingForTutor => "warning",
                                    Webgiasu.Models.ProblemStatus.InProgress => "info",
                                    Webgiasu.Models.ProblemStatus.Solved => "success",
                                    _ => "secondary"
                                };
                                var statusText = problem.Status switch
                                {
                                    Webgiasu.Models.ProblemStatus.WaitingForTutor => "Chờ Mentor",
                                    Webgiasu.Models.ProblemStatus.InProgress => "Đang giải",
                                    Webgiasu.Models.ProblemStatus.Solved => "Đã giải",
                                    _ => "Khác"
                                };

                                // ✅ EDUCATION LEVEL DISPLAY
                                var levelBadgeClass = problem.Difficulty switch
                                {
                                    Webgiasu.Models.DifficultyLevel.TieuHoc => "primary",
                                    Webgiasu.Models.DifficultyLevel.THCS => "info",
                                    Webgiasu.Models.DifficultyLevel.THPT => "warning",
                                    Webgiasu.Models.DifficultyLevel.DaiHoc => "success",
                                    _ => "secondary"
                                };

                                var levelText = problem.Difficulty switch
                                {
                                    Webgiasu.Models.DifficultyLevel.TieuHoc => "Tiểu học",
                                    Webgiasu.Models.DifficultyLevel.THCS => "THCS",
                                    Webgiasu.Models.DifficultyLevel.THPT => "THPT",
                                    Webgiasu.Models.DifficultyLevel.DaiHoc => "Đại học",
                                    _ => "N/A"
                                };

                                <tr>
                                    <td class="ps-3 fw-bold text-primary">#@problem.Id</td>
                                    <td>
                                        <div class="fw-semibold text-truncate" style="max-width: 250px;" title="@problem.Title">
                                            @problem.Title
                                        </div>
                                    </td>
                                    <td><span class="badge bg-secondary">@problem.Type</span></td>
                                    <td>
                                        <span class="badge bg-@levelBadgeClass">@levelText</span>
                                    </td>
                                    <td>
                                        <small class="text-muted">
                                            <i class="bi bi-calendar3 me-1"></i>@problem.CreatedDate.ToString("dd/MM/yyyy")
                                        </small>
                                    </td>
                                    <td>
                                        <span class="badge bg-@statusClass">
                                            @if (problem.Status == Webgiasu.Models.ProblemStatus.WaitingForTutor)
                                            {
                                                <i class="bi bi-hourglass-split me-1"></i>
                                            }
                                            else if (problem.Status == Webgiasu.Models.ProblemStatus.InProgress)
                                            {
                                                <i class="bi bi-gear-fill me-1"></i>
                                            }
                                            else if (problem.Status == Webgiasu.Models.ProblemStatus.Solved)
                                            {
                                                <i class="bi bi-check-circle-fill me-1"></i>
                                            }
                                            @statusText
                                        </span>
                                    </td>
                                    <td>
                                        <span class="fw-bold text-success">
                                            <i class="bi bi-currency-dollar"></i>@problem.Price.ToString("N0")đ
                                        </span>
                                    </td>
                                    <td class="text-center pe-3">
                                        <div class="btn-group" role="group">
                                            <a asp-action="ProblemDetails" asp-route-id="@problem.Id" 
                                               class="btn btn-sm btn-outline-primary" 
                                               title="Xem chi tiết">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            @if (problem.Status == Webgiasu.Models.ProblemStatus.WaitingForTutor)
                                            {
                                                <a asp-action="EditProblem" asp-route-id="@problem.Id" 
                                                   class="btn btn-sm btn-outline-warning" 
                                                   title="Chỉnh sửa">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                
                @if (Model.MyProblems.Count > 10)
                {
                    <div class="card-footer bg-light text-center py-3">
                        <a asp-action="MyProblems" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-arrow-right-circle me-1"></i>Xem tất cả @Model.MyProblems.Count bài toán
                        </a>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <div class="mb-4">
                        <i class="bi bi-inbox text-muted empty-state-icon"></i>
                    </div>
                    <h5 class="text-muted mb-2">Chưa có bài toán nào</h5>
                    <p class="text-muted small mb-4">Đăng bài toán đầu tiên để nhận hỗ trợ từ Mentor</p>
                    <a asp-action="CreateProblem" class="btn btn-primary">
                        <i class="bi bi-plus-circle me-1"></i> Đăng bài ngay
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- Quick Actions -->
    @if (Model.MyProblems.Any())
    {
        <div class="row g-4 mt-4">
            <div class="col-md-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <h6 class="fw-bold mb-3">
                            <i class="bi bi-lightning-charge text-warning me-2"></i>Thao tác nhanh
                        </h6>
                        <div class="d-grid gap-2">
                            <a asp-action="CreateProblem" class="btn btn-outline-primary">
                                <i class="bi bi-plus-circle me-1"></i>Đăng bài toán mới
                            </a>
                            <a asp-action="Payments" class="btn btn-outline-success">
                                <i class="bi bi-credit-card me-1"></i>Xem thanh toán
                            </a>
                            <a asp-action="BrowseTutors" class="btn btn-outline-info">
                                <i class="bi bi-mortarboard me-1"></i>Tìm Mentor
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-md-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <h6 class="fw-bold mb-3">
                            <i class="bi bi-info-circle text-info me-2"></i>Hướng dẫn
                        </h6>
                        <ul class="list-unstyled mb-0 small">
                            <li class="mb-2">
                                <i class="bi bi-check-circle text-success me-2"></i>
                                Chọn cấp học phù hợp với bài toán
                            </li>
                            <li class="mb-2">
                                <i class="bi bi-check-circle text-success me-2"></i>
                                Mô tả chi tiết để Mentor hiểu rõ yêu cầu
                            </li>
                            <li class="mb-2">
                                <i class="bi bi-check-circle text-success me-2"></i>
                                Đặt deadline hợp lý
                            </li>
                            <li class="mb-2">
                                <i class="bi bi-check-circle text-success me-2"></i>
                                Thanh toán sau khi nhận lời giải
                            </li>
                            <li>
                                <i class="bi bi-check-circle text-success me-2"></i>
                                Đánh giá Mentor sau khi hoàn thành
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

