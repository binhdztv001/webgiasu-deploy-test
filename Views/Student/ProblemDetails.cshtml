@model Webgiasu.Models.ViewModels.ProblemDetailsViewModel
@inject Webgiasu.Services.IPaymentService PaymentService
@inject Webgiasu.Services.IProblemGroupService ProblemGroupService
@{
    ViewData["Title"] = "Chi tiết bài toán";
    Layout = "_StudentLayout";

    // Lấy userId hiện tại
    var userId = Context.Session.GetInt32("UserId") ?? 0;

    // Kiểm tra xem bài toán này có phải là bài toán nhóm không
    var group = Model.Group ?? ProblemGroupService.GetGroupByProblemId(Model.Problem.Id);
    var isGroupProblem = group != null;

    // Nếu là bài toán nhóm, lấy thông tin member và payment
    ProblemGroupMember? currentMember = null;
    GroupPayment? groupPayment = null;
    if (isGroupProblem && group != null)
    {
        currentMember = group.Members.FirstOrDefault(m => m.UserId == userId);
        if (currentMember != null)
        {
            groupPayment = PaymentService.GetGroupPaymentByMemberId(currentMember.Id);
        }
    }

    var canEdit = Model.Problem.StudentId == userId &&
                  Model.Problem.Status == Webgiasu.Models.ProblemStatus.WaitingForTutor;

    // ✅ EDUCATION LEVEL DISPLAY
    var levelBadgeClass = Model.Problem.Difficulty switch
    {
        Webgiasu.Models.DifficultyLevel.TieuHoc => "primary",
        Webgiasu.Models.DifficultyLevel.THCS => "info",
        Webgiasu.Models.DifficultyLevel.THPT => "warning",
        Webgiasu.Models.DifficultyLevel.DaiHoc => "success",
        _ => "secondary"
    };

    var levelText = Model.Problem.Difficulty switch
    {
        Webgiasu.Models.DifficultyLevel.TieuHoc => "Tiểu học",
        Webgiasu.Models.DifficultyLevel.THCS => "THCS",
        Webgiasu.Models.DifficultyLevel.THPT => "THPT",
        Webgiasu.Models.DifficultyLevel.DaiHoc => "Đại học",
        _ => "N/A"
    };

    var levelIcon = Model.Problem.Difficulty switch
    {
        Webgiasu.Models.DifficultyLevel.TieuHoc => "1-circle",
        Webgiasu.Models.DifficultyLevel.THCS => "2-circle",
        Webgiasu.Models.DifficultyLevel.THPT => "3-circle",
        Webgiasu.Models.DifficultyLevel.DaiHoc => "mortarboard",
        _ => "question-circle"
    };
}

<div>
    <!-- Page Header -->
    <div class="page-header d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h5 class="fw-bold mb-1 text-dark">
                <i class="bi bi-file-text text-primary me-2"></i>Chi tiết bài toán #@Model.Problem.Id
                @if (isGroupProblem)
                {
                    <span class="badge bg-success ms-2">
                        <i class="bi bi-people-fill me-1"></i>Nhóm
                    </span>
                }
            </h5>
            <p class="text-muted mb-0 small">Xem thông tin và lời giải bài toán</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            @if (canEdit)
            {
                <a asp-action="EditProblem" asp-route-id="@Model.Problem.Id"
                   class="btn btn-warning">
                    <i class="bi bi-pencil-square me-1"></i> Sửa
                </a>
                <button type="button" class="btn btn-danger"
                        onclick="confirmDelete(@Model.Problem.Id)">
                    <i class="bi bi-trash me-1"></i> Xóa
                </button>
            }
            <a asp-action="MyProblems" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Quay lại
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <!-- Card thông tin bài toán -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-file-text me-2"></i>Thông tin bài toán</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong><i class="bi bi-hash"></i> Mã bài:</strong> #@Model.Problem.Id
                        </div>
                        <div class="col-md-6 text-end">
                            @{
                                var statusClass = Model.Problem.Status switch
                                {
                                    Webgiasu.Models.ProblemStatus.WaitingForTutor => "warning",
                                    Webgiasu.Models.ProblemStatus.InProgress => "info",
                                    Webgiasu.Models.ProblemStatus.Solved => "success",
                                    _ => "secondary"
                                };
                                var statusText = Model.Problem.Status switch
                                {
                                    Webgiasu.Models.ProblemStatus.WaitingForTutor => "Chờ Mentor",
                                    Webgiasu.Models.ProblemStatus.InProgress => "Đang giải",
                                    Webgiasu.Models.ProblemStatus.Solved => "Đã giải",
                                    _ => "Khác"
                                };
                            }
                            <span class="badge bg-@statusClass fs-6">@statusText</span>
                        </div>
                    </div>

                    <h3 class="mb-3">@Model.Problem.Title</h3>

                    <div class="mb-3">
                        <span class="badge bg-secondary me-2">
                            <i class="bi bi-book me-1"></i>@Model.Problem.Type
                        </span>
                        <span class="badge bg-@levelBadgeClass me-2">
                            <i class="bi bi-@levelIcon me-1"></i>@levelText
                        </span>
                        <span class="badge bg-success fs-6">
                            <i class="bi bi-currency-dollar me-1"></i>@Model.Problem.Price.ToString("N0") đ
                        </span>
                    </div>

                    @* Hiển thị thông tin nhóm nếu là bài toán nhóm *@
                    @if (isGroupProblem && group != null)
                    {
                        <div class="alert alert-info">
                            <h6 class="mb-2">
                                <i class="bi bi-people-fill me-1"></i><strong>Nhóm học tập: @group.GroupName</strong>
                            </h6>
                            <div class="row">
                                <div class="col-md-6">
                                    <small>
                                        <i class="bi bi-people me-1"></i>Số thành viên: <strong>@group.Members.Count</strong>
                                    </small>
                                </div>
                                <div class="col-md-6">
                                    <small>
                                        <i class="bi bi-currency-dollar me-1"></i>Phần của bạn: <strong class="text-success">@group.PricePerMember.ToString("N0") đ</strong>
                                    </small>
                                </div>
                            </div>
                            <div class="mt-2">
                                <a asp-action="GroupDetails" asp-route-id="@group.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye me-1"></i> Xem chi tiết nhóm
                                </a>
                            </div>
                        </div>
                    }

                    <hr />

                    <h5 class="mb-3"><i class="bi bi-file-text me-2"></i>Mô tả chi tiết:</h5>
                    <div class="bg-light p-3 rounded border">
                        <div class="problem-description">
                            @Html.Raw(Model.Problem.Description)
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Problem.ImageUrl) && Model.Problem.ImageUrl != "/images/default.jpg")
                    {
                        <div class="mt-4">
                            <h5><i class="bi bi-image me-2"></i>Hình ảnh:</h5>
                            <div class="text-center">
                                <img src="@Model.Problem.ImageUrl" alt="Problem image" class="img-fluid rounded shadow-sm" style="max-height: 400px;" />
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.Problem.AttachmentFile))
                    {
                        <div class="mt-4">
                            <h5><i class="bi bi-paperclip me-2"></i>File đính kèm:</h5>
                            <div class="alert alert-info d-flex align-items-center">
                                <i class="bi bi-file-earmark-pdf fs-3 me-3"></i>
                                <div class="flex-grow-1">
                                    <strong>Tài liệu bài toán</strong>
                                    <p class="mb-0 small text-muted">@Model.Problem.AttachmentFile</p>
                                </div>
                                <a href="@Model.Problem.AttachmentFile" target="_blank" class="btn btn-sm btn-primary">
                                    <i class="bi bi-download me-1"></i>Tải xuống
                                </a>
                            </div>
                        </div>
                    }

                    <hr />

                    <div class="row mt-4">
                        <div class="col-md-6">
                            <div class="border-start border-primary border-4 ps-3 mb-3">
                                <label class="text-muted small mb-1">
                                    <i class="bi bi-calendar-plus me-1"></i>Ngày đăng
                                </label>
                                <h6 class="fw-bold mb-0">@Model.Problem.CreatedDate.ToString("dd/MM/yyyy HH:mm")</h6>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="border-start border-danger border-4 ps-3 mb-3">
                                <label class="text-muted small mb-1">
                                    <i class="bi bi-calendar-event me-1"></i>Deadline
                                </label>
                                <h6 class="fw-bold text-danger mb-0">@Model.Problem.Deadline.ToString("dd/MM/yyyy HH:mm")</h6>
                                @if (Model.Problem.Deadline < DateTime.Now && Model.Problem.Status != Webgiasu.Models.ProblemStatus.Solved)
                                {
                                    <small class="text-danger">
                                        <i class="bi bi-exclamation-triangle me-1"></i>Đã quá hạn
                                    </small>
                                }
                                else
                                {
                                    var timeLeft = Model.Problem.Deadline - DateTime.Now;
                                    if (timeLeft.TotalHours > 0 && timeLeft.TotalHours < 24)
                                    {
                                        <small class="text-warning">
                                            <i class="bi bi-clock me-1"></i>Còn @((int)timeLeft.TotalHours) giờ
                                        </small>
                                    }
                                    else if (timeLeft.TotalDays > 0)
                                    {
                                        <small class="text-success">
                                            <i class="bi bi-clock me-1"></i>Còn @((int)timeLeft.TotalDays) ngày
                                        </small>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @if (Model.Solution != null)
            {
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0"><i class="bi bi-check-circle me-2"></i>Lời giải từ Mentor</h5>
                    </div>
                    <div class="card-body">
                        @if (Model.AssignedTutor != null)
                        {
                            <div class="alert alert-success">
                                <i class="bi bi-person-check me-2"></i>
                                <strong>Mentor:</strong> @Model.AssignedTutor.FullName
                            </div>
                        }

                        <h5 class="mb-3">Nội dung lời giải:</h5>
                        <div class="bg-light p-3 rounded border">
                            <div class="solution-content">
                                @Html.Raw(Model.Solution.Content)
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.Solution.FileUrl))
                        {
                            <div class="mt-3 alert alert-info">
                                <i class="bi bi-file-earmark-arrow-down me-2"></i>
                                <strong>File lời giải:</strong>
                                <a href="@Model.Solution.FileUrl" target="_blank" class="alert-link ms-2">
                                    <i class="bi bi-download me-1"></i>Tải xuống
                                </a>
                            </div>
                        }

                        <hr />

                        <div class="d-flex align-items-center text-muted mb-3">
                            <i class="bi bi-clock me-2"></i>
                            <small>Gửi lúc: @Model.Solution.SubmittedDate.ToString("dd/MM/yyyy HH:mm")</small>
                        </div>

                        @* Rating Section *@
                        @if (ViewBag.HasRated == true)
                        {
                            <div class="alert alert-success">
                                <i class="bi bi-check-circle-fill me-2"></i>
                                <strong>Bạn đã đánh giá Mentor cho bài toán này!</strong>
                            </div>
                        }
                        else if (Model.Problem.Status == Webgiasu.Models.ProblemStatus.Solved)
                        {
                            <div class="card border-warning">
                                <div class="card-body bg-warning bg-opacity-10">
                                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                                        <div>
                                            <h5 class="mb-2">
                                                <i class="bi bi-star-fill text-warning me-1"></i>Đánh giá Mentor
                                            </h5>
                                            <p class="mb-0 text-muted small">
                                                Chia sẻ trải nghiệm của bạn để giúp Mentor cải thiện chất lượng dạy học
                                            </p>
                                        </div>
                                        <div>
                                            <a asp-action="RateTutor" asp-route-problemId="@Model.Problem.Id"
                                               class="btn btn-warning">
                                                <i class="bi bi-star me-1"></i>Đánh giá ngay
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else if (Model.Problem.Status == Webgiasu.Models.ProblemStatus.WaitingForTutor)
            {
                <div class="alert alert-warning">
                    <i class="bi bi-hourglass-split me-2"></i>
                    <strong>Trạng thái:</strong> Đang chờ Mentor nhận bài
                </div>
            }
            else if (Model.Problem.Status == Webgiasu.Models.ProblemStatus.InProgress)
            {
                <div class="alert alert-info">
                    <i class="bi bi-gear-fill me-2"></i>
                    <strong>Trạng thái:</strong> Mentor đang giải bài toán
                </div>
            }
        </div>

        <div class="col-lg-4">
            @if (Model.AssignedTutor != null)
            {
                if (ViewBag.IsPremium == true)
                {
                    <!-- CÓ PREMIUM: xem full hồ sơ -->
                    <div class="card shadow-sm mb-3">
                        <div class="card-header bg-success text-white">
                            <h6 class="mb-0">
                                <i class="bi bi-person-check me-2"></i>Mentor phụ trách
                                <span class="badge bg-warning text-dark float-end">
                                    <i class="bi bi-star-fill me-1"></i>Premium
                                </span>
                            </h6>
                        </div>
                        <div class="card-body text-center">
                            <div class="rounded-circle bg-success bg-opacity-10 d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                                <i class="bi bi-mortarboard text-success" style="font-size: 2.5rem;"></i>
                            </div>
                            <h6 class="fw-bold mb-2">@Model.AssignedTutor.FullName</h6>

                            <div class="border-start border-success border-3 ps-3 mb-2 text-start">
                                <small class="text-muted">Email</small>
                                <p class="mb-0 small"><i class="bi bi-envelope me-1"></i>@Model.AssignedTutor.Email</p>
                            </div>

                            <div class="border-start border-success border-3 ps-3 text-start">
                                <small class="text-muted">Số điện thoại</small>
                                <p class="mb-0 small"><i class="bi bi-phone me-1"></i>@Model.AssignedTutor.PhoneNumber</p>
                            </div>

                            @if (Model.AssignedTutor.Level.HasValue)
                            {
                                <div class="mt-3">
                                    <span class="badge bg-@levelBadgeClass">
                                        <i class="bi bi-mortarboard me-1"></i>
                                        @(Model.AssignedTutor.Level.Value switch
                                        {
                                            Webgiasu.Models.EducationLevel.TieuHoc => "Tiểu học",
                                            Webgiasu.Models.EducationLevel.THCS => "THCS",
                                            Webgiasu.Models.EducationLevel.THPT => "THPT",
                                            Webgiasu.Models.EducationLevel.DaiHoc => "Đại học",
                                            _ => "N/A"
                                        })
                        </span>
                    </div>
                                        }
                        </div>
                    </div>
                }
                else
                {
                    <!-- KHÔNG PREMIUM -->
                    <div class="card shadow-sm mb-3 border-warning">
                        <div class="card-header bg-warning text-dark">
                            <h6 class="mb-0">
                                <i class="bi bi-lock-fill me-2"></i>Mentor phụ trách
                            </h6>
                        </div>
                        <div class="card-body text-center">
                            <i class="bi bi-lock text-warning" style="font-size: 3rem;"></i>
                            <h6 class="mt-3 mb-2">Nội dung dành cho Premium</h6>
                            <p class="text-muted small mb-3">
                                Nâng cấp Premium để xem thông tin Mentor và liên hệ trực tiếp
                            </p>
                            <a asp-action="Premium" class="btn btn-warning">
                                <i class="bi bi-star-fill me-1"></i>Nâng cấp Premium
                            </a>
                        </div>
                    </div>
                }
            }

            @* THANH TOÁN - Xử lý cho cả bài toán đơn và nhóm *@
            @if (isGroupProblem && currentMember != null)
            {
                @* THANH TOÁN NHÓM *@
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-warning text-dark">
                        <h6 class="mb-0">
                            <i class="bi bi-credit-card me-2"></i>Thanh toán
                            <span class="badge bg-success float-end">Nhóm</span>
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="text-center mb-3">
                            <i class="bi bi-currency-dollar text-primary" style="font-size: 2rem;"></i>
                            <h4 class="mt-2 mb-0 text-success">@group!.PricePerMember.ToString("N0") đ</h4>
                            <small class="text-muted">Phần của bạn</small>
                        </div>

                        <div class="d-flex justify-content-between mb-3">
                            <span>Trạng thái:</span>
                            @if (groupPayment != null && groupPayment.Status == PaymentStatus.Completed)
                            {
                                <span class="badge bg-success">Đã thanh toán</span>
                            }
                            else if (currentMember.PaymentStatus == GroupPaymentStatus.Paid)
                            {
                                <span class="badge bg-success">Đã thanh toán</span>
                            }
                            else
                            {
                                <span class="badge bg-warning">Chưa thanh toán</span>
                            }
                        </div>

                        @if (groupPayment != null && groupPayment.Status == PaymentStatus.Completed)
                        {
                            <div class="alert alert-success mb-0">
                                <small>
                                    <i class="bi bi-check-circle me-1"></i>
                                    Đã thanh toán lúc: @groupPayment.CompletedDate?.ToString("dd/MM/yyyy HH:mm")
                                </small>
                                @if (!string.IsNullOrEmpty(groupPayment.TransactionId))
                                {
                                    <div class="mt-1">
                                        <small>Mã GD: <code>@groupPayment.TransactionId</code></small>
                                    </div>
                                }
                            </div>
                        }
                        else if (currentMember.PaymentStatus == GroupPaymentStatus.Unpaid)
                        {
                            <form asp-controller="Student" asp-action="ProcessGroupPayment" method="post">
                                <input type="hidden" name="memberId" value="@currentMember.Id" />
                                <div class="d-grid">
                                    <button type="submit" class="btn btn-success">
                                        <i class="bi bi-credit-card me-1"></i>Thanh toán ngay
                                    </button>
                                </div>
                            </form>
                        }
                        else
                        {
                            <div class="alert alert-info mb-0">
                                <small>
                                    <i class="bi bi-info-circle me-1"></i>
                                    Bạn đã thanh toán cho nhóm này
                                </small>
                            </div>
                        }
                    </div>
                </div>
            }
            else if (Model.Payment != null)
            {
                @* THANH TOÁN ĐƠN *@
                <div class="card shadow-sm mb-3">
                    <div class="card-header bg-warning text-dark">
                        <h6 class="mb-0"><i class="bi bi-credit-card me-2"></i>Thanh toán</h6>
                    </div>
                    <div class="card-body">
                        <div class="text-center mb-3">
                            <i class="bi bi-currency-dollar text-primary" style="font-size: 2rem;"></i>
                            <h4 class="mt-2 mb-0 text-success">@Model.Payment.Amount.ToString("N0") đ</h4>
                            <small class="text-muted">Tổng tiền</small>
                        </div>

                        <div class="d-flex justify-content-between mb-3">
                            <span>Trạng thái:</span>
                            @if (Model.Payment.Status == Webgiasu.Models.PaymentStatus.Completed)
                            {
                                <span class="badge bg-success">Đã thanh toán</span>
                            }
                            else
                            {
                                <span class="badge bg-warning">Chưa thanh toán</span>
                            }
                        </div>

                        @if (Model.Payment.Status == Webgiasu.Models.PaymentStatus.Pending)
                        {
                            <form asp-controller="Student" asp-action="ProcessPayment" method="post">
                                <input type="hidden" name="paymentId" value="@Model.Payment.Id" />
                                <div class="d-grid">
                                    <button type="submit" class="btn btn-success">
                                        <i class="bi bi-credit-card me-1"></i>Thanh toán ngay
                                    </button>
                                </div>
                            </form>
                        }
                        else
                        {
                            <div class="alert alert-success mb-0">
                                <small>
                                    <i class="bi bi-check-circle me-1"></i>
                                    Đã thanh toán lúc: @Model.Payment.CompletedDate?.ToString("dd/MM/yyyy HH:mm")
                                </small>
                                @if (!string.IsNullOrEmpty(Model.Payment.TransactionId))
                                {
                                    <div class="mt-1">
                                        <small>Mã GD: <code>@Model.Payment.TransactionId</code></small>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="d-grid gap-2">
                <a asp-action="MyProblems" class="btn btn-outline-primary">
                    <i class="bi bi-arrow-left me-1"></i>Danh sách bài toán
                </a>
                <a asp-action="Dashboard" class="btn btn-outline-secondary">
                    <i class="bi bi-house me-1"></i>Dashboard
                </a>
            </div>
        </div>
    </div>

    <!-- ✅ AI Chat - Full width below the main content -->
    <div class="row mt-4">
        <div class="col-12">
            @await Html.PartialAsync("_AiChatPartial", Model)
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ✅ DELETE CONFIRMATION
        function confirmDelete(problemId) {
            if (confirm('⚠️ Bạn có chắc chắn muốn xóa bài toán này?\n\nLưu ý: Hành động này không thể hoàn tác!')) {
                fetch(`/Student/DeleteProblem/${problemId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert('✅ Đã xóa bài toán thành công!');
                        window.location.href = '/Student/MyProblems';
                    } else {
                        alert('❌ Lỗi: ' + (data.message || 'Không thể xóa bài toán!'));
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('❌ Đã xảy ra lỗi khi xóa bài toán!');
                });
            }
        }
    </script>
}

<style>
    .problem-description, .solution-content {
        line-height: 1.6;
    }

        .problem-description img, .solution-content img {
            max-width: 100%;
            height: auto;
            border-radius: 8px;
            margin: 10px 0;
        }

        .problem-description pre, .solution-content pre {
            background-color: #f8f9fa;
            padding: 15px;
            border-radius: 8px;
            overflow-x: auto;
        }

        .problem-description code, .solution-content code {
            background-color: #e9ecef;
            padding: 2px 6px;
            border-radius: 4px;
            font-size: 0.9em;
        }
</style>