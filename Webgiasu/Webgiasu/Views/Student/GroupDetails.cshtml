@model Webgiasu.Models.ViewModels.GroupDetailsViewModel
@{
    ViewData["Title"] = "Chi tiết nhóm";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<div>
    <!-- Page Header -->
    <div class="page-header d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h5 class="fw-bold mb-1 text-dark">
                <i class="bi bi-people-fill text-success me-2"></i>Chi tiết nhóm
            </h5>
            <p class="text-muted mb-0 small">Quản lý thành viên và mời bạn bè tham gia</p>
        </div>
        <a asp-action="MyGroups" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>

    <div class="row">
        <!-- Left Column: Group Info & Problem -->
        <div class="col-lg-8">
            <!-- Group Info Card -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-gradient-success text-white">
                    <h6 class="mb-0 fw-bold">
                        <i class="bi bi-info-circle me-2"></i>Thông tin nhóm
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="d-flex align-items-center mb-3">
                                <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3">
                                    <i class="bi bi-people-fill text-success fs-4"></i>
                                </div>
                                <div>
                                    <small class="text-muted d-block">Tên nhóm</small>
                                    <h6 class="mb-0 fw-bold">@Model.Group.GroupName</h6>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-center mb-3">
                                <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3">
                                    <i class="bi bi-calendar-check text-primary fs-4"></i>
                                </div>
                                <div>
                                    <small class="text-muted d-block">Ngày tạo</small>
                                    <h6 class="mb-0 fw-bold">@Model.Group.CreatedAt.ToString("dd/MM/yyyy HH:mm")</h6>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-center mb-3">
                                <div class="rounded-circle bg-warning bg-opacity-10 p-3 me-3">
                                    <i class="bi bi-cash-coin text-warning fs-4"></i>
                                </div>
                                <div>
                                    <small class="text-muted d-block">Tổng chi phí</small>
                                    <h6 class="mb-0 fw-bold text-success">@Model.Group.TotalPrice.ToString("N0") đ</h6>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="d-flex align-items-center mb-3">
                                <div class="rounded-circle bg-info bg-opacity-10 p-3 me-3">
                                    <i class="bi bi-person-check text-info fs-4"></i>
                                </div>
                                <div>
                                    <small class="text-muted d-block">Chi phí mỗi người</small>
                                    <h6 class="mb-0 fw-bold text-primary">@Model.PricePerMember.ToString("N0") đ</h6>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Status Badge -->
                    <div class="mt-3 pt-3 border-top">
                        <span class="badge bg-@(Model.Group.Status == ProblemGroupStatus.Open ? "success" : Model.Group.Status == ProblemGroupStatus.InProgress ? "warning" : Model.Group.Status == ProblemGroupStatus.Completed ? "primary" : "secondary") fs-6 px-3 py-2">
                            <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>
                            @(Model.Group.Status == ProblemGroupStatus.Open ? "Đang mở" :
                                                        Model.Group.Status == ProblemGroupStatus.InProgress ? "Đang giải" :
                                                        Model.Group.Status == ProblemGroupStatus.Completed ? "Hoàn thành" : "Đã hủy")
                        </span>
                        <span class="badge bg-secondary fs-6 px-3 py-2 ms-2">
                            <i class="bi bi-people me-1"></i>@Model.Members.Count thành viên
                        </span>
                    </div>
                </div>
            </div>

            <!-- Problem Info Card -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-gradient-primary text-white">
                    <h6 class="mb-0 fw-bold">
                        <i class="bi bi-journal-text me-2"></i>Bài toán chung
                    </h6>
                </div>
                <div class="card-body">
                    <h5 class="fw-bold mb-3">@Model.Problem.Title</h5>
                    <div class="mb-3">
                        <span class="badge bg-primary me-2">
                            <i class="bi bi-book me-1"></i>@Model.Problem.Type
                        </span>
                        <span class="badge bg-warning text-dark me-2">
                            <i class="bi bi-bar-chart me-1"></i>@Model.Problem.Difficulty
                        </span>
                        <span class="badge bg-info">
                            <i class="bi bi-calendar me-1"></i>Deadline: @Model.Problem.Deadline.ToString("dd/MM/yyyy")
                        </span>
                    </div>
                    <div class="border-start border-4 border-primary ps-3 py-2 bg-light rounded">
                        <p class="mb-0 text-muted">@Model.Problem.Description</p>
                    </div>
                    <div class="mt-3">
                        <a asp-action="ProblemDetails" asp-route-id="@Model.Problem.Id" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-eye me-1"></i>Xem chi tiết bài toán
                        </a>
                    </div>
                </div>
            </div>

            <!-- Members List -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom">
                    <h6 class="mb-0 fw-bold">
                        <i class="bi bi-people me-2 text-success"></i>Thành viên (@Model.Members.Count)
                    </h6>
                </div>
                <div class="card-body">
                    @if (Model.Members.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var member in Model.Members)
                            {
                                <div class="list-group-item border-0 px-0">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <div class="d-flex align-items-center">
                                            <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(member.User.FullName)&background=667eea&color=fff&size=50"
                                                 class="rounded-circle me-3" alt="Avatar" width="50" height="50">
                                            <div>
                                                <h6 class="mb-0 fw-bold">
                                                    @member.User.FullName
                                                    @if (member.Role == GroupMemberRole.Owner)
                                                    {
                                                        <span class="badge bg-warning text-dark ms-2">
                                                            <i class="bi bi-star-fill"></i> Trưởng nhóm
                                                        </span>
                                                    }
                                            </h6>
                                            <small class="text-muted">
                                                <i class="bi bi-calendar me-1"></i>Tham gia: @member.JoinedAt.ToString("dd/MM/yyyy")
                                            </small>
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        <span class="badge bg-@(member.PaymentStatus == GroupPaymentStatus.Paid ? "success" : member.PaymentStatus == GroupPaymentStatus.Unpaid ? "warning" : "secondary")">
                                            @(member.PaymentStatus == GroupPaymentStatus.Paid ? "Đã thanh toán" :
                                                                                    member.PaymentStatus == GroupPaymentStatus.Unpaid ? "Chưa thanh toán" : "Hoàn tiền")
                                    </span>
                                    @if (Model.IsOwner && member.Role != GroupMemberRole.Owner)
                                            {
                                                <button class="btn btn-sm btn-outline-danger ms-2" onclick="removeMember(@Model.Group.Id, @member.UserId)">
                                                    <i class="bi bi-x-circle"></i>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-people fs-1 d-block mb-2"></i>
                            <p class="mb-0">Chưa có thành viên nào</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right Column: Invitations -->
        <div class="col-lg-4">
            @if (Model.IsMember)
            {
                <!-- Invite Friends Card -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-gradient-success text-white">
                        <h6 class="mb-0 fw-bold">
                            <i class="bi bi-person-plus-fill me-2"></i>Mời bạn bè
                        </h6>
                    </div>
                    <div class="card-body">
                        @if (Model.AvailableFriendsToInvite.Any())
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var friend in Model.AvailableFriendsToInvite.Take(5))
                                {
                                    <div class="list-group-item px-0 d-flex align-items-center justify-content-between">
                                        <div class="d-flex align-items-center">
                                            <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(friend.FullName)&background=random&size=40"
                                                 class="rounded-circle me-2" alt="Avatar" width="40" height="40">
                                            <div>
                                                <p class="mb-0 fw-semibold small">@friend.FullName</p>
                                            </div>
                                        </div>
                                        <button class="btn btn-sm btn-success" onclick="inviteFriend(@Model.Group.Id, @friend.Id)">
                                            <i class="bi bi-plus-circle"></i>
                                        </button>
                                    </div>
                                }
                            </div>
                            @if (Model.AvailableFriendsToInvite.Count > 5)
                            {
                                <div class="text-center mt-3">
                                    <small class="text-muted">Còn @(Model.AvailableFriendsToInvite.Count - 5) bạn bè khác</small>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-3 text-muted">
                                <i class="bi bi-person-x fs-2 d-block mb-2"></i>
                                <small>Không có bạn bè để mời</small>
                            </div>
                        }
                    </div>
                </div>

                <!-- Pending Invites -->
                @if (Model.PendingInvites.Any())
                {
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-header bg-white border-bottom">
                            <h6 class="mb-0 fw-bold">
                                <i class="bi bi-hourglass-split me-2 text-warning"></i>Lời mời đang chờ (@Model.PendingInvites.Count)
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="list-group list-group-flush">
                                @foreach (var invite in Model.PendingInvites)
                                {
                                    <div class="list-group-item px-0">
                                        <div class="d-flex align-items-center">
                                            <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(invite.InvitedUser.FullName)&background=random&size=40"
                                                 class="rounded-circle me-2" alt="Avatar" width="40" height="40">
                                            <div class="flex-grow-1">
                                                <p class="mb-0 fw-semibold small">@invite.InvitedUser.FullName</p>
                                                <small class="text-muted">@invite.InvitedAt.ToString("dd/MM/yyyy HH:mm")</small>
                                            </div>
                                            <span class="badge bg-warning text-dark">Chờ</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    Bạn không phải thành viên của nhóm này
                </div>
            }

            <!-- Actions Card -->
            @if (Model.IsMember && !Model.IsOwner)
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-body text-center">
                        <button class="btn btn-outline-danger w-100" onclick="leaveGroup(@Model.Group.Id)">
                            <i class="bi bi-box-arrow-left me-1"></i> Rời khỏi nhóm
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
                function inviteFriend(groupId, friendId) {
            console.log('Inviting friend:', { groupId, friendId }); // Debug log

            if (!confirm('Bạn có chắc muốn mời bạn này vào nhóm?')) return;

            fetch('/Student/InviteFriend', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: `groupId=${groupId}&friendId=${friendId}`  // ✅ Change to form data
            })
            .then(res => res.json())
            .then(data => {
                console.log('Response:', data); // Debug log
                if (data.success) {
                    alert(data.message);
                    location.reload();
                } else {
                    alert(data.message);
                }
            })
            .catch(err => {
                console.error('Error:', err);
                alert('Đã xảy ra lỗi: ' + err.message);
            });
        }

        function removeMember(groupId, memberId) {
            if (!confirm('Bạn có chắc muốn xóa thành viên này khỏi nhóm?')) return;

            fetch('/Student/RemoveMember', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ groupId, memberId })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    alert(data.message);
                    location.reload();
                } else {
                    alert(data.message);
                }
            })
            .catch(err => {
                console.error(err);
                alert('Đã xảy ra lỗi!');
            });
        }

        function leaveGroup(groupId) {
            if (!confirm('Bạn có chắc muốn rời khỏi nhóm? Bạn sẽ cần được mời lại để tham gia.')) return;

            fetch('/Student/LeaveGroup', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ groupId })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    alert(data.message);
                    window.location.href = '/Student/MyGroups';
                } else {
                    alert(data.message);
                }
            })
            .catch(err => {
                console.error(err);
                alert('Đã xảy ra lỗi!');
            });
        }
    </script>

    <style>
        .bg-gradient-success {
            background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        }

        .bg-gradient-primary {
            background: linear-gradient(135deg, #007bff 0%, #6610f2 100%);
        }
    </style>
}