@model Webgiasu.Models.ViewModels.CreateProblemViewModel
@{
    ViewData["Title"] = "Đăng bài toán mới";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<div>
    <!-- Page Header -->
    <div class="page-header d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
        <div>
            <h5 class="fw-bold mb-1 text-dark">
                <i class="bi bi-plus-circle text-primary me-2"></i>Đăng bài toán mới
            </h5>
            <p class="text-muted mb-0 small">Điền thông tin bài toán để nhận hỗ trợ từ Mentor</p>
        </div>
        <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm w-sm-auto">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="CreateProblem" method="post" enctype="multipart/form-data" id="problemForm">
                        
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-semibold">
                                <i class="bi bi-pencil text-primary me-1"></i> Tiêu đề bài toán <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Title" class="form-control" placeholder="VD: Giải phương trình bậc 2" required />
                            <small class="text-muted">Tiêu đề ngắn gọn, dễ hiểu</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-semibold">
                                <i class="bi bi-file-text text-primary me-1"></i> Mô tả chi tiết <span class="text-danger">*</span>
                            </label>
                            <textarea asp-for="Description" class="form-control hide-scrollbar" rows="5" placeholder="Mô tả chi tiết bài toán của bạn..." required></textarea>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Type" class="form-label fw-semibold">
                                    <i class="bi bi-book text-primary me-1"></i> Môn học <span class="text-danger">*</span>
                                </label>
                                <select asp-for="Type" class="form-select" required>
                                    <option value="">-- Chọn môn học --</option>
                                    <option value="Toan">Toán</option>
                                    <option value="Ly">Vật lý</option>
                                    <option value="Hoa">Hóa học</option>
                                    <option value="Sinh">Sinh học</option>
                                    <option value="Van">Ngữ văn</option>
                                    <option value="Anh">Tiếng Anh</option>
                                    <option value="Su">Lịch sử</option>
                                    <option value="Dia">Địa lý</option>
                                    <option value="Khac">Khác</option>
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Difficulty" class="form-label fw-semibold">
                                    <i class="bi bi-mortarboard text-primary me-1"></i> Cấp học <span class="text-danger">*</span>
                                </label>
                                <select asp-for="Difficulty" class="form-select" id="educationLevelSelect" required>
                                    <option value="">-- Chọn cấp học --</option>
                                    <option value="0" data-price="30000">Tiểu học (30,000 đ)</option>
                                    <option value="1" data-price="50000">THCS (50,000 đ)</option>
                                    <option value="2" data-price="70000">THPT (70,000 đ)</option>
                                    <option value="3" data-price="100000">Đại học (100,000 đ)</option>
                                </select>
                                <small class="text-muted">Chọn cấp học phù hợp với bài toán</small>
                            </div>
                        </div>

                        <!-- Custom Price Input -->
                        <div class="mb-3 mt-3">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-cash-coin text-success me-1"></i> Giá tiền (tùy chọn)
                            </label>
                            <div class="input-group">
                                <input type="number" id="customPriceInput" name="CustomPrice" class="form-control"
                                       placeholder="Nhập số tiền tùy chỉnh (VNĐ)" min="10000" step="1000" />
                                <span class="input-group-text">đ</span>
                            </div>
                            <small class="text-muted">
                                <i class="bi bi-info-circle me-1"></i>
                                Để trống để sử dụng giá mặc định theo cấp học. Giá tối thiểu: 10,000 đ
                            </small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Deadline" class="form-label fw-semibold">
                                <i class="bi bi-calendar text-primary me-1"></i> Deadline <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Deadline" type="datetime-local" class="form-control" required />
                            <small class="text-muted">Thời hạn bạn cần nhận lời giải</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ImageFile" class="form-label fw-semibold">
                                <i class="bi bi-image text-primary me-1"></i> Hình ảnh bài toán (nếu có)
                            </label>
                            <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
                            <small class="text-muted">Hỗ trợ: JPG, PNG, GIF (Tối đa 5MB)</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="AttachmentFile" class="form-label fw-semibold">
                                <i class="bi bi-paperclip text-primary me-1"></i> Tài liệu bài toán (nếu có)
                            </label>
                            <input asp-for="AttachmentFile"
                                   type="file"
                                   class="form-control"
                                   accept=".pdf,.doc,.docx" />
                            <small class="text-muted">Hỗ trợ: .pdf, .doc, .docx (Tối đa 10MB)</small>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-send me-1"></i> Đăng bài toán
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Price Card -->
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body text-center">
                    <i class="bi bi-currency-dollar text-primary icon-size-xl"></i>
                    <h6 class="mt-2 mb-1">Giá dự kiến</h6>
                    <p class="fs-4 fw-bold text-primary mb-0" id="priceDisplay">-- đ</p>
                    <small class="text-muted" id="priceHint">Chọn cấp học để xem giá</small>
                </div>
            </div>

            <!-- Education Level Info Card -->
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white text-dark border-0">
                    <h6 class="mb-0 fw-bold"><i class="bi bi-info-circle text-info me-2"></i>Bảng giá theo cấp</h6>
                </div>
                <div class="card-body pt-2">
                    <div class="row g-2 text-center">
                        <div class="col-6">
                            <div class="border rounded p-2">
                                <div class="text-primary fw-bold">Tiểu học</div>
                                <div class="small text-muted">30,000 đ</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="border rounded p-2">
                                <div class="text-info fw-bold">THCS</div>
                                <div class="small text-muted">50,000 đ</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="border rounded p-2">
                                <div class="text-warning fw-bold">THPT</div>
                                <div class="small text-muted">70,000 đ</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="border rounded p-2">
                                <div class="text-success fw-bold">Đại học</div>
                                <div class="small text-muted">100,000 đ</div>
                            </div>
                        </div>
                    </div>
                    <div class="alert alert-info mt-3 mb-0 small">
                        <i class="bi bi-lightbulb me-1"></i>
                        Bạn có thể tùy chỉnh giá nếu muốn
                    </div>
                </div>
            </div>

            <!-- Tips Card -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white text-dark border-0">
                    <h6 class="mb-0 fw-bold"><i class="bi bi-lightbulb text-warning me-2"></i>Mẹo hay</h6>
                </div>
                <div class="card-body pt-0">
                    <ul class="list-unstyled mb-0 small">
                        <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Viết tiêu đề rõ ràng</li>
                        <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Mô tả chi tiết yêu cầu</li>
                        <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Đính kèm hình ảnh nếu cần</li>
                        <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Chọn deadline hợp lý</li>
                        <li class="mb-2"><i class="bi bi-check-circle text-success me-2"></i>Chọn cấp học chính xác</li>
                        <li><i class="bi bi-check-circle text-success me-2"></i>Tùy chỉnh giá nếu cần</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const educationLevelSelect = document.getElementById('educationLevelSelect');
        const customPriceInput = document.getElementById('customPriceInput');
        const priceDisplay = document.getElementById('priceDisplay');
        const priceHint = document.getElementById('priceHint');
        const deadlineInput = document.querySelector('input[type="datetime-local"]');

        // Handle education level change
        educationLevelSelect.addEventListener('change', function() {
            const selectedOption = this.options[this.selectedIndex];
            const defaultPrice = selectedOption.getAttribute('data-price');

            if (defaultPrice) {
                const price = parseInt(defaultPrice);
                
                // Only update if custom price is not entered
                if (!customPriceInput.value) {
                    priceDisplay.textContent = price.toLocaleString('vi-VN') + ' đ';
                    priceHint.textContent = 'Giá mặc định theo cấp học';
                }
            } else {
                if (!customPriceInput.value) {
                    priceDisplay.textContent = '-- đ';
                    priceHint.textContent = 'Chọn cấp học để xem giá';
                }
            }
        });

        // Handle custom price input
        customPriceInput.addEventListener('input', function() {
            const customPrice = parseInt(this.value);
            
            if (customPrice && customPrice >= 10000) {
                priceDisplay.textContent = customPrice.toLocaleString('vi-VN') + ' đ';
                priceHint.textContent = 'Giá tùy chỉnh';
            } else {
                // Revert to default price if custom price is cleared
                const selectedOption = educationLevelSelect.options[educationLevelSelect.selectedIndex];
                const defaultPrice = selectedOption.getAttribute('data-price');
                
                if (defaultPrice) {
                    const price = parseInt(defaultPrice);
                    priceDisplay.textContent = price.toLocaleString('vi-VN') + ' đ';
                    priceHint.textContent = 'Giá mặc định theo cấp học';
                } else {
                    priceDisplay.textContent = '-- đ';
                    priceHint.textContent = 'Chọn cấp học để xem giá';
                }
            }
        });

        // Form validation
        document.querySelector('form').addEventListener('submit', function(e) {
            const educationLevel = educationLevelSelect.value;
            const customPrice = parseInt(customPriceInput.value);

            if (!educationLevel) {
                e.preventDefault();
                alert('Vui lòng chọn cấp học!');
                educationLevelSelect.focus();
                return false;
            }

            // Validate custom price if entered
            if (customPriceInput.value && customPrice < 10000) {
                e.preventDefault();
                alert('Giá tối thiểu là 10,000 đ!');
                customPriceInput.focus();
                return false;
            }
        });

        // Set default deadline (minimum is now)
        const today = new Date();
        today.setMinutes(today.getMinutes() - today.getTimezoneOffset());
        const todayString = today.toISOString().slice(0, 16);
        deadlineInput.min = todayString;
        deadlineInput.value = todayString;
    </script>

    <script src="https://cdn.ckeditor.com/4.22.1/standard/ckeditor.js"></script>
    <script>
        CKEDITOR.replace('Description', {
            height: 300,
            on: {
                instanceReady: function (evt) {
                    // Inject CSS into the CKEditor iframe to hide its scrollbar but keep scroll functionality
                    var head = evt.editor.document.$.head;
                    var style = evt.editor.document.$.createElement('style');
                    style.innerHTML = 'html, body { -ms-overflow-style: none !important; scrollbar-width: none !important; } html::-webkit-scrollbar, body::-webkit-scrollbar { display: none !important; }';
                    head.appendChild(style);
                }
            },
            removePlugins: 'elementspath,save,print,preview,find,flash,forms,iframe,fullscreen,sourcearea,maximize',
            removeButtons: 'Save,NewPage,ExportPdf,Preview,Print,Templates,SelectAll,' +
                           'Form,Checkbox,Radio,TextField,Textarea,Select,Button,ImageButton,HiddenField,' +
                           'Flash,Iframe,Maximize,Source',
            toolbar: [
                { name: 'basicstyles', items: ['Bold', 'Italic', 'Underline', 'Strike'] },
                { name: 'paragraph', items: ['NumberedList', 'BulletedList', '-', 'JustifyLeft', 'JustifyCenter', 'JustifyRight'] },
                { name: 'links', items: ['Link', 'Unlink'] },
                { name: 'insert', items: ['Image', 'Table', 'Mathjax'] },
                { name: 'styles', items: ['Format', 'FontSize'] },
                { name: 'colors', items: ['TextColor', 'BGColor'] }
            ]
        });
        CKEDITOR.config.versionCheck = false;
    </script>
}
