@{
    ViewData["Title"] = "Thống kê - Nhà trường";
    Layout = "~/Views/Shared/_SchoolLayout.cshtml";
}

<div class="dashboard-container">
    <!-- Page Header -->
    <div class="page-header">
        <h2><i class="bi bi-bar-chart-line me-2 text-warning"></i>Thống kê nhà trường</h2>
        <p class="text-muted">Xem báo cáo và phân tích chi tiết</p>
    </div>

    <!-- Overview Stats -->
    <div class="row g-3 mb-4">
        <div class="col-md-6 col-lg-3">
            <div class="card stat-card border-start border-5 border-warning">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small text-uppercase mb-1">Tổng số lớp</div>
                            <h3 class="mb-0 fw-bold text-warning">@ViewBag.TotalClasses</h3>
                        </div>
                        <div class="stat-icon bg-warning bg-opacity-10 text-warning">
                            <i class="bi bi-collection"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card stat-card border-start border-5 border-info">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small text-uppercase mb-1">Học sinh</div>
                            <h3 class="mb-0 fw-bold text-info">@ViewBag.TotalStudents</h3>
                        </div>
                        <div class="stat-icon bg-info bg-opacity-10 text-info">
                            <i class="bi bi-people"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card stat-card border-start border-5 border-success">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small text-uppercase mb-1">Mentor</div>
                            <h3 class="mb-0 fw-bold text-success">@ViewBag.TotalTutors</h3>
                        </div>
                        <div class="stat-icon bg-success bg-opacity-10 text-success">
                            <i class="bi bi-person-badge"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card stat-card border-start border-5 border-danger">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small text-uppercase mb-1">Đang diễn ra</div>
                            <h3 class="mb-0 fw-bold text-danger">@ViewBag.OngoingClasses</h3>
                        </div>
                        <div class="stat-icon bg-danger bg-opacity-10 text-danger">
                            <i class="bi bi-clock-history"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Section -->
    <div class="row g-3 mb-4">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-pie-chart me-2"></i>Phân bố lớp học</h5>
                </div>
                <div class="card-body">
                    <div class="text-center py-5">
                        <i class="bi bi-graph-up fs-1 text-warning mb-3 d-block"></i>
                        <p class="text-muted">Biểu đồ phân bố lớp học theo môn học</p>
                        <small class="text-muted">Chức năng sẽ được cập nhật sau</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-graph-up me-2"></i>Xu hướng tăng trưởng</h5>
                </div>
                <div class="card-body">
                    <div class="text-center py-5">
                        <i class="bi bi-bar-chart fs-1 text-info mb-3 d-block"></i>
                        <p class="text-muted">Biểu đồ tăng trưởng học sinh và lớp học</p>
                        <small class="text-muted">Chức năng sẽ được cập nhật sau</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Detailed Stats -->
    <div class="row g-3">
        <div class="col-lg-4">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="bi bi-check-circle me-2"></i>Lớp đã hoàn thành</h5>
                </div>
                <div class="card-body text-center">
                    <h1 class="display-4 fw-bold text-success mb-0">@ViewBag.CompletedClasses</h1>
                    <p class="text-muted mb-0">Lớp học</p>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-header bg-warning text-white">
                    <h5 class="mb-0"><i class="bi bi-arrow-repeat me-2"></i>Đang diễn ra</h5>
                </div>
                <div class="card-body text-center">
                    <h1 class="display-4 fw-bold text-warning mb-0">@ViewBag.OngoingClasses</h1>
                    <p class="text-muted mb-0">Lớp học</p>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="bi bi-hourglass-split me-2"></i>Sắp bắt đầu</h5>
                </div>
                <div class="card-body text-center">
                    <h1 class="display-4 fw-bold text-info mb-0">0</h1>
                    <p class="text-muted mb-0">Lớp học</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Performance Metrics -->
    <div class="row g-3 mt-2">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-trophy me-2"></i>Hiệu suất hệ thống</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <div class="text-center">
                                <div class="h2 fw-bold text-success mb-2">95%</div>
                                <div class="text-muted small">Tỷ lệ hoàn thành</div>
                                <div class="progress mt-2" style="height: 5px;">
                                    <div class="progress-bar bg-success" style="width: 95%"></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="text-center">
                                <div class="h2 fw-bold text-info mb-2">4.5/5</div>
                                <div class="text-muted small">Đánh giá trung bình</div>
                                <div class="progress mt-2" style="height: 5px;">
                                    <div class="progress-bar bg-info" style="width: 90%"></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="text-center">
                                <div class="h2 fw-bold text-warning mb-2">88%</div>
                                <div class="text-muted small">Sự hài lòng</div>
                                <div class="progress mt-2" style="height: 5px;">
                                    <div class="progress-bar bg-warning" style="width: 88%"></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="text-center">
                                <div class="h2 fw-bold text-danger mb-2">100%</div>
                                <div class="text-muted small">Tham gia</div>
                                <div class="progress mt-2" style="height: 5px;">
                                    <div class="progress-bar bg-danger" style="width: 100%"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
