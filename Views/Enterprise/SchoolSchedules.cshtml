@{
    ViewData["Title"] = "Lịch trao đổi các trường";
    Layout = "~/Views/Shared/_EnterpriseLayout.cshtml";
}

<div class="dashboard-container">
    <!-- Page Header -->
    <div class="page-header d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div class="mb-2 mb-md-0">
            <h5 class="fw-bold mb-1 text-dark">
                <i class="bi bi-calendar-week text-info me-2"></i>Lịch trao đổi các trường
            </h5>
            <p class="text-muted mb-0 small">Theo dõi lịch trao đổi của tất cả trường trong hệ thống</p>
        </div>
        <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>

    <!-- Stats -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card stat-card border-0 shadow-sm">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 small text-uppercase">Tổng lịch trao đổi</p>
                            <h3 class="fw-bold mb-0 text-info">@ViewBag.AllSchedules.Count</h3>
                        </div>
                        <div class="stat-icon bg-info bg-opacity-10 rounded">
                            <i class="bi bi-calendar-week text-info"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Schedules List -->
    <div class="card border-0 shadow-sm">
        <div class="card-header py-3 bg-white border-bottom">
            <h6 class="mb-0 fw-bold text-dark">
                <i class="bi bi-list-ul text-info me-2"></i>Danh sách lịch trao đổi
            </h6>
        </div>
        <div class="card-body p-0">
            @if (ViewBag.AllSchedules != null && ViewBag.AllSchedules.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>STT</th>
                                <th>Tiêu đề</th>
                                <th>Trường</th>
                                <th>Lớp học</th>
                                <th>Môn học</th>
                                <th>Ngày</th>
                                <th>Thời gian</th>
                                <th>Hình thức</th>
                                <th>Trạng thái</th>
                                <th class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var index = 1;
                            }
                            @foreach (var s in ViewBag.AllSchedules)
                            {
                                <tr>
                                    <td class="fw-semibold">@index</td>
                                    <td class="fw-semibold">@s.Title</td>
                                    <td>@s.SchoolName</td>
                                    <td>@s.ClassName</td>
                                    <td><span class="badge bg-info">@s.Subject</span></td>
                                    <td>@s.ScheduleDate.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @s.StartTime.ToString(@"hh\:mm") - @s.EndTime.ToString(@"hh\:mm")
                                    </td>
                                    <td>
                                        @if (s.MeetingType == "Online")
                                        {
                                            <span class="badge bg-primary">
                                                <i class="bi bi-camera-video me-1"></i>Online
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-person-workspace me-1"></i>Offline
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (s.StatusText == "Sắp diễn ra")
                                        {
                                            <span class="badge bg-info">@s.StatusText</span>
                                        }
                                        else if (s.StatusText == "Đang diễn ra")
                                        {
                                            <span class="badge bg-warning">@s.StatusText</span>
                                        }
                                        else if (s.StatusText == "Đã hoàn thành")
                                        {
                                            <span class="badge bg-success">@s.StatusText</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">@s.StatusText</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="ScheduleDetail" asp-route-id="@s.ScheduleId" 
                                           class="btn btn-sm btn-primary" 
                                           title="Xem chi tiết">
                                            <i class="bi bi-eye me-1"></i>Chi tiết
                                        </a>
                                    </td>
                                </tr>
                                index++;
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-5 text-center">
                    <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                    <p class="text-muted mt-3">Chưa có lịch trao đổi nào trong hệ thống</p>
                </div>
            }
        </div>
    </div>
</div>


