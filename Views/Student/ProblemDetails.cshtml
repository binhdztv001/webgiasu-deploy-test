@model Webgiasu.Models.ViewModels.ProblemDetailsViewModel
@inject Webgiasu.Services.IPaymentService PaymentService
@inject Webgiasu.Services.IProblemGroupService ProblemGroupService
@{
    ViewData["Title"] = "Chi tiết bài toán";
    Layout = "_StudentLayout";
    
    // Lấy userId hiện tại
    var userId = Context.Session.GetInt32("UserId") ?? 0;
    
    // Kiểm tra xem bài toán này có phải là bài toán nhóm không
    var group = Model.Group ?? ProblemGroupService.GetGroupByProblemId(Model.Problem.Id);
    var isGroupProblem = group != null;
    
    // Nếu là bài toán nhóm, lấy thông tin member và payment
    ProblemGroupMember? currentMember = null;
    GroupPayment? groupPayment = null;
    if (isGroupProblem && group != null)
    {
        currentMember = group.Members.FirstOrDefault(m => m.UserId == userId);
        if (currentMember != null)
        {
            groupPayment = PaymentService.GetGroupPaymentByMemberId(currentMember.Id);
        }
    }
}

<div>
    <div>
        <div class="page-header d-flex flex-wrap justify-content-between align-items-center">
            <div>
                <h5 class="fw-bold mb-1 text-dark">
                    <i class="bi bi-file-text text-primary me-2"></i>Chi tiết bài toán #@Model.Problem.Id
                    @if (isGroupProblem)
                    {
                        <span class="badge bg-success ms-2">
                            <i class="bi bi-people-fill"></i> Nhóm
                        </span>
                    }
                </h5>
                <p class="text-muted mb-0 small">Xem thông tin và lời giải bài toán</p>
            </div>
            <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Quay lại
            </a>
        </div>

        <div class="row">
            <div class="col-lg-8">
                <!-- Card thông tin bài toán -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-primary text-white">
                        <h4 class="mb-0"><i class="bi bi-file-text"></i> Thông tin bài toán</h4>
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <strong><i class="bi bi-hash"></i> Mã bài:</strong> #@Model.Problem.Id
                            </div>
                            <div class="col-md-6 text-end">
                                @{
                                    var statusClass = Model.Problem.Status switch
                                    {
                                        Webgiasu.Models.ProblemStatus.WaitingForTutor => "warning",
                                        Webgiasu.Models.ProblemStatus.InProgress => "info",
                                        Webgiasu.Models.ProblemStatus.Solved => "success",
                                        _ => "secondary"
                                    };
                                    var statusText = Model.Problem.Status switch
                                    {
                                        Webgiasu.Models.ProblemStatus.WaitingForTutor => "Chờ gia sư",
                                        Webgiasu.Models.ProblemStatus.InProgress => "Đang giải",
                                        Webgiasu.Models.ProblemStatus.Solved => "Đã giải",
                                        _ => "Khác"
                                    };
                                }
                                <span class="badge bg-@statusClass fs-6">@statusText</span>
                            </div>
                        </div>

                        <h3 class="mb-3">@Model.Problem.Title</h3>

                        <div class="mb-3">
                            <span class="badge bg-secondary me-2"><i class="bi bi-book"></i> @Model.Problem.Type</span>
                            @if (Model.Problem.Difficulty == Webgiasu.Models.DifficultyLevel.Easy)
                            {
                                <span class="badge bg-success me-2"><i class="bi bi-bar-chart"></i> Dễ</span>
                            }
                            else if (Model.Problem.Difficulty == Webgiasu.Models.DifficultyLevel.Medium)
                            {
                                <span class="badge bg-warning me-2"><i class="bi bi-bar-chart"></i> Trung bình</span>
                            }
                            else
                            {
                                <span class="badge bg-danger me-2"><i class="bi bi-bar-chart"></i> Khó</span>
                            }
                            <span class="badge bg-info"><i class="bi bi-currency-dollar"></i> @Model.Problem.Price.ToString("N0") đ</span>
                        </div>

                        @* Hiển thị thông tin nhóm nếu là bài toán nhóm *@
                        @if (isGroupProblem && group != null)
                        {
                            <div class="alert alert-info">
                                <h6 class="mb-2">
                                    <i class="bi bi-people-fill me-1"></i><strong>Nhóm học tập: @group.GroupName</strong>
                                </h6>
                                <div class="row">
                                    <div class="col-md-6">
                                        <small>
                                            <i class="bi bi-people me-1"></i>Số thành viên: <strong>@group.Members.Count</strong>
                                        </small>
                                    </div>
                                    <div class="col-md-6">
                                        <small>
                                            <i class="bi bi-currency-dollar me-1"></i>Phần của bạn: <strong class="text-success">@group.PricePerMember.ToString("N0") đ</strong>
                                        </small>
                                    </div>
                                </div>
                                <div class="mt-2">
                                    <a asp-action="GroupDetails" asp-route-id="@group.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye me-1"></i> Xem chi tiết nhóm
                                    </a>
                                </div>
                            </div>
                        }

                        <hr />

                        <h5 class="mb-3"><i class="bi bi-file-text"></i> Mô tả chi tiết:</h5>
                        <p class="text-justify">@Html.Raw(Model.Problem.Description)</p>

                        @if (!string.IsNullOrEmpty(Model.Problem.ImageUrl) && Model.Problem.ImageUrl != "/images/default.jpg")
                        {
                            <div class="mt-3">
                                <h5><i class="bi bi-image"></i> Hình ảnh:</h5>
                                <img src="@Model.Problem.ImageUrl" alt="Problem image" class="img-fluid rounded" style="max-height: 400px;" />
                            </div>
                        }

                        <hr />

                        <div class="row mt-3">
                            <div class="col-md-6">
                                <p class="mb-1"><strong><i class="bi bi-calendar-plus"></i> Ngày đăng:</strong></p>
                                <p>@Model.Problem.CreatedDate.ToString("dd/MM/yyyy HH:mm")</p>
                            </div>
                            <div class="col-md-6">
                                <p class="mb-1"><strong><i class="bi bi-calendar-event"></i> Deadline:</strong></p>
                                <p class="text-danger fw-bold">@Model.Problem.Deadline.ToString("dd/MM/yyyy HH:mm")</p>
                            </div>
                        </div>
                    </div>
                </div>

                @if (Model.Solution != null)
                {
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-success text-white">
                            <h4 class="mb-0"><i class="bi bi-check-circle"></i> Lời giải từ gia sư</h4>
                        </div>
                        <div class="card-body">
                            <div class="alert alert-success">
                                <i class="bi bi-person-check"></i>
                                <strong>Gia sư:</strong> @Model.AssignedTutor?.FullName
                            </div>

                            <h5 class="mb-3">Nội dung lời giải:</h5>
                            <div class="bg-light p-3 rounded">
                                <pre class="mb-0" style="white-space: pre-wrap;">@Model.Solution.Content</pre>
                            </div>

                            @if (!string.IsNullOrEmpty(Model.Solution.FileUrl))
                            {
                                <div class="mt-3">
                                    <a href="@Model.Solution.FileUrl" class="btn btn-outline-primary" target="_blank">
                                        <i class="bi bi-download"></i> Tải file lời giải
                                    </a>
                                </div>
                            }

                            <hr />

                            <div class="mb-2">
                                <small class="text-muted">
                                    <i class="bi bi-clock"></i> Gửi lúc: @Model.Solution.SubmittedDate.ToString("dd/MM/yyyy HH:mm")
                                </small>
                            </div>

                            @* Rating Section *@
                            @if (ViewBag.HasRated == true)
                            {
                                <div class="alert alert-success mt-3">
                                    <i class="bi bi-check-circle-fill"></i>
                                    <strong>Bạn đã đánh giá gia sư cho bài toán này!</strong>
                                </div>
                            }
                            else if (Model.Problem.Status == Webgiasu.Models.ProblemStatus.Solved)
                            {
                                <div class="card border-warning mt-4">
                                    <div class="card-body bg-light">
                                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                                            <div>
                                                <h5 class="mb-2">
                                                    <i class="bi bi-star-fill text-warning"></i> Đánh giá Gia sư
                                                </h5>
                                                <p class="mb-0 text-muted">
                                                    Chia sẻ trải nghiệm của bạn để giúp gia sư cải thiện chất lượng dạy học
                                                </p>
                                            </div>
                                            <div>
                                                <a asp-action="RateTutor" asp-route-problemId="@Model.Problem.Id"
                                                   class="btn btn-warning btn-lg">
                                                    <i class="bi bi-star"></i> Đánh giá ngay
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="col-lg-4">
                @if (Model.AssignedTutor != null)
                {
                    if (ViewBag.IsPremium == true)
                    {
                        <!-- CÓ PREMIUM: xem full hồ sơ -->
                        <div class="card shadow-sm mb-4">
                            <div class="card-header bg-info text-white">
                                <h5 class="mb-0">
                                    <i class="bi bi-person-check"></i> Gia sư phụ trách (Premium)
                                </h5>
                            </div>
                            <div class="card-body text-center">
                                <i class="bi bi-person-circle text-info" style="font-size: 4rem;"></i>
                                <h5 class="mt-3">@Model.AssignedTutor.FullName</h5>
                                <p class="text-muted mb-2">
                                    <i class="bi bi-envelope"></i> @Model.AssignedTutor.Email<br />
                                    <i class="bi bi-phone"></i> @Model.AssignedTutor.PhoneNumber
                                </p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- KHÔNG PREMIUM -->
                        <div class="card shadow-sm mb-4 border-warning">
                            <div class="card-header bg-warning text-dark">
                                <h5 class="mb-0">
                                    <i class="bi bi-lock-fill"></i> Gia sư phụ trách
                                </h5>
                            </div>
                            <div class="card-body text-center">
                                <i class="bi bi-lock text-warning" style="font-size: 3rem;"></i>
                                <h6 class="mt-3">Nội dung dành cho Premium</h6>
                                <p class="text-muted small">
                                    Nâng cấp Premium để xem thông tin gia sư và liên hệ trực tiếp
                                </p>
                                <a asp-action="Premium" class="btn btn-warning btn-sm">
                                    ⭐ Nâng cấp Premium
                                </a>
                            </div>
                        </div>
                    }
                }

                @* THANH TOÁN - Xử lý cho cả bài toán đơn và nhóm *@
                @if (isGroupProblem && currentMember != null)
                {
                    @* THANH TOÁN NHÓM *@
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-warning text-dark">
                            <h5 class="mb-0">
                                <i class="bi bi-credit-card"></i> Thanh toán
                                <span class="badge bg-success float-end">Nhóm</span>
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="text-center mb-3">
                                <i class="bi bi-currency-dollar text-primary" style="font-size: 2rem;"></i>
                                <h4 class="mt-2 mb-0 text-success">@group!.PricePerMember.ToString("N0") đ</h4>
                                <small class="text-muted">Phần của bạn</small>
                            </div>

                            <div class="d-flex justify-content-between mb-3">
                                <span>Trạng thái:</span>
                                @if (groupPayment != null && groupPayment.Status == PaymentStatus.Completed)
                                {
                                    <span class="badge bg-success">Đã thanh toán</span>
                                }
                                else if (currentMember.PaymentStatus == GroupPaymentStatus.Paid)
                                {
                                    <span class="badge bg-success">Đã thanh toán</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">Chưa thanh toán</span>
                                }
                            </div>

                            @if (groupPayment != null && groupPayment.Status == PaymentStatus.Completed)
                            {
                                <div class="alert alert-success mb-0">
                                    <small>
                                        <i class="bi bi-check-circle"></i>
                                        Đã thanh toán lúc: @groupPayment.CompletedDate?.ToString("dd/MM/yyyy HH:mm")
                                    </small>
                                    @if (!string.IsNullOrEmpty(groupPayment.TransactionId))
                                    {
                                        <div class="mt-1">
                                            <small>Mã GD: <code>@groupPayment.TransactionId</code></small>
                                        </div>
                                    }
                                </div>
                            }
                            else if (currentMember.PaymentStatus == GroupPaymentStatus.Unpaid)
                            {
                                <form asp-controller="Student" asp-action="ProcessGroupPayment" method="post">
                                    <input type="hidden" name="memberId" value="@currentMember.Id" />
                                    <div class="d-grid">
                                        <button type="submit" class="btn btn-success">
                                            <i class="bi bi-credit-card"></i> Thanh toán ngay
                                        </button>
                                    </div>
                                </form>
                            }
                            else
                            {
                                <div class="alert alert-info mb-0">
                                    <small>
                                        <i class="bi bi-info-circle"></i>
                                        Bạn đã thanh toán cho nhóm này
                                    </small>
                                </div>
                            }
                        </div>
                    </div>
                }
                else if (Model.Payment != null)
                {
                    @* THANH TOÁN ĐƠN (code cũ) *@
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-warning text-dark">
                            <h5 class="mb-0"><i class="bi bi-credit-card"></i> Thanh toán</h5>
                        </div>
                        <div class="card-body">
                            <div class="d-flex justify-content-between mb-2">
                                <span>Số tiền:</span>
                                <strong class="text-success fs-5">@Model.Payment.Amount.ToString("N0") đ</strong>
                            </div>
                            <div class="d-flex justify-content-between mb-3">
                                <span>Trạng thái:</span>
                                @if (Model.Payment.Status == Webgiasu.Models.PaymentStatus.Completed)
                                {
                                    <span class="badge bg-success">Đã thanh toán</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">Chưa thanh toán</span>
                                }
                            </div>

                            @if (Model.Payment.Status == Webgiasu.Models.PaymentStatus.Pending)
                            {
                                <form asp-controller="Student" asp-action="ProcessPayment" method="post">
                                    <input type="hidden" name="paymentId" value="@Model.Payment.Id" />
                                    <div class="d-grid">
                                        <button type="submit" class="btn btn-success">
                                            <i class="bi bi-credit-card"></i> Thanh toán ngay
                                        </button>
                                    </div>
                                </form>
                            }
                            else
                            {
                                <div class="alert alert-success mb-0">
                                    <small>
                                        <i class="bi bi-check-circle"></i>
                                        Đã thanh toán lúc: @Model.Payment.CompletedDate?.ToString("dd/MM/yyyy HH:mm")
                                    </small>
                                </div>
                            }
                        </div>
                    </div>
                }

                <div class="d-grid">
                    <a asp-action="Dashboard" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Quay lại Dashboard
                    </a>
                </div>
            </div>

            <!-- ✅ AI Chat - Full width below the main content -->
            <div class="row mt-4">
                <div class="col-12">
                    @await Html.PartialAsync("_AiChatPartial", Model)
                </div>
            </div>
        </div>
    </div>
</div>
