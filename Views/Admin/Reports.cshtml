@{
    ViewData["Title"] = "Báo cáo vi phạm";
    Layout = "_AdminLayout";
}

<div>
    <div class="page-header mb-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <h2 class="fw-bold mb-1">
                    <i class="bi bi-flag text-danger"></i> Báo cáo vi phạm
                </h2>
                <p class="text-muted mb-0">Quản lý các báo cáo vi phạm từ người dùng</p>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-filter"></i> Lọc
                </button>
                <button class="btn btn-outline-success btn-sm">
                    <i class="bi bi-file-earmark-excel"></i> Xuất Excel
                </button>
            </div>
        </div>
    </div>

    <div class="row g-2 g-md-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <div class="bg-danger bg-opacity-10 rounded p-2 p-md-3">
                                <i class="bi bi-exclamation-triangle text-danger fs-4 fs-md-3"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-2 ms-md-3">
                            <h6 class="text-muted mb-1 small">Chờ xử lý</h6>
                            <h4 class="fw-bold mb-0 text-danger">5</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <div class="bg-warning bg-opacity-10 rounded p-2 p-md-3">
                                <i class="bi bi-hourglass-split text-warning fs-4 fs-md-3"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-2 ms-md-3">
                            <h6 class="text-muted mb-1 small">Đang xử lý</h6>
                            <h4 class="fw-bold mb-0 text-warning">3</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <div class="bg-success bg-opacity-10 rounded p-2 p-md-3">
                                <i class="bi bi-check-circle text-success fs-4 fs-md-3"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-2 ms-md-3">
                            <h6 class="text-muted mb-1 small">Đã xử lý</h6>
                            <h4 class="fw-bold mb-0 text-success">24</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <div class="bg-secondary bg-opacity-10 rounded p-2 p-md-3">
                                <i class="bi bi-x-circle text-secondary fs-4 fs-md-3"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-2 ms-md-3">
                            <h6 class="text-muted mb-1 small">Từ chối</h6>
                            <h4 class="fw-bold mb-0 text-secondary">7</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Người báo cáo</th>
                            <th>Đối tượng</th>
                            <th>Lý do</th>
                            <th>Mức độ</th>
                            <th>Thời gian</th>
                            <th>Trạng thái</th>
                            <th>Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>#R001</td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <img src="https://ui-avatars.com/api/?name=Nguyen+Van+A&size=32" class="rounded-circle me-2" width="32" height="32">
                                    <span>Nguyễn Văn A</span>
                                </div>
                            </td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <img src="https://ui-avatars.com/api/?name=Tran+Thi+B&size=32" class="rounded-circle me-2" width="32" height="32">
                                    <span>Trần Thị B (Gia sư)</span>
                                </div>
                            </td>
                            <td>Spam, quảng cáo</td>
                            <td><span class="badge bg-danger">Cao</span></td>
                            <td>5 phút trước</td>
                            <td><span class="badge bg-warning">Chờ xử lý</span></td>
                            <td>
                                <button class="btn btn-sm btn-primary me-1" title="Xem chi tiết">
                                    <i class="bi bi-eye"></i>
                                </button>
                                <button class="btn btn-sm btn-success me-1" title="Chấp nhận">
                                    <i class="bi bi-check"></i>
                                </button>
                                <button class="btn btn-sm btn-danger" title="Từ chối">
                                    <i class="bi bi-x"></i>
                                </button>
                            </td>
                        </tr>
                        <tr>
                            <td>#R002</td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <img src="https://ui-avatars.com/api/?name=Le+Van+C&size=32" class="rounded-circle me-2" width="32" height="32">
                                    <span>Lê Văn C</span>
                                </div>
                            </td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <img src="https://ui-avatars.com/api/?name=Pham+Thi+D&size=32" class="rounded-circle me-2" width="32" height="32">
                                    <span>Phạm Thị D (Học sinh)</span>
                                </div>
                            </td>
                            <td>Hành vi không phù hợp</td>
                            <td><span class="badge bg-warning">Trung bình</span></td>
                            <td>1 giờ trước</td>
                            <td><span class="badge bg-info">Đang xử lý</span></td>
                            <td>
                                <button class="btn btn-sm btn-primary me-1">
                                    <i class="bi bi-eye"></i>
                                </button>
                                <button class="btn btn-sm btn-success me-1">
                                    <i class="bi bi-check"></i>
                                </button>
                                <button class="btn btn-sm btn-danger">
                                    <i class="bi bi-x"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <nav class="mt-3">
                <ul class="pagination justify-content-center">
                    <li class="page-item disabled"><a class="page-link" href="#">Trước</a></li>
                    <li class="page-item active"><a class="page-link" href="#">1</a></li>
                    <li class="page-item"><a class="page-link" href="#">2</a></li>
                    <li class="page-item"><a class="page-link" href="#">3</a></li>
                    <li class="page-item"><a class="page-link" href="#">Sau</a></li>
                </ul>
            </nav>
        </div>
    </div>
</div>
