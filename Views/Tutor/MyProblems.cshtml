@model List<Webgiasu.Models.Problem>
@{
    ViewData["Title"] = "Bài toán của tôi";
    Layout = "_TutorLayout";
}

@functions {
    string GetGradeLevelText(Webgiasu.Models.DifficultyLevel level)
    {
        return level switch
        {
            Webgiasu.Models.DifficultyLevel.TieuHoc => "Tiểu học",
            Webgiasu.Models.DifficultyLevel.THCS => "THCS",
            Webgiasu.Models.DifficultyLevel.THPT => "THPT",
            Webgiasu.Models.DifficultyLevel.DaiHoc => "Đại học",
            _ => "N/A"
        };
    }

    string GetGradeLevelBadgeClass(Webgiasu.Models.DifficultyLevel level)
    {
        return level switch
        {
            Webgiasu.Models.DifficultyLevel.TieuHoc => "primary",
            Webgiasu.Models.DifficultyLevel.THCS => "info",
            Webgiasu.Models.DifficultyLevel.THPT => "warning",
            Webgiasu.Models.DifficultyLevel.DaiHoc => "success",
            _ => "secondary"
        };
    }
}

<div>
    <div class="row mb-4">
        <div class="col">
            <h2 class="fw-bold">
                <i class="bi bi-briefcase text-warning"></i> Bài toán của tôi
            </h2>
            <p class="text-muted">Quản lý các bài toán bạn đã nhận</p>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="row g-3 mb-4">
            <div class="col-md-4 ">
                <div class="card text-center shadow-sm card-hover">
                    <div class="card-body">
                        <i class="bi bi-hourglass-split text-warning" style="font-size: 2rem;"></i>
                        <h3 class="mt-2 mb-0">@Model.Count(p => p.Status == Webgiasu.Models.ProblemStatus.InProgress)</h3>
                        <p class="text-muted mb-0">Đang giải</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-center shadow-sm card-hover">
                    <div class="card-body">
                        <i class="bi bi-check-circle text-success" style="font-size: 2rem;"></i>
                        <h3 class="mt-2 mb-0">@Model.Count(p => p.Status == Webgiasu.Models.ProblemStatus.Solved)</h3>
                        <p class="text-muted mb-0">Đã hoàn thành</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-center shadow-sm card-hover">
                    <div class="card-body">
                        <i class="bi bi-cash-stack text-info" style="font-size: 2rem;"></i>
                        <h4 class="mt-2 mb-0">@Model.Sum(p => p.Price).ToString("N0") đ</h4>
                        <p class="text-muted mb-0">Tổng giá trị</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header py-3" style="background: linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 100%);">
                <h5 class="mb-0 text-success"><i class="bi bi-list-ul me-2"></i>Danh sách bài toán</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Tiêu đề</th>
                                <th>Môn học</th>
                                <th>Cấp học</th>
                                <th>Deadline</th>
                                <th>Trạng thái</th>
                                <th>Giá</th>
                                <th>Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var problem in Model)
                            {
                                var isNearDeadline = (problem.Deadline - DateTime.Now).TotalHours < 24;
                                <tr class="@(isNearDeadline && problem.Status == Webgiasu.Models.ProblemStatus.InProgress ? "table-warning" : "")">
                                    <td class="fw-bold">#@problem.Id</td>
                                    <td>@problem.Title</td>
                                    <td><span class="badge bg-secondary">@problem.Type</span></td>
                                    <td>
                                        <span class="badge bg-@GetGradeLevelBadgeClass(problem.Difficulty)">
                                            @GetGradeLevelText(problem.Difficulty)
                                        </span>
                                    </td>
                                    <td>
                                        <span class="@(isNearDeadline ? "text-danger fw-bold" : "")">
                                            @problem.Deadline.ToString("dd/MM/yyyy HH:mm")
                                        </span>
                                        @if (isNearDeadline && problem.Status == Webgiasu.Models.ProblemStatus.InProgress)
                                        {
                                            <br />
                                
                                            <small class="text-danger"><i class="bi bi-exclamation-triangle"></i> Sắp hết hạn!</small>
                                        }
                                    </td>
                                    <td>
                                        @if (problem.Status == Webgiasu.Models.ProblemStatus.InProgress)
                                        {
                                            <span class="badge bg-warning">
                                                <i class="bi bi-hourglass-split"></i> Đang giải
                                            </span>
                                        }
                                        else if (problem.Status == Webgiasu.Models.ProblemStatus.Solved)
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle"></i> Đã gửi
                                            </span>
                                        }
                                    </td>
                                    <td class="fw-bold text-success">@problem.Price.ToString("N0") đ</td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="ProblemDetails" asp-route-id="@problem.Id" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            @if (problem.Status == Webgiasu.Models.ProblemStatus.InProgress)
                                            {
                                                <a asp-action="SubmitSolution" asp-route-problemId="@problem.Id" class="btn btn-sm btn-warning">
                                                    <i class="bi bi-send"></i> Gửi
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-inbox text-muted" style="font-size: 5rem;"></i>
                <h4 class="mt-3 text-muted">Bạn chưa nhận bài nào</h4>
                <p class="text-muted">Hãy tìm và nhận bài toán phù hợp với bạn</p>
                <a asp-action="AvailableProblems" class="btn btn-success btn-lg">
                    <i class="bi bi-search"></i> Tìm bài toán
                </a>
            </div>
        </div>
    }
</div>
