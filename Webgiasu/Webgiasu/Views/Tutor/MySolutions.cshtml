@model List<Webgiasu.Models.Solution>
@inject Webgiasu.Services.IProblemService ProblemService
@{
    ViewData["Title"] = "Lời giải đã gửi";
    Layout = "_TutorLayout";
}

<div class="row mb-4">
    <div class="col">
        <h2 class="fw-bold">
            <i class="bi bi-check-circle text-success"></i> Lời giải đã gửi
        </h2>
        <p class="text-muted">Danh sách các lời giải bạn đã hoàn thành</p>
    </div>
</div>

@if (Model.Any())
{
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card text-center shadow-sm card-hover">
                <div class="card-body">
                    <i class="bi bi-check-circle text-success" style="font-size: 2rem;"></i>
                    <h3 class="mt-2 mb-0">@Model.Count</h3>
                    <p class="text-muted mb-0">Tổng lời giải</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center shadow-sm card-hover">
                <div class="card-body">
                    <i class="bi bi-star-fill text-warning" style="font-size: 2rem;"></i>
                    <h3 class="mt-2 mb-0">@(Model.Count(s => s.Rating.HasValue && s.Rating >= 4))</h3>
                    <p class="text-muted mb-0">Đánh giá tốt (≥4⭐)</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center shadow-sm card-hover">
                <div class="card-body">
                    <i class="bi bi-hourglass-split text-info" style="font-size: 2rem;"></i>
                    <h3 class="mt-2 mb-0">@Model.Count(s => !s.Rating.HasValue)</h3>
                    <p class="text-muted mb-0">Chờ đánh giá</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        @foreach (var solution in Model)
        {
            var problem = ProblemService.GetProblemById(solution.ProblemId);
            <div class="col-lg-6 mb-4">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-success text-white">
                        <div class="d-flex justify-content-between align-items-center">
                            <h6 class="mb-0">
                                <i class="bi bi-file-text"></i> Bài #@solution.ProblemId
                            </h6>
                            @if (solution.Rating.HasValue)
                            {
                                <span class="badge bg-warning">
                                    <i class="bi bi-star-fill"></i> @solution.Rating/5
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-light text-dark">
                                    <i class="bi bi-hourglass-split"></i> Chờ đánh giá
                                </span>
                            }
                        </div>
                    </div>
                    <div class="card-body">
                        <h5 class="card-title">@problem?.Title</h5>
                        
                        <div class="mb-3">
                            @if (problem != null)
                            {
                                <span class="badge bg-secondary me-1">@problem.Type</span>
                                @if (problem.Difficulty == Webgiasu.Models.DifficultyLevel.Easy)
                                {
                                    <span class="badge bg-success me-1">Dễ</span>
                                }
                                else if (problem.Difficulty == Webgiasu.Models.DifficultyLevel.Medium)
                                {
                                    <span class="badge bg-warning me-1">TB</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger me-1">Khó</span>
                                }
                                <span class="badge bg-info">@problem.Price.ToString("N0") đ</span>
                            }
                        </div>

                        <div class="bg-light p-3 rounded mb-3" style="max-height: 150px; overflow-y: auto;">
                            <small class="text-muted">Lời giải của bạn:</small>
                            <p class="mb-0 small">@(solution.Content.Length > 200 ? solution.Content.Substring(0, 200) + "..." : solution.Content)</p>
                        </div>

                        @if (!string.IsNullOrEmpty(solution.FileUrl))
                        {
                            <p class="mb-2">
                                <i class="bi bi-paperclip"></i>
                                <small>Có file đính kèm</small>
                            </p>
                        }

                        <div class="mb-2">
                            <small class="text-muted">
                                <i class="bi bi-clock"></i> Gửi: @solution.SubmittedDate.ToString("dd/MM/yyyy HH:mm")
                            </small>
                        </div>

                        @if (solution.Rating.HasValue)
                        {
                            <div class="alert alert-success mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <strong><i class="bi bi-star-fill text-warning"></i> Đánh giá:</strong>
                                    <span>
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= solution.Rating.Value)
                                            {
                                                <i class="bi bi-star-fill text-warning"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-star text-muted"></i>
                                            }
                                        }
                                    </span>
                                </div>
                                @if (!string.IsNullOrEmpty(solution.Feedback))
                                {
                                    <small class="mb-0">
                                        <strong>Nhận xét:</strong> @solution.Feedback
                                    </small>
                                }
                            </div>
                        }
                    </div>
                    <div class="card-footer bg-light">
                        <div class="d-flex justify-content-between align-items-center">
                            <small class="text-muted">ID: #@solution.Id</small>
                            <a asp-action="ProblemDetails" asp-route-id="@solution.ProblemId" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-eye"></i> Chi tiết
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <i class="bi bi-inbox text-muted" style="font-size: 5rem;"></i>
            <h4 class="mt-3 text-muted">Bạn chưa gửi lời giải nào</h4>
            <p class="text-muted">Hãy nhận và giải các bài toán</p>
            <a asp-action="AvailableProblems" class="btn btn-success btn-lg">
                <i class="bi bi-search"></i> Tìm bài toán
            </a>
        </div>
    </div>
}
