@{
    ViewData["Title"] = "Trang chủ Doanh nghiệp";
    Layout = "~/Views/Shared/_EnterpriseLayout.cshtml";
}

<div class="dashboard-container">
    <!-- Page Header -->
    <div class="page-header mb-4">
        <h5 class="fw-bold mb-1 text-dark">
            <i class="bi bi-house-door text-primary me-2"></i>Dashboard Doanh nghiệp
        </h5>
        <p class="text-muted mb-0 small">Tổng quan quản lý hệ thống Mentor và các trường</p>
    </div>

    <!-- Stats Overview Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card stat-card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 small text-uppercase">Mentor đã tạo</p>
                            <h3 class="fw-bold mb-0 text-primary">@ViewBag.TotalMentors</h3>
                        </div>
                        <div class="stat-icon bg-primary bg-opacity-10 rounded">
                            <i class="bi bi-person-badge text-primary"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card stat-card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 small text-uppercase">Tổng lớp học</p>
                            <h3 class="fw-bold mb-0 text-success">@ViewBag.TotalClasses</h3>
                        </div>
                        <div class="stat-icon bg-success bg-opacity-10 rounded">
                            <i class="bi bi-book text-success"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card stat-card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 small text-uppercase">Lớp đang hoạt động</p>
                            <h3 class="fw-bold mb-0 text-info">@ViewBag.ActiveClasses</h3>
                        </div>
                        <div class="stat-icon bg-info bg-opacity-10 rounded">
                            <i class="bi bi-check-circle text-info"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card stat-card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 small text-uppercase">Lịch trao đổi</p>
                            <h3 class="fw-bold mb-0 text-warning">@ViewBag.TotalSchedules</h3>
                        </div>
                        <div class="stat-icon bg-warning bg-opacity-10 rounded">
                            <i class="bi bi-calendar-week text-warning"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header py-3 bg-white border-bottom">
                    <h6 class="mb-0 fw-bold text-dark">
                        <i class="bi bi-lightning-charge text-primary me-2"></i>Thao tác nhanh
                    </h6>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-action="CreateMentor" class="btn btn-primary">
                            <i class="bi bi-person-plus me-2"></i>Tạo tài khoản Mentor mới
                        </a>
                        <a asp-action="ManageMentors" class="btn btn-outline-primary">
                            <i class="bi bi-people me-2"></i>Quản lý Mentor
                        </a>
                        <a asp-action="SchoolClasses" class="btn btn-outline-success">
                            <i class="bi bi-book me-2"></i>Xem lớp học các trường
                        </a>
                        <a asp-action="SchoolSchedules" class="btn btn-outline-info">
                            <i class="bi bi-calendar-week me-2"></i>Xem lịch trao đổi
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header py-3 bg-white border-bottom">
                    <h6 class="mb-0 fw-bold text-dark">
                        <i class="bi bi-info-circle text-info me-2"></i>Thông tin hệ thống
                    </h6>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3 pb-3 border-bottom">
                        <div class="stat-icon bg-primary bg-opacity-10 rounded me-3">
                            <i class="bi bi-building text-primary"></i>
                        </div>
                        <div>
                            <p class="mb-0 small text-muted">Số trường trong hệ thống</p>
                            <h5 class="mb-0 fw-bold">@ViewBag.TotalSchools trường</h5>
                        </div>
                    </div>
                    <div class="d-flex align-items-center mb-3 pb-3 border-bottom">
                        <div class="stat-icon bg-success bg-opacity-10 rounded me-3">
                            <i class="bi bi-person-check text-success"></i>
                        </div>
                        <div>
                            <p class="mb-0 small text-muted">Mentor đã được phê duyệt</p>
                            <h5 class="mb-0 fw-bold">@ViewBag.TotalMentors người</h5>
                        </div>
                    </div>
                    <div class="d-flex align-items-center">
                        <div class="stat-icon bg-info bg-opacity-10 rounded me-3">
                            <i class="bi bi-graph-up text-info"></i>
                        </div>
                        <div>
                            <p class="mb-0 small text-muted">Tỷ lệ lớp đang hoạt động</p>
                            <h5 class="mb-0 fw-bold">
                                @if (ViewBag.TotalClasses > 0)
                                {
                                    @Math.Round((double)ViewBag.ActiveClasses / ViewBag.TotalClasses * 100, 1)<text>%</text>
                                }
                                else
                                {
                                    <text>0%</text>
                                }
                            </h5>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

