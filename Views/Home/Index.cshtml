@{
    ViewData["Title"] = "Trang chủ";
}

<link rel="stylesheet" href="~/css/home.css?v=10" />

<div class="row mt-5 mb-5 fade-in">
<div class="col-lg-8 mx-auto text-center">
    <h1 class="hero-title fw-bold mb-4">
        Nền tảng kết nối Học sinh và Mentor
    </h1>
    <p class="lead mb-4 text-muted">
        Giải đáp bài tập nhanh chóng, chất lượng cao với đội ngũ chuyên gia hàng đầu. Nâng tầm kiến thức của bạn ngay hôm nay.
    </p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <div class="badge bg-primary badge-pill px-4 py-2">
                <i class="bi bi-check-circle me-1"></i> Đáng tin cậy
            </div>
            <div class="badge bg-success badge-pill px-4 py-2">
                <i class="bi bi-lightning me-1"></i> Nhanh chóng
            </div>
            <div class="badge bg-info badge-pill px-4 py-2">
                <i class="bi bi-shield-check me-1"></i> Bảo mật
            </div>
            <div class="badge bg-warning badge-pill px-4 py-2">
                <i class="bi bi-star me-1"></i> Chất lượng
            </div>
        </div>
    </div>
</div>

<!-- Carousel 3D Container -->
<div class="carousel-3d-container">
    <div class="carousel-3d-scene" id="carousel3d">
        <!-- Card 1: Học sinh -->
        <div class="carousel-card" data-index="0">
            <div class="card h-100 shadow-soft border-0" style="box-shadow: 0 0 30px rgba(33, 150, 243, 0.4), 0 8px 20px rgba(33, 150, 243, 0.3) !important; border: 2px solid rgba(33, 150, 243, 0.3) !important;">
                <div class="card-body text-center p-5">
                    <div class="mb-4">
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center bg-primary bg-gradient text-white" style="width: 100px; height: 100px; box-shadow: 0 0 20px rgba(33, 150, 243, 0.5);">
                            <i class="bi bi-person-circle" style="font-size: 3.5rem;"></i>
                        </div>
                    </div>
                    <h3 class="card-title mb-3 fw-bold">Học sinh</h3>
                    <p class="card-text text-muted mb-4">
                        Đăng bài toán, nhận lời giải chi tiết từ các Mentor giỏi
                    </p>
                    <div class="list-group list-group-flush mb-4 text-start">
                        <div class="list-group-item border-0 ps-0">
                            <i class="bi bi-check-circle-fill text-success me-2"></i> Đăng bài dễ dàng
                        </div>
                        <div class="list-group-item border-0 ps-0">
                            <i class="bi bi-check-circle-fill text-success me-2"></i> Lời giải chi tiết
                        </div>
                        <div class="list-group-item border-0 ps-0">
                            <i class="bi bi-check-circle-fill text-success me-2"></i> Giá cả hợp lý
                        </div>
                    </div>
                    <div class="d-grid gap-2">
                        <a asp-controller="Account" asp-action="Login" asp-route-role="Student" class="btn btn-primary btn-lg btn-pill">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
                        </a>
                        <a asp-controller="Account" asp-action="Register" asp-route-role="Student" class="btn btn-outline-primary btn-pill">
                            <i class="bi bi-person-plus me-1"></i> Đăng ký
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 2: Mentor -->
        <div class="carousel-card" data-index="1">
            <div class="card h-100 shadow-soft border-0" style="box-shadow: 0 0 30px rgba(76, 175, 80, 0.4), 0 8px 20px rgba(76, 175, 80, 0.3) !important; border: 2px solid rgba(76, 175, 80, 0.3) !important;">
                <div class="card-body text-center p-5">
                    <div class="mb-4">
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center bg-success bg-gradient text-white" style="width: 100px; height: 100px; box-shadow: 0 0 20px rgba(76, 175, 80, 0.5);">
                            <i class="bi bi-mortarboard" style="font-size: 3.5rem;"></i>
                        </div>
                    </div>
                    <h3 class="card-title mb-3 fw-bold">Mentor</h3>
                    <p class="card-text text-muted mb-4">
                        Giải bài toán, kiếm thu nhập từ kiến thức của bạn
                    </p>
                    <div class="list-group list-group-flush mb-4 text-start">
                        <div class="list-group-item border-0 ps-0">
                            <i class="bi bi-check-circle-fill text-success me-2"></i> Làm việc linh hoạt
                        </div>
                        <div class="list-group-item border-0 ps-0">
                            <i class="bi bi-check-circle-fill text-success me-2"></i> Thu nhập hấp dẫn
                        </div>
                        <div class="list-group-item border-0 ps-0">
                            <i class="bi bi-check-circle-fill text-success me-2"></i> Phát triển kỹ năng
                        </div>
                    </div>
                    <div class="d-grid gap-2">
                        <a asp-controller="Account" asp-action="Login" asp-route-role="Tutor" class="btn btn-success btn-lg btn-pill">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
                        </a>
                        <a asp-controller="Account" asp-action="Register" asp-route-role="Tutor" class="btn btn-outline-success btn-pill">
                            <i class="bi bi-person-plus me-1"></i> Đăng ký
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 3: Quản trị -->
        <div class="carousel-card" data-index="2">
            <div class="card h-100 shadow-soft border-0" style="box-shadow: 0 0 30px rgba(220, 53, 69, 0.4), 0 8px 20px rgba(220, 53, 69, 0.3) !important; border: 2px solid rgba(220, 53, 69, 0.3) !important;">
                <div class="card-body text-center p-5">
                    <div class="mb-4">
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center bg-danger bg-gradient text-white" style="width: 100px; height: 100px; box-shadow: 0 0 20px rgba(220, 53, 69, 0.5);">
                            <i class="bi bi-shield-check" style="font-size: 3.5rem;"></i>
                        </div>
                    </div>
                    <h3 class="card-title mb-3 fw-bold">Quản trị</h3>
                    <p class="card-text text-muted mb-4">
                        Quản lý hệ thống, duyệt Mentor, theo dõi hoạt động
                    </p>
                    <div class="list-group list-group-flush mb-4 text-start">
                        <div class="list-group-item border-0 ps-0">
                            <i class="bi bi-check-circle-fill text-success me-2"></i> Quản lý toàn diện
                        </div>
                        <div class="list-group-item border-0 ps-0">
                            <i class="bi bi-check-circle-fill text-success me-2"></i> Thống kê chi tiết
                        </div>
                        <div class="list-group-item border-0 ps-0">
                            <i class="bi bi-check-circle-fill text-success me-2"></i> Kiểm soát chất lượng
                        </div>
                    </div>
                    <div class="d-grid gap-2">
                        <a asp-controller="Account" asp-action="Login" asp-route-role="Admin" class="btn btn-danger btn-lg btn-pill">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 4: Doanh nghiệp -->
        <div class="carousel-card" data-index="3">
            <div class="card h-100 shadow-soft border-0" style="box-shadow: 0 0 30px rgba(121, 85, 72, 0.4), 0 8px 20px rgba(121, 85, 72, 0.3) !important; border: 2px solid rgba(121, 85, 72, 0.3) !important;">
                <div class="card-body text-center p-5">
                    <div class="mb-4">
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center text-white" style="width: 100px; height: 100px; background: linear-gradient(135deg, #795548 0%, #8D6E63 100%); box-shadow: 0 0 20px rgba(121, 85, 72, 0.5);">
                            <i class="bi bi-briefcase-fill" style="font-size: 3.5rem;"></i>
                        </div>
                    </div>
                    <h3 class="card-title mb-3 fw-bold">Doanh nghiệp</h3>
                    <p class="card-text text-muted mb-4">
                        Tạo Mentor, theo dõi hoạt động các trường
                    </p>
                    <div class="list-group list-group-flush mb-4 text-start">
                        <div class="list-group-item border-0 ps-0">
                            <i class="bi bi-check-circle-fill text-success me-2"></i> Tạo tài khoản Mentor
                        </div>
                        <div class="list-group-item border-0 ps-0">
                            <i class="bi bi-check-circle-fill text-success me-2"></i> Xem thông tin lớp học
                        </div>
                        <div class="list-group-item border-0 ps-0">
                            <i class="bi bi-check-circle-fill text-success me-2"></i> Quản lý hiệu quả
                        </div>
                    </div>
                    <div class="d-grid gap-2">
                        <a asp-controller="Account" asp-action="Login" asp-route-role="Enterprise" class="btn btn-lg btn-pill" style="background: linear-gradient(135deg, #795548 0%, #8D6E63 100%); color: white; border: none;">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
                        </a>
                        <a asp-controller="Account" asp-action="Register" asp-route-role="Enterprise" class="btn btn-pill" style="border: 2px solid #795548; color: #795548; background: transparent;">
                            <i class="bi bi-person-plus me-1"></i> Đăng ký
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 5: Nhà trường -->
        <div class="carousel-card" data-index="4">
            <div class="card h-100 shadow-soft border-0" style="box-shadow: 0 0 30px rgba(255, 193, 7, 0.4), 0 8px 20px rgba(255, 193, 7, 0.3) !important; border: 2px solid rgba(255, 193, 7, 0.3) !important;">
                <div class="card-body text-center p-5">
                    <div class="mb-4">
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center bg-warning bg-gradient text-white" style="width: 100px; height: 100px; box-shadow: 0 0 20px rgba(255, 193, 7, 0.5);">
                            <i class="bi bi-building" style="font-size: 3.5rem;"></i>
                        </div>
                    </div>
                    <h3 class="card-title mb-3 fw-bold">Nhà trường</h3>
                    <p class="card-text text-muted mb-4">
                        Quản lý học sinh, theo dõi tiến trình học tập
                    </p>
                    <div class="list-group list-group-flush mb-4 text-start">
                        <div class="list-group-item border-0 ps-0">
                            <i class="bi bi-check-circle-fill text-success me-2"></i> Quản lý học sinh
                        </div>
                        <div class="list-group-item border-0 ps-0">
                            <i class="bi bi-check-circle-fill text-success me-2"></i> Theo dõi học tập
                        </div>
                        <div class="list-group-item border-0 ps-0">
                            <i class="bi bi-check-circle-fill text-success me-2"></i> Báo cáo chi tiết
                        </div>
                    </div>
                    <div class="d-grid gap-2">
                        <a asp-controller="Account" asp-action="Login" asp-route-role="School" class="btn btn-warning btn-lg btn-pill">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
                        </a>
                        <a asp-controller="Account" asp-action="Register" asp-route-role="School" class="btn btn-outline-warning btn-pill school-register-btn">
                            <i class="bi bi-person-plus me-1"></i> Đăng ký
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Navigation Buttons -->
    <button class="carousel-nav carousel-nav-left" id="prevBtn">
        <i class="bi bi-chevron-left"></i>
    </button>
    <button class="carousel-nav carousel-nav-right" id="nextBtn">
        <i class="bi bi-chevron-right"></i>
    </button>

    <!-- Indicators -->
    <div class="carousel-indicators-3d">
        <span class="indicator active" data-slide="0"></span>
        <span class="indicator" data-slide="1"></span>
        <span class="indicator" data-slide="2"></span>
        <span class="indicator" data-slide="3"></span>
        <span class="indicator" data-slide="4"></span>
    </div>
</div>

<!-- Giới thiệu dự án -->
<div class="row mt-5 mb-5">
    <div class="col-lg-10 mx-auto">
        <div class="card border-0 shadow-lg position-relative overflow-hidden" style="border-radius: 25px; background: linear-gradient(135deg, rgba(102, 126, 234, 0.05) 0%, rgba(118, 75, 162, 0.05) 100%);">
            <!-- Decorative elements -->
            <div class="position-absolute" style="top: -50px; right: -50px; width: 200px; height: 200px; background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%); border-radius: 50%;"></div>
            <div class="position-absolute" style="bottom: -30px; left: -30px; width: 150px; height: 150px; background: linear-gradient(135deg, rgba(17, 153, 142, 0.1) 0%, rgba(56, 239, 125, 0.1) 100%); border-radius: 50%;"></div>
            
            <div class="card-body p-5 position-relative">
                <div class="text-center mb-4">
                    <span class="badge px-4 py-2 mb-3" style="background: #19d27c; color: white; border-radius: 50px; font-size: 0.9rem; font-weight: 600; letter-spacing: 0.5px;">
                        <i class="bi bi-info-circle-fill me-2"></i>GIỚI THIỆU
                    </span>
                    <h2 class="fw-bold mb-4 hero-title" style="font-size: 2.5rem; padding-bottom: 0.3rem;">
                        Cách mạng hóa phương thức học tập trực tuyến
                    </h2>
                    <p class="lead text-muted mb-4" style="font-size: 1.15rem; line-height: 1.8;">
                        Nền tảng kết nối học sinh và mentor được xây dựng với sứ mệnh dân chủ hóa giáo dục, 
                        mang đến cơ hội học tập chất lượng cao và chi phí hợp lý cho mọi học sinh Việt Nam.
                    </p>
                </div>

                <div class="row g-4 mb-4">
                    <!-- Mục tiêu 1 -->
                    <div class="col-md-4">
                        <div class="text-center p-4 h-100" style="background: rgba(255, 255, 255, 0.7); border-radius: 15px; border: 2px solid rgba(102, 126, 234, 0.1);">
                            <div class="mb-3">
                                <div class="d-inline-flex align-items-center justify-content-center rounded-circle" style="width: 70px; height: 70px; background: linear-gradient(135deg, rgba(33, 150, 243, 0.15) 0%, rgba(3, 169, 244, 0.15) 100%);">
                                    <i class="bi bi-bullseye" style="font-size: 2.5rem; color: #2196F3;"></i>
                                </div>
                            </div>
                            <h5 class="fw-bold mb-3" style="color: #2196F3;">Mục tiêu</h5>
                            <p class="text-muted small mb-0" style="line-height: 1.7;">
                                Xây dựng cộng đồng học tập toàn diện, kết nối hàng triệu học sinh với đội ngũ mentor giàu kinh nghiệm, 
                                giúp học sinh tự tin vượt qua mọi thử thách học tập.
                            </p>
                        </div>
                    </div>

                    <!-- Giá trị cốt lõi -->
                    <div class="col-md-4">
                        <div class="text-center p-4 h-100" style="background: rgba(255, 255, 255, 0.7); border-radius: 15px; border: 2px solid rgba(76, 175, 80, 0.1);">
                            <div class="mb-3">
                                <div class="d-inline-flex align-items-center justify-content-center rounded-circle" style="width: 70px; height: 70px; background: linear-gradient(135deg, rgba(76, 175, 80, 0.15) 0%, rgba(56, 239, 125, 0.15) 100%);">
                                    <i class="bi bi-gem" style="font-size: 2.5rem; color: #4CAF50;"></i>
                                </div>
                            </div>
                            <h5 class="fw-bold mb-3" style="color: #4CAF50;">Giá trị cốt lõi</h5>
                            <p class="text-muted small mb-0" style="line-height: 1.7;">
                                Minh bạch trong mọi giao dịch, công bằng cho cả học sinh và mentor, 
                                chất lượng được đảm bảo qua hệ thống đánh giá và kiểm duyệt nghiêm ngặt.
                            </p>
                        </div>
                    </div>

                    <!-- Đóng góp cho giáo dục -->
                    <div class="col-md-4">
                        <div class="text-center p-4 h-100" style="background: rgba(255, 255, 255, 0.7); border-radius: 15px; border: 2px solid rgba(255, 152, 0, 0.1);">
                            <div class="mb-3">
                                <div class="d-inline-flex align-items-center justify-content-center rounded-circle" style="width: 70px; height: 70px; background: linear-gradient(135deg, rgba(255, 152, 0, 0.15) 0%, rgba(255, 193, 7, 0.15) 100%);">
                                    <i class="bi bi-trophy" style="font-size: 2.5rem; color: #FF9800;"></i>
                                </div>
                            </div>
                            <h5 class="fw-bold mb-3" style="color: #FF9800;">Đóng góp cho giáo dục</h5>
                            <p class="text-muted small mb-0" style="line-height: 1.7;">
                                Tạo cơ hội việc làm cho sinh viên và giáo viên, nâng cao chất lượng giáo dục phụ đạo, 
                                ứng dụng công nghệ 4.0 vào học tập, góp phần xây dựng nền giáo dục hiện đại.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Tính năng nổi bật -->
                <div class="row g-4 mt-4 justify-content-center">
                    <div class="col-md-6 col-lg-3">
                        <div class="text-center p-4 position-relative overflow-hidden" style="background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%); border-radius: 15px; border: 2px solid rgba(102, 126, 234, 0.2);">
                            <div class="mb-3">
                                <i class="bi bi-robot" style="font-size: 3rem; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;"></i>
                            </div>
                            <h4 class="fw-bold mb-2" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">AI gợi ý bài giải</h4>
                            <p class="text-muted small mb-0">Hệ thống AI thông minh gợi ý bài giải cho học sinh và mentor giải bài</p>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <div class="text-center p-4 position-relative overflow-hidden" style="background: linear-gradient(135deg, rgba(0, 200, 83, 0.1) 0%, rgba(0, 168, 67, 0.1) 100%); border-radius: 15px; border: 2px solid rgba(0, 200, 83, 0.2);">
                            <div class="mb-3">
                                <i class="bi bi-qr-code-scan" style="font-size: 3rem; background: linear-gradient(135deg, #00c853 0%, #00a843 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;"></i>
                            </div>
                            <h4 class="fw-bold mb-2" style="background: linear-gradient(135deg, #00c853 0%, #00a843 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Thanh toán QR</h4>
                            <p class="text-muted small mb-0">Thanh toán nhanh chóng, an toàn qua mã QR với các ví điện tử phổ biến</p>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <div class="text-center p-4 position-relative overflow-hidden" style="background: linear-gradient(135deg, rgba(156, 39, 176, 0.1) 0%, rgba(142, 36, 170, 0.1) 100%); border-radius: 15px; border: 2px solid rgba(156, 39, 176, 0.2);">
                            <div class="mb-3">
                                <i class="bi bi-people" style="font-size: 3rem; background: linear-gradient(135deg, #9C27B0 0%, #8E24AA 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;"></i>
                            </div>
                            <h4 class="fw-bold mb-2" style="background: linear-gradient(135deg, #9C27B0 0%, #8E24AA 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Kết bạn & Giao tiếp</h4>
                            <p class="text-muted small mb-0">Kết nối, kết bạn và trao đổi trực tiếp giữa học sinh với học sinh, mentor với mentor</p>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <div class="text-center p-4 position-relative overflow-hidden" style="background: linear-gradient(135deg, rgba(233, 30, 99, 0.1) 0%, rgba(216, 27, 96, 0.1) 100%); border-radius: 15px; border: 2px solid rgba(233, 30, 99, 0.2);">
                            <div class="mb-3">
                                <i class="bi bi-chat-dots" style="font-size: 3rem; background: linear-gradient(135deg, #E91E63 0%, #D81B60 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;"></i>
                            </div>
                            <h4 class="fw-bold mb-2" style="background: linear-gradient(135deg, #E91E63 0%, #D81B60 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Diễn đàn Ẩn danh</h4>
                            <p class="text-muted small mb-0">Cộng đồng thảo luận với danh tính ẩn danh, bảo vệ thông tin cá nhân</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mt-5 mb-5 four-steps-section">
<div class="col-lg-10 mx-auto">
    <div class="text-center mb-5">
        <h2 class="fw-bold mb-3 hero-title" style="font-size: 2.8rem;">
            Hướng dẫn sử dụng chỉ với 4 bước cơ bản
        </h2>
        <p class="lead text-muted mb-1" style="font-size: 1.1rem;">Từ đăng ký đến nhận lời giải - Nhanh chóng, dễ dàng và hiệu quả</p>
        <p class="text-muted">Hàng ngàn học sinh và mentor đã tin tưởng sử dụng nền tảng của chúng tôi</p>
    </div>
        <div class="row g-4">
