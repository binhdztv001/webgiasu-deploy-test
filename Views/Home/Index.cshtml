@{
    ViewData["Title"] = "Trang chủ";
}

<link rel="stylesheet" href="~/css/home.css?v=10" />

<div class="row mb-5 fade-in">
    <div class="col-lg-8 mx-auto text-center">
        <h1 class="hero-title fw-bold mb-4">
            Nền tảng kết nối Học sinh và Mentor
        </h1>
        <p class="lead mb-4 text-muted">
            Giải đáp bài tập nhanh chóng, chất lượng cao với đội ngũ chuyên gia hàng đầu. Nâng tầm kiến thức của bạn ngay hôm nay.
        </p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <div class="badge bg-primary badge-pill px-4 py-2">
                <i class="bi bi-check-circle me-1"></i> Đáng tin cậy
            </div>
            <div class="badge bg-success badge-pill px-4 py-2">
                <i class="bi bi-lightning me-1"></i> Nhanh chóng
            </div>
            <div class="badge bg-info badge-pill px-4 py-2">
                <i class="bi bi-shield-check me-1"></i> Bảo mật
            </div>
            <div class="badge bg-warning badge-pill px-4 py-2">
                <i class="bi bi-star me-1"></i> Chất lượng
            </div>
        </div>
    </div>
</div>

<!-- Carousel 3D Container -->
<div class="carousel-3d-container">
    <div class="carousel-3d-scene" id="carousel3d">
        <!-- Card 1: Học sinh -->
        <div class="carousel-card" data-index="0">
            <div class="card h-100 shadow-soft">
                <div class="card-body text-center p-5">
                    <div class="mb-4">
                        <div class="icon-circle">
                            <i class="bi bi-person-circle"></i>
                        </div>
                    </div>
                    <h3 class="card-title mb-3 fw-bold">Học sinh</h3>
                    <p class="card-text text-muted mb-4">
                        Đăng bài toán, nhận lời giải chi tiết từ các Mentor giỏi
                    </p>
                    <div class="list-group list-group-flush mb-4 text-start">
                        <div class="list-group-item border-0 ps-0">
                            <i class="bi bi-check-circle-fill text-success me-2"></i> Đăng bài dễ dàng
                        </div>
                        <div class="list-group-item border-0 ps-0">
                            <i class="bi bi-check-circle-fill text-success me-2"></i> Lời giải chi tiết
                        </div>
                        <div class="list-group-item border-0 ps-0">
                            <i class="bi bi-check-circle-fill text-success me-2"></i> Giá cả hợp lý
                        </div>
                    </div>
                    <div class="d-grid gap-2">
                        <a asp-controller="Account" asp-action="Login" asp-route-role="Student" class="btn btn-primary btn-lg btn-pill">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
                        </a>
                        <a asp-controller="Account" asp-action="Register" asp-route-role="Student" class="btn btn-outline-primary btn-pill">
                            <i class="bi bi-person-plus me-1"></i> Đăng ký
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 2: Mentor -->
        <div class="carousel-card" data-index="1">
            <div class="card h-100 shadow-soft">
                <div class="card-body text-center p-5">
                    <div class="mb-4">
                        <div class="icon-circle">
                            <i class="bi bi-mortarboard"></i>
                        </div>
                    </div>
                    <h3 class="card-title mb-3 fw-bold">Mentor</h3>
                    <p class="card-text text-muted mb-4">
                        Giải bài toán, kiếm thu nhập từ kiến thức của bạn
                    </p>
                    <div class="list-group list-group-flush mb-4 text-start">
                        <div class="list-group-item border-0 ps-0">
                            <i class="bi bi-check-circle-fill text-success me-2"></i> Làm việc linh hoạt
                        </div>
                        <div class="list-group-item border-0 ps-0">
                            <i class="bi bi-check-circle-fill text-success me-2"></i> Thu nhập hấp dẫn
                        </div>
                        <div class="list-group-item border-0 ps-0">
                            <i class="bi bi-check-circle-fill text-success me-2"></i> Phát triển kỹ năng
                        </div>
                    </div>
                    <div class="d-grid gap-2">
                        <a asp-controller="Account" asp-action="Login" asp-route-role="Tutor" class="btn btn-success btn-lg btn-pill">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
                        </a>
                        <a asp-controller="Account" asp-action="Register" asp-route-role="Tutor" class="btn btn-outline-success btn-pill">
                            <i class="bi bi-person-plus me-1"></i> Đăng ký
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 3: Quản trị -->
        <div class="carousel-card" data-index="2">
            <div class="card h-100 shadow-soft">
                <div class="card-body text-center p-5">
                    <div class="mb-4">
                        <div class="icon-circle">
                            <i class="bi bi-shield-check"></i>
                        </div>
                    </div>
                    <h3 class="card-title mb-3 fw-bold">Quản trị</h3>
                    <p class="card-text text-muted mb-4">
                        Quản lý hệ thống, duyệt Mentor, theo dõi hoạt động
                    </p>
                    <div class="list-group list-group-flush mb-4 text-start">
                        <div class="list-group-item border-0 ps-0">
                            <i class="bi bi-check-circle-fill text-success me-2"></i> Quản lý toàn diện
                        </div>
                        <div class="list-group-item border-0 ps-0">
                            <i class="bi bi-check-circle-fill text-success me-2"></i> Thống kê chi tiết
                        </div>
                        <div class="list-group-item border-0 ps-0">
                            <i class="bi bi-check-circle-fill text-success me-2"></i> Kiểm soát chất lượng
                        </div>
                    </div>
                    <div class="d-grid gap-2">
                        <a asp-controller="Account" asp-action="Login" asp-route-role="Admin" class="btn btn-danger btn-lg btn-pill">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 4: Doanh nghiệp -->
        <div class="carousel-card" data-index="3">
            <div class="card h-100 shadow-soft">
                <div class="card-body text-center p-5">
                    <div class="mb-4">
                        <div class="icon-circle">
                            <i class="bi bi-briefcase-fill"></i>
                        </div>
                    </div>
                    <h3 class="card-title mb-3 fw-bold">Doanh nghiệp</h3>
                    <p class="card-text text-muted mb-4">
                        Tạo Mentor, theo dõi hoạt động các trường
                    </p>
                    <div class="list-group list-group-flush mb-4 text-start">
                        <div class="list-group-item border-0 ps-0">
                            <i class="bi bi-check-circle-fill text-success me-2"></i> Tạo tài khoản Mentor
                        </div>
                        <div class="list-group-item border-0 ps-0">
                            <i class="bi bi-check-circle-fill text-success me-2"></i> Xem thông tin lớp học
                        </div>
                        <div class="list-group-item border-0 ps-0">
                            <i class="bi bi-check-circle-fill text-success me-2"></i> Quản lý hiệu quả
                        </div>
                    </div>
                    <div class="d-grid gap-2">
                        <a asp-controller="Account" asp-action="Login" asp-route-role="Enterprise" class="btn btn-lg btn-pill" style="background: linear-gradient(135deg, #795548 0%, #8D6E63 100%); color: white; border: none;">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
                        </a>
                        <a asp-controller="Account" asp-action="Register" asp-route-role="Enterprise" class="btn btn-pill" style="border: 2px solid #795548; color: #795548; background: transparent;">
                            <i class="bi bi-person-plus me-1"></i> Đăng ký
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 5: Nhà trường -->
        <div class="carousel-card" data-index="4">
            <div class="card h-100 shadow-soft">
                <div class="card-body text-center p-5">
                    <div class="mb-4">
                        <div class="icon-circle">
                            <i class="bi bi-building"></i>
                        </div>
                    </div>
                    <h3 class="card-title mb-3 fw-bold">Nhà trường</h3>
                    <p class="card-text text-muted mb-4">
                        Quản lý học sinh, theo dõi tiến trình học tập
                    </p>
                    <div class="list-group list-group-flush mb-4 text-start">
                        <div class="list-group-item border-0 ps-0">
                            <i class="bi bi-check-circle-fill text-success me-2"></i> Quản lý học sinh
                        </div>
                        <div class="list-group-item border-0 ps-0">
                            <i class="bi bi-check-circle-fill text-success me-2"></i> Theo dõi học tập
                        </div>
                        <div class="list-group-item border-0 ps-0">
                            <i class="bi bi-check-circle-fill text-success me-2"></i> Báo cáo chi tiết
                        </div>
                    </div>
                    <div class="d-grid gap-2">
                        <a asp-controller="Account" asp-action="Login" asp-route-role="School" class="btn btn-warning btn-lg btn-pill">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
                        </a>
                        <a asp-controller="Account" asp-action="Register" asp-route-role="School" class="btn btn-outline-warning btn-pill school-register-btn">
                            <i class="bi bi-person-plus me-1"></i> Đăng ký
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Navigation Buttons -->
    <button class="carousel-nav carousel-nav-left" id="prevBtn">
        <i class="bi bi-chevron-left"></i>
    </button>
    <button class="carousel-nav carousel-nav-right" id="nextBtn">
        <i class="bi bi-chevron-right"></i>
    </button>

    <!-- Indicators -->
    <div class="carousel-indicators-3d">
        <span class="indicator active" data-slide="0"></span>
        <span class="indicator" data-slide="1"></span>
        <span class="indicator" data-slide="2"></span>
        <span class="indicator" data-slide="3"></span>
        <span class="indicator" data-slide="4"></span>
    </div>
</div>

<!-- Giới thiệu dự án -->
<div class="row mt-5 mb-5">
    <div class="col-lg-10 mx-auto">
        <div class="card hero-card shadow-lg border-0">

            <div class="card-body p-5 position-relative">
                <div class="text-center mb-4">
                    <span class="badge hero-badge px-4 py-2 mb-3">
                        <i class="bi bi-info-circle-fill me-2"></i>GIỚI THIỆU
                    </span>

                    <h2 class="fw-bold mb-4 hero-title">
                        Cách mạng hóa phương thức học tập trực tuyến
                    </h2>

                    <p class="lead text-muted mb-4 hero-text">
                        Nền tảng kết nối học sinh và mentor được xây dựng với sứ mệnh dân chủ hóa giáo dục,
                        mang đến cơ hội học tập chất lượng cao và chi phí hợp lý cho mọi học sinh Việt Nam.
                    </p>
                </div>

                <div class="row g-4 mb-4">
                    <!-- Mục tiêu -->
                    <div class="col-md-4">
                        <div class="text-center info-card info-blue">
                            <div class="mb-3 info-icon-wrapper">
                                <div class="info-icon info-icon-blue">
                                    <i class="bi bi-bullseye fs-2"></i>
                                </div>
                            </div>
                            <h5 class="fw-bold mb-3 text-blue">Mục tiêu</h5>
                            <p class="text-muted small mb-0">
                                Xây dựng cộng đồng học tập toàn diện, kết nối hàng triệu học sinh với đội ngũ mentor giàu kinh nghiệm, 
                                giúp học sinh tự tin vượt qua mọi thử thách học tập.
                            </p>
                        </div>
                    </div>
                    
                    <!-- Giá trị cốt lõi -->
                    <div class="col-md-4">
                        <div class="text-center info-card info-green">
                            <div class="mb-3 info-icon-wrapper">
                                <div class="info-icon info-icon-green">
                                    <i class="bi bi-gem fs-2"></i>
                                </div>
                            </div>
                            <h5 class="fw-bold mb-3 text-green">Giá trị cốt lõi</h5>
                            <p class="text-muted small mb-0">
                                Minh bạch trong mọi giao dịch, công bằng cho cả học sinh và mentor, 
                                chất lượng được đảm bảo qua hệ thống đánh giá và kiểm duyệt nghiêm ngặt.
                            </p>
                        </div>
                    </div>

                    <!-- Đóng góp cho giáo dục -->
                    <div class="col-md-4">
                        <div class="text-center info-card info-orange">
                            <div class="mb-3 info-icon-wrapper">
                                <div class="info-icon info-icon-orange">
                                    <i class="bi bi-trophy fs-2"></i>
                                </div>
                            </div>
                            <h5 class="fw-bold mb-3 text-orange">Đóng góp cho giáo dục</h5>
                            <p class="text-muted small mb-0">
                                Tạo cơ hội việc làm cho sinh viên và giáo viên, nâng cao chất lượng giáo dục phụ đạo, 
                                ứng dụng công nghệ 4.0 vào học tập, góp phần xây dựng nền giáo dục hiện đại.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Feature -->
                <div class="row g-4 mt-4 justify-content-center">

                    <div class="col-md-6 col-lg-3">
                        <div class="text-center feature-card feature-purple">
                            <i class="bi bi-robot fs-1 gradient-text-purple mb-3"></i>
                            <h4 class="fw-bold mb-2 gradient-text-purple">AI gợi ý bài giải</h4>
                            <p class="text-muted small">Hệ thống AI thông minh gợi ý bài giải cho học sinh và mentor giải bài</p>
                        </div>
                    </div>

                    <div class="col-md-6 col-lg-3">
                        <div class="text-center feature-card feature-green">
                            <i class="bi bi-qr-code-scan fs-1 gradient-text-green mb-3"></i>
                            <h4 class="fw-bold mb-2 gradient-text-green">Thanh toán QR</h4>
                            <p class="text-muted small">Thanh toán nhanh chóng, an toàn qua mã QR với các ví điện tử phổ biến</p>
                        </div>
                    </div>

                    <div class="col-md-6 col-lg-3">
                        <div class="text-center feature-card feature-violet">
                            <i class="bi bi-people fs-1 gradient-text-violet mb-3"></i>
                            <h4 class="fw-bold mb-2 gradient-text-violet">Kết bạn & Giao tiếp</h4>
                            <p class="text-muted small">Kết nối, kết bạn và trao đổi trực tiếp giữa học sinh với học sinh, mentor với mentor</p>
                        </div>
                    </div>

                    <div class="col-md-6 col-lg-3">
                        <div class="text-center feature-card feature-pink">
                            <i class="bi bi-chat-dots fs-1 gradient-text-pink mb-3"></i>
                            <h4 class="fw-bold mb-2 gradient-text-pink">Diễn đàn Ẩn danh</h4>
                            <p class="text-muted small">Cộng đồng thảo luận với danh tính ẩn danh, bảo vệ thông tin cá nhân</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mt-5 mb-5 four-steps-section">
    <div class="col-lg-10 mx-auto">
        <div class="text-center mb-5">
            <h2 class="fw-bold mb-3 hero-title" style="font-size: 2.8rem;">
                Hướng dẫn sử dụng chỉ với 4 bước cơ bản
            </h2>
            <p class="lead text-muted mb-1" style="font-size: 1.1rem;">Từ đăng ký đến nhận lời giải - Nhanh chóng, dễ dàng và hiệu quả</p>
            <p class="text-muted">Hàng ngàn học sinh và mentor đã tin tưởng sử dụng nền tảng của chúng tôi</p>
        </div>
        <div class="row g-4">
            <!-- Bước 1: Đăng ký -->
            <div class="col-md-6 col-lg-3">
                <div class="card border-0 shadow-lg hover-card step-card step-1 h-100 position-relative overflow-hidden">
                    <div class="position-absolute step-decor"></div>
                    <div class="card-body text-center p-4 text-white position-relative">
                        <div class="mb-4">
                            <div class="rounded-circle bg-white d-inline-flex align-items-center justify-content-center shadow-lg position-relative step-icon">
                                <span class="position-absolute top-0 start-0 translate-middle badge rounded-pill step-badge">
                                    Bước 1
                                </span>
                                <i class="bi bi-person-plus-fill icon-gradient-1"></i>
                            </div>
                        </div>
                        <h5 class="fw-bold mb-3 step-title">Đăng ký tài khoản</h5>
                        <p class="small mb-3 opacity-90 step-desc">
                            Tạo tài khoản <strong>miễn phí</strong> chỉ trong <strong>30 giây</strong>
                        </p>
                        <div class="d-flex align-items-center justify-content-center gap-2 text-white-50 small">
                            <i class="bi bi-check-circle-fill"></i>
                            <span>Email hoặc số điện thoại</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bước 2: Đăng/Tìm bài -->
            <div class="col-md-6 col-lg-3">
                <div class="card border-0 shadow-lg hover-card step-card step-2 h-100 position-relative overflow-hidden">
                    <div class="position-absolute step-decor"></div>
                    <div class="card-body text-center p-4 text-white position-relative">
                        <div class="mb-4">
                            <div class="rounded-circle bg-white d-inline-flex align-items-center justify-content-center shadow-lg position-relative step-icon">
                                <span class="position-absolute top-0 start-0 translate-middle badge rounded-pill step-badge">
                                    Bước 2
                                </span>
                                <i class="bi bi-cloud-upload-fill icon-gradient-2"></i>
                            </div>
                        </div>
                        <h5 class="fw-bold mb-3 step-title">Đăng bài và Nhận bài</h5>
                        <p class="small mb-3 opacity-90 step-desc">
                            <strong>Học sinh:</strong> Đăng câu hỏi<br />
                            <strong>Mentor:</strong> Chọn bài phù hợp
                        </p>
                        <div class="d-flex align-items-center justify-content-center gap-2 text-white-50 small">
                            <i class="bi bi-check-circle-fill"></i>
                            <span>Hỗ trợ hình ảnh & tài liệu</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bước 3: Nhận lời giải -->
            <div class="col-md-6 col-lg-3">
                <div class="card border-0 shadow-lg hover-card step-card step-3 h-100 position-relative overflow-hidden">
                    <div class="position-absolute step-decor"></div>
                    <div class="card-body text-center p-4 text-white position-relative">
                        <div class="mb-4">
                            <div class="rounded-circle bg-white d-inline-flex align-items-center justify-content-center shadow-lg position-relative step-icon">
                                <span class="position-absolute top-0 start-0 translate-middle badge rounded-pill step-badge">
                                    Bước 3
                                </span>
                                <i class="bi bi-chat-dots-fill icon-gradient-3"></i>
                            </div>
                        </div>
                        <h5 class="fw-bold mb-3 step-title">Nhận lời giải chi tiết</h5>
                        <p class="small mb-3 opacity-90 step-desc">
                            Mentor gửi bài giải <strong>từng bước</strong> kèm <strong>hình ảnh</strong> và <strong>giải thích</strong>
                        </p>
                        <div class="d-flex align-items-center justify-content-center gap-2 text-white-50 small">
                            <i class="bi bi-check-circle-fill"></i>
                            <span>AI gợi ý bài giải</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bước 4: Đánh giá -->
            <div class="col-md-6 col-lg-3">
                <div class="card border-0 shadow-lg hover-card step-card step-4 h-100 position-relative overflow-hidden">
                    <div class="position-absolute step-decor"></div>
                    <div class="card-body text-center p-4 text-white position-relative">
                        <div class="mb-4">
                            <div class="rounded-circle bg-white d-inline-flex align-items-center justify-content-center shadow-lg position-relative step-icon">
                                <span class="position-absolute top-0 start-0 translate-middle badge rounded-pill step-badge">
                                    Bước 4
                                </span>
                                <i class="bi bi-star-fill icon-gradient-4" style="font-size: 3rem;"></i>
                            </div>
                        </div>
                        <h5 class="fw-bold mb-3 step-title">Đánh giá & Hoàn tất</h5>
                        <p class="small mb-3 opacity-90 step-desc">
                            <strong>Thanh toán an toàn</strong> và đánh giá để xây dựng cộng đồng uy tín
                        </p>
                        <div class="d-flex align-items-center justify-content-center gap-2 text-white-50 small">
                            <i class="bi bi-check-circle-fill"></i>
                            <span>Bảo vệ 100% quyền lợi</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Thống kê hệ thống - Section cuối cùng trước footer -->
<div class="row mt-5 mb-5">
    <div class="col-lg-10 mx-auto">
        <div class="text-center mb-5">
            <h2 class="fw-bold mb-3 hero-title" style="font-size: 2.5rem;">
                <i class="bi bi-graph-up-arrow me-2"></i>
                Con số ấn tượng
            </h2>
            <p class="lead text-muted">Những thành tựu chúng tôi đạt được cùng cộng đồng</p>
        </div>
        
        <div class="row g-4 text-center">
            <div class="col-md-6 col-lg-3">
                <div class="card border-0 shadow-lg hover-card h-100 stats-card stats-1">
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <i class="bi bi-people-fill stats-icon icon-blue"></i>
                        </div>
