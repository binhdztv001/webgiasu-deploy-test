@model Webgiasu.Models.ViewModels.EditScheduleViewModel

@{
    ViewData["Title"] = "Chỉnh sửa lịch trao đổi";
    Layout = "~/Views/Shared/_SchoolLayout.cshtml";
}

<div class="dashboard-container">
    <!-- Page Header -->
    <div class="page-header">
        <h2><i class="bi bi-pencil-square me-2 text-warning"></i>Chỉnh sửa lịch trao đổi</h2>
        <p class="text-muted mb-0">Cập nhật thông tin buổi trao đổi</p>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header bg-warning text-white">
                    <h5 class="mb-0"><i class="bi bi-clipboard me-2"></i>Thông tin lịch trao đổi</h5>
                </div>
                <div class="card-body">
                    <form asp-action="EditSchedule" method="post">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="ClassId" />

                        <!-- Lớp học (read-only) -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-book text-warning"></i> Lớp học
                            </label>
                            <input type="text" class="form-control" value="@Model.ClassName" readonly />
                            <small class="text-muted">Không thể thay đổi lớp học sau khi tạo lịch</small>
                        </div>

                        <!-- Tiêu đề -->
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-semibold">
                                <i class="bi bi-card-heading text-warning"></i> Tiêu đề <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Title" class="form-control" required />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <!-- Ngày và Giờ -->
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label asp-for="ScheduleDate" class="form-label fw-semibold">
                                    <i class="bi bi-calendar3 text-warning"></i> Ngày <span class="text-danger">*</span>
                                </label>
                                <input asp-for="ScheduleDate" type="date" class="form-control" required />
                                <span asp-validation-for="ScheduleDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">
                                    <i class="bi bi-clock text-warning"></i> Giờ bắt đầu <span class="text-danger">*</span>
                                </label>
                                <input name="StartTime" type="time" class="form-control" 
                                       value="@Model.StartTime.ToString(@"hh\:mm")" required />
                                <span asp-validation-for="StartTime" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label fw-semibold">
                                    <i class="bi bi-clock-fill text-warning"></i> Giờ kết thúc <span class="text-danger">*</span>
                                </label>
                                <input name="EndTime" type="time" class="form-control" 
                                       value="@Model.EndTime.ToString(@"hh\:mm")" required />
                                <span asp-validation-for="EndTime" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Hình thức -->
                        <div class="mb-3">
                            <label asp-for="MeetingType" class="form-label fw-semibold">
                                <i class="bi bi-geo-alt text-warning"></i> Hình thức <span class="text-danger">*</span>
                            </label>
                            <select asp-for="MeetingType" class="form-select" id="meetingTypeSelect" required>
                                <option value="Online">Online</option>
                                <option value="Offline">Offline</option>
                            </select>
                            <span asp-validation-for="MeetingType" class="text-danger"></span>
                        </div>

                        <!-- Địa điểm/Link -->
                        <div class="mb-3">
                            <label asp-for="Location" class="form-label fw-semibold" id="locationLabel">
                                <i class="bi bi-link-45deg text-warning"></i> Link meeting / Địa điểm
                            </label>
                            <input asp-for="Location" class="form-control" id="locationInput" />
                            <span asp-validation-for="Location" class="text-danger"></span>
                            <small class="text-muted" id="locationHint">Nhập link hoặc địa điểm</small>
                        </div>

                        <!-- Nội dung -->
                        <div class="mb-3">
                            <label asp-for="Content" class="form-label fw-semibold">
                                <i class="bi bi-file-text text-warning"></i> Nội dung trao đổi
                            </label>
                            <textarea asp-for="Content" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="Content" class="text-danger"></span>
                        </div>

                        <!-- Ghi chú -->
                        <div class="mb-3">
                            <label asp-for="Notes" class="form-label fw-semibold">
                                <i class="bi bi-sticky text-warning"></i> Ghi chú
                            </label>
                            <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                            <span asp-validation-for="Notes" class="text-danger"></span>
                        </div>

                        <!-- Trạng thái -->
                        <div class="mb-3">
                            <label asp-for="Status" class="form-label fw-semibold">
                                <i class="bi bi-activity text-warning"></i> Trạng thái <span class="text-danger">*</span>
                            </label>
                            <select asp-for="Status" class="form-select" required>
                                <option value="0">Sắp tới</option>
                                <option value="1">Đang diễn ra</option>
                                <option value="2">Đã hoàn thành</option>
                                <option value="3">Đã hủy</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>

                        <!-- Buttons -->
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-warning">
                                <i class="bi bi-check-circle me-2"></i>Lưu thay đổi
                            </button>
                            <a asp-controller="School" asp-action="ScheduleDetails" asp-route-id="@Model.Id" class="btn btn-secondary">
                                <i class="bi bi-x-circle me-2"></i>Hủy
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <div class="card mb-3">
                <div class="card-header bg-info text-white">
                    <h6 class="mb-0"><i class="bi bi-info-circle me-2"></i>Thông tin</h6>
                </div>
                <div class="card-body">
                    <div class="mb-2">
                        <small class="text-muted">Lớp học:</small>
                        <div class="fw-semibold">@Model.ClassName</div>
                    </div>
                    <hr>
                    <small class="text-muted">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        Lưu ý: Thay đổi thời gian có thể ảnh hưởng đến lịch của học sinh và mentor
                    </small>
                </div>
            </div>

            <div class="card">
                <div class="card-header bg-warning text-white">
                    <h6 class="mb-0"><i class="bi bi-lightbulb me-2"></i>Gợi ý</h6>
                </div>
                <div class="card-body">
                    <ul class="mb-0 small">
                        <li class="mb-2">Thông báo cho học sinh khi thay đổi thời gian</li>
                        <li class="mb-2">Đảm bảo link meeting hoạt động trước buổi trao đổi</li>
                        <li>Cập nhật trạng thái sau khi buổi trao đổi kết thúc</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Dynamic label and placeholder based on meeting type
        const meetingTypeSelect = document.getElementById('meetingTypeSelect');
        const locationLabel = document.getElementById('locationLabel');
        const locationInput = document.getElementById('locationInput');
        const locationHint = document.getElementById('locationHint');

        function updateLocationLabels() {
            if (meetingTypeSelect.value === 'Online') {
                locationLabel.innerHTML = '<i class="bi bi-link-45deg text-warning"></i> Link meeting (Google Meet, Zoom...)';
                locationInput.placeholder = 'https://meet.google.com/xxx-yyyy-zzz';
                locationHint.textContent = 'Nhập link cuộc họp online';
            } else {
                locationLabel.innerHTML = '<i class="bi bi-geo-alt text-warning"></i> Địa điểm cụ thể';
                locationInput.placeholder = 'VD: Phòng 101, Tòa nhà A, Trường XYZ';
                locationHint.textContent = 'Nhập địa chỉ gặp mặt trực tiếp';
            }
        }

        meetingTypeSelect.addEventListener('change', updateLocationLabels);

        // Trigger on page load
        updateLocationLabels();
    </script>
}
