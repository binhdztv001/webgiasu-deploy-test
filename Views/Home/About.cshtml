@{
    ViewData["Title"] = "Giới thiệu";
}

<div class="about-header text-center">
    <div class="container">
        <h1 class="display-4 fw-bold mb-3">
            <i class="bi bi-info-circle-fill me-3"></i>Giới thiệu dự án
        </h1>
        <p class="lead mb-0">Nền tảng kết nối học sinh và mentor - Dân chủ hóa giáo dục cho mọi người</p>
    </div>
</div>

<div class="container">
    <!-- Tổng quan dự án -->
    <div class="info-guide row mb-5">
        <div class="col-lg-10 mx-auto">
            <div class="card border-0 shadow-lg">
                <div class="card-body p-5">
                    <h2 class="fw-bold mb-4 text-center">
                        <i class="bi bi-lightbulb me-2"></i>Tổng quan dự án
                    </h2>
                    <p class="lead text-muted mb-4 text-justify">
                        <strong>Learn with Mentor</strong> là nền tảng kết nối học sinh và mentor được xây dựng với sứ mệnh dân chủ hóa giáo dục, 
                        mang đến cơ hội học tập chất lượng cao và chi phí hợp lý cho mọi học sinh Việt Nam. 
                        Không chỉ là nơi giải đáp bài tập, chúng tôi còn tạo ra một cộng đồng học tập năng động 
                        với các tính năng kết nối, giao tiếp và chia sẻ kiến thức.
                    </p>
                    
                    <div class="row g-4 mt-4">
                        <div class="col-md-4">
                            <div class="feature-box text-center">
                                <i class="bi bi-bullseye text-primary"></i>
                                <h5 class="fw-bold mt-3 mb-3">Mục tiêu</h5>
                                <p class="text-muted mb-0">
                                    Xây dựng cộng đồng học tập toàn diện, kết nối hàng triệu học sinh với đội ngũ mentor giàu kinh nghiệm
                                </p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="feature-box text-center">
                                <i class="bi bi-gem text-success"></i>
                                <h5 class="fw-bold mt-3 mb-3">Giá trị cốt lõi</h5>
                                <p class="text-muted mb-0">
                                    Minh bạch, công bằng, chất lượng được đảm bảo qua hệ thống đánh giá nghiêm ngặt
                                </p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="feature-box text-center">
                                <i class="bi bi-trophy text-warning"></i>
                                <h5 class="fw-bold mt-3 mb-3">Đóng góp</h5>
                                <p class="text-muted mb-0">
                                    Tạo việc làm cho sinh viên, nâng cao chất lượng giáo dục, ứng dụng công nghệ 4.0
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Các đối tượng sử dụng -->
    <div class="mb-5">
        <h2 class="fw-bold text-center mb-5">
            <i class="bi bi-people-fill me-2"></i>Đối tượng sử dụng
        </h2>
        
        <div class="row g-4">
            <!-- Học sinh -->
            <div class="col-md-6 col-lg-3">
                <div class="card role-card h-100 shadow">
                    <div class="card-body p-4">
                        <div class="role-icon role-icon-student">
                            <i class="bi bi-person-circle"></i>
                        </div>
                        <h4 class="text-center fw-bold mb-3">Học sinh</h4>
                        <ul class="list-unstyled">
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Đăng bài toán dễ dàng</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Nhận lời giải chi tiết</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Giá cả hợp lý</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>AI gợi ý bài giải</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Thanh toán QR tiện lợi</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Mentor -->
            <div class="col-md-6 col-lg-3">
                <div class="card role-card h-100 shadow">
                    <div class="card-body p-4">
                        <div class="role-icon role-icon-mentor">
                            <i class="bi bi-mortarboard"></i>
                        </div>
                        <h4 class="text-center fw-bold mb-3">Mentor</h4>
                        <ul class="list-unstyled">
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Làm việc linh hoạt</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Thu nhập hấp dẫn</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Phát triển kỹ năng</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Hệ thống đánh giá minh bạch</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>AI hỗ trợ giải bài</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Nhà trường -->
            <div class="col-md-6 col-lg-3">
                <div class="card role-card h-100 shadow">
                    <div class="card-body p-4">
                        <div class="role-icon role-icon-school">
                            <i class="bi bi-building"></i>
                        </div>
                        <h4 class="text-center fw-bold mb-3">Nhà trường</h4>
                        <ul class="list-unstyled">
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Quản lý học sinh</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Theo dõi tiến trình học tập</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Báo cáo chi tiết</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Thống kê hiệu quả</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Hỗ trợ đa dạng</li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Quản trị viên -->
            <div class="col-md-6 col-lg-3">
                <div class="card role-card h-100 shadow">
                    <div class="card-body p-4">
                        <div class="role-icon role-icon-enterprise">
                            <i class="bi bi-shield-check"></i>
                        </div>
                        <h4 class="text-center fw-bold mb-3">Doanh nghiệp</h4>
                        <ul class="list-unstyled">
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Hợp tác với nhà trường</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Tạo tài khoản Mentor</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Xem thông tin lớp học</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Xem các lịch trao đổi</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Thống kê hiệu quả</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tính năng nổi bật -->
    <div class="row mb-5">
        <div class="col-lg-10 mx-auto">
            <h2 class="fw-bold text-center mb-5">
                <i class="bi bi-stars me-2"></i>Tính năng nổi bật
            </h2>

            <div class="row g-4">
                <div class="col-md-6">
                    <div class="card border-0 shadow">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center mb-3">
                                <div class="rounded-circle d-inline-flex align-items-center justify-content-center me-3 icon-gradient-purple">
                                    <i class="bi bi-robot text-white"></i>
                                </div>
                                <h4 class="fw-bold mb-0">AI gợi ý bài giải</h4>
                            </div>
                            <p class="text-muted mb-0">
                                Hệ thống AI thông minh tự động gợi ý bài giải cho học sinh và hỗ trợ mentor trong quá trình giải bài, 
                                giúp tiết kiệm thời gian và nâng cao chất lượng học tập.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card border-0 shadow">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center mb-3">
                                <div class="rounded-circle d-inline-flex align-items-center justify-content-center me-3 icon-gradient-green">
                                    <i class="bi bi-qr-code-scan text-white"></i>
                                </div>
                                <h4 class="fw-bold mb-0">Thanh toán QR</h4>
                            </div>
                            <p class="text-muted mb-0">
                                Thanh toán nhanh chóng, an toàn qua mã QR với các ví điện tử phổ biến như MoMo, ZaloPay, VNPay. 
                                Giao dịch được mã hóa và bảo mật cao nhất.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card border-0 shadow">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center mb-3">
                                <div class="rounded-circle d-inline-flex align-items-center justify-content-center me-3 icon-gradient-violet">
                                    <i class="bi bi-people text-white"></i>
                                </div>
                                <h4 class="fw-bold mb-0">Kết nối & Kết bạn</h4>
                            </div>
                            <p class="text-muted mb-0">
                                Học sinh kết bạn với học sinh để trao đổi học tập, chia sẻ kinh nghiệm. 
                                Mentor kết nối với mentor để thảo luận công việc, nâng cao kỹ năng giảng dạy.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card border-0 shadow">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center mb-3">
                                <div class="rounded-circle d-inline-flex align-items-center justify-content-center me-3 icon-gradient-pink">
                                    <i class="bi bi-chat-dots text-white"></i>
                                </div>
                                <h4 class="fw-bold mb-0">Diễn đàn Cộng đồng</h4>
                            </div>
                            <p class="text-muted mb-0">
                                Diễn đàn cho phép đăng chủ đề, thảo luận với danh tính ẩn danh, 
                                bảo vệ thông tin cá nhân, tạo không gian an toàn để chia sẻ và học hỏi.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Call to Action -->
    <div class="text-center mb-5">
        <div class="card border-0 shadow-lg position-relative overflow-hidden">
            <!-- Animated gradient background -->
            <div class="position-absolute w-100 h-100 cta-bg"></div>
            <div class="card-body p-5 position-relative">
                <h3 class="fw-bold text-white mb-3">
                    Sẵn sàng bắt đầu hành trình học tập của bạn?
                </h3>
                <p class="text-white mb-4">
                    Tham gia cộng đồng hơn 1,500 học sinh và Mentor ngay hôm nay
                </p>
                <div class="d-flex justify-content-center gap-3 flex-wrap">
                    <a href="/Account/Register?role=Student" class="btn btn-lg px-5 py-3 btn-cta-student">
                        <i class="bi bi-person-plus me-2"></i>Đăng ký làm Học sinh
                    </a>
                    <a href="/Account/Register?role=Tutor" class="btn btn-lg px-5 py-3 btn-cta-mentor">
                        <i class="bi bi-briefcase me-2"></i>Trở thành Mentor
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
