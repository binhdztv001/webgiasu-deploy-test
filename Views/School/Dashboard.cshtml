@{
    ViewData["Title"] = "Trang chủ - Nhà trường";
    Layout = "~/Views/Shared/_SchoolLayout.cshtml";
}

<div class="dashboard-container">
    <!-- Page Header -->
    <div class="page-header">
        <h2><i class="bi bi-house-door me-2 text-warning"></i>Trang chủ - Nhà trường</h2>
        <p class="text-muted">Xem tổng quan và quản lý hệ thống lớp học</p>
    </div>

    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-6 col-lg-3">
            <div class="card stat-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small mb-1">Tổng số lớp học</div>
                            <h3 class="mb-0 fw-bold">@ViewBag.TotalClasses</h3>
                            <small class="text-success">
                                <i class="bi bi-arrow-up"></i> Hoạt động
                            </small>
                        </div>
                        <div class="stat-icon bg-warning bg-opacity-10 text-warning">
                            <i class="bi bi-collection"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card stat-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small mb-1">Học sinh</div>
                            <h3 class="mb-0 fw-bold">@ViewBag.TotalStudents</h3>
                            <small class="text-info">
                                <i class="bi bi-people"></i> Tham gia
                            </small>
                        </div>
                        <div class="stat-icon bg-info bg-opacity-10 text-info">
                            <i class="bi bi-mortarboard"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card stat-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small mb-1">Mentor</div>
                            <h3 class="mb-0 fw-bold">@ViewBag.TotalTutors</h3>
                            <small class="text-success">
                                <i class="bi bi-person-check"></i> Sẵn sàng
                            </small>
                        </div>
                        <div class="stat-icon bg-success bg-opacity-10 text-success">
                            <i class="bi bi-person-badge"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card stat-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small mb-1">Lớp đang diễn ra</div>
                            <h3 class="mb-0 fw-bold">@ViewBag.ActiveClasses</h3>
                            <small class="text-warning">
                                <i class="bi bi-arrow-repeat"></i> Đang học
                            </small>
                        </div>
                        <div class="stat-icon bg-warning bg-opacity-10 text-warning">
                            <i class="bi bi-clock-history"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row g-3 mb-4">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-lightning me-2"></i>Thao tác nhanh</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <a asp-controller="School" asp-action="CreateClass" class="text-decoration-none">
                                <div class="d-flex align-items-center p-3 bg-warning bg-opacity-10 rounded">
                                    <div class="me-3">
                                        <div class="rounded-circle bg-warning text-white d-inline-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                            <i class="bi bi-plus-circle fs-4"></i>
                                        </div>
                                    </div>
                                    <div>
                                        <h6 class="mb-1 fw-bold text-warning">Tạo lớp học mới</h6>
                                        <small class="text-muted">Thêm lớp học và phân công Mentor</small>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-6">
                            <a asp-controller="School" asp-action="ManageClasses" class="text-decoration-none">
                                <div class="d-flex align-items-center p-3 bg-info bg-opacity-10 rounded">
                                    <div class="me-3">
                                        <div class="rounded-circle bg-info text-white d-inline-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                            <i class="bi bi-people fs-4"></i>
                                        </div>
                                    </div>
                                    <div>
                                        <h6 class="mb-1 fw-bold text-info">Quản lý lớp học</h6>
                                        <small class="text-muted">Xem và chỉnh sửa thông tin lớp</small>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-6">
                            <a asp-controller="School" asp-action="ManageMentors" class="text-decoration-none">
                                <div class="d-flex align-items-center p-3 bg-primary bg-opacity-10 rounded">
                                    <div class="me-3">
                                        <div class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                            <i class="bi bi-person-badge fs-4"></i>
                                        </div>
                                    </div>
                                    <div>
                                        <h6 class="mb-1 fw-bold text-primary">Quản lý Mentor</h6>
                                        <small class="text-muted">Tạo và quản lý tài khoản Mentor</small>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-6">
                            <a asp-controller="School" asp-action="Statistics" class="text-decoration-none">
                                <div class="d-flex align-items-center p-3 bg-success bg-opacity-10 rounded">
                                    <div class="me-3">
                                        <div class="rounded-circle bg-success text-white d-inline-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                            <i class="bi bi-bar-chart fs-4"></i>
                                        </div>
                                    </div>
                                    <div>
                                        <h6 class="mb-1 fw-bold text-success">Thống kê chi tiết</h6>
                                        <small class="text-muted">Xem báo cáo và phân tích</small>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <div class="col-md-6">
                            <a asp-controller="School" asp-action="Settings" class="text-decoration-none">
                                <div class="d-flex align-items-center p-3 bg-secondary bg-opacity-10 rounded">
                                    <div class="me-3">
                                        <div class="rounded-circle bg-secondary text-white d-inline-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                            <i class="bi bi-gear fs-4"></i>
                                        </div>
                                    </div>
                                    <div>
                                        <h6 class="mb-1 fw-bold text-secondary">Cài đặt</h6>
                                        <small class="text-muted">Quản lý thông tin nhà trường</small>
                                    </div>
                                </div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Hướng dẫn</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <div class="d-flex align-items-start">
                            <div class="rounded-circle bg-warning text-white d-inline-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; flex-shrink: 0;">
                                <strong>1</strong>
                            </div>
                            <div>
                                <h6 class="fw-semibold mb-1">Tạo lớp học</h6>
                                <small class="text-muted">Thiết lập thông tin lớp và thêm học sinh</small>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="d-flex align-items-start">
                            <div class="rounded-circle bg-warning text-white d-inline-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; flex-shrink: 0;">
                                <strong>2</strong>
                            </div>
                            <div>
                                <h6 class="fw-semibold mb-1">Phân công Mentor</h6>
                                <small class="text-muted">Gán Mentor phù hợp cho lớp học</small>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="d-flex align-items-start">
                            <div class="rounded-circle bg-warning text-white d-inline-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; flex-shrink: 0;">
                                <strong>3</strong>
                            </div>
                            <div>
                                <h6 class="fw-semibold mb-1">Theo dõi tiến độ</h6>
                                <small class="text-muted">Xem báo cáo và thống kê học tập</small>
                            </div>
                        </div>
                    </div>
                    <div>
                        <div class="d-flex align-items-start">
                            <div class="rounded-circle bg-warning text-white d-inline-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; flex-shrink: 0;">
                                <strong>4</strong>
                            </div>
                            <div>
                                <h6 class="fw-semibold mb-1">Quản lý hiệu quả</h6>
                                <small class="text-muted">Đánh giá và cải thiện chất lượng</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Classes List -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-book me-2"></i>Danh sách lớp học</h5>
                    <a asp-controller="School" asp-action="ManageClasses" class="btn btn-sm btn-warning">
                        <i class="bi bi-list-ul me-1"></i>Xem tất cả
                    </a>
                </div>
                <div class="card-body">
                    @if (ViewBag.RecentClasses != null && ((List<Webgiasu.Models.ViewModels.ClassViewModel>)ViewBag.RecentClasses).Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Tên lớp học</th>
                                        <th>Môn học</th>
                                        <th>Mentor</th>
                                        <th>Số học sinh</th>
                                        <th>Ngày bắt đầu</th>
                                        <th>Trạng thái</th>
                                        <th>Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var classItem in (List<Webgiasu.Models.ViewModels.ClassViewModel>)ViewBag.RecentClasses)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="rounded-circle bg-warning bg-opacity-10 text-warning d-inline-flex align-items-center justify-content-center me-2" style="width: 40px; height: 40px;">
                                                        <i class="bi bi-book"></i>
                                                    </div>
                                                    <strong>@classItem.ClassName</strong>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge bg-info">@classItem.Subject</span>
                                            </td>
                                            <td>@classItem.TutorName</td>
                                            <td>
                                                <span class="badge bg-primary">@classItem.StudentCount học sinh</span>
                                            </td>
                                            <td>@classItem.StartDate</td>
                                            <td>
                                                @if (classItem.Status == ClassStatus.Active)
                                                {
                                                    <span class="badge bg-success">
                                                        <i class="bi bi-check-circle me-1"></i>Đang hoạt động
                                                    </span>
                                                }
                                                else if (classItem.Status == ClassStatus.Completed)
                                                {
                                                    <span class="badge bg-secondary">
                                                        <i class="bi bi-check-all me-1"></i>Đã hoàn thành
                                                    </span>
                                                }
                                                else if (classItem.Status == ClassStatus.Upcoming)
                                                {
                                                    <span class="badge bg-info">
                                                        <i class="bi bi-clock me-1"></i>Sắp bắt đầu
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">
                                                        <i class="bi bi-x-circle me-1"></i>Đã hủy
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                <a asp-controller="School" asp-action="ClassDetails" asp-route-id="@classItem.Id" 
                                                   class="btn btn-sm btn-warning">
                                                    <i class="bi bi-eye me-1"></i>Chi tiết
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted py-5">
                            <i class="bi bi-inbox fs-1 mb-3 d-block"></i>
                            <p>Chưa có lớp học nào</p>
                            <a asp-controller="School" asp-action="CreateClass" class="btn btn-warning">
                                <i class="bi bi-plus-circle me-2"></i>Tạo lớp học đầu tiên
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
