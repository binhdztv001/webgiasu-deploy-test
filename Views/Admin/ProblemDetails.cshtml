@model Webgiasu.Models.ViewModels.ProblemDetailsViewModel
@{
    ViewData["Title"] = "Chi tiết bài toán - Admin";
    Layout = "_AdminLayout";
}

<div class="row">
    <div class="col-lg-8">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0"><i class="bi bi-file-text me-2"></i>Thông tin bài toán</h4>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong><i class="bi bi-hash"></i> Mã bài:</strong> #@Model.Problem.Id
                    </div>
                    <div class="col-md-6 text-end">
                        @{
                            var statusClass = Model.Problem.Status switch
                            {
                                Webgiasu.Models.ProblemStatus.WaitingForTutor => "warning",
                                Webgiasu.Models.ProblemStatus.InProgress => "info",
                                Webgiasu.Models.ProblemStatus.Solved => "success",
                                _ => "secondary"
                            };
                            var statusText = Model.Problem.Status switch
                            {
                                Webgiasu.Models.ProblemStatus.WaitingForTutor => "Chờ Mentor",
                                Webgiasu.Models.ProblemStatus.InProgress => "Đang giải",
                                Webgiasu.Models.ProblemStatus.Solved => "Đã giải",
                                _ => "Khác"
                            };
                        }
                        <span class="badge bg-@statusClass fs-6">@statusText</span>
                    </div>
                </div>

                <h3 class="mb-3">@Model.Problem.Title</h3>
                
                <div class="mb-3">
                    <span class="badge bg-secondary me-2">
                        <i class="bi bi-book me-1"></i>@Model.Problem.Type
                    </span>
                    
                    @{
                        // ✅ EDUCATION LEVEL BADGE
                        var levelBadgeClass = Model.Problem.Difficulty switch
                        {
                            Webgiasu.Models.DifficultyLevel.TieuHoc => "primary",
                            Webgiasu.Models.DifficultyLevel.THCS => "info",
                            Webgiasu.Models.DifficultyLevel.THPT => "warning",
                            Webgiasu.Models.DifficultyLevel.DaiHoc => "success",
                            _ => "secondary"
                        };

                        var levelText = Model.Problem.Difficulty switch
                        {
                            Webgiasu.Models.DifficultyLevel.TieuHoc => "Tiểu học",
                            Webgiasu.Models.DifficultyLevel.THCS => "THCS",
                            Webgiasu.Models.DifficultyLevel.THPT => "THPT",
                            Webgiasu.Models.DifficultyLevel.DaiHoc => "Đại học",
                            _ => "N/A"
                        };

                        var levelIcon = Model.Problem.Difficulty switch
                        {
                            Webgiasu.Models.DifficultyLevel.TieuHoc => "1-circle",
                            Webgiasu.Models.DifficultyLevel.THCS => "2-circle",
                            Webgiasu.Models.DifficultyLevel.THPT => "3-circle",
                            Webgiasu.Models.DifficultyLevel.DaiHoc => "mortarboard",
                            _ => "question-circle"
                        };
                    }
                    
                    <span class="badge bg-@levelBadgeClass me-2">
                        <i class="bi bi-@levelIcon me-1"></i>@levelText
                    </span>
                    
                    <span class="badge bg-success fs-6">
                        <i class="bi bi-currency-dollar me-1"></i>@Model.Problem.Price.ToString("N0") đ
                    </span>
                </div>

                <hr />

                <h5 class="mb-3"><i class="bi bi-file-text me-2"></i>Mô tả chi tiết:</h5>
                <div class="bg-light p-3 rounded border">
                    <div class="problem-description">
                        @Html.Raw(Model.Problem.Description)
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.Problem.ImageUrl) && Model.Problem.ImageUrl != "/images/default.jpg")
                {
                    <div class="mt-4">
                        <h5><i class="bi bi-image me-2"></i>Hình ảnh:</h5>
                        <div class="text-center">
                            <img src="@Model.Problem.ImageUrl" alt="Problem image" class="img-fluid rounded shadow-sm" style="max-height: 400px;" />
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.Problem.AttachmentFile))
                {
                    <div class="mt-4">
                        <h5><i class="bi bi-paperclip me-2"></i>File đính kèm:</h5>
                        <div class="alert alert-info d-flex align-items-center">
                            <i class="bi bi-file-earmark-pdf fs-3 me-3"></i>
                            <div class="flex-grow-1">
                                <strong>Tài liệu bài toán</strong>
                                <p class="mb-0 small text-muted">@Model.Problem.AttachmentFile</p>
                            </div>
                            <a href="@Model.Problem.AttachmentFile" target="_blank" class="btn btn-sm btn-primary">
                                <i class="bi bi-download me-1"></i>Tải xuống
                            </a>
                        </div>
                    </div>
                }

                <hr />

                <div class="row mt-4">
                    <div class="col-md-6">
                        <div class="border-start border-primary border-4 ps-3 mb-3">
                            <label class="text-muted small mb-1">
                                <i class="bi bi-calendar-plus me-1"></i>Ngày đăng
                            </label>
                            <h6 class="fw-bold mb-0">@Model.Problem.CreatedDate.ToString("dd/MM/yyyy HH:mm")</h6>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="border-start border-danger border-4 ps-3 mb-3">
                            <label class="text-muted small mb-1">
                                <i class="bi bi-calendar-event me-1"></i>Deadline
                            </label>
                            <h6 class="fw-bold text-danger mb-0">@Model.Problem.Deadline.ToString("dd/MM/yyyy HH:mm")</h6>
                            @if (Model.Problem.Deadline < DateTime.Now && Model.Problem.Status != Webgiasu.Models.ProblemStatus.Solved)
                            {
                                <small class="text-danger">
                                    <i class="bi bi-exclamation-triangle me-1"></i>Đã quá hạn
                                </small>
                            }
                            else
                            {
                                var timeLeft = Model.Problem.Deadline - DateTime.Now;
                                if (timeLeft.TotalHours > 0 && timeLeft.TotalHours < 24)
                                {
                                    <small class="text-warning">
                                        <i class="bi bi-clock me-1"></i>Còn @((int)timeLeft.TotalHours) giờ
                                    </small>
                                }
                                else if (timeLeft.TotalDays > 0)
                                {
                                    <small class="text-success">
                                        <i class="bi bi-clock me-1"></i>Còn @((int)timeLeft.TotalDays) ngày
                                    </small>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.Solution != null)
        {
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="bi bi-check-circle me-2"></i>Lời giải từ Mentor</h5>
                </div>
                <div class="card-body">
                    <div class="bg-light p-3 rounded border">
                        <div class="solution-content">
                            @Html.Raw(Model.Solution.Content)
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Solution.FileUrl))
                    {
                        <div class="mt-3 alert alert-info">
                            <i class="bi bi-file-earmark-arrow-down me-2"></i>
                            <strong>File lời giải:</strong> 
                            <a href="@Model.Solution.FileUrl" target="_blank" class="alert-link ms-2">
                                <i class="bi bi-download me-1"></i>Tải xuống
                            </a>
                        </div>
                    }

                    <hr />

                    <div class="d-flex align-items-center text-muted">
                        <i class="bi bi-clock me-2"></i>
                        <small>Gửi lúc: @Model.Solution.SubmittedDate.ToString("dd/MM/yyyy HH:mm")</small>
                    </div>

                    @if (Model.Solution.Rating.HasValue)
                    {
                        <div class="alert alert-success mt-3 mb-0">
                            <h6 class="mb-2">
                                <i class="bi bi-star-fill text-warning me-1"></i>
                                Đánh giá từ học sinh: 
                                <strong>@Model.Solution.Rating/5</strong>
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= Model.Solution.Rating)
                                    {
                                        <i class="bi bi-star-fill text-warning"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-star text-muted"></i>
                                    }
                                }
                            </h6>
                            @if (!string.IsNullOrEmpty(Model.Solution.Feedback))
                            {
                                <p class="mb-0">
                                    <i class="bi bi-chat-left-quote me-1"></i>
                                    <strong>Nhận xét:</strong> <em>"@Model.Solution.Feedback"</em>
                                </p>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning mt-3 mb-0">
                            <i class="bi bi-hourglass-split me-2"></i>Chưa có đánh giá từ học sinh
                        </div>
                    }
                </div>
            </div>
        }
        else if (Model.Problem.Status == Webgiasu.Models.ProblemStatus.WaitingForTutor)
        {
            <div class="alert alert-warning">
                <i class="bi bi-info-circle me-2"></i>
                <strong>Trạng thái:</strong> Đang chờ Mentor nhận bài
            </div>
        }
        else if (Model.Problem.Status == Webgiasu.Models.ProblemStatus.InProgress)
        {
            <div class="alert alert-info">
                <i class="bi bi-hourglass-split me-2"></i>
                <strong>Trạng thái:</strong> Mentor đang giải bài toán
            </div>
        }
    </div>

    <div class="col-lg-4">
        <!-- Student Card -->
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-primary text-white">
                <h6 class="mb-0"><i class="bi bi-person-circle me-2"></i>Thông tin Học sinh</h6>
            </div>
            <div class="card-body">
                <div class="text-center mb-3">
                    <div class="rounded-circle bg-primary bg-opacity-10 d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                        <i class="bi bi-person-fill text-primary" style="font-size: 2.5rem;"></i>
                    </div>
                </div>
                <h6 class="text-center fw-bold mb-3">@Model.Student?.FullName</h6>
                
                <div class="border-start border-primary border-3 ps-3 mb-2">
                    <small class="text-muted">Username</small>
                    <p class="mb-0"><i class="bi bi-person-badge me-1"></i>@Model.Student?.Username</p>
                </div>
                
                <div class="border-start border-primary border-3 ps-3 mb-2">
                    <small class="text-muted">Email</small>
                    <p class="mb-0"><i class="bi bi-envelope me-1"></i>@Model.Student?.Email</p>
                </div>
                
                <div class="border-start border-primary border-3 ps-3 mb-2">
                    <small class="text-muted">Số điện thoại</small>
                    <p class="mb-0"><i class="bi bi-phone me-1"></i>@Model.Student?.PhoneNumber</p>
                </div>

                @if (Model.Student?.Level.HasValue == true)
                {
                    <div class="border-start border-primary border-3 ps-3">
                        <small class="text-muted">Cấp học</small>
                        <p class="mb-0">
                            <i class="bi bi-mortarboard me-1"></i>
                            @(Model.Student.Level.Value switch
                            {
                                Webgiasu.Models.EducationLevel.TieuHoc => "Tiểu học",
                                Webgiasu.Models.EducationLevel.THCS => "THCS",
                                Webgiasu.Models.EducationLevel.THPT => "Đại học",
                                _ => "Chưa cập nhật"
                            })
                        </p>
                    </div>
                }
            </div>
        </div>

        @if (Model.AssignedTutor != null)
        {
            <!-- Tutor Card -->
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-success text-white">
                    <h6 class="mb-0"><i class="bi bi-mortarboard me-2"></i>Thông tin Mentor</h6>
                </div>
                <div class="card-body">
                    <div class="text-center mb-3">
                        <div class="rounded-circle bg-success bg-opacity-10 d-inline-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                            <i class="bi bi-mortarboard text-success" style="font-size: 2.5rem;"></i>
                        </div>
                    </div>
                    <h6 class="text-center fw-bold mb-3">@Model.AssignedTutor.FullName</h6>
                    
                    <div class="border-start border-success border-3 ps-3 mb-2">
                        <small class="text-muted">Username</small>
                        <p class="mb-0"><i class="bi bi-person-badge me-1"></i>@Model.AssignedTutor.Username</p>
                    </div>
                    
                    <div class="border-start border-success border-3 ps-3 mb-2">
                        <small class="text-muted">Email</small>
                        <p class="mb-0"><i class="bi bi-envelope me-1"></i>@Model.AssignedTutor.Email</p>
                    </div>
                    
                    <div class="border-start border-success border-3 ps-3 mb-2">
                        <small class="text-muted">Số điện thoại</small>
                        <p class="mb-0"><i class="bi bi-phone me-1"></i>@Model.AssignedTutor.PhoneNumber</p>
                    </div>

                    @if (Model.AssignedTutor.Level.HasValue)
                    {
                        <div class="border-start border-success border-3 ps-3">
                            <small class="text-muted">Cấp giảng dạy</small>
                            <p class="mb-0">
                                <i class="bi bi-mortarboard me-1"></i>
                                @(Model.AssignedTutor.Level.Value switch
                                {
                                    Webgiasu.Models.EducationLevel.TieuHoc => "Tiểu học",
                                    Webgiasu.Models.EducationLevel.THCS => "THCS",
                                    Webgiasu.Models.EducationLevel.THPT => "Đại học",
                                    _ => "Chưa cập nhật"
                                })
                            </p>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Payment Info -->
        @if (Model.Payment != null)
        {
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-warning text-dark">
                    <h6 class="mb-0"><i class="bi bi-credit-card me-2"></i>Thông tin thanh toán</h6>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted">Số tiền:</span>
                        <strong class="text-success fs-5">@Model.Payment.Amount.ToString("N0") đ</strong>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted">Trạng thái:</span>
                        @{
                            var paymentStatusClass = Model.Payment.Status switch
                            {
                                Webgiasu.Models.PaymentStatus.Pending => "warning",
                                Webgiasu.Models.PaymentStatus.Completed => "success",
                                Webgiasu.Models.PaymentStatus.Failed => "danger",
                                _ => "secondary"
                            };
                            var paymentStatusText = Model.Payment.Status switch
                            {
                                Webgiasu.Models.PaymentStatus.Pending => "Chờ thanh toán",
                                Webgiasu.Models.PaymentStatus.Completed => "Đã thanh toán",
                                Webgiasu.Models.PaymentStatus.Failed => "Thất bại",
                                _ => "N/A"
                            };
                        }
                        <span class="badge bg-@paymentStatusClass">@paymentStatusText</span>
                    </div>
                    @if (Model.Payment.CompletedDate.HasValue)
                    {
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted small">Thanh toán lúc:</span>
                            <span class="small">@Model.Payment.CompletedDate.Value.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Action Buttons -->
        <div class="d-grid gap-2">
            <a asp-action="ManageProblems" class="btn btn-outline-primary">
                <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
            </a>
            <a asp-action="Dashboard" class="btn btn-outline-secondary">
                <i class="bi bi-house me-1"></i>Dashboard
            </a>
            <hr class="my-2" />
            <form asp-action="DeleteProblem" method="post" class="mb-0">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Problem.Id" />
                <button type="submit" class="btn btn-danger w-100" onclick="return confirm('⚠️ Xác nhận xóa bài toán #@Model.Problem.Id?\n\nHành động này không thể hoàn tác!')">
                    <i class="bi bi-trash me-1"></i>Xóa bài toán
                </button>
            </form>
        </div>
    </div>
</div>

<style>
    .problem-description, .solution-content {
        line-height: 1.6;
    }

    .problem-description img, .solution-content img {
        max-width: 100%;
        height: auto;
        border-radius: 8px;
        margin: 10px 0;
    }

    .problem-description pre, .solution-content pre {
        background-color: #f8f9fa;
        padding: 15px;
        border-radius: 8px;
        overflow-x: auto;
    }

    .problem-description code, .solution-content code {
        background-color: #e9ecef;
        padding: 2px 6px;
        border-radius: 4px;
        font-size: 0.9em;
    }
</style>
