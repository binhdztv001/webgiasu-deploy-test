@model List<Webgiasu.Models.Problem>
@{
    ViewData["Title"] = "Danh sách bài đã gửi";
    Layout = "_StudentLayout";
    var groupProblemIds = ViewBag.GroupProblemIds as HashSet<int> ?? new HashSet<int>();
}

<div>
    <!-- Page Header -->
    <div class="page-header d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 gap-3">
        <div class="mb-2 mb-md-0">
            <h5 class="fw-bold mb-1 text-dark">
                <i class="bi bi-journal-text text-primary me-2"></i>Danh sách bài đã gửi
            </h5>
            <p class="text-muted mb-0 small">Quản lý và theo dõi các bài toán của bạn</p>
        </div>
        <div class="d-grid mt-3 mt-sm-0 align-self-stretch align-self-sm-auto">
            <a asp-action="CreateProblem" class="btn btn-primary w-100">
                <i class="bi bi-plus-circle me-1"></i> Gửi bài mới
            </a>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100 hover-card stat-card">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <div class="bg-warning bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center icon-wrapper-lg">
                                <i class="bi bi-hourglass-split text-warning fs-4"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-0 ms-md-3 mt-2 mt-md-0">
                            <h6 class="text-muted mb-1 small">Chờ Mentor</h6>
                            <h3 class="fw-bold mb-0 text-warning">@Model.Count(p => p.Status == Webgiasu.Models.ProblemStatus.WaitingForTutor)</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100 hover-card stat-card">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <div class="bg-info bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center icon-wrapper-lg">
                                <i class="bi bi-gear-fill text-info fs-4"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-0 ms-md-3 mt-2 mt-md-0">
                            <h6 class="text-muted mb-1 small">Đang giải</h6>
                            <h3 class="fw-bold mb-0 text-info">@Model.Count(p => p.Status == Webgiasu.Models.ProblemStatus.InProgress)</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100 hover-card stat-card">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <div class="bg-success bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center icon-wrapper-lg">
                                <i class="bi bi-check-circle-fill text-success fs-4"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-0 ms-md-3 mt-2 mt-md-0">
                            <h6 class="text-muted mb-1 small">Hoàn thành</h6>
                            <h3 class="fw-bold mb-0 text-success">@Model.Count(p => p.Status == Webgiasu.Models.ProblemStatus.Solved)</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm h-100 hover-card stat-card">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center icon-wrapper-lg">
                                <i class="bi bi-list-check text-primary fs-4"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1 ms-0 ms-md-3 mt-2 mt-md-0">
                            <h6 class="text-muted mb-1 small">Tổng bài</h6>
                            <h3 class="fw-bold mb-0 text-primary">@Model.Count</h3>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Education Level Statistics -->
    @if (Model.Any())
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-bottom py-3">
                        <h6 class="mb-0 fw-bold text-dark">
                            <i class="bi bi-mortarboard text-primary me-2"></i>Thống kê theo cấp học
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-6 col-md-3">
                                <div class="text-center p-3 border rounded">
                                    <i class="bi bi-1-circle text-primary fs-2 mb-2"></i>
                                    <h4 class="fw-bold mb-1">@Model.Count(p => p.Difficulty == Webgiasu.Models.DifficultyLevel.TieuHoc)</h4>
                                    <p class="text-muted mb-0 small">Tiểu học</p>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="text-center p-3 border rounded">
                                    <i class="bi bi-2-circle text-info fs-2 mb-2"></i>
                                    <h4 class="fw-bold mb-1">@Model.Count(p => p.Difficulty == Webgiasu.Models.DifficultyLevel.THCS)</h4>
                                    <p class="text-muted mb-0 small">THCS</p>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="text-center p-3 border rounded">
                                    <i class="bi bi-3-circle text-warning fs-2 mb-2"></i>
                                    <h4 class="fw-bold mb-1">@Model.Count(p => p.Difficulty == Webgiasu.Models.DifficultyLevel.THPT)</h4>
                                    <p class="text-muted mb-0 small">THPT</p>
                                </div>
                            </div>
                            <div class="col-6 col-md-3">
                                <div class="text-center p-3 border rounded">
                                    <i class="bi bi-mortarboard text-success fs-2 mb-2"></i>
                                    <h4 class="fw-bold mb-1">@Model.Count(p => p.Difficulty == Webgiasu.Models.DifficultyLevel.DaiHoc)</h4>
                                    <p class="text-muted mb-0 small">Đại học</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filter Section -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Lọc theo trạng thái</label>
                        <select class="form-select form-select-sm" id="filterStatus">
                            <option value="">Tất cả</option>
                            <option value="WaitingForTutor">Chờ Mentor</option>
                            <option value="InProgress">Đang giải</option>
                            <option value="Solved">Hoàn thành</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Lọc theo cấp học</label>
                        <select class="form-select form-select-sm" id="filterLevel">
                            <option value="">Tất cả</option>
                            <option value="TieuHoc">Tiểu học</option>
                            <option value="THCS">THCS</option>
                            <option value="THPT">THPT</option>
                            <option value="DaiHoc">Đại học</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Tìm kiếm</label>
                        <input type="text" class="form-control form-control-sm" id="searchInput" placeholder="Tìm theo tiêu đề...">
                    </div>
                </div>
            </div>
        </div>

        <!-- Problems Grid -->
        <div class="row" id="problemsGrid">
            @foreach (var problem in Model.OrderByDescending(p => p.CreatedDate))
            {
                var isGroupProblem = groupProblemIds.Contains(problem.Id);
                
                // ✅ EDUCATION LEVEL DISPLAY
                var levelBadgeClass = problem.Difficulty switch
                {
                    Webgiasu.Models.DifficultyLevel.TieuHoc => "primary",
                    Webgiasu.Models.DifficultyLevel.THCS => "info",
                    Webgiasu.Models.DifficultyLevel.THPT => "warning",
                    Webgiasu.Models.DifficultyLevel.DaiHoc => "success",
                    _ => "secondary"
                };

                var levelText = problem.Difficulty switch
                {
                    Webgiasu.Models.DifficultyLevel.TieuHoc => "Tiểu học",
                    Webgiasu.Models.DifficultyLevel.THCS => "THCS",
                    Webgiasu.Models.DifficultyLevel.THPT => "THPT",
                    Webgiasu.Models.DifficultyLevel.DaiHoc => "Đại học",
                    _ => "N/A"
                };

                var statusClass = problem.Status switch
                {
                    Webgiasu.Models.ProblemStatus.WaitingForTutor => "warning",
                    Webgiasu.Models.ProblemStatus.InProgress => "info",
                    Webgiasu.Models.ProblemStatus.Solved => "success",
                    _ => "secondary"
                };

                var statusText = problem.Status switch
                {
                    Webgiasu.Models.ProblemStatus.WaitingForTutor => "Chờ Mentor",
                    Webgiasu.Models.ProblemStatus.InProgress => "Đang giải",
                    Webgiasu.Models.ProblemStatus.Solved => "Hoàn thành",
                    _ => "Khác"
                };

                <div class="col-md-6 col-lg-4 mb-4 problem-card" 
                     data-status="@problem.Status" 
                     data-level="@problem.Difficulty" 
                     data-title="@problem.Title.ToLower()">
                    <div class="card border-0 shadow-sm h-100 @(isGroupProblem ? "border-success border-2" : "") hover-card">
                        <div class="card-body">
                            <!-- Header with Status -->
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div class="flex-grow-1">
                                    <h6 class="fw-bold mb-0 text-truncate" title="@problem.Title">
                                        @problem.Title
                                    </h6>
                                </div>
                                <span class="badge bg-@statusClass ms-2">
                                    @statusText
                                </span>
                            </div>

                            <!-- Group Badge -->
                            @if (isGroupProblem)
                            {
                                <div class="mb-2">
                                    <span class="badge bg-success" title="Bài toán nhóm">
                                        <i class="bi bi-people-fill me-1"></i>Bài nhóm
                                    </span>
                                </div>
                            }

                            <!-- Description -->
                            <p class="text-muted small mb-3 text-truncate-2">
                                @{
                                    var plainText = System.Text.RegularExpressions.Regex.Replace(problem.Description ?? "", "<.*?>", string.Empty);
                                    var truncatedText = plainText.Length > 150 ? plainText.Substring(0, 150) + "..." : plainText;
                                }
                                @truncatedText
                            </p>

                            <!-- Badges Row -->
                            <div class="d-flex gap-2 mb-3 flex-wrap">
                                <span class="badge bg-secondary">
                                    <i class="bi bi-book me-1"></i>@problem.Type
                                </span>
                                <span class="badge bg-@levelBadgeClass">
                                    <i class="bi bi-mortarboard me-1"></i>@levelText
                                </span>
                                <span class="badge bg-success">
                                    <i class="bi bi-currency-dollar"></i>@problem.Price.ToString("N0") đ
                                </span>
                            </div>

                            <!-- Date & Deadline -->
                            <div class="small mb-3">
                                <div class="d-flex justify-content-between text-muted">
                                    <span>
                                        <i class="bi bi-calendar-plus me-1"></i>
                                        @problem.CreatedDate.ToString("dd/MM/yyyy")
                                    </span>
                                    <span class="@(problem.Deadline < DateTime.Now && problem.Status != Webgiasu.Models.ProblemStatus.Solved ? "text-danger fw-bold" : "")">
                                        <i class="bi bi-calendar-event me-1"></i>
                                        @problem.Deadline.ToString("dd/MM/yyyy")
                                    </span>
                                </div>
                            </div>

                            <hr class="my-2" />

                            <!-- Action Buttons -->
                            <div class="d-flex gap-2 flex-wrap">
                                <a asp-action="ProblemDetails" asp-route-id="@problem.Id" class="btn btn-sm btn-primary flex-grow-1">
                                    <i class="bi bi-eye me-1"></i> Xem
                                </a>
                                
                                @if (isGroupProblem)
                                {
                                    var groupId = ViewBag.ProblemGroupMap != null && ((Dictionary<int, int>)ViewBag.ProblemGroupMap).ContainsKey(problem.Id) 
                                        ? ((Dictionary<int, int>)ViewBag.ProblemGroupMap)[problem.Id] 
                                        : 0;
                                    
                                    if (groupId > 0)
                                    {
                                        <a asp-action="GroupDetails" asp-route-id="@groupId" class="btn btn-sm btn-success">
                                            <i class="bi bi-people-fill"></i>
                                        </a>
                                    }
                                }
                                
                                <!-- ✅ THÊM NÚT XEM APPLICATIONS -->
                                @if (problem.Status == Webgiasu.Models.ProblemStatus.WaitingForTutor)
                                {
                                    <a asp-action="ViewTutorApplications" 
                                       asp-route-problemId="@problem.Id" 
                                       class="btn btn-sm btn-warning flex-grow-1"
                                       title="Xem Mentor đăng ký">
                                        <i class="bi bi-people me-1"></i>Mentor 
                                        @{
                                            var appCountDict = ViewBag.ApplicationCounts as Dictionary<int, int>;
                                            var displayCount = appCountDict?.ContainsKey(problem.Id) == true 
                                                ? appCountDict[problem.Id] 
                                                : 0;
                                        }
                                        (@displayCount)
                                    </a>
                                    
                                    <a asp-action="EditProblem" asp-route-id="@problem.Id" 
                                       class="btn btn-sm btn-outline-warning" title="Chỉnh sửa">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                }
                                
                                @if (problem.Status == Webgiasu.Models.ProblemStatus.Solved)
                                {
                                    <a asp-action="RateTutor" asp-route-problemId="@problem.Id" class="btn btn-sm btn-warning" title="Đánh giá">
                                        <i class="bi bi-star"></i>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="text-center py-5">
            <div class="mb-4">
                <i class="bi bi-inbox text-muted empty-state-icon-lg"></i>
            </div>
            <h4 class="text-muted mb-2">Chưa có bài toán nào</h4>
            <p class="text-muted mb-4">Hãy gửi bài toán đầu tiên để nhận hỗ trợ từ Mentor!</p>
            <a asp-action="CreateProblem" class="btn btn-primary btn-lg">
                <i class="bi bi-plus-circle me-1"></i> Gửi bài mới
            </a>
        </div>
    }
</div>

@section Scripts {
    <script>
        // ✅ FILTER & SEARCH FUNCTIONALITY
        (function() {
            const filterStatus = document.getElementById('filterStatus');
            const filterLevel = document.getElementById('filterLevel');
            const searchInput = document.getElementById('searchInput');
            const problemCards = document.querySelectorAll('.problem-card');

            function applyFilters() {
                const statusValue = filterStatus?.value;
                const levelValue = filterLevel?.value;
                const searchValue = searchInput?.value.toLowerCase().trim();

                let visibleCount = 0;

                problemCards.forEach(card => {
                    const cardStatus = card.getAttribute('data-status');
                    const cardLevel = card.getAttribute('data-level');
                    const cardTitle = card.getAttribute('data-title');

                    let show = true;

                    // Filter by status
                    if (statusValue && cardStatus !== statusValue) {
                        show = false;
                    }

                    // Filter by level
                    if (levelValue && cardLevel !== levelValue) {
                        show = false;
                    }

                    // Filter by search
                    if (searchValue && !cardTitle.includes(searchValue)) {
                        show = false;
                    }

                    card.style.display = show ? '' : 'none';
                    if (show) visibleCount++;
                });

                console.log(`Hiển thị ${visibleCount}/${problemCards.length} bài toán`);
            }

            // Event listeners
            filterStatus?.addEventListener('change', applyFilters);
            filterLevel?.addEventListener('change', applyFilters);
            searchInput?.addEventListener('input', applyFilters);
        })();
    </script>
}
