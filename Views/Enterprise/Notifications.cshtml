@model List<Webgiasu.Models.Notification>
@{
    ViewData["Title"] = "Thông báo Doanh nghiệp";
    Layout = "_EnterpriseLayout";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4 px-3 px-md-0">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-bell text-brown me-2"></i>Thông báo
        </h2>
        <p class="text-muted mb-0">Quản lý và theo dõi các hoạt động trên hệ thống</p>
    </div>
    <div class="d-none d-md-block">
        <form asp-action="MarkAllNotificationsAsRead" method="post" id="markAllReadForm">
            <button type="submit" class="btn btn-pill" style="border: 2px solid #795548; color: #795548; background: transparent;">
                <i class="bi bi-check-all me-1"></i>Đánh dấu tất cả đã đọc
            </button>
        </form>
    </div>
</div>

<!-- Mobile Mark All Read Button -->
<div class="d-md-none mb-3 px-3">
    <button type="button" class="btn btn-sm w-100 py-2 border-brown text-brown" onclick="document.getElementById('markAllReadForm').submit()">
        <i class="bi bi-check-all me-1"></i>Đánh dấu tất cả đã đọc
    </button>
</div>

<div class="card shadow-sm border-0 rounded-12 overflow-hidden">
    <div class="card-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="list-group list-group-flush">
                @foreach (var notification in Model)
                {
                    var iconClass = notification.Type switch
                    {
                        Webgiasu.Models.NotificationType.EnterpriseMentorCreated => "bi-person-plus-fill",
                        Webgiasu.Models.NotificationType.EnterpriseSystemAlert => "bi-exclamation-triangle",
                        _ => "bi-bell"
                    };

                    var bgClass = notification.Type switch
                    {
                        Webgiasu.Models.NotificationType.EnterpriseMentorCreated => "bg-brown text-white",
                        Webgiasu.Models.NotificationType.EnterpriseSystemAlert => "bg-warning text-dark",
                        _ => "bg-light text-muted"
                    };

                    <a href="@(notification.Link ?? "#")" 
                       class="list-group-item list-group-item-action border-start-0 border-end-0 border-bottom py-3 px-4 @(!notification.IsRead ? "bg-light" : "")"
                       onclick="markAsRead(@notification.Id)">
                        <div class="d-flex align-items-start gap-3">
                            <div class="flex-shrink-0">
                                <div class="rounded-circle d-flex align-items-center justify-content-center" 
                                     style="width: 42px; height: 42px; @(notification.Type == Webgiasu.Models.NotificationType.EnterpriseMentorCreated ? "background: #795548; color: white;" : "background: #e9ecef;")">
                                    <i class="bi @iconClass @(notification.Type == Webgiasu.Models.NotificationType.EnterpriseMentorCreated ? "" : "text-brown") fs-5"></i>
                                </div>
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <h6 class="mb-0 fw-bold @(!notification.IsRead ? "text-dark" : "text-muted")">@notification.Title</h6>
                                    <small class="text-muted ms-2">@GetTimeAgo(notification.CreatedDate)</small>
                                </div>
                                <p class="mb-0 text-muted small">@notification.Message</p>
                                @if (!notification.IsRead)
                                {
                                    <span class="badge bg-danger mt-2" style="font-size: 0.65rem;">Mới</span>
                                }
                            </div>
                        </div>
                    </a>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <div class="mb-3">
                    <i class="bi bi-bell-slash text-muted" style="font-size: 3.5rem; opacity: 0.3;"></i>
                </div>
                <h5 class="text-muted">Không có thông báo nào</h5>
                <p class="text-muted small">Bạn sẽ nhận được thông báo khi có hoạt động mới trên hệ thống</p>
            </div>
        }
    </div>
</div>

@functions {
    string GetTimeAgo(DateTime dateTime)
    {
        var timeSpan = DateTime.Now - dateTime;
        if (timeSpan.TotalMinutes < 1) return "vừa xong";
        if (timeSpan.TotalMinutes < 60) return $"{(int)timeSpan.TotalMinutes} phút trước";
        if (timeSpan.TotalHours < 24) return $"{(int)timeSpan.TotalHours} giờ trước";
        if (timeSpan.TotalDays < 30) return $"{(int)timeSpan.TotalDays} ngày trước";
        return dateTime.ToString("dd/MM/yyyy");
    }
}

<script>
    function markAsRead(notificationId) {
        fetch(`/Enterprise/MarkNotificationAsRead/${notificationId}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            }
        });
    }
</script>

<style>
    .border-brown { border-color: #795548 !important; }
    .text-brown { color: #795548 !important; }
    .rounded-12 { border-radius: 12px; }
    
    .notification-item {
        transition: all 0.2s ease;
    }
    
    .notification-item:hover {
        background-color: rgba(121, 85, 72, 0.05) !important;
    }
    
    .notification-item.unread {
        border-left: 4px solid #795548 !important;
    }
</style>
