@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Panel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/animations.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dropdown-fix.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Webgiasu.styles.css" asp-append-version="true" />
    <style>
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
        }
    </style>
</head>
<body>
    @{
        var userName = Context.Session.GetString("UserName");
        var userRole = Context.Session.GetString("UserRole");
        var pendingCount = ViewBag.PendingTutorApprovals ?? 0;
    }

    <!-- Top Header -->
    <nav class="top-header">
        <div class="container-fluid px-4">
            <div class="d-flex align-items-center justify-content-between">
                <!-- Left: Logo & Toggle -->
                <div class="d-flex align-items-center">
                    <button class="btn btn-link text-white me-3" id="sidebarToggle">
                        <i class="bi bi-list fs-3"></i>
                    </button>
                    <a class="navbar-brand fw-bold text-white d-flex align-items-center" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-shield-check me-2 fs-4"></i>
                        <span class="d-none d-md-inline">Admin Panel</span>
                    </a>
                </div>

                <!-- Right: Actions -->
                <div class="d-flex align-items-center gap-3">
                    <!-- Notifications -->
                    @if (pendingCount > 0)
                    {
                        <div class="dropdown">
                            <button class="btn btn-link position-relative" type="button" data-bs-toggle="dropdown" style="color: rgba(255,255,255,0.9);">
                                <i class="bi bi-bell fs-5"></i>
                                <span class="position-absolute bottom-0 start-70 rounded-pill bg-warning px-1 py-0"
                                      style="font-size: 0.58rem;">
                                    @pendingCount
                                </span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end notification-dropdown">
                            <li class="dropdown-header" style="background: linear-gradient(135deg, #DC143C 0%, #FF1744 100%); padding: 1rem 1.25rem; margin: -0.5rem -0.5rem 0.5rem -0.5rem; border-radius: 12px 12px 0 0;">
                                <h6 class="mb-0 text-white">Thông báo</h6>
                            </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item notification-item" asp-action="PendingTutors">
                                        <div class="d-flex">
                                            <div class="notification-icon bg-warning">
                                                <i class="bi bi-person-check"></i>
                                            </div>
                                            <div class="notification-content">
                                                <p class="mb-1 fw-semibold">Mentor chờ duyệt</p>
                                                <small class="text-muted">@pendingCount Mentor cần phê duyệt</small>
                                            </div>
                                        </div>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <button class="btn btn-link position-relative" type="button" style="color: rgba(255,255,255,0.9);">
                            <i class="bi bi-bell fs-5"></i>
                        </button>
                    }

                    <!-- Live Clock -->
                    <div class="header-clock d-flex align-items-center gap-2 text-white px-3 py-2 rounded" 
                         style="background: rgba(255, 255, 255, 0.15); backdrop-filter: blur(10px);">
                        <i class="bi bi-clock fs-5"></i>
                        <div class="d-flex flex-column" style="line-height: 1.2;">
                            <span class="fw-semibold" id="currentTime" style="font-size: 0.95rem;">--:--:--</span>
                            <small style="font-size: 0.7rem; opacity: 0.9;" id="currentDate">--, -- -- ----</small>
                        </div>
                    </div>

                    <div class="dropdown">
                        <button class="btn btn-link text-white d-flex align-items-center gap-2 profile-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <img src="https://ui-avatars.com/api/?name=Admin&background=fff&color=DC143C&size=40" 
                                 class="rounded-circle profile-avatar" alt="Avatar" width="40" height="40">
                            <span class="d-none d-md-inline fw-semibold">@userName</span>
                            <i class="bi bi-chevron-down profile-chevron"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end profile-dropdown">
                            <li class="dropdown-header">
                                <div class="text-center py-2">
                                    <img src="https://ui-avatars.com/api/?name=@userName&background=DC143C&color=fff&size=60" 
                                         class="rounded-circle mb-2 profile-avatar-large" alt="Avatar" width="60" height="60">
                                    <h6 class="mb-0 fw-bold">@userName</h6>
                                    <small class="text-muted">Quản trị viên</small>
                                </div>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item profile-menu-item logout-item" asp-controller="Account" asp-action="Logout">
                                    <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <div class="layout-container">
        <div class="sidebar-overlay" id="sidebarOverlay"></div>

        <aside class="sidebar" id="sidebar">
            <div class="sidebar-content">
                <nav class="sidebar-nav">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="Dashboard">
                                <i class="bi bi-house"></i>
                                <span>Tổng quan</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="ManageUsers">
                                <i class="bi bi-people"></i>
                                <span>Quản lý người dùng</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="ManageTutors">
                                <i class="bi bi-mortarboard"></i>
                                <span>Quản lý Mentor</span>
                                @if (pendingCount > 0)
                                {
                                    <span class="position-absolute bottom-0 start-70 rounded-pill bg-danger px-1 py-0"
                                          style="font-size: 0.58rem;">
                                        @pendingCount
                                    </span>
                                }
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="ManageProblems">
                                <i class="bi bi-journal-text"></i>
                                <span>Quản lý bài giải</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="ManagePayments">
                                <i class="bi bi-credit-card"></i>
                                <span>Quản lý thanh toán</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="Reports">
                                <i class="bi bi-flag"></i>
                                <span>Báo cáo vi phạm</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="Statistics">
                                <i class="bi bi-bar-chart"></i>
                                <span>Thống kê</span>
                            </a>
                        </li>
                        <li class="nav-divider"></li>
                        <li class="nav-item">
                            <a class="nav-link" href="#" data-bs-toggle="modal" data-bs-target="#settingsModal">
                                <i class="bi bi-gear"></i>
                                <span>Cài đặt</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="Logs">
                                <i class="bi bi-clock-history"></i>
                                <span>Nhật ký hệ thống</span>
                            </a>
                        </li>
                    </ul>
                </nav>

                <div class="sidebar-footer">
                    <div class="card bg-gradient">
                        <div class="card-body text-center py-3">
                            <i class="bi bi-shield-check text-warning fs-2 mb-2"></i>
                            <p class="mb-1 fw-bold small">Hệ thống hoạt động tốt</p>
                            <p class="mb-0 text-muted small">Uptime: 99.9%</p>
                        </div>
                    </div>
                </div>
            </div>
        </aside>

        <main class="main-content">
            <div class="content-wrapper">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show custom-alert" role="alert">
                        <div class="d-flex align-items-center">
                            <div class="alert-icon-wrapper bg-success">
                                <i class="bi bi-check-lg"></i>
                            </div>
                            <div class="alert-content">
                                <strong>Thành công!</strong>
                                <span>@TempData["Success"]</span>
                            </div>
                        </div>
                        <div class="alert-progress"></div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show custom-alert" role="alert">
                        <div class="d-flex align-items-center">
                            <div class="alert-icon-wrapper bg-danger">
                                <i class="bi bi-x-lg"></i>
                            </div>
                            <div class="alert-content">
                                <strong>Lỗi!</strong>
                                <span>@TempData["Error"]</span>
                            </div>
                        </div>
                        <div class="alert-progress alert-progress-danger"></div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Warning"] != null)
                {
                    <div class="alert alert-warning alert-dismissible fade show custom-alert" role="alert">
                        <div class="d-flex align-items-center">
                            <div class="alert-icon-wrapper bg-warning">
                                <i class="bi bi-exclamation-lg"></i>
                            </div>
                            <div class="alert-content">
                                <strong>Chú ý!</strong>
                                <span>@TempData["Warning"]</span>
                            </div>
                        </div>
                        <div class="alert-progress alert-progress-warning"></div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Info"] != null)
                {
                    <div class="alert alert-info alert-dismissible fade show custom-alert" role="alert">
                        <div class="d-flex align-items-center">
                            <div class="alert-icon-wrapper bg-info">
                                <i class="bi bi-info-lg"></i>
                            </div>
                            <div class="alert-content">
                                <strong>Thông tin!</strong>
                                <span>@TempData["Info"]</span>
                            </div>
                        </div>
                        <div class="alert-progress alert-progress-info"></div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @RenderBody()

                <!-- Footer - Scroll cùng content, nền trắng ngang hết -->
                <footer class="content-footer">
                    <div class="d-flex justify-content-between align-items-center">
                        <p class="mb-0 text-muted small">
                            © 2025 Admin Panel - Learn with Mentor. All rights reserved.
                        </p>
                        <div class="d-flex gap-3">
                            <a href="#" class="text-muted small text-decoration-none">Hướng dẫn</a>
                            <a href="#" class="text-muted small text-decoration-none">Hỗ trợ</a>
                            <a href="#" class="text-muted small text-decoration-none">Liên hệ</a>
                        </div>
                    </div>
                </footer>
            </div>
        </main>
    </div>

    <!-- Settings Modal -->
    <div class="modal fade" id="settingsModal" tabindex="-1" aria-labelledby="settingsModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header" style="background: linear-gradient(135deg, #DC143C 0%, #FF1744 100%); color: white;">
                    <h5 class="modal-title" id="settingsModalLabel">
                        <i class="bi bi-gear me-2"></i>Cài đặt giao diện
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-4">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-palette me-2"></i>Chế độ hiển thị
                        </label>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-danger flex-fill theme-btn active" data-theme="light">
                                <i class="bi bi-sun me-2"></i>Sáng
                            </button>
                            <button type="button" class="btn btn-outline-danger flex-fill theme-btn" data-theme="dark">
                                <i class="bi bi-moon-stars me-2"></i>Tối
                            </button>
                        </div>
                    </div>
                    <hr>
                    <div class="mb-3">
                        <a href="/Admin/Settings" class="btn btn-outline-secondary w-100">
                            <i class="bi bi-sliders me-2"></i>Cài đặt nâng cao
                        </a>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <script>
        (function() {
            'use strict';
            
            function debounce(func, wait) {
                let timeout;
                return function executedFunction(...args) {
                    const later = () => {
                        clearTimeout(timeout);
                        func(...args);
                    };
                    clearTimeout(timeout);
                    timeout = setTimeout(later, wait);
                };
            }

            document.addEventListener('DOMContentLoaded', function() {
                const sidebar = document.getElementById('sidebar');
                const mainContent = document.querySelector('.main-content');
                const sidebarToggle = document.getElementById('sidebarToggle');
                const sidebarOverlay = document.getElementById('sidebarOverlay');
                const isMobile = window.innerWidth < 992;
                
                if (!isMobile) {
                    const sidebarState = localStorage.getItem('adminSidebarState');
                    if (sidebarState === 'collapsed') {
                        sidebar.classList.add('collapsed');
                        mainContent.classList.add('expanded');
                    }
                }
                
                sidebarToggle.addEventListener('click', function() {
                    const isMobileNow = window.innerWidth < 992;
                    
                    if (isMobileNow) {
                        sidebar.classList.toggle('show');
                        sidebarOverlay.classList.toggle('show');
                        document.body.style.overflow = sidebar.classList.contains('show') ? 'hidden' : '';
                    } else {
                        sidebar.classList.toggle('collapsed');
                        mainContent.classList.toggle('expanded');
                        
                        if (sidebar.classList.contains('collapsed')) {
                            localStorage.setItem('adminSidebarState', 'collapsed');
                        } else {
                            localStorage.setItem('adminSidebarState', 'expanded');
                        }
                    }
                });
                
                if (sidebarOverlay) {
                    sidebarOverlay.addEventListener('click', function() {
                        sidebar.classList.remove('show');
                        sidebarOverlay.classList.remove('show');
                        document.body.style.overflow = '';
                    });
                }
                
                if (isMobile) {
                    document.querySelectorAll('.sidebar-nav .nav-link').forEach(link => {
                        link.addEventListener('click', function() {
                            sidebar.classList.remove('show');
                            sidebarOverlay.classList.remove('show');
                            document.body.style.overflow = '';
                        });
                    });
                }
                
                const handleResize = debounce(function() {
                    const isMobileNow = window.innerWidth < 992;
                    
                    if (!isMobileNow) {
                        sidebar.classList.remove('show');
                        sidebarOverlay.classList.remove('show');
                        document.body.style.overflow = '';
                        
                        const sidebarState = localStorage.getItem('adminSidebarState');
                        if (sidebarState === 'collapsed') {
                            sidebar.classList.add('collapsed');
                            mainContent.classList.add('expanded');
                        } else {
                            sidebar.classList.remove('collapsed');
                            mainContent.classList.remove('expanded');
                        }
                    } else {
                        sidebar.classList.remove('collapsed');
                        mainContent.classList.remove('expanded');
                    }
                }, 150);
                
                window.addEventListener('resize', handleResize);

                // Enhanced dropdown positioning - fixed position with scroll tracking
                const initDropdownFix = () => {
                    const dropdowns = document.querySelectorAll('.top-header .dropdown');
                    
                    dropdowns.forEach(dropdown => {
                        const toggle = dropdown.querySelector('[data-bs-toggle="dropdown"]');
                        const menu = dropdown.querySelector('.dropdown-menu');
                        
                        if (!toggle || !menu) return;
                        
                        let scrollHandler = null;
                        let resizeHandler = null;
                        
                        const updatePosition = () => {
                            if (!menu.classList.contains('show')) return;
                            
                            const rect = toggle.getBoundingClientRect();
                            const menuHeight = menu.offsetHeight;
                            const viewportHeight = window.innerHeight;
                            
                            // Set fixed position
                            menu.style.position = 'fixed';
                            menu.style.transform = 'none';
                            
                            // Calculate top position (default below button)
                            let top = rect.bottom + 8;
                            
                            // If dropdown would go off screen, show it above
                            if (top + menuHeight > viewportHeight && rect.top - menuHeight - 8 > 0) {
                                top = rect.top - menuHeight - 8;
                            }
                            
                            menu.style.top = top + 'px';
                            
                            // Handle horizontal position
                            if (menu.classList.contains('dropdown-menu-end')) {
                                const right = window.innerWidth - rect.right;
                                menu.style.right = right + 'px';
                                menu.style.left = 'auto';
                            } else {
                                menu.style.left = rect.left + 'px';
                                menu.style.right = 'auto';
                            }
                        };
                        
                        // On dropdown show
                        toggle.addEventListener('shown.bs.dropdown', function() {
                            updatePosition();
                            
                            // Add scroll listener
                            scrollHandler = debounce(updatePosition, 10);
                            window.addEventListener('scroll', scrollHandler, { passive: true });
                            
                            // Add resize listener
                            resizeHandler = debounce(updatePosition, 10);
                            window.addEventListener('resize', resizeHandler, { passive: true });
                        });
                        
                        // On dropdown hide - cleanup
                        toggle.addEventListener('hidden.bs.dropdown', function() {
                            if (scrollHandler) {
                                window.removeEventListener('scroll', scrollHandler);
                                scrollHandler = null;
                            }
                            if (resizeHandler) {
                                window.removeEventListener('resize', resizeHandler);
                                resizeHandler = null;
                            }
                            
                            // Reset styles
                            menu.style.position = '';
                            menu.style.top = '';
                            menu.style.left = '';
                            menu.style.right = '';
                            menu.style.transform = '';
                        });
                    });
                };
                
                initDropdownFix();
                
                // Prevent dropdown close on scroll (optional)
                document.addEventListener('scroll', function(e) {
                    // Don't close dropdowns on scroll
                    e.stopPropagation();
                }, { passive: true, capture: true });
            });

            const currentPath = window.location.pathname.toLowerCase();
            document.querySelectorAll('.sidebar-nav .nav-link').forEach(link => {
                const href = link.getAttribute('href');
                if (href) {
                    const linkPath = href.toLowerCase();
                    if (currentPath === linkPath || 
                        (currentPath.startsWith(linkPath) && currentPath.charAt(linkPath.length) === '/')) {
                        link.classList.add('active');
                    }
                }
            });

            // Real-time clock for header
            function updateClock() {
                const now = new Date();
                
                // Format time HH:MM:SS
                const hours = String(now.getHours()).padStart(2, '0');
                const minutes = String(now.getMinutes()).padStart(2, '0');
                const seconds = String(now.getSeconds()).padStart(2, '0');
                const timeString = `${hours}:${minutes}:${seconds}`;
                
                // Format date
                const days = ['CN', 'T2', 'T3', 'T4', 'T5', 'T6', 'T7'];
                const dayName = days[now.getDay()];
                const day = String(now.getDate()).padStart(2, '0');
                const month = String(now.getMonth() + 1).padStart(2, '0');
                const year = now.getFullYear();
                const dateString = `${dayName}, ${day}/${month}/${year}`;
                
                // Update DOM
                const timeElement = document.getElementById('currentTime');
                const dateElement = document.getElementById('currentDate');
                
                if (timeElement) timeElement.textContent = timeString;
                if (dateElement) dateElement.textContent = dateString;
            }
            updateClock();
            setInterval(updateClock, 1000);

            // Auto hide alerts with smooth animation
            (function() {
                const alerts = document.querySelectorAll('.custom-alert');
                alerts.forEach(function(alert) {
                    // Start progress bar animation
                    const progress = alert.querySelector('.alert-progress');
                    if (progress) {
                        progress.style.animation = 'alertProgress 8s linear forwards';
                    }
                    
                    // Auto dismiss after 8 seconds
                    setTimeout(function() {
                        if (alert && alert.parentNode) {
                            alert.style.animation = 'alertSlideOut 0.5s ease-out forwards';
                            setTimeout(function() {
                                if (alert.parentNode) {
                                    alert.parentNode.removeChild(alert);
                                }
                            }, 500);
                        }
                    }, 8000);
                });
            })();
            
            // ========== THEME SETTINGS ==========
            function initThemeSettings() {
                const savedTheme = localStorage.getItem('theme') || 'light';
                applyTheme(savedTheme);
                setActiveThemeButton(savedTheme);
                
                document.querySelectorAll('.theme-btn').forEach(btn => {
                    btn.addEventListener('click', function() {
                        const theme = this.dataset.theme;
                        localStorage.setItem('theme', theme);
                        applyTheme(theme);
                        setActiveThemeButton(theme);
                    });
                });
            }
            
            function setActiveThemeButton(theme) {
                document.querySelectorAll('.theme-btn').forEach(btn => {
                    if (btn.dataset.theme === theme) {
                        btn.classList.remove('btn-outline-danger');
                        btn.classList.add('btn-danger', 'active');
                    } else {
                        btn.classList.remove('btn-danger', 'active');
                        btn.classList.add('btn-outline-danger');
                    }
                });
            }
            
            function applyTheme(theme) {
                if (theme === 'dark') {
                    document.body.classList.add('dark-mode');
                } else {
                    document.body.classList.remove('dark-mode');
                }
            }
            
            // Initialize theme on page load
            document.addEventListener('DOMContentLoaded', initThemeSettings);
        })();
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
