@{
    ViewData["Title"] = "Lớp học các trường";
    Layout = "~/Views/Shared/_EnterpriseLayout.cshtml";
}

<div class="dashboard-container">
    <!-- Page Header -->
    <div class="page-header d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div class="mb-2 mb-md-0">
            <h5 class="fw-bold mb-1 text-dark">
                <i class="bi bi-book text-success me-2"></i>Lớp học các trường
            </h5>
            <p class="text-muted mb-0 small">Xem thông tin tất cả lớp học trong hệ thống</p>
        </div>
        <a asp-action="Dashboard" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>

    <!-- Stats -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card stat-card border-0 shadow-sm">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 small text-uppercase">Tổng lớp học</p>
                            <h3 class="fw-bold mb-0 text-success">@ViewBag.AllClasses.Count</h3>
                        </div>
                        <div class="stat-icon bg-success bg-opacity-10 rounded">
                            <i class="bi bi-book text-success"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Classes List -->
    <div class="card border-0 shadow-sm">
        <div class="card-header py-3 bg-white border-bottom">
            <h6 class="mb-0 fw-bold text-dark">
                <i class="bi bi-list-ul text-success me-2"></i>Danh sách lớp học
            </h6>
        </div>
        <div class="card-body p-0">
            @if (ViewBag.AllClasses != null && ViewBag.AllClasses.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>STT</th>
                                <th>Tên lớp</th>
                                <th>Môn học</th>
                                <th>Trường</th>
                                <th>Mentor</th>
                                <th>Học sinh</th>
                                <th>Ngày bắt đầu</th>
                                <th>Trạng thái</th>
                                <th class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var index = 1;
                            }
                            @foreach (var c in ViewBag.AllClasses)
                            {
                                <tr>
                                    <td class="fw-semibold">@index</td>
                                    <td class="fw-semibold">@c.ClassName</td>
                                    <td><span class="badge bg-info">@c.Subject</span></td>
                                    <td>@c.SchoolName</td>
                                    <td>@c.TutorName</td>
                                    <td>
                                        <i class="bi bi-people me-1"></i>@c.StudentCount học sinh
                                    </td>
                                    <td>@c.StartDate</td>
                                    <td>
                                        @if (c.StatusText == "Đang hoạt động")
                                        {
                                            <span class="badge bg-success">@c.StatusText</span>
                                        }
                                        else if (c.StatusText == "Đã hoàn thành")
                                        {
                                            <span class="badge bg-primary">@c.StatusText</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">@c.StatusText</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="ClassDetail" asp-route-id="@c.ClassId" 
                                           class="btn btn-sm btn-primary" 
                                           title="Xem chi tiết">
                                            <i class="bi bi-eye me-1"></i>Chi tiết
                                        </a>
                                    </td>
                                </tr>
                                index++;
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-5 text-center">
                    <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                    <p class="text-muted mt-3">Chưa có lớp học nào trong hệ thống</p>
                </div>
            }
        </div>
    </div>
</div>


