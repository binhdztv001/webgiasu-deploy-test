<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Learn with Mentor</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/animations.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dropdown-fix.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/_Layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/responsive.css" asp-append-version="true" />
</head>
@{
    var path = Context.Request.Path.ToString();
    var roleQuery = Context.Request.Query["role"].ToString();
    var isHome = path == "/" || path == "/Home" || path == "/Home/Index";
    var isAbout = path == "/Home/About";
    var isGuide = path == "/Home/Guide";
    var isLoginWithRole = path == "/Account/Login" && (roleQuery == "Student" || roleQuery == "Tutor" || roleQuery == "Admin");
    var isRegisterWithRole = path == "/Account/Register" && (roleQuery == "Student" || roleQuery == "Tutor" || roleQuery == "Admin");
    var bodyClass = (isHome || isAbout || isGuide || isLoginWithRole || isRegisterWithRole) ? "home-background" : string.Empty;
    var theme = roleQuery.ToLower();
}
<body class="layout-root @bodyClass" data-theme="@theme">
    <header>
        <nav class="navbar navbar-expand-lg fixed-top">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-mortarboard-fill me-2"></i> Learn with Mentor
                </a>
                <button class="navbar-dark navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class=" navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    @{
                        var userName = Context.Session.GetString("UserName");
                        var userRole = Context.Session.GetString("UserRole");
                    }
                    
                    @if (!string.IsNullOrEmpty(userRole))
                    {
                        @if (userRole == "Student")
                        {
                            <ul class="navbar-nav me-auto">
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Student" asp-action="Dashboard">
                                        <i class="bi bi-speedometer2"></i> Dashboard
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Student" asp-action="CreateProblem">
                                        <i class="bi bi-plus-circle"></i> Đăng bài toán
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Student" asp-action="Payments">
                                        <i class="bi bi-credit-card"></i> Thanh toán
                                    </a>
                                </li>
                            </ul>
                        }
                        else if (userRole == "Tutor")
                        {
                            <ul class="navbar-nav me-auto">
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Tutor" asp-action="Dashboard">
                                        <i class="bi bi-speedometer2"></i> Dashboard
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Tutor" asp-action="AvailableProblems">
                                        <i class="bi bi-list-task"></i> Bài toán chờ giải
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Tutor" asp-action="MyProblems">
                                        <i class="bi bi-briefcase"></i> Bài của tôi
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Tutor" asp-action="MySolutions">
                                        <i class="bi bi-check-circle"></i> Lời giải đã gửi
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Tutor" asp-action="MyRatings">
                                        <i class="bi bi-star"></i> Đánh giá của tôi
                                    </a>
                                </li>
                            </ul>
                        }
                        else if (userRole == "Admin")
                        {
                            <ul class="navbar-nav me-auto">
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Admin" asp-action="Dashboard">
                                        <i class="bi bi-speedometer2"></i> Dashboard
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Admin" asp-action="PendingTutors">
                                        <i class="bi bi-person-check"></i> Duyệt Mentor
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Admin" asp-action="ManageProblems">
                                        <i class="bi bi-card-list"></i> Quản lý bài toán
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Admin" asp-action="ManagePayments">
                                        <i class="bi bi-currency-dollar"></i> Giao dịch
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Admin" asp-action="Statistics">
                                        <i class="bi bi-bar-chart"></i> Thống kê
                                    </a>
                                </li>
                            </ul>
                        }
                        
                        <ul class="navbar-nav ms-auto">
                            <!-- Public navigation links on the right -->
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="About">
                                    <i class="bi bi-info-circle"></i> Giới thiệu
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Guide">
                                    <i class="bi bi-book"></i> Hướng dẫn
                                </a>
                            </li>
                            
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle me-1"></i> @userName
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    @if (userRole == "Student")
                                    {
                                        <li><a class="dropdown-item" asp-controller="Student" asp-action="Profile"><i class="bi bi-person me-2"></i> Hồ sơ</a></li>
                                        <li><a class="dropdown-item" asp-controller="Student" asp-action="Settings"><i class="bi bi-gear me-2"></i> Cài đặt</a></li>
                                    }
                                    else if (userRole == "Tutor")
                                    {
                                        <li><a class="dropdown-item" asp-controller="Tutor" asp-action="Profile"><i class="bi bi-person me-2"></i> Hồ sơ</a></li>
                                        <li><a class="dropdown-item" asp-controller="Tutor" asp-action="Settings"><i class="bi bi-gear me-2"></i> Cài đặt</a></li>
                                    }
                                    else if (userRole == "Admin")
                                    {
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Profile"><i class="bi bi-person me-2"></i> Hồ sơ</a></li>
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Settings"><i class="bi bi-gear me-2"></i> Cài đặt</a></li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i> Đăng xuất</a></li>
                                </ul>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <!-- Public navigation links when not logged in -->
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="About">
                                    <i class="bi bi-info-circle"></i> Giới thiệu
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Guide">
                                    <i class="bi bi-book"></i> Hướng dẫn
                                </a>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>
    
    <div class="container main-content">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>
                <strong>Thành công!</strong> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <strong>Lỗi!</strong> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Warning"] != null)
        {
            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-circle-fill me-2"></i>
                <strong>Chú ý!</strong> @TempData["Warning"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Info"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show" role="alert">
                <i class="bi bi-info-circle-fill me-2"></i>
                <strong>Thông tin!</strong> @TempData["Info"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>


    <footer class="footer mt-auto py-4">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-3 mb-md-0">
                    <h5 class="fw-bold mb-3">
                        <i class="bi bi-mortarboard-fill me-2"></i>Learn with Mentor
                    </h5>
                    <p class="mb-0 text-dark">Nền tảng kết nối học sinh và Mentor chất lượng cao, giúp giải đáp bài tập nhanh chóng và hiệu quả.</p>
                </div>
                <div class="col-md-4 mb-3 mb-md-0">
                    <h5 class="fw-bold mb-3">Liên kết nhanh</h5>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a href="#" class="text-dark text-decoration-none"><i class="bi bi-chevron-right me-1"></i>Điều khoản sử dụng</a></li>
                        <li class="mb-2"><a href="#" class="text-dark text-decoration-none"><i class="bi bi-chevron-right me-1"></i>Chính sách bảo mật</a></li>
                        <li class="mb-2"><a href="#" class="text-dark text-decoration-none"><i class="bi bi-chevron-right me-1"></i>Liên hệ</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h5 class="fw-bold mb-3">Kết nối với chúng tôi</h5>
                    <div class="d-flex gap-3 mb-3">
                        <a href="#" class="text-dark fs-4"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="text-dark fs-4"><i class="bi bi-twitter"></i></a>
                        <a href="#" class="text-dark fs-4"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="text-dark fs-4"><i class="bi bi-youtube"></i></a>
                    </div>
                    <p class="mb-1 text-dark"><i class="bi bi-envelope me-2"></i>support@giasu.com</p>
                    <p class="mb-0 text-dark"><i class="bi bi-telephone me-2"></i>1900 xxxx</p>
                </div>
            </div>
            <hr class="my-4" style="border-color: rgba(0,0,0,0.08); opacity: .25;">
            <div class="text-center">
                <p class="mb-0 text-dark">&copy; 2025 - Learn with Mentor. All rights reserved.</p>
            </div>
        </div>
    </footer>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <script>
        // Auto hide alerts after 5 seconds
        setTimeout(function() {
            $('.alert').fadeOut('slow');
        }, 5000);

        // Add smooth scroll
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({ behavior: 'smooth' });
                }
            });
        });

        // Add animation to cards on scroll
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        };

        const observer = new IntersectionObserver(function(entries) {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('fade-in');
                }
            });
        }, observerOptions);

        document.querySelectorAll('.card, .row > div').forEach(el => {
            observer.observe(el);
        });
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
