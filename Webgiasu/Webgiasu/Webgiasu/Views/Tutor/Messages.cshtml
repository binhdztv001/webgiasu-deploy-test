@{
    ViewData["Title"] = "Tin nhắn";
    Layout = "_TutorLayout";
}

<div class="page-header mb-4">
    <h2 class="fw-bold">
        <i class="bi bi-chat-dots text-success"></i> Tin nhắn
    </h2>
    <p class="text-muted">Trò chuyện với học sinh và quản trị viên</p>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">
                    <i class="bi bi-people"></i> Danh sách trò chuyện
                </h5>
            </div>
            <div class="card-body p-0">
                <div class="list-group list-group-flush">
                    <a href="#" class="list-group-item list-group-item-action active">
                        <div class="d-flex w-100 justify-content-between">
                            <h6 class="mb-1">
                                <i class="bi bi-person-circle me-2"></i> Nguyễn Văn A
                            </h6>
                            <small>5 phút</small>
                        </div>
                        <p class="mb-1 small text-truncate">Em cần hỏi thêm về bài tập...</p>
                        <span class="badge bg-danger">2</span>
                    </a>
                    <a href="#" class="list-group-item list-group-item-action">
                        <div class="d-flex w-100 justify-content-between">
                            <h6 class="mb-1">
                                <i class="bi bi-person-circle me-2"></i> Trần Thị B
                            </h6>
                            <small>1 giờ</small>
                        </div>
                        <p class="mb-1 small text-truncate">Cảm ơn thầy đã giải đáp!</p>
                    </a>
                    <a href="#" class="list-group-item list-group-item-action">
                        <div class="d-flex w-100 justify-content-between">
                            <h6 class="mb-1">
                                <i class="bi bi-shield-check me-2"></i> Admin
                            </h6>
                            <small>2 giờ</small>
                        </div>
                        <p class="mb-1 small text-truncate">Thông báo: Tài khoản đã được duyệt</p>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-light">
                <div class="d-flex align-items-center">
                    <img src="https://ui-avatars.com/api/?name=Nguyen+Van+A&background=667eea&color=fff&size=40" 
                         class="rounded-circle me-3" width="40" height="40" alt="Avatar">
                    <div>
                        <h6 class="mb-0">Nguyễn Văn A</h6>
                        <small class="text-muted">
                            <i class="bi bi-circle-fill text-success" style="font-size: 8px;"></i> Đang hoạt động
                        </small>
                    </div>
                </div>
            </div>
            <div class="card-body" style="height: 400px; overflow-y: auto;">
                <div class="d-flex mb-3">
                    <img src="https://ui-avatars.com/api/?name=Nguyen+Van+A&background=667eea&color=fff&size=35" 
                         class="rounded-circle me-2" width="35" height="35" alt="Avatar">
                    <div>
                        <div class="bg-light p-3 rounded">
                            <p class="mb-0">Em chào thầy! Em muốn hỏi về bài tập phần đạo hàm ạ.</p>
                        </div>
                        <small class="text-muted">10:30 AM</small>
                    </div>
                </div>

                <div class="d-flex mb-3 flex-row-reverse">
                    <img src="https://ui-avatars.com/api/?name=Tutor&background=28a745&color=fff&size=35" 
                         class="rounded-circle ms-2" width="35" height="35" alt="Avatar">
                    <div class="text-end">
                        <div class="bg-success text-white p-3 rounded">
                            <p class="mb-0">Chào em! Thầy sẵn sàng giải đáp. Em gửi đề bài nhé.</p>
                        </div>
                        <small class="text-muted">10:32 AM</small>
                    </div>
                </div>

                <div class="d-flex mb-3">
                    <img src="https://ui-avatars.com/api/?name=Nguyen+Van+A&background=667eea&color=fff&size=35" 
                         class="rounded-circle me-2" width="35" height="35" alt="Avatar">
                    <div>
                        <div class="bg-light p-3 rounded">
                            <p class="mb-0">Dạ em cần giải bài toán tìm đạo hàm của hàm số y = x² + 3x - 5</p>
                        </div>
                        <small class="text-muted">10:33 AM</small>
                    </div>
                </div>
            </div>
            <div class="card-footer">
                <form>
                    <div class="input-group">
                        <input type="text" class="form-control" placeholder="Nhập tin nhắn..." />
                        <button class="btn btn-success" type="submit">
                            <i class="bi bi-send"></i> Gửi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="alert alert-info mt-4">
    <i class="bi bi-info-circle me-2"></i>
    <strong>Lưu ý:</strong> Tính năng tin nhắn real-time đang được phát triển. Hiện tại đây là giao diện demo.
</div>
