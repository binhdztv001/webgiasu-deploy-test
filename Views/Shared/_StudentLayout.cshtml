<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hệ thống Gia sư Online</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/animations.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/student-layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dropdown-fix.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Webgiasu.styles.css" asp-append-version="true" />
    <style>
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
        }
    </style>
</head>
<body>
    @{
        var userName = Context.Session.GetString("UserName");
        var userRole = Context.Session.GetString("UserRole");
    }

    <!-- Top Header -->
    <nav class="top-header">
        <div class="container-fluid px-4">
            <div class="d-flex align-items-center justify-content-between">
                <!-- Left: Logo & Toggle -->
                <div class="d-flex align-items-center">
                    <button class="btn btn-link text-white me-3" id="sidebarToggle">
                        <i class="bi bi-list fs-3"></i>
                    </button>
                    <a class="navbar-brand fw-bold text-white d-flex align-items-center" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-mortarboard-fill me-2 fs-4"></i>
                        <span class="d-none d-md-inline">Gia Sư Online</span>
                    </a>
                </div>

                <!-- Right: Actions -->
                <div class="d-flex align-items-center gap-3">
                    <!-- Notifications -->
                    <div class="dropdown">
                        <button class="btn btn-link position-relative" type="button" data-bs-toggle="dropdown" style="color: rgba(255,255,255,0.9);">
                            <i class="bi bi-bell fs-5"></i>
                            <span class="position-absolute bottom-0 start-70 rounded-pill bg-danger px-1 py-0"
                                  style="font-size: 0.58rem;">
                                5
                            </span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end notification-dropdown">
                        <li class="dropdown-header" style="background: linear-gradient(135deg, #2196F3 0%, #03A9F4 100%); padding: 1rem 1.25rem; margin: -0.5rem -0.5rem 0.5rem -0.5rem; border-radius: 12px 12px 0 0;">
                            <h6 class="mb-0 text-white">Thông báo</h6>
                        </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item notification-item" href="#">
                                    <div class="d-flex">
                                        <div class="notification-icon bg-success">
                                            <i class="bi bi-check-circle"></i>
                                        </div>
                                        <div class="notification-content">
                                            <p class="mb-1 fw-semibold">Bài giải đã sẵn sàng</p>
                                            <small class="text-muted">Gia sư đã hoàn thành bài toán của bạn</small>
                                            <small class="d-block text-muted mt-1">2 phút trước</small>
                                        </div>
                                    </div>
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item notification-item" href="#">
                                    <div class="d-flex">
                                        <div class="notification-icon bg-info">
                                            <i class="bi bi-person-check"></i>
                                        </div>
                                        <div class="notification-content">
                                            <p class="mb-1 fw-semibold">Gia sư đã nhận yêu cầu</p>
                                            <small class="text-muted">Thầy Nguyễn Văn A đã nhận bài toán</small>
                                            <small class="d-block text-muted mt-1">15 phút trước</small>
                                        </div>
                                    </div>
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item notification-item" href="#">
                                    <div class="d-flex">
                                        <div class="notification-icon bg-success">
                                            <i class="bi bi-credit-card"></i>
                                        </div>
                                        <div class="notification-content">
                                            <p class="mb-1 fw-semibold">Thanh toán thành công</p>
                                            <small class="text-muted">Giao dịch 150,000đ hoàn tất</small>
                                            <small class="d-block text-muted mt-1">1 giờ trước</small>
                                        </div>
                                    </div>
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item text-center text-primary fw-semibold" href="#">
                                    Xem tất cả thông báo
                                </a>
                            </li>
                        </ul>
                    </div>

                    <!-- Messages -->
                    @await Component.InvokeAsync("MessageDropdown")
                  
                    <!-- Profile -->
                    <div class="dropdown">
                        <button class="btn btn-link text-white d-flex align-items-center gap-2 profile-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <img src="https://ui-avatars.com/api/?name=@userName&background=fff&color=2196F3&size=40" 
                                 class="rounded-circle profile-avatar" alt="Avatar" width="40" height="40">
                            <span class="d-none d-md-inline fw-semibold">@userName</span>
                            <i class="bi bi-chevron-down profile-chevron"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end profile-dropdown">
                            <li class="dropdown-header">
                                <div class="text-center py-2">
                                    <img src="https://ui-avatars.com/api/?name=@userName&background=2196F3&color=fff&size=60" 
                                         class="rounded-circle mb-2 profile-avatar-large" alt="Avatar" width="60" height="60">
                                    <h6 class="mb-0 fw-bold">@userName</h6>
                                    <small class="text-muted">Học sinh</small>
                                </div>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item profile-menu-item" asp-controller="Student" asp-action="Profile">
                                    <i class="bi bi-person me-2"></i> Thông tin cá nhân
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item profile-menu-item" asp-controller="Student" asp-action="PaymentHistory">
                                    <i class="bi bi-clock-history me-2"></i> Lịch sử thanh toán
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item profile-menu-item" asp-controller="Student" asp-action="Settings">
                                    <i class="bi bi-gear me-2"></i> Cài đặt tài khoản
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item profile-menu-item logout-item" asp-controller="Account" asp-action="Logout">
                                    <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <div class="layout-container">
        <!-- Sidebar Overlay (for mobile) -->
        <div class="sidebar-overlay" id="sidebarOverlay"></div>

        <!-- Sidebar -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-content">
                <nav class="sidebar-nav">
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Student" asp-action="Dashboard">
                                <i class="bi bi-house"></i>
                                <span>Trang chủ</span>
                            </a>
                        </li>

                        @* <li class="nav-item">
                            <a class="nav-link" asp-controller="Student" asp-action="BrowseTutors">
                                <i class="bi bi-search"></i>
                                <span>Tìm gia sư</span>
                            </a>
                        </li> *@
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Student" asp-action="CreateProblem">
                                <i class="bi bi-plus-circle"></i>
                                <span>Đăng tải bài mới</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Student" asp-action="MyProblems">
                                <i class="bi bi-journal-text"></i>
                                <span class="position-relative">Danh sách bài đã gửi</span>
                                @* <span class="badge bg-primary rounded-pill px-1 py-1">3</span> *@

                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link position-relative" asp-controller="Student" asp-action="GroupInvites">
                                <i class="bi bi-people"></i>
                                <span>Nhóm học tập</span>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Student" asp-action="Messages">
                                <i class="bi bi-chat-dots"></i>
                                <span>Tin nhắn</span>
                                @* <span class="badge bg-danger ms-auto">3</span> *@
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link position-relative" asp-controller="Student" asp-action="FriendShip">
                                <i class="bi bi-people"></i>
                                <span>Bạn bè</span>

                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Student" asp-action="Community">
                                <i class="bi bi-people"></i>
                                <span>Cộng Đồng</span>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Student" asp-action="Payments">
                                <i class="bi bi-credit-card"></i>
                                <span>Thanh toán</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Student" asp-action="RateTutors">
                                <i class="bi bi-star"></i>
                                <span>Đánh giá gia sư</span>
                            </a>
                        </li>
                        <li class="nav-divider"></li>
                        <li class="nav-item">
                            <a class="nav-link" href="#" data-bs-toggle="modal" data-bs-target="#settingsModal">
                                <i class="bi bi-gear"></i>
                                <span>Cài đặt</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Support" asp-action="Index">
                                <i class="bi bi-question-circle"></i>
                                <span>Hỗ trợ / Support</span>
                            </a>
                        </li>
                    </ul>
                </nav>

                <!-- Sidebar Footer -->
                <div class="sidebar-footer">
                    <div class="card bg-gradient">
                        <div class="card-body text-center py-3">
                            <i class="bi bi-gift text-danger fs-2 mb-2"></i>
                            <p class="mb-1 fw-bold small">Ưu đãi đặc biệt!</p>
                            <p class="mb-0 text-muted small">Giảm 20% cho lần đầu</p>
                        </div>
                    </div>
                </div>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="main-content">
            <div class="content-wrapper">
                <!-- Alert Messages -->
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show custom-alert" role="alert">
                        <div class="d-flex align-items-center">
                            <div class="alert-icon-wrapper bg-success">
                                <i class="bi bi-check-lg"></i>
                            </div>
                            <div class="alert-content">
                                <strong>Thành công!</strong>
                                <span>@TempData["Success"]</span>
                            </div>
                        </div>
                        <div class="alert-progress"></div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show custom-alert" role="alert">
                        <div class="d-flex align-items-center">
                            <div class="alert-icon-wrapper bg-danger">
                                <i class="bi bi-x-lg"></i>
                            </div>
                            <div class="alert-content">
                                <strong>Lỗi!</strong>
                                <span>@TempData["Error"]</span>
                            </div>
                        </div>
                        <div class="alert-progress alert-progress-danger"></div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Warning"] != null)
                {
                    <div class="alert alert-warning alert-dismissible fade show custom-alert" role="alert">
                        <div class="d-flex align-items-center">
                            <div class="alert-icon-wrapper bg-warning">
                                <i class="bi bi-exclamation-lg"></i>
                            </div>
                            <div class="alert-content">
                                <strong>Chú ý!</strong>
                                <span>@TempData["Warning"]</span>
                            </div>
                        </div>
                        <div class="alert-progress alert-progress-warning"></div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Info"] != null)
                {
                    <div class="alert alert-info alert-dismissible fade show custom-alert" role="alert">
                        <div class="d-flex align-items-center">
                            <div class="alert-icon-wrapper bg-info">
                                <i class="bi bi-info-lg"></i>
                            </div>
                            <div class="alert-content">
                                <strong>Thông tin!</strong>
                                <span>@TempData["Info"]</span>
                            </div>
                        </div>
                        <div class="alert-progress alert-progress-info"></div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @RenderBody()

                            <!-- Footer - Scroll cùng content, nền trắng ngang hết -->
                            <footer class="content-footer">
                                <div class="d-flex justify-content-between align-items-center">
                                    <p class="mb-0 text-muted small">
                                        © 2025 Student Portal - Hệ thống Gia sư Online. All rights reserved.
                                    </p>
                                    <div class="d-flex gap-3">
                                        <a href="#" class="text-muted small text-decoration-none">Hướng dẫn</a>
                                        <a href="#" class="text-muted small text-decoration-none">Hỗ trợ</a>
                                        <a href="#" class="text-muted small text-decoration-none">Liên hệ</a>
                                    </div>
                                </div>
                            </footer>
                        </div>
                    </main>
                </div>

    <!-- Settings Modal -->
    <div class="modal fade" id="settingsModal" tabindex="-1" aria-labelledby="settingsModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header" style="background: linear-gradient(135deg, #2196F3 0%, #03A9F4 100%); color: white;">
                    <h5 class="modal-title" id="settingsModalLabel">
                        <i class="bi bi-gear me-2"></i>Cài đặt giao diện
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-4">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-palette me-2"></i>Chế độ hiển thị
                        </label>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-primary flex-fill theme-btn active" data-theme="light">
                                <i class="bi bi-sun me-2"></i>Sáng
                            </button>
                            <button type="button" class="btn btn-outline-primary flex-fill theme-btn" data-theme="dark">
                                <i class="bi bi-moon-stars me-2"></i>Tối
                            </button>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <!-- Initialize Bootstrap Dropdowns -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize all dropdowns manually
            var dropdownElementList = [].slice.call(document.querySelectorAll('[data-bs-toggle="dropdown"]'));
            dropdownElementList.forEach(function (dropdownToggleEl) {
                new bootstrap.Dropdown(dropdownToggleEl);
            });
            
            // Initialize all modals manually
            var modalElementList = [].slice.call(document.querySelectorAll('.modal'));
            modalElementList.forEach(function (modalEl) {
                // Pre-initialize modal
                new bootstrap.Modal(modalEl);
            });
            
            // Fix: Handle modal trigger buttons manually
            document.querySelectorAll('[data-bs-toggle="modal"]').forEach(function(btn) {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    var targetId = this.getAttribute('data-bs-target');
                    var modalEl = document.querySelector(targetId);
                    if (modalEl) {
                        var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                        modal.show();
                    }
                });
            });
        });
    </script>
    
    <script>
        (function() {
            'use strict';
            
            // ========== SIDEBAR TOGGLE ==========
            document.addEventListener('DOMContentLoaded', function() {
                const sidebar = document.getElementById('sidebar');
                const mainContent = document.querySelector('.main-content');
                const sidebarToggle = document.getElementById('sidebarToggle');
                const sidebarOverlay = document.getElementById('sidebarOverlay');
                
                if (!sidebar || !sidebarToggle) return;
                
                // Check if mobile
                const isMobile = () => window.innerWidth < 992;
                
                // Load saved state (desktop only)
                if (!isMobile()) {
                    const state = localStorage.getItem('studentSidebarState');
                    if (state === 'collapsed') {
                        sidebar.classList.add('collapsed');
                        mainContent.classList.add('expanded');
                    }
                }
                
                // Toggle sidebar
                sidebarToggle.addEventListener('click', function() {
                    if (isMobile()) {
                        // Mobile: slide in/out
                        sidebar.classList.toggle('show');
                        sidebarOverlay.classList.toggle('show');
                        document.body.style.overflow = sidebar.classList.contains('show') ? 'hidden' : '';
                    } else {
                        // Desktop: collapse/expand
                        sidebar.classList.toggle('collapsed');
                        mainContent.classList.toggle('expanded');
                        localStorage.setItem('studentSidebarState', 
                            sidebar.classList.contains('collapsed') ? 'collapsed' : 'expanded');
                    }
                });
                
                // Close on overlay click
                if (sidebarOverlay) {
                    sidebarOverlay.addEventListener('click', function() {
                        sidebar.classList.remove('show');
                        sidebarOverlay.classList.remove('show');
                        document.body.style.overflow = '';
                    });
                }
                
                // Close on link click (mobile)
                if (isMobile()) {
                    document.querySelectorAll('.sidebar-nav .nav-link').forEach(link => {
                        link.addEventListener('click', function() {
                            sidebar.classList.remove('show');
                            sidebarOverlay.classList.remove('show');
                            document.body.style.overflow = '';
                        });
                    });
                }
                
                // Handle resize
                let resizeTimer;
                window.addEventListener('resize', function() {
                    clearTimeout(resizeTimer);
                    resizeTimer = setTimeout(function() {
                        if (!isMobile()) {
                            sidebar.classList.remove('show');
                            sidebarOverlay.classList.remove('show');
                            document.body.style.overflow = '';
                        }
                    }, 150);
                });
                
                // ========== ACTIVE MENU ==========
                const currentPath = window.location.pathname.toLowerCase();
                document.querySelectorAll('.sidebar-nav .nav-link').forEach(link => {
                    const href = link.getAttribute('href');
                    if (href && currentPath.includes(href.toLowerCase())) {
                        link.classList.add('active');
                    }
                });
                
                // ========== AUTO HIDE ALERTS ==========
                (function() {
                    const alerts = document.querySelectorAll('.custom-alert');
                    alerts.forEach(function(alert) {
                        // Start progress bar animation
                        const progress = alert.querySelector('.alert-progress');
                        if (progress) {
                            progress.style.animation = 'alertProgress 8s linear forwards';
                        }
                        
                        // Auto dismiss after 8 seconds
                        setTimeout(function() {
                            if (alert && alert.parentNode) {
                                alert.style.animation = 'alertSlideOut 0.5s ease-out forwards';
                                setTimeout(function() {
                                    if (alert.parentNode) {
                                        alert.parentNode.removeChild(alert);
                                    }
                                }, 500);
                            }
                        }, 8000);
                    });
                })();
                
                // ========== THEME SETTINGS ==========
                initThemeSettings();
            });
            
            function initThemeSettings() {
                const savedTheme = localStorage.getItem('theme') || 'light';
                applyTheme(savedTheme);
                setActiveThemeButton(savedTheme);
                
                document.querySelectorAll('.theme-btn').forEach(btn => {
                    btn.addEventListener('click', function() {
                        const theme = this.dataset.theme;
                        localStorage.setItem('theme', theme);
                        applyTheme(theme);
                        setActiveThemeButton(theme);
                    });
                });
            }
            
            function setActiveThemeButton(theme) {
                document.querySelectorAll('.theme-btn').forEach(btn => {
                    if (btn.dataset.theme === theme) {
                        btn.classList.remove('btn-outline-primary');
                        btn.classList.add('btn-primary', 'active');
                    } else {
                        btn.classList.remove('btn-primary', 'active');
                        btn.classList.add('btn-outline-primary');
                    }
                });
            }
            
            function applyTheme(theme) {
                if (theme === 'dark') {
                    document.body.classList.add('dark-mode');
                } else {
                    document.body.classList.remove('dark-mode');
                }
            }
        })();
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
