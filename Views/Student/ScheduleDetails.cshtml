@model Webgiasu.Models.ViewModels.ScheduleDetailsViewModel

@{
    ViewData["Title"] = "Chi tiết lịch trao đổi";
    Layout = "_StudentLayout";
}

<div>
    <!-- Page Header -->
    <div class="page-header d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h5 class="fw-bold mb-1 text-dark">
                <i class="bi bi-calendar-event-fill text-primary me-2"></i>Chi tiết lịch trao đổi
            </h5>
            <p class="text-muted mb-0 small">Thông tin chi tiết về buổi trao đổi</p>
        </div>
        <a asp-action="MyClassSchedules" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
        </a>
    </div>

    <!-- Main Content -->
    <div class="row g-4">
        <!-- Left Column - Schedule Details -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-gradient text-black bg-gradient-dark">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-info-circle me-2"></i>@Model.Title
                    </h5>
                </div>
                <div class="card-body">
                    <!-- Status Badge -->
                    <div class="mb-4">
                        <span class="badge @(Model.Status == ScheduleStatus.Upcoming ? "bg-info" :
                                                                        Model.Status == ScheduleStatus.InProgress ? "bg-warning" :
                                                                        Model.Status == ScheduleStatus.Completed ? "bg-success" : "bg-danger") fs-6">
                            <i class="bi @(Model.Status == ScheduleStatus.Upcoming ? "bi-clock-history" :
                                                                       Model.Status == ScheduleStatus.InProgress ? "bi-hourglass-split" :
                                                                       Model.Status == ScheduleStatus.Completed ? "bi-check-circle" : "bi-x-circle") me-1"></i>
                            @(Model.Status == ScheduleStatus.Upcoming ? "Sắp tới" :
                                                        Model.Status == ScheduleStatus.InProgress ? "Đang diễn ra" :
                                                        Model.Status == ScheduleStatus.Completed ? "Đã hoàn thành" : "Đã hủy")
                        </span>
                    </div>

                    <!-- Date and Time -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="border-start border-primary border-3 ps-3">
                                <p class="text-muted small mb-1">
                                    <i class="bi bi-calendar3 me-1"></i>Ngày trao đổi
                                </p>
                                <h5 class="fw-bold mb-0">@Model.ScheduleDate.ToString("dd/MM/yyyy")</h5>
                                <small class="text-muted">@Model.ScheduleDate.ToString("dddd", new System.Globalization.CultureInfo("vi-VN"))</small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="border-start border-primary border-3 ps-3">
                                <p class="text-muted small mb-1">
                                    <i class="bi bi-clock me-1"></i>Thời gian
                                </p>
                                <h5 class="fw-bold mb-0">@Model.StartTime.ToString(@"hh\:mm") - @Model.EndTime.ToString(@"hh\:mm")</h5>
                                <small class="text-muted">Thời lượng: @Model.Duration</small>
                            </div>
                        </div>
                    </div>

                    <!-- Meeting Type and Location -->
                    <div class="row g-3 mb-4">
                        <div class="col-12">
                            <div class="border-start border-primary border-3 ps-3">
                                <p class="text-muted small mb-1">
                                    <i class="bi @(Model.MeetingType == "Online" ? "bi-camera-video" : "bi-geo-alt") me-1"></i>
                                    Hình thức
                                </p>
                                <h5 class="fw-bold mb-2">
                                    <span class="badge @(Model.MeetingType == "Online" ? "bg-info" : "bg-secondary") fs-6">
                                        @Model.MeetingType
                                    </span>
                                </h5>
                                @if (!string.IsNullOrEmpty(Model.Location))
                                {
                                    @if (Model.MeetingType == "Online")
                                    {
                                        <div class="alert alert-info mb-0">
                                            <strong><i class="bi bi-link-45deg me-1"></i>Link Meeting:</strong>
                                            <br>
                                            <a href="@Model.Location" target="_blank" class="text-decoration-none">
                                                @Model.Location
                                            </a>
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="mb-0">
                                            <strong><i class="bi bi-geo-alt-fill me-1"></i>Địa điểm:</strong> @Model.Location
                                        </p>
                                    }
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Content -->
                    @if (!string.IsNullOrEmpty(Model.Content))
                    {
                        <div class="mb-4">
                            <h6 class="fw-bold text-dark mb-2">
                                <i class="bi bi-file-text me-2"></i>Nội dung trao đổi
                            </h6>
                            <div class="alert alert-light border">
                                @Html.Raw(Model.Content.Replace("\n", "<br>"))
                            </div>
                        </div>
                    }

                    <!-- Notes -->
                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <div class="mb-0">
                            <h6 class="fw-bold text-dark mb-2">
                                <i class="bi bi-sticky me-2"></i>Ghi chú
                            </h6>
                            <div class="alert alert-warning border-warning">
                                <i class="bi bi-exclamation-triangle me-1"></i>
                                @Html.Raw(Model.Notes.Replace("\n", "<br>"))
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right Column - Class & Creator Info -->
        <div class="col-lg-4">
            <!-- Class Info -->
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-warning bg-opacity-10 border-bottom">
                    <h6 class="mb-0 fw-bold text-warning">
                        <i class="bi bi-building me-2"></i>Thông tin lớp học
                    </h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <small class="text-muted d-block mb-1">Tên lớp</small>
                        <strong class="d-block">@Model.ClassName</strong>
                    </div>
                    <div class="mb-3">
                        <small class="text-muted d-block mb-1">Môn học</small>
                        <strong class="d-block">@Model.Subject</strong>
                    </div>
                    <div class="mb-3">
                        <small class="text-muted d-block mb-1">Số học sinh</small>
                        <strong class="d-block">
                            <i class="bi bi-people me-1"></i>@Model.TotalStudents người
                        </strong>
                    </div>
                    <a asp-action="ClassSchoolDetails" asp-route-id="@Model.ClassId" class="btn btn-warning btn-sm w-100">
                        <i class="bi bi-eye me-1"></i>Xem lớp học
                    </a>
                </div>
            </div>

            <!-- Tutor Info -->
            @if (!string.IsNullOrEmpty(Model.TutorName))
            {
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-success bg-opacity-10 border-bottom">
                        <h6 class="mb-0 fw-bold text-success">
                            <i class="bi bi-person-check me-2"></i>Mentor
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="mb-2">
                            <strong class="d-block">@Model.TutorName</strong>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.TutorEmail))
                        {
                            <small class="text-muted">
                                <i class="bi bi-envelope me-1"></i>@Model.TutorEmail
                            </small>
                        }
                    </div>
                </div>
            }

            <!-- Creator Info -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light border-bottom">
                    <h6 class="mb-0 fw-bold">
                        <i class="bi bi-person-badge me-2"></i>Người tạo
                    </h6>
                </div>
                <div class="card-body">
                    <div class="mb-2">
                        <strong class="d-block">@Model.CreatorName</strong>
                    </div>
                    <small class="text-muted">
                        <i class="bi bi-calendar-plus me-1"></i>
                        Tạo lúc: @Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>