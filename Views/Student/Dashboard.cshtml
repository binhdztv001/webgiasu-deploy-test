@model Webgiasu.Models.ViewModels.StudentDashboardViewModel
@{
    ViewData["Title"] = "Trang chủ - Học sinh";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<div class="dashboard-container">
    <!-- Page Header -->
    <div class="page-header d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div class="mb-2 mb-md-0">
            <h5 class="fw-bold mb-1 text-dark">
                <i class="bi bi-mortarboard text-primary me-2"></i>Trang chủ Học sinh
            </h5>
            <p class="text-muted mb-0 small">Quản lý bài toán và theo dõi tiến độ học tập</p>
            <p class="text-muted mb-0">
                <i class="bi bi-calendar3"></i> @DateTime.Now.ToString("dddd, dd MMMM yyyy")
                <span class="mx-2">•</span>
                <i class="bi bi-clock"></i> <span class="clock">@DateTime.Now.ToString("HH:mm")</span>
            </p>
        </div>
        <a asp-action="CreateProblem" class="btn btn-primary btn-sm shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Đăng bài mới
        </a>
    </div>

    <!-- Stats Cards -->
    <div class="row g-3 mb-3">
        <div class="col-6 col-lg-3">
            <div class="card stat-card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 small text-uppercase">Đã đăng</p>
                            <h3 class="fw-bold mb-0 text-primary">@Model.MyProblems.Count</h3>
                        </div>
                        <div class="stat-icon bg-primary bg-opacity-10 rounded">
                            <i class="bi bi-file-text text-primary"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card stat-card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 small text-uppercase">Đã giải</p>
                            <h3 class="fw-bold mb-0 text-success">@Model.MyProblems.Count(p => p.Status == Webgiasu.Models.ProblemStatus.Solved)</h3>
                        </div>
                        <div class="stat-icon bg-success bg-opacity-10 rounded">
                            <i class="bi bi-check-circle text-success"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card stat-card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 small text-uppercase">Đang giải</p>
                            <h3 class="fw-bold mb-0 text-warning">@Model.MyProblems.Count(p => p.Status == Webgiasu.Models.ProblemStatus.InProgress)</h3>
                        </div>
                        <div class="stat-icon bg-warning bg-opacity-10 rounded">
                            <i class="bi bi-hourglass-split text-warning"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="card stat-card border-0 shadow-sm h-100">
                <div class="card-body p-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-1 small text-uppercase">Chờ thanh toán</p>
                            <h3 class="fw-bold mb-0 text-info">@Model.Payments.Count(p => p.Status == Webgiasu.Models.PaymentStatus.Pending)</h3>
                        </div>
                        <div class="stat-icon bg-info bg-opacity-10 rounded">
                            <i class="bi bi-credit-card text-info"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Problems List -->
    <div class="card border-0 shadow-sm">
        <div class="card-header py-3" style="background: linear-gradient(135deg, #2196F3 0%, #03A9F4 100%);">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="mb-0 fw-bold text-white">
                        <i class="bi bi-list-ul me-2"></i>Danh sách bài toán
                    </h6>
                </div>
                <span class="badge bg-white text-primary">@Model.MyProblems.Count bài</span>
            </div>
        </div>
        <div class="card-body p-0">
            @if (Model.MyProblems.Any())
            {
                <div class="table-responsive mt-3">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-3">ID</th>
                                <th>Tiêu đề</th>
                                <th>Môn</th>
                                <th>Độ khó</th>
                                <th>Ngày đăng</th>
                                <th>Trạng thái</th>
                                <th>Giá</th>
                                <th class="text-center pe-3">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var problem in Model.MyProblems)
                            {
                                var statusClass = problem.Status switch
                                {
                                    Webgiasu.Models.ProblemStatus.WaitingForTutor => "warning",
                                    Webgiasu.Models.ProblemStatus.InProgress => "info",
                                    Webgiasu.Models.ProblemStatus.Solved => "success",
                                    _ => "secondary"
                                };
                                var statusText = problem.Status switch
                                {
                                    Webgiasu.Models.ProblemStatus.WaitingForTutor => "Chờ gia sư",
                                    Webgiasu.Models.ProblemStatus.InProgress => "Đang giải",
                                    Webgiasu.Models.ProblemStatus.Solved => "Đã giải",
                                    _ => "Khác"
                                };
                                <tr>
                                    <td class="ps-3 fw-bold text-primary">#@problem.Id</td>
                                    <td>
                                        <div class="fw-semibold text-truncate" style="max-width: 200px;">@problem.Title</div>
                                    </td>
                                    <td><span class="badge bg-secondary">@problem.Type</span></td>
                                    <td>
                                        @if (problem.Difficulty == Webgiasu.Models.DifficultyLevel.Easy)
                                        {
                                            <span class="badge bg-success">Dễ</span>
                                        }
                                        else if (problem.Difficulty == Webgiasu.Models.DifficultyLevel.Medium)
                                        {
                                            <span class="badge bg-warning text-dark">TB</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Khó</span>
                                        }
                                    </td>
                                    <td>
                                        <small class="text-muted">@problem.CreatedDate.ToString("dd/MM/yyyy")</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-@statusClass">@statusText</span>
                                    </td>
                                    <td class="fw-bold text-success">@problem.Price.ToString("N0")đ</td>
                                    <td class="text-center pe-3">
                                        <a asp-action="ProblemDetails" asp-route-id="@problem.Id" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox text-muted" style="font-size: 3rem; opacity: 0.3;"></i>
                    <h6 class="text-muted mt-3">Chưa có bài toán nào</h6>
                    <p class="text-muted small mb-3">Đăng bài toán đầu tiên để nhận hỗ trợ từ gia sư</p>
                    <a asp-action="CreateProblem" class="btn btn-primary btn-sm">
                        <i class="bi bi-plus-circle"></i> Đăng bài ngay
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Dashboard specific scripts if needed
    </script>
}
