@model List<Webgiasu.Models.ViewModels.ClassViewModel>
@using Webgiasu.Models

@{
    ViewData["Title"] = "Danh sách lớp học";
    Layout = "~/Views/Shared/_SchoolLayout.cshtml";
}

<div class="dashboard-container">
    <!-- Page Header -->
    <div class="page-header d-flex justify-content-between align-items-center">
        <div>
            <h2><i class="bi bi-list-ul me-2 text-warning"></i>Danh sách lớp học</h2>
            <p class="text-muted mb-0">Xem tổng quan các lớp học trong hệ thống</p>
        </div>
        <div class="d-flex gap-2 w-sm-auto mt-2 mt-sm-0">
            <a asp-controller="School" asp-action="CreateClass" class="btn btn-warning flex-fill flex-sm-none">
                <i class="bi bi-plus-circle me-2"></i>Tạo lớp mới
            </a>
        </div>
    </div>

    <!-- Filter Section -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Tìm kiếm</label>
                    <input type="text" class="form-control" name="search" placeholder="Tên lớp, môn học...">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Trạng thái</label>
                    <select class="form-select" name="status">
                        <option value="">Tất cả</option>
                        <option value="active">Đang diễn ra</option>
                        <option value="completed">Đã hoàn thành</option>
                        <option value="upcoming">Sắp bắt đầu</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Môn học</label>
                    <select class="form-select" name="subject">
                        <option value="">Tất cả</option>
                        <option value="math">Toán</option>
                        <option value="physics">Vật lý</option>
                        <option value="chemistry">Hóa học</option>
                        <option value="english">Tiếng Anh</option>
                    </select>
                </div>
                <div class="col-md-2 d-grid d-md-flex align-items-end">
                    <button type="submit" class="btn btn-warning w-100">
                        <i class="bi bi-search me-2"></i>Tìm kiếm
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Classes List -->
    @if (Model == null || !Model.Any())
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <i class="bi bi-inbox fs-1 text-muted mb-3 d-block"></i>
                <h5 class="text-muted mb-3">Chưa có lớp học nào</h5>
                <p class="text-muted mb-4">Hãy tạo lớp học đầu tiên để bắt đầu quản lý</p>
                <a asp-controller="School" asp-action="CreateClass" class="btn btn-warning">
                    <i class="bi bi-plus-circle me-2"></i>Tạo lớp học mới
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var classItem in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100">
                        <div class="card-header bg-warning text-white">
                            <h5 class="mb-0">@classItem.ClassName</h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-2">
                                <small class="text-muted">
                                    <i class="bi bi-book me-1"></i>Môn học:
                                </small>
                                <span class="badge bg-info">@classItem.Subject</span>
                            </div>
                            <div class="mb-2">
                                <small class="text-muted">
                                    <i class="bi bi-person-badge me-1"></i>Mentor:
                                </small>
                                <strong>@classItem.TutorName</strong>
                            </div>
                            <div class="mb-2">
                                <small class="text-muted">
                                    <i class="bi bi-people me-1"></i>Học sinh:
                                </small>
                                <strong>@classItem.StudentCount người</strong>
                            </div>
                            <div class="mb-2">
                                <small class="text-muted">
                                    <i class="bi bi-calendar me-1"></i>Bắt đầu:
                                </small>
                                <strong>@classItem.StartDate</strong>
                            </div>
                            <div class="mb-2">
                                <small class="text-muted">
                                    <i class="bi bi-activity me-1"></i>Trạng thái:
                                </small>
                                @if (classItem.Status == ClassStatus.Active)
                                {
                                    <span class="badge bg-success">Đang hoạt động</span>
                                }
                                else if (classItem.Status == ClassStatus.Completed)
                                {
                                    <span class="badge bg-secondary">Đã hoàn thành</span>
                                }
                                else if (classItem.Status == ClassStatus.Upcoming)
                                {
                                    <span class="badge bg-info">Sắp bắt đầu</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Đã hủy</span>
                                }
                            </div>
                            <hr>
                            <div class="d-flex gap-2">
                                <a asp-controller="School" asp-action="ClassDetails" asp-route-id="@classItem.Id" class="btn btn-sm btn-warning flex-fill">
                                    <i class="bi bi-eye me-1"></i>Xem chi tiết
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
